/-
# Small Frobenius elements generate the cyclotomic Galois groups

Built against PrimeNumberTheoremAnd at commit 650d312 (`lib/vendor/pnt-plus`).

Plain statement. Let `L` be the `q`-th cyclotomic field over `ℚ` and `ζ` a primitive `q`-th root of unity in it. For a
prime `ℓ ∤ q`, the automorphism `σ_ℓ` of `L` with `σ_ℓ(ζ) = ζ^ℓ` is the Frobenius element of `ℓ`. For every `A > 12`
there is `C` such that, for every `q ≥ 1`, the `σ_ℓ` with `ℓ ≤ C(log(q + 2))^A` generate `Gal(L/ℚ)`
(`closure_frob_eq_top`). For every `ε > 0` there is `C` such that, whenever `Gal(L/ℚ) ≅ (ℤ/qℤ)ˣ` is cyclic (`q` is `1`,
`2`, `4`, `pᵏ` or `2pᵏ` with `p` an odd prime), a single `σ_ℓ` with `ℓ ≤ Cq^ε` generates it
(`exists_frob_generator`). No hypothesis.

These are effective Chebotarev statements for the abelian fields `ℚ(ζ_q)`: under GRH, E. Bach (1990) shows that the
primes `ℓ < 2(log q)²` generate `(ℤ/qℤ)ˣ`, and so that their Frobenius elements generate `Gal(ℚ(ζ_q)/ℚ)`. Here they
come from the half-plane, through `SmallPrimes.closure_primes_eq_top` and
`LeastPrimitiveRoot.exists_prime_primRoot_le_rpow`.

* `apply_zeta_eq_pow_iff`: Mathlib's `IsCyclotomicExtension.autEquivPow`, `Gal(L/ℚ) ≃* (ℤ/qℤ)ˣ` (`ℚ`'s cyclotomic
  polynomials are irreducible), sends `σ` to the class `k` with `σ(ζ) = ζ^k`. So `σ(ζ) = ζ^ℓ` if and only if `σ` goes
  to `ℓ mod q`.
* The isomorphism carries the subgroup generated by the `σ_ℓ` to the one generated by the classes of the `ℓ`, and the
  order of `σ_ℓ` to the order of `ℓ mod q`.
-/
import SmallPrimes
import LeastPrimitiveRoot

open IsCyclotomicExtension

namespace CyclotomicFrobenius

variable {q : ℕ} [NeZero q] {L : Type*} [Field L] [Algebra ℚ L] [IsCyclotomicExtension {q} ℚ L]

/-- `Gal(L/ℚ) ≃* (ℤ/qℤ)ˣ` for the `q`-th cyclotomic field `L` (Mathlib's `IsCyclotomicExtension.autEquivPow`, with the
irreducibility of `ℚ`'s cyclotomic polynomials). -/
noncomputable abbrev galEquiv (q : ℕ) [NeZero q] (L : Type*) [Field L] [Algebra ℚ L] [IsCyclotomicExtension {q} ℚ L] :
    (L ≃ₐ[ℚ] L) ≃* (ZMod q)ˣ :=
  autEquivPow L (Polynomial.cyclotomic.irreducible_rat (NeZero.pos q))

/-- `σ(ζ) = ζ^ℓ` if and only if `σ` goes to `ℓ mod q` under `Gal(L/ℚ) ≃* (ℤ/qℤ)ˣ`. -/
lemma apply_zeta_eq_pow_iff (σ : L ≃ₐ[ℚ] L) (ℓ : ℕ) :
    σ (zeta q ℚ L) = zeta q ℚ L ^ ℓ ↔ ((galEquiv q L σ : (ZMod q)ˣ) : ZMod q) = ℓ := by
  have hζ := zeta_spec q ℚ L
  have hfin : IsOfFinOrder (zeta q ℚ L) :=
    isOfFinOrder_iff_pow_eq_one.2 ⟨q, NeZero.pos q, hζ.pow_eq_one⟩
  rw [galEquiv, autEquivPow_apply, ← hζ.autToPow_spec ℚ σ, hfin.pow_eq_pow_iff_modEq, ← hζ.eq_orderOf,
    ← ZMod.natCast_eq_natCast_iff, ZMod.natCast_zmod_val]
  exact Iff.rfl

/-- **The Frobenius elements of the small primes generate the cyclotomic Galois group.** For every `A > 12` there is
`C > 0` such that for every `q ≥ 1` and every `q`-th cyclotomic field `L` over `ℚ`, with `ζ` its primitive `q`-th root
of unity `IsCyclotomicExtension.zeta q ℚ L`, the automorphisms `σ` with `σ(ζ) = ζ^ℓ` for a prime `ℓ ≤ C(log(q + 2))^A`
generate `Gal(L/ℚ)`. -/
theorem closure_frob_eq_top {A : ℝ} (hA : 12 < A) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q] (L : Type*) [Field L] [Algebra ℚ L] [IsCyclotomicExtension {q} ℚ L],
      Subgroup.closure {σ : L ≃ₐ[ℚ] L | ∃ ℓ : ℕ, ℓ.Prime ∧ (ℓ : ℝ) ≤ C * Real.log (q + 2) ^ A ∧
        σ (zeta q ℚ L) = zeta q ℚ L ^ ℓ} = ⊤ := by
  obtain ⟨C, hC, h⟩ := SmallPrimes.closure_primes_eq_top hA
  refine ⟨C, hC, fun q _ L _ _ _ ↦ ?_⟩
  set e := galEquiv q L
  set S := {σ : L ≃ₐ[ℚ] L | ∃ ℓ : ℕ, ℓ.Prime ∧ (ℓ : ℝ) ≤ C * Real.log (q + 2) ^ A ∧
    σ (zeta q ℚ L) = zeta q ℚ L ^ ℓ} with hSdef
  have himage : e.toMonoidHom '' S = {u : (ZMod q)ˣ | ∃ p : ℕ, p.Prime ∧ (p : ℝ) ≤ C * Real.log (q + 2) ^ A ∧
      (u : ZMod q) = p} := by
    ext u
    constructor
    · rintro ⟨σ, ⟨ℓ, hℓ, hle, hσ⟩, rfl⟩
      exact ⟨ℓ, hℓ, hle, (apply_zeta_eq_pow_iff σ ℓ).1 hσ⟩
    · rintro ⟨ℓ, hℓ, hle, hu⟩
      refine ⟨e.symm u, ⟨ℓ, hℓ, hle, (apply_zeta_eq_pow_iff (e.symm u) ℓ).2 ?_⟩, by simp⟩
      rw [MulEquiv.apply_symm_apply, hu]
  have hmap : (Subgroup.closure S).map e.toMonoidHom = ⊤ := by
    rw [MonoidHom.map_closure, himage, h q]
  have hcomap := congrArg (Subgroup.comap e.toMonoidHom) hmap
  rwa [Subgroup.comap_map_eq_self_of_injective (f := e.toMonoidHom) e.injective, Subgroup.comap_top] at hcomap

/-- **A single small Frobenius element generates the cyclotomic Galois group.** For every `ε > 0` there is `C > 0`
such that for every `q ≥ 1` with `(ℤ/qℤ)ˣ` cyclic and every `q`-th cyclotomic field `L` over `ℚ`, with `ζ` its
primitive `q`-th root of unity `IsCyclotomicExtension.zeta q ℚ L`, some prime `ℓ ∤ q` with `ℓ ≤ Cq^ε` has an
automorphism `σ` with `σ(ζ) = ζ^ℓ` that generates `Gal(L/ℚ)`. -/
theorem exists_frob_generator {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q], IsCyclic (ZMod q)ˣ →
      ∀ (L : Type*) [Field L] [Algebra ℚ L] [IsCyclotomicExtension {q} ℚ L],
        ∃ ℓ : ℕ, ℓ.Prime ∧ ¬ ℓ ∣ q ∧ (ℓ : ℝ) ≤ C * (q : ℝ) ^ ε ∧
          ∃ σ : L ≃ₐ[ℚ] L, σ (zeta q ℚ L) = zeta q ℚ L ^ ℓ ∧ Subgroup.zpowers σ = ⊤ := by
  obtain ⟨C, hC, h⟩ := LeastPrimitiveRoot.exists_prime_primRoot_le_rpow hε
  refine ⟨C, hC, fun q _ hcyc L _ _ _ ↦ ?_⟩
  obtain ⟨ℓ, hℓ, hℓq, hord, hle⟩ := h q hcyc
  have hcop : ℓ.Coprime q := (Nat.Prime.coprime_iff_not_dvd hℓ).2 hℓq
  have : Finite (L ≃ₐ[ℚ] L) := Finite.of_equiv _ (galEquiv q L).symm.toEquiv
  refine ⟨ℓ, hℓ, hℓq, hle, (galEquiv q L).symm (ZMod.unitOfCoprime ℓ hcop), ?_, ?_⟩
  · rw [apply_zeta_eq_pow_iff, MulEquiv.apply_symm_apply, ZMod.coe_unitOfCoprime]
  · refine Subgroup.eq_top_of_card_eq _ ?_
    rw [Nat.card_zpowers, MulEquiv.orderOf_eq, ← orderOf_units, ZMod.coe_unitOfCoprime, hord,
      Nat.card_congr (galEquiv q L).toEquiv, Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]

end CyclotomicFrobenius

#print axioms CyclotomicFrobenius.closure_frob_eq_top
#print axioms CyclotomicFrobenius.exists_frob_generator
