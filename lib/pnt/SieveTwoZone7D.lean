/-- **The region of the estimate in two variables.** With `s_i = 1 − m_i` and `ρ = L − m₁ − m₂`: `ρ ≥ 1/2000`,
`m_i ≥ 2/3`, and `s₁ + 1/12500`, `s₂ + 1/12500`, `s₁ + s₂ + 1/12500` at most `λρ`, `λ = 27637 / 62500`. -/
def Zone7d (L m₁ m₂ : ℝ) : Prop :=
  1 / 2000 ≤ L - m₁ - m₂ ∧ 2 / 3 ≤ m₁ ∧ 2 / 3 ≤ m₂ ∧
    (1 - m₁) + 1 / 12500 ≤ 27637 / 62500 * (L - m₁ - m₂) ∧
    (1 - m₂) + 1 / 12500 ≤ 27637 / 62500 * (L - m₁ - m₂) ∧
    (1 - m₁) + (1 - m₂) + 1 / 12500 ≤ 27637 / 62500 * (L - m₁ - m₂)

/-- The region lies in `m₁ + m₂ ≤ L`. -/
lemma zone7d_le (L : ℝ) (m₁ m₂ : ℝ) (h : Zone7d L m₁ m₂) : m₁ + m₂ ≤ L := by
  have := h.1; linarith

/-- For `β ≤ 7789 / 10000` the zone's exponents hold on the region by orthogonality, whatever the curve. -/
lemma zone7d_orth (g : ℝ → ℝ) (L : ℝ) :
    ZonePiece g L (1 / 1000) (1 / 1000) (Zone7d L) (1 / 2) (7789 / 10000) :=
  zonePiece_OO g (zone7d_le L) (by zends)

