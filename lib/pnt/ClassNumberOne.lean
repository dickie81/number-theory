/-
# Gauss's class number one problem: the nine imaginary quadratic fields (Baker, Heegner, Stark)

Imports Mathlib and the library's `ClassNumberSharp`, `QuadPrincipal` and the certificate `ClassNumberOneCertP0`, …,
`ClassNumberOneCertP3`.

Plain statement. A number field `K` of degree `2` with no real place has class number one if and only if its
discriminant is one of `−3, −4, −7, −8, −11, −19, −43, −67, −163` (`classNumber_eq_one_iff`).

The proof of "only if" is not Heegner's, Baker's or Stark's. It has three steps.

* **The analytic bound.** A field of class number one has `|D_K| < 2.5·10⁷`
  (`ClassNumberSharp.abs_discr_lt_of_classNumber_eq_one`): the class number formula with
  `L(1, χ_K) ≥ e^{−γ−3/100}/(13(52 + log log(|D_K| + 2)))`, which the library proves from the zero-free half-plane
  `Re s > 11/12` (`Eis.LFunction_ne_zero_of_re_gt`). This is the step that Siegel's theorem cannot do: it gives
  `h_K → ∞` with no bound on where.
* **Small primes are inert.** In a field of class number one a prime ideal of norm `p` is principal, and an element of
  `𝓞 K` of norm `p` forces `|D_K| ≤ 4p` (`QuadPrincipal.abs_discr_le_of_norm`). So every prime `p < |D_K|/4` is inert
  (`QuadPrincipal.abs_discr_le_of_split`, `QuadPrincipal.abs_discr_le_of_ramified`). With `K = ℚ(√d)`: for
  `d ≡ 2, 3 (mod 4)` the prime `2` ramifies, so `|D_K| = 4|d| ≤ 8`; for `d ≡ 1 (mod 8)` it splits, so `|d| ≤ 8`; and for
  `d ≡ 5 (mod 8)`, `d` is a non-square modulo every odd prime `p < |d|/4`.
* **The finite search.** For every `n ≡ 3 (mod 8)` below `25 600 171` other than `3, 11, 19, 43, 67, 163`, `−n` is a
  square modulo some odd prime `p ≤ 67` with `4p < n` (`heegner_or_good`): `3 200 000` cases, which the kernel checks
  in `32` computations of `100 000` cases each (`ClassNumberOneCert.check_0`, …, `check_31`), and `15` cases below
  `171` (`good_small`). The bit masks of the squares modulo `p` that the search reads are proved correct here
  (`masks_ok`), with the primality of each `p`.

"If": Minkowski's bound puts an ideal of norm at most `(2/π)√|D_K|` in every class, and for these nine fields every
prime up to that bound is inert, so every such ideal is generated by a natural number
(`QuadPrincipal.classNumber_eq_one_of_inert`). For `−163` the primes are `2, 3, 5, 7`.

`classNumber K` and `discr K` are Mathlib's. The theorem depends on `propext`, `Classical.choice` and `Quot.sound` only.
-/
import Mathlib
import ClassNumberSharp
import QuadPrincipal
import ClassNumberOneCertP0
import ClassNumberOneCertP1
import ClassNumberOneCertP2
import ClassNumberOneCertP3

open NumberField ClassNumberOneCert

/- Erased for `ring` in `ZMod p`, as in `QuadSplit`: with `[Fact p.Prime]` in context, `-x` in `ZMod p` otherwise
elaborates through this instance. -/
attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

namespace ClassNumberOne

/-! ### The certificate, and what it means -/

/-- **The masks are right**: each `p` of the list is at least `3` and has no divisor in `[2, p)`, and each set bit of
its mask is a square modulo `p`. -/
theorem masks_ok : ∀ pm ∈ primeMasks, 2 < pm.1 ∧ (∀ m, m < pm.1 → 2 ≤ m → pm.1 % m ≠ 0) ∧
    ∀ i, i < pm.1 → Nat.testBit pm.2 i = true → ∃ r, r < pm.1 ∧ r * r % pm.1 = i := by
  decide +kernel

/-- Each `p` of the list is prime. -/
theorem prime_of_mem {pm : ℕ × ℕ} (h : pm ∈ primeMasks) : pm.1.Prime := by
  obtain ⟨h2, hdiv, -⟩ := masks_ok pm h
  rw [Nat.prime_def_lt]
  refine ⟨by omega, fun m hm hmd => ?_⟩
  by_contra h1
  rcases Nat.lt_or_ge m 2 with hlt | hge
  · have h0 : m = 0 := by omega
    rw [h0, zero_dvd_iff] at hmd
    omega
  · exact hdiv m hm hge (Nat.mod_eq_zero_of_dvd hmd)

/-- **What `good n` means**: an odd prime `p` with `4p < n` and `p ∣ r² + n` for some `r`. -/
theorem exists_prime_of_good {n : ℕ} (h : good n = true) :
    ∃ p : ℕ, p.Prime ∧ p ≠ 2 ∧ 4 * p < n ∧ ∃ r : ℕ, p ∣ r * r + n := by
  unfold good at h
  rw [List.any_eq_true] at h
  obtain ⟨pm, hmem, hcond⟩ := h
  rw [Bool.and_eq_true, decide_eq_true_eq] at hcond
  obtain ⟨h4, hsq⟩ := hcond
  obtain ⟨h2, -, hmask⟩ := masks_ok pm hmem
  have hp0 : 0 < pm.1 := by omega
  refine ⟨pm.1, prime_of_mem hmem, by omega, h4, ?_⟩
  unfold ClassNumberOneCert.sq at hsq
  obtain ⟨r, -, hr⟩ := hmask _ (Nat.mod_lt _ hp0) hsq
  refine ⟨r, ?_⟩
  rw [Nat.dvd_iff_mod_eq_zero, Nat.add_mod, hr]
  rcases Nat.eq_zero_or_pos (n % pm.1) with h0 | hpos
  · rw [h0, Nat.sub_zero, Nat.mod_self, Nat.zero_add, Nat.zero_mod]
  · have hlt : pm.1 - n % pm.1 < pm.1 := Nat.sub_lt hp0 hpos
    rw [Nat.mod_eq_of_lt hlt, Nat.sub_add_cancel (Nat.mod_lt n hp0).le, Nat.mod_self]

/-- **The search, assembled**: `good n` for every `n ≡ 3 (mod 8)` with `171 ≤ n < 25 600 171`. -/
