/-- The cases below `171`. -/
theorem good_small :
    ∀ n ∈ [27, 35, 51, 59, 75, 83, 91, 99, 107, 115, 123, 131, 139, 147, 155], good n = true := by
  decide +kernel

/-- **The finite search**: every `n ≡ 3 (mod 8)` below `25 600 171` is one of `3, 11, 19, 43, 67, 163`, or `−n` is a
square modulo an odd prime `p ≤ 67` with `4p < n`. -/
theorem heegner_or_good {n : ℕ} (h8 : n % 8 = 3) (hhi : n < 25600171) :
    n = 3 ∨ n = 11 ∨ n = 19 ∨ n = 43 ∨ n = 67 ∨ n = 163 ∨ good n = true := by
  rcases Nat.lt_or_ge n 171 with hlt | hge
  · obtain ⟨q, rfl⟩ : ∃ q, n = 8 * q + 3 := ⟨n / 8, by omega⟩
    have hq : q < 21 := by omega
    interval_cases q <;> first
      | (left; rfl) | (right; left; rfl) | (right; right; left; rfl) | (right; right; right; left; rfl)
      | (right; right; right; right; left; rfl) | (right; right; right; right; right; left; rfl)
      | (right; right; right; right; right; right; exact good_small _ (by decide))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (good_of_mod h8 hge hhi))))))

/-! ### The nine fields -/

variable {K : Type*} [Field K] [NumberField K]

/-- A squarefree integer is `1`, `2` or `3` modulo `4`. -/
theorem emod_four {d : ℤ} (hd : Squarefree d) : d % 4 = 1 ∨ d % 4 = 2 ∨ d % 4 = 3 := by
  have h0 : d % 4 ≠ 0 := by
    intro h
    obtain ⟨k, hk⟩ := Int.dvd_of_emod_eq_zero h
    have := hd 2 ⟨k, by rw [hk]; ring⟩
    exact absurd (Int.isUnit_iff.1 this) (by omega)
  omega

/-- **Only the nine**: an imaginary quadratic field of class number one has discriminant
`−3, −4, −7, −8, −11, −19, −43, −67` or `−163`. -/
theorem discr_of_classNumber_eq_one (hK : Module.finrank ℚ K = 2) (hc : InfinitePlace.nrRealPlaces K = 0)
    (h1 : classNumber K = 1) :
    discr K = -3 ∨ discr K = -4 ∨ discr K = -7 ∨ discr K = -8 ∨ discr K = -11 ∨ discr K = -19 ∨
      discr K = -43 ∨ discr K = -67 ∨ discr K = -163 := by
  obtain ⟨d, s, hd, hd1, hs⟩ := QuadRing.exists_sqrt hK
  have hd0 : d < 0 := QuadPrincipal.neg_of_nrRealPlaces hd hd1 hs hK hc
  have hbig := ClassNumberSharp.abs_discr_lt_of_classNumber_eq_one hK hc h1
  rcases emod_four hd with h4 | h23
  · -- `d ≡ 1 (mod 4)`: `D_K = d`
    have hD := QuadRing.discr_θ₁ hd hd1 hs h4 hK
    have h8 : d % 8 = 1 ∨ d % 8 = 5 := by omega
    rcases h8 with h8 | h8
    · -- `2` splits, so `|d| ≤ 8`
      have hle := QuadPrincipal.abs_discr_le_of_split hK hc h1 Nat.prime_two
        (QuadSplit.split_two₁ hd hd1 hs hK h4 h8)
      rw [hD, abs_of_neg hd0] at hle
      rw [hD]
      have : d = -7 := by
        have : -d ≤ 8 := by exact_mod_cast hle
        omega
      right; right; left; exact this
    · -- `n = −d ≡ 3 (mod 8)`: the search
      obtain ⟨n, hnd⟩ : ∃ n : ℕ, (n : ℤ) = -d := ⟨(-d).toNat, Int.toNat_of_nonneg (by omega)⟩
      have hn8 : n % 8 = 3 := by omega
      have hnhi : n < 25600171 := by
        rw [hD, abs_of_neg (by exact_mod_cast hd0)] at hbig
        have h' : (n : ℝ) < 25000000 := by
          have : (n : ℝ) = -(d : ℝ) := by exact_mod_cast hnd
          rw [this]; exact hbig
        have : n < 25000000 := by exact_mod_cast h'
        omega
      rw [hD]
      rcases heegner_or_good hn8 hnhi with h | h | h | h | h | h | hgood
      · left; omega
      · right; right; right; right; left; omega
      · right; right; right; right; right; left; omega
      · right; right; right; right; right; right; left; omega
      · right; right; right; right; right; right; right; left; omega
      · right; right; right; right; right; right; right; right; omega
      · exfalso
        obtain ⟨p, hp, hp2, h4p, r, hr⟩ := exists_prime_of_good hgood
        have : Fact p.Prime := ⟨hp⟩
        have hsq : IsSquare ((d : ℤ) : ZMod p) := by
          refine ⟨(r : ZMod p), ?_⟩
          have h0 : ((r * r + n : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).2 hr
          have hdn : ((d : ℤ) : ZMod p) = -(n : ZMod p) := by
            have : d = -(n : ℤ) := by omega
            rw [this]
            push_cast
            rfl
          rw [hdn]
          push_cast at h0
          linear_combination (-1 : ZMod p) * h0
        have hle : |discr K| ≤ 4 * p := by
          by_cases hpd : (p : ℤ) ∣ d
          · exact QuadPrincipal.abs_discr_le_of_ramified hK hc h1 hp
              (QuadSplit.ramified_of_dvd₁ hd hd1 hs hK h4 hp2 hpd)
          · exact QuadPrincipal.abs_discr_le_of_split hK hc h1 hp
              (QuadSplit.split₁ hd hd1 hs hK h4 hp2 hpd hsq)
        rw [hD, abs_of_neg hd0] at hle
        have : (n : ℤ) ≤ 4 * p := by rw [hnd]; exact hle
        have : n ≤ 4 * p := by exact_mod_cast this
        omega
  · -- `d ≡ 2, 3 (mod 4)`: `D_K = 4d`, and `2` ramifies, so `4|d| ≤ 8`
    have hD := QuadRing.discr_θ₂ hd hd1 hs h23 hK
    have hle := QuadPrincipal.abs_discr_le_of_ramified hK hc h1 Nat.prime_two
      (QuadSplit.ramified_two₂ hd hd1 hs hK h23)
    rw [hD, abs_of_neg (by omega)] at hle
    rw [hD]
    have hle' : -(4 * d) ≤ 8 := by exact_mod_cast hle
    have : d = -1 ∨ d = -2 := by omega
    rcases this with rfl | rfl
    · right; left; norm_num
    · right; right; right; left; norm_num

/-! ### The nine fields have class number one -/

open scoped nonZeroDivisors in
/-- **Minkowski's bound, in integers**: if `4|D_K| < 9(B + 1)²`, every class of ideals of an imaginary quadratic field
contains an ideal of norm at most `B`, since `(2/π)√|D_K| < (2/3)√|D_K| < B + 1`. -/
theorem exists_ideal_norm_le_nat (hK : Module.finrank ℚ K = 2) (hc : InfinitePlace.nrRealPlaces K = 0) {B : ℕ}
    (hD : 4 * |discr K| < 9 * ((B : ℤ) + 1) ^ 2) (C : ClassGroup (𝓞 K)) :
    ∃ I : (Ideal (𝓞 K))⁰, ClassGroup.mk0 I = C ∧ Ideal.absNorm (I : Ideal (𝓞 K)) ≤ B := by
  obtain ⟨I, hI, hle⟩ := QuadPrincipal.exists_ideal_norm_le hK hc C
  refine ⟨I, hI, ?_⟩
  set a := Ideal.absNorm (I : Ideal (𝓞 K)) with ha
  set x := Real.sqrt |(discr K : ℝ)| with hx
  have hx0 : 0 ≤ x := Real.sqrt_nonneg _
  have hx2 : x ^ 2 = |(discr K : ℝ)| := Real.sq_sqrt (abs_nonneg _)
  have hπ := Real.pi_gt_three
  have h1 : (a : ℝ) ≤ 2 / 3 * x := by
    refine hle.trans (mul_le_mul_of_nonneg_right ?_ hx0)
    exact div_le_div_of_nonneg_left (by norm_num) (by norm_num) hπ.le
  have hDr : 4 * |(discr K : ℝ)| < 9 * ((B : ℝ) + 1) ^ 2 := by exact_mod_cast hD
  have h2 : (a : ℝ) < B + 1 := by
    by_contra hcon
    rw [not_lt] at hcon
    have h3 : (B : ℝ) + 1 ≤ 2 / 3 * x := hcon.trans h1
    have h4 : ((B : ℝ) + 1) ^ 2 ≤ (2 / 3 * x) ^ 2 := pow_le_pow_left₀ (by positivity) h3 2
    rw [mul_pow, hx2] at h4
    linarith
  have h5 : a < B + 1 := by exact_mod_cast h2
  omega

/-- If `4|D_K| < 9(B + 1)²` and every prime `p ≤ B` is inert, the imaginary quadratic field `K` has class number
one. -/
theorem classNumber_eq_one_of_inert_le (hK : Module.finrank ℚ K = 2) (hc : InfinitePlace.nrRealPlaces K = 0)
    {B : ℕ} (hD : 4 * |discr K| < 9 * ((B : ℤ) + 1) ^ 2)
    (hB : ∀ p : ℕ, p.Prime → p ≤ B → QuadIdeals.Inert K p) : classNumber K = 1 :=
  QuadPrincipal.classNumber_eq_one_of_inert hK (exists_ideal_norm_le_nat hK hc hD) hB

/-- **The nine fields have class number one**: an imaginary quadratic field with discriminant
`−3, −4, −7, −8, −11, −19, −43, −67` or `−163` has class number one. -/
theorem classNumber_eq_one_of_discr (hK : Module.finrank ℚ K = 2) (hc : InfinitePlace.nrRealPlaces K = 0)
    (h : discr K = -3 ∨ discr K = -4 ∨ discr K = -7 ∨ discr K = -8 ∨ discr K = -11 ∨ discr K = -19 ∨
      discr K = -43 ∨ discr K = -67 ∨ discr K = -163) : classNumber K = 1 := by
  obtain ⟨d, s, hd, hd1, hs⟩ := QuadRing.exists_sqrt hK
  rcases emod_four hd with h4 | h23
  · have hD := QuadRing.discr_θ₁ hd hd1 hs h4 hK
    rw [hD] at h
    have hd' : d = -3 ∨ d = -7 ∨ d = -11 ∨ d = -19 ∨ d = -43 ∨ d = -67 ∨ d = -163 := by omega
    have h2 : d % 8 = 5 → QuadIdeals.Inert K 2 := fun h8 => QuadSplit.inert_two₁ hd hd1 hs hK h4 h8
    have hodd : ∀ (p : ℕ) [Fact p.Prime], ¬ IsSquare ((d : ℤ) : ZMod p) → QuadIdeals.Inert K p :=
      fun p _ hsq => QuadSplit.inert₁ hd hd1 hs hK h4 hsq
    rcases hd' with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact classNumber_eq_one_of_inert_le hK hc (B := 1) (by rw [hD]; norm_num)
        (fun p hp hpB => absurd hp.two_le (by omega))
    · exact classNumber_eq_one_of_inert_le hK hc (B := 1) (by rw [hD]; norm_num)
        (fun p hp hpB => absurd hp.two_le (by omega))
    · refine classNumber_eq_one_of_inert_le hK hc (B := 2) (by rw [hD]; norm_num) (fun p hp hpB => ?_)
      interval_cases p
      · exact absurd hp (by norm_num)
      · exact absurd hp (by norm_num)
      · exact h2 (by norm_num)
    · refine classNumber_eq_one_of_inert_le hK hc (B := 2) (by rw [hD]; norm_num) (fun p hp hpB => ?_)
      interval_cases p
      · exact absurd hp (by norm_num)
      · exact absurd hp (by norm_num)
      · exact h2 (by norm_num)
    · refine classNumber_eq_one_of_inert_le hK hc (B := 4) (by rw [hD]; norm_num) (fun p hp hpB => ?_)
      interval_cases p
      · exact absurd hp (by norm_num)
      · exact absurd hp (by norm_num)
      · exact h2 (by norm_num)
      · have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
        exact hodd 3 (by decide +revert)
      · exact absurd hp (by norm_num)
    · refine classNumber_eq_one_of_inert_le hK hc (B := 5) (by rw [hD]; norm_num) (fun p hp hpB => ?_)
      interval_cases p
      · exact absurd hp (by norm_num)
      · exact absurd hp (by norm_num)
      · exact h2 (by norm_num)
      · have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
        exact hodd 3 (by decide +revert)
      · exact absurd hp (by norm_num)
      · have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
        exact hodd 5 (by decide +revert)
    · refine classNumber_eq_one_of_inert_le hK hc (B := 8) (by rw [hD]; norm_num) (fun p hp hpB => ?_)
      interval_cases p
      · exact absurd hp (by norm_num)
      · exact absurd hp (by norm_num)
      · exact h2 (by norm_num)
      · have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
        exact hodd 3 (by decide +revert)
      · exact absurd hp (by norm_num)
      · have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
        exact hodd 5 (by decide +revert)
      · exact absurd hp (by norm_num)
      · have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
        exact hodd 7 (by decide +revert)
      · exact absurd hp (by norm_num)
  · have hD := QuadRing.discr_θ₂ hd hd1 hs h23 hK
    rw [hD] at h
    have hd' : d = -1 ∨ d = -2 := by omega
    refine classNumber_eq_one_of_inert_le hK hc (B := 1) ?_ (fun p hp hpB => absurd hp.two_le (by omega))
    rw [hD]
    rcases hd' with rfl | rfl <;> norm_num

/-- **Gauss's class number one problem** (Baker, Heegner, Stark): an imaginary quadratic field has class number one
if and only if its discriminant is `−3, −4, −7, −8, −11, −19, −43, −67` or `−163`. -/
theorem classNumber_eq_one_iff (hK : Module.finrank ℚ K = 2) (hc : InfinitePlace.nrRealPlaces K = 0) :
    classNumber K = 1 ↔
      discr K = -3 ∨ discr K = -4 ∨ discr K = -7 ∨ discr K = -8 ∨ discr K = -11 ∨ discr K = -19 ∨
        discr K = -43 ∨ discr K = -67 ∨ discr K = -163 :=
  ⟨discr_of_classNumber_eq_one hK hc, classNumber_eq_one_of_discr hK hc⟩

end ClassNumberOne
