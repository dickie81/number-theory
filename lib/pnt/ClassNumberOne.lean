  obtain ⟨k, rfl⟩ : ∃ k, n = 171 + 8 * k := ⟨(n - 171) / 8, by omega⟩
  obtain ⟨i, j, hi, hj, rfl⟩ : ∃ i j, i < 32 ∧ j < 100000 ∧ k = 100000 * i + j :=
    ⟨k / 100000, k % 100000, by omega, Nat.mod_lt _ (by norm_num), by omega⟩
  interval_cases i
  · rw [show 171 + 8 * (100000 * 0 + j) = 171 + 8 * j by omega]
    exact good_of_checkDown check_0 hj
  · rw [show 171 + 8 * (100000 * 1 + j) = 800171 + 8 * j by omega]
    exact good_of_checkDown check_1 hj
  · rw [show 171 + 8 * (100000 * 2 + j) = 1600171 + 8 * j by omega]
    exact good_of_checkDown check_2 hj
  · rw [show 171 + 8 * (100000 * 3 + j) = 2400171 + 8 * j by omega]
    exact good_of_checkDown check_3 hj
  · rw [show 171 + 8 * (100000 * 4 + j) = 3200171 + 8 * j by omega]
    exact good_of_checkDown check_4 hj
  · rw [show 171 + 8 * (100000 * 5 + j) = 4000171 + 8 * j by omega]
    exact good_of_checkDown check_5 hj
  · rw [show 171 + 8 * (100000 * 6 + j) = 4800171 + 8 * j by omega]
    exact good_of_checkDown check_6 hj
  · rw [show 171 + 8 * (100000 * 7 + j) = 5600171 + 8 * j by omega]
