import SieveResTestHDefs
import SieveResTestYDefs

namespace SieveResTest

/-- `cond c t e`, as the recursor of `Bool`. -/
local macro "bcond " c:term:max t:term:max e:term:max : term => `(Bool.rec (motive := fun _ => _) $e $t $c)

/-- `a && b`, as the recursor of `Bool`. -/
local macro:35 (priority := high) a:term:35 " && " b:term:36 : term => `(Bool.rec false $b $a)

/-- `a && b` as a definition, for the head of a body. Where the kernel unfolds a definition with variables for its
arguments (to check its equation, or under a binder in a proof by rewriting), it reduces the major premise of a
recursor at the body's head to weak head normal form: through `le0`'s `mulF` and `mulC`, a product of variables
shifted right by `64`, that did not end within 7 GB. A definition at the head stops the kernel there. Inside a body
`&&` is the recursor itself; `andF` costs the kernel under 1% of the test. -/
noncomputable def andF (a b : Bool) : Bool := Bool.rec false b a

/-! ### The functions that branch -/

/-- `minN`. -/
noncomputable def minNF (a b : Nat) : Nat := bcond (Nat.ble a b) a b

/-- `maxN`. -/
noncomputable def maxNF (a b : Nat) : Nat := bcond (Nat.ble a b) b a

/-- `clampL`. -/
noncomputable def clampLF (c1 yuP yuN ydP ydN a b cc : Nat) : Nat × Nat × Nat :=
  bcond (Nat.beq cc 0) (Nat.sub (Nat.add (Nat.shiftRight (Nat.add b 1) 1) yuP) yuN, 0, 0)
    (bcond (Nat.beq cc 1) (Nat.add yuP (Nat.sub ydN (Nat.add (Nat.shiftRight a 1) ydP)), H, yuN) (c1, 0, 0))

/-- `mkTmK`. -/
noncomputable def mkTmKF (lo k0 : Nat) : Tm :=
  ⟨lo,
    bcond (Nat.ble k0 1) SS
      (Nat.div (Nat.add (Nat.sub S (Nat.mul (Nat.sub k0 1) lo)) (Nat.sub (Nat.mul 2 (Nat.sub k0 1)) 1))
        (Nat.mul 2 (Nat.sub k0 1))),
    bcond (Nat.ble k0 1) 0 (Nat.div S (Nat.mul 2 (Nat.sub k0 1))),
    Nat.div S (Nat.mul 2 k0),
    mulC lo WC⟩

/-- `mkTm`. -/
noncomputable def mkTmF (lo : Nat) : Tm := mkTmKF lo (Nat.div (Nat.add S (Nat.sub lo 1)) lo)

/-- `lvG`. -/
noncomputable def lvGF (lo hi k : Nat) : Nat :=
  bcond (Nat.ble 1 k && Nat.ble E23 (Nat.mul k lo))
    (Nat.add LVE (maxNF (mulC (Nat.mul (Nat.mul 2 k) hi) C15U)
      (maxNF (Nat.sub H (mulF (Nat.mul k lo) C15D)) (Nat.sub C43 (mulF (Nat.mul k lo) C65D)))))
    SS

/-- `lvVal`. -/
noncomputable def lvValF (lo k x : Nat) : Nat :=
  maxNF
    (maxNF (Nat.sub OFF (mulF lo C310))
      (Nat.div (Nat.sub (Nat.add (Nat.add (Nat.mul (Nat.mul 2 k) OFF) LVE) (Nat.sub (Nat.mul 2 k) 1)) x)
        (Nat.mul 2 k)))
    (maxNF
      (Nat.div
        (Nat.sub (Nat.add (Nat.add (Nat.mul (Nat.mul 4 k) OFF) (Nat.add H LVE)) (Nat.sub (Nat.mul 4 k) 1))
          (Nat.add x (Nat.mul k lo)))
        (Nat.mul 4 k))
      (Nat.div
        (Nat.sub (Nat.add (Nat.add (Nat.mul (Nat.mul 4 k) OFF) (Nat.add C43 LVE)) (Nat.sub (Nat.mul 4 k) 1))
          (Nat.add x (Nat.mul (Nat.mul 2 k) lo)))
        (Nat.mul 4 k)))

/-- `lvU`. -/
noncomputable def lvUF (lo k g a x : Nat) : Nat := bcond (Nat.blt g a) (lvValF lo k x) OFF

/-- `mkTv`. -/
noncomputable def mkTvF (ub lo : Nat) : Tv :=
  (fun k0 =>
    ⟨mkTmKF lo k0, Nat.sub k0 1, lvGF lo (Nat.add ub lo) (Nat.sub k0 1), Nat.sub k0 2,
      lvGF lo (Nat.add ub lo) (Nat.sub k0 2)⟩)
    (Nat.div (Nat.add S (Nat.sub lo 1)) lo)

/-- `mkTvH`. -/
noncomputable def mkTvHF (lo hi : Nat) : Tv :=
  (fun k0 => ⟨mkTmKF hi k0, Nat.sub k0 1, lvGF lo hi (Nat.sub k0 1), Nat.sub k0 2, lvGF lo hi (Nat.sub k0 2)⟩)
    (Nat.div (Nat.add S (Nat.sub hi 1)) hi)

/-- `pieceC`. -/
noncomputable def pieceCF (b : Nat) : Nat :=
  (bcond (Nat.ble b 7641361430578972243)
    (bcond (Nat.ble b 6873985410747762418)
      (bcond (Nat.ble b 6506976623818538820)
        (bcond (Nat.ble b 6327432045883067909) (bcond (Nat.ble b 6210403838148882377) 0 1) 2)
        (bcond (Nat.ble b 6689141809598112703) 3 4))
      (bcond (Nat.ble b 7251947717250131954)
        (bcond (Nat.ble b 7061566947609045205) 5 6)
        (bcond (Nat.ble b 7445190860260040799) 7 8)))
    (bcond (Nat.ble b 8668546005725876889)
      (bcond (Nat.ble b 8248118502438512073)
        (bcond (Nat.ble b 8042755077203197321) (bcond (Nat.ble b 7840526468526980238) 9 10) 11)
        (bcond (Nat.ble b 8456690216496028348) 12 13))
      (bcond (Nat.ble b 9102425080919114670)
        (bcond (Nat.ble b 8883764062394065609) 14 15)
        (bcond (Nat.ble b 9154280273435530746) 16 17))))

/-! ### The functions on lists, by the recursor of lists -/

/-- `addTerms`. -/
noncomputable def addTermsF (dS iax : Nat) : List Tm → Nat → Nat → Nat → Nat → Nat × Nat × Nat :=
  List.rec (motive := fun _ => Nat → Nat → Nat → Nat → Nat × Nat × Nat) (fun _ p0 n0 n1 => (p0, n0, n1))
    (fun t _ ih h p0 n0 n1 =>
      (fun c h' =>
        bcond (Nat.beq c 0) (ih h' (Nat.add p0 t.a0) n0 (Nat.add n1 t.a1))
          (bcond (Nat.beq c 1) (ih h' p0 n0 (Nat.add n1 t.b1))
            (bcond (Nat.beq c 2) (ih h' p0 (Nat.add n0 (mulF t.lo dS)) n1)
              (ih h' (Nat.add p0 t.lw) n0 (Nat.add n1 (mulF t.lo iax))))))
        (Nat.land h 3) (Nat.shiftRight h 2))

/-- `addTerms2`. -/
noncomputable def addTerms2F (dS iax a b : Nat) :
    List Tv → Nat → Nat → Nat → Nat → Nat → Nat → Nat × Nat × Nat × Nat × Nat :=
  List.rec (motive := fun _ => Nat → Nat → Nat → Nat → Nat → Nat → Nat × Nat × Nat × Nat × Nat)
    (fun _ p0 n0 n1 va vb => (p0, n0, n1, va, vb))
    (fun v _ ih h p0 n0 n1 va vb =>
      (fun c h' =>
        bcond (Nat.beq c 0) (ih h' (Nat.add p0 v.t.a0) n0 (Nat.add n1 v.t.a1) va vb)
          (bcond (Nat.beq c 1) (ih h' p0 n0 (Nat.add n1 v.t.b1) va vb)
            (bcond (Nat.beq c 2) (ih h' p0 (Nat.add n0 (mulF v.t.lo dS)) n1 va vb)
              (bcond (Nat.beq c 3) (ih h' (Nat.add p0 v.t.lw) n0 (Nat.add n1 (mulF v.t.lo iax)) va vb)
                (bcond (Nat.beq c 4)
                  (ih h' p0 (Nat.add n0 OFF) n1 (Nat.add va (lvUF v.t.lo v.k1 v.g1 a a))
                    (Nat.add vb (lvUF v.t.lo v.k1 v.g1 a b)))
                  (ih h' p0 (Nat.add n0 OFF) n1 (Nat.add va (lvUF v.t.lo v.k2 v.g2 a a))
                    (Nat.add vb (lvUF v.t.lo v.k2 v.g2 a b))))))))
        (Nat.land h 7) (Nat.shiftRight h 3))

/-- `hpSum`. -/
noncomputable def hpSumF : List Tm → Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun t _ ih => Nat.add (mulF t.lo HP) ih)

/-- `hpSum2`. -/
noncomputable def hpSum2F : List Tv → Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun v _ ih => Nat.add (mulF v.t.lo HP) ih)

/-- `sumN`. -/
noncomputable def sumNF : List Nat → Nat := List.rec (motive := fun _ => Nat) 0 (fun x _ ih => Nat.add x ih)

/-- The length of a list of terms. -/
noncomputable def lenTF : List Tm → Nat := List.rec (motive := fun _ => Nat) 0 (fun _ _ ih => Nat.succ ih)

/-- `lenV`. -/
noncomputable def lenVF : List Tv → Nat := List.rec (motive := fun _ => Nat) 0 (fun _ _ ih => Nat.succ ih)

/-- `okY`. -/
noncomputable def okYF (Lnum Lden : Nat) : List (Nat × Nat) → Bool :=
  List.rec (motive := fun _ => Bool) true (fun c _ ih => Nat.ble c.1 c.2 && Nat.blt 0 (loW Lnum Lden c.1) && ih)

/-- The terms `mkTm (loOf Lnum Lden c)` of the cells `c`. -/
noncomputable def mapTmF (Lnum Lden : Nat) : List Nat → List Tm :=
  List.rec (motive := fun _ => List Tm) [] (fun c _ ih => mkTmF (loOf Lnum Lden c) :: ih)

/-- The lower ends `loOf Lnum Lden c` of the cells `c`. -/
noncomputable def mapLoOfF (Lnum Lden : Nat) : List Nat → List Nat :=
  List.rec (motive := fun _ => List Nat) [] (fun c _ ih => loOf Lnum Lden c :: ih)

/-- The terms `mkTv ub lo` of the lower ends `lo`. -/
noncomputable def mapTvF (ub : Nat) : List Nat → List Tv :=
  List.rec (motive := fun _ => List Tv) [] (fun lo _ ih => mkTvF ub lo :: ih)

/-- The ends `(loW c, hiW d)` of the cells `(c, d)`. -/
noncomputable def endsF (Lnum Lden : Nat) : List (Nat × Nat) → List (Nat × Nat) :=
  List.rec (motive := fun _ => List (Nat × Nat)) [] (fun c _ ih => (loW Lnum Lden c.1, hiW Lnum Lden c.2) :: ih)

/-- The upper corner's terms `mkTvH lo hi` of the ends `(lo, hi)`. -/
noncomputable def mapHiF : List (Nat × Nat) → List Tv :=
  List.rec (motive := fun _ => List Tv) [] (fun p _ ih => mkTvHF p.1 p.2 :: ih)

/-- The lower corner's terms `mkTv u lo` of the ends `(lo, hi)`. -/
noncomputable def mapLoF (u : Nat) : List (Nat × Nat) → List Tv :=
  List.rec (motive := fun _ => List Tv) [] (fun p _ ih => mkTvF u p.1 :: ih)

/-- The sum of the lower ends. -/
noncomputable def fstSumF : List (Nat × Nat) → Nat := List.rec (motive := fun _ => Nat) 0 (fun p _ ih => Nat.add p.1 ih)

/-- The sum of the upper ends. -/
noncomputable def sndSumF : List (Nat × Nat) → Nat := List.rec (motive := fun _ => Nat) 0 (fun p _ ih => Nat.add p.2 ih)

/-! ### The checks at an interval's ends -/

/-- `chkI`. -/
noncomputable def chkIF (ts : List Tm) (ltm dS iax a b ch : Nat) (cl : Nat × Nat × Nat) : Bool :=
  (fun s => andF (le0 s.1 (Nat.add H cl.2.1) s.2.1 s.2.2 a) (le0 s.1 (Nat.add H cl.2.1) s.2.1 s.2.2 b))
    (addTermsF dS iax ts ch (Nat.add ltm cl.1) cl.2.2 0)

/-- `chkI2`. -/
noncomputable def chkI2F (vs : List Tv) (ltm dS iax a b ch : Nat) (cl : Nat × Nat × Nat) : Bool :=
  (fun s =>
    andF (le0 (Nat.add s.1 s.2.2.2.1) (Nat.add H cl.2.1) s.2.1 s.2.2.1 a)
      (le0 (Nat.add s.1 s.2.2.2.2) (Nat.add H cl.2.1) s.2.1 s.2.2.1 b))
    (addTerms2F dS iax a b vs ch (Nat.add ltm cl.1) cl.2.2 0 0 0)

/-! ### The test at the two corners -/

/-- `intv3`. -/
noncomputable def intv3F (vs : List Tv) (c1 yuP yuN ydP ydN ltm a pa r : Nat) : Bool :=
  (fun b =>
    (fun pb =>
      (fun dS iax =>
        andF (Nat.ble pb 17 && Nat.blt (get tFTm pb) b && Nat.ble b (get tFT pb) && Nat.ble a b)
          (chkI2F vs ltm dS iax a b (Nat.shiftRight r 15)
            (clampLF c1 yuP yuN ydP ydN a b (Nat.land (Nat.shiftRight r 13) 3))))
        (maxNF (get tDH pa) (Nat.sub (mulF a (get tIA pa)) WC)) (minNF (get tIA pa) (get tIA pb)))
      (pieceCF b))
    (bOf r)

/-- `runI3`. -/
noncomputable def runI3F (vs : List Tv) (w c1 yuP yuN ydP ydN ltm : Nat) : Nat → Nat → Nat → Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Bool) (fun a _ _ => Nat.beq a S)
    (fun _ ih a pa h =>
      (fun r => andF (intv3F vs c1 yuP yuN ydP ydN ltm a pa r) (ih (bOf r) (pieceCF (bOf r)) (Nat.shiftRight h w)))
        (Nat.land h (Nat.sub (Nat.shiftLeft 1 w) 1)))

/-- `resTM3`. -/
noncomputable def resTM3F (vs : List Tv) (mlo ltm k h : Nat) : Bool :=
  (fun mtu mtd c1 =>
    (fun yuP yuN ydP ydN =>
      andF (Nat.ble (Nat.add ltm (minNF c1 yuP)) (hpSum2F vs))
        (runI3F vs (Nat.add 15 (Nat.mul 3 (lenVF vs))) c1 yuP yuN ydP ydN ltm k 0 0 h))
      (Nat.shiftRight (Nat.add (Nat.sub K1U mtd) 1) 1) (Nat.shiftRight (Nat.sub mtd K1U) 1)
      (Nat.shiftRight (Nat.sub K1D mtu) 1) (Nat.shiftRight (Nat.add (Nat.sub mtu K1D) 1) 1))
    (mulC mlo M1U) (mulF mlo M1D) (Nat.shiftRight (Nat.add (Nat.sub S mlo) 1) 1)

/-- `resY`. -/
noncomputable def resYF (Lnum Lden : Nat) (cells : List (Nat × Nat)) (kH hH kL hL : Nat) : Bool :=
  (fun ps =>
    (fun sl sh ltm ls =>
      (fun need =>
        andF (okYF Lnum Lden cells && Nat.ble need ls && resTM3F (mapHiF ps) (Nat.sub ls need) ltm kH hH)
          (resTM3F (mapLoF (Nat.sub sh sl) ps) S ltm kL hL))
        (Nat.add (Nat.add (Nat.add sh W2) (Nat.div (Nat.sub sh sl) 11)) 2))
      (fstSumF ps) (sndSumF ps)
      (Nat.add (Nat.div (Nat.add (Nat.mul Lnum S) (Nat.sub (Nat.mul Lden 1000000) 1)) (Nat.mul Lden 1000000)) MG)
      (Nat.div (Nat.mul Lnum S) Lden))
    (endsF Lnum Lden cells)

/-- **The test at the two corners of a box of cells**: `resYH`. -/
noncomputable def resYHF (Lnum Lden : Nat) (cells : List (Nat × Nat)) (s : Nat) : Bool :=
  (fun kH kL hh sh => resYF Lnum Lden cells kH (Nat.mod hh sh) kL (Nat.div hh sh))
    (Nat.mod (Nat.div s 16) 16) (Nat.mod (Nat.div s 256) 16) (Nat.div s 4096)
    (Nat.pow 2 (Nat.mul (Nat.add 15 (Nat.mul 3 (Nat.mod s 16))) (Nat.mod (Nat.div s 16) 16)))

/-! ### The test with the lines named by the hint -/

/-- `intvH`. -/
noncomputable def intvHF (ts : List Tm) (c1 yuP yuN ydP ydN ltm a pa r : Nat) : Bool :=
  (fun b =>
    (fun pb =>
      andF (Nat.ble pb 17 && Nat.blt (get tFTm pb) b && Nat.ble b (get tFT pb) && Nat.ble a b)
        (chkIF ts ltm (maxNF (get tDH pa) (Nat.sub (mulF a (get tIA pa)) WC)) (minNF (get tIA pa) (get tIA pb)) a b
          (Nat.shiftRight r 15) (clampLF c1 yuP yuN ydP ydN a b (Nat.land (Nat.shiftRight r 13) 3))))
      (pieceCF b))
    (bOf r)

/-- `runIH`. -/
noncomputable def runIHF (ts : List Tm) (w c1 yuP yuN ydP ydN ltm : Nat) : Nat → Nat → Nat → Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Bool) (fun a _ _ => Nat.beq a S)
    (fun _ ih a pa h =>
      (fun r => andF (intvHF ts c1 yuP yuN ydP ydN ltm a pa r) (ih (bOf r) (pieceCF (bOf r)) (Nat.shiftRight h w)))
        (Nat.land h (Nat.sub (Nat.shiftLeft 1 w) 1)))

/-- `resTMH`. -/
noncomputable def resTMHF (ts : List Tm) (mlo ltm k h : Nat) : Bool :=
  (fun mtu mtd c1 =>
    (fun yuP yuN ydP ydN =>
      andF (Nat.ble (Nat.add ltm (minNF c1 yuP)) (hpSumF ts))
        (runIHF ts (Nat.add 15 (Nat.mul 2 (lenTF ts))) c1 yuP yuN ydP ydN ltm k 0 0 h))
      (Nat.shiftRight (Nat.add (Nat.sub K1U mtd) 1) 1) (Nat.shiftRight (Nat.sub mtd K1U) 1)
      (Nat.shiftRight (Nat.sub K1D mtu) 1) (Nat.shiftRight (Nat.add (Nat.sub mtu K1D) 1) 1))
    (mulC mlo M1U) (mulF mlo M1D) (Nat.shiftRight (Nat.add (Nat.sub S mlo) 1) 1)

/-- `resTH`. -/
noncomputable def resTHF (Lnum Lden : Nat) (cs : List Nat) (hs k h : Nat) : Bool :=
  andF (Nat.blt (Nat.add hs 1) DEN)
    (resTMHF (mapTmF Lnum Lden cs)
      (Nat.div (Nat.mul (Nat.mul Lnum (Nat.sub (Nat.sub DEN hs) 1)) S) (Nat.mul Lden DEN))
      (Nat.add (Nat.div (Nat.add (Nat.mul Lnum S) (Nat.sub (Nat.mul Lden 1000000) 1)) (Nat.mul Lden 1000000)) MG)
      k h)

/-- `intv2H`. -/
noncomputable def intv2HF (vs : List Tv) (c1 yuP yuN ydP ydN ltm a pa r : Nat) : Bool :=
  (fun b =>
    (fun pb =>
      andF (Nat.ble pb 17 && Nat.blt (get tFTm pb) b && Nat.ble b (get tFT pb) && Nat.ble a b)
        (chkI2F vs ltm (maxNF (get tDH pa) (Nat.sub (mulF a (get tIA pa)) WC)) (minNF (get tIA pa) (get tIA pb)) a b
          (Nat.shiftRight r 15) (clampLF c1 yuP yuN ydP ydN a b (Nat.land (Nat.shiftRight r 13) 3))))
      (pieceCF b))
    (bOf r)

/-- `runI2H`. -/
noncomputable def runI2HF (vs : List Tv) (w c1 yuP yuN ydP ydN ltm : Nat) : Nat → Nat → Nat → Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Bool) (fun a _ _ => Nat.beq a S)
    (fun _ ih a pa h =>
      (fun r => andF (intv2HF vs c1 yuP yuN ydP ydN ltm a pa r) (ih (bOf r) (pieceCF (bOf r)) (Nat.shiftRight h w)))
        (Nat.land h (Nat.sub (Nat.shiftLeft 1 w) 1)))

/-- `resTM2H`. -/
noncomputable def resTM2HF (vs : List Tv) (mlo ltm k h : Nat) : Bool :=
  (fun mtu mtd c1 =>
    (fun yuP yuN ydP ydN =>
      andF (Nat.ble (Nat.add ltm (minNF c1 yuP)) (hpSum2F vs))
        (runI2HF vs (Nat.add 15 (Nat.mul 3 (lenVF vs))) c1 yuP yuN ydP ydN ltm k 0 0 h))
      (Nat.shiftRight (Nat.add (Nat.sub K1U mtd) 1) 1) (Nat.shiftRight (Nat.sub mtd K1U) 1)
      (Nat.shiftRight (Nat.sub K1D mtu) 1) (Nat.shiftRight (Nat.add (Nat.sub mtu K1D) 1) 1))
    (mulC mlo M1U) (mulF mlo M1D) (Nat.shiftRight (Nat.add (Nat.sub S mlo) 1) 1)

/-- `resT2H`. -/
noncomputable def resT2HF (Lnum Lden : Nat) (cs : List Nat) (hs k h : Nat) : Bool :=
  andF (Nat.blt (Nat.add hs 1) DEN)
    ((fun los mlo =>
      resTM2HF
        (mapTvF
          (Nat.sub (Nat.succ (Nat.div (Nat.mul (Nat.add (Nat.mul Lnum 100000) Lden) S) (Nat.mul Lden 100000)))
            (Nat.add mlo (sumNF los)))
          los)
        mlo
        (Nat.add (Nat.div (Nat.add (Nat.mul Lnum S) (Nat.sub (Nat.mul Lden 1000000) 1)) (Nat.mul Lden 1000000)) MG)
        k h)
      (mapLoOfF Lnum Lden cs)
      (Nat.div (Nat.mul (Nat.mul Lnum (Nat.sub (Nat.sub DEN hs) 1)) S) (Nat.mul Lden DEN)))

/-- **The test with the lines named by the hint**: `resXH`. -/
noncomputable def resXHF (Lnum Lden : Nat) (cs : List Nat) (hs k h : Nat) : Bool :=
  bcond (Nat.beq k 0) (resT2HF Lnum Lden cs hs (Nat.land h 15) (Nat.shiftRight h 4)) (resTHF Lnum Lden cs hs k h)

end SieveResTest
