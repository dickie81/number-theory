`A = 2.25057`, `e = 1/100000`. -/
def parS106 : ParC where
  M := 1556
  a := (75017 / 100000)
  lam := (112527 / 100000)
  lo := (653 / 840)
  hi := (1307 / 1680)
  Ai := (7033 / 3125)
  A := (225057 / 100000)
  e := 1 / 100000

theorem parS106_good : parS106.Good := by cgl_good parS106

open scoped Classical in
/-- **Chen–Gupta–Li's Proposition 3.1 on `[653 / 840, 1307 / 1680]`, density step 106**: there is `C ≥ 0` such that for every
`q ≥ 1`, `653 / 840 ≤ σ ≤ 1307 / 1680` and `T ≥ 2` at most `C(qT)^{(225057 / 100000)(1−σ)}(log qT)^{10}`
characters mod `q` have a zero of
`L(·, χ)` in `Re s ≥ σ`, `|Im s| ≤ T`; no hypothesis. -/
theorem charDensity_s106 :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (q : ℕ) [NeZero q] (σ T : ℝ), (653 / 840) ≤ σ → σ ≤ (1307 / 1680) → 2 ≤ T →
      ((Finset.univ.filter fun χ : DirichletCharacter ℂ q =>
        ∃ s : ℂ, σ ≤ s.re ∧ |s.im| ≤ T ∧ DirichletCharacter.LFunction χ s = 0).card : ℝ) ≤
          C * ((q : ℝ) * T) ^ ((225057 / 100000) * (1 - σ)) * Real.log ((q : ℝ) * T) ^ (10 : ℝ) :=
  charDensity_cglGen LinnikCGLHB101.prop31 parS106 parS106_good

open scoped Classical in
/-- **Ingham's last step at `ε = 1/400000`**: there is `C ≥ 0` such that for every `q ≥ 1`,
`99 / 140 ≤ σ ≤ 5 / 7` and `T ≥ 2` at most `C(qT)^{(700003 / 300000)(1−σ)}(log qT)^{10}` characters mod `q`
have a zero of `L(·, χ)` in `Re s ≥ σ`, `|Im s| ≤ T`: `LinnikInghamC.charDensity_ingham_c` at `c = 1/12`, where `2 + 4c = 7/3 = 3/(2 − 5/7)`. -/
theorem charDensity_inT :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (q : ℕ) [NeZero q] (σ T : ℝ), (99 / 140) ≤ σ → σ ≤ (5 / 7) → 2 ≤ T →
      ((Finset.univ.filter fun χ : DirichletCharacter ℂ q =>
        ∃ s : ℂ, σ ≤ s.re ∧ |s.im| ≤ T ∧ DirichletCharacter.LFunction χ s = 0).card : ℝ) ≤
          C * ((q : ℝ) * T) ^ ((700003 / 300000) * (1 - σ)) * Real.log ((q : ℝ) * T) ^ (10 : ℝ) := by
  have h := LinnikInghamC.charDensity_ingham_c (ε := 1 / 400000) (c := 1 / 12)
    (δ₀ := 29 / 140) (σ₂ := 5 / 7)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  obtain ⟨C, hC0, hC⟩ := h
  refine ⟨C, hC0, fun q _ σ T hσ hσ1 hT => ?_⟩
  have := hC q σ T (by linarith) hσ1 hT
  rwa [show (2 + 4 * (1 / 12 : ℝ) + 4 * (1 / 400000)) * (1 - σ) =
      (700003 / 300000) * (1 - σ) by ring] at this

end LinnikCGLSteps

