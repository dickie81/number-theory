import LinnikCGLHB101
import LinnikInghamC

open Real

noncomputable section

namespace LinnikCGLSteps

open LinnikCGLStep

/-- `ParC.Good` for numerals: the fifteen fields of `ParC.Good` are closed, in the order of the structure, by
`norm_num` on the unfolded parameters, and by `linarith` for the three exponent conditions (affine in `σ` once the
parameters are numerals). One use for each step below. -/
macro "cgl_good " P:ident : tactic =>
  `(tactic| (
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num
    · simp [$P:ident]
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num
    · intro σ h1 h2
      simp only [$P:ident] at *
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> linarith
    · intro σ h1 h2
      simp only [$P:ident] at *
      linarith
    · intro σ h2
      simp only [$P:ident] at *
      push_cast
      linarith
    · simp only [$P:ident]; norm_num
    · simp only [$P:ident]; norm_num))

/-- Step 0, `[5 / 7, 1201 / 1680]`: `M = 1556`, `a = 0.77778`, `λ = 1.16669`, `A_i = 2.33339`,
`A = 2.33340`, `e = 1/100000`. -/
def parS0 : ParC where
  M := 1556
  a := (38889 / 50000)
  lam := (116669 / 100000)
  lo := (5 / 7)
  hi := (1201 / 1680)
  Ai := (233339 / 100000)
  A := (11667 / 5000)
  e := 1 / 100000

theorem parS0_good : parS0.Good := by cgl_good parS0

open scoped Classical in
/-- **Chen–Gupta–Li's Proposition 3.1 on `[5 / 7, 1201 / 1680]`, density step 0**: there is `C ≥ 0` such that for every
`q ≥ 1`, `5 / 7 ≤ σ ≤ 1201 / 1680` and `T ≥ 2` at most `C(qT)^{(11667 / 5000)(1−σ)}(log qT)^{10}`
characters mod `q` have a zero of
`L(·, χ)` in `Re s ≥ σ`, `|Im s| ≤ T`; no hypothesis. -/
theorem charDensity_s0 :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (q : ℕ) [NeZero q] (σ T : ℝ), (5 / 7) ≤ σ → σ ≤ (1201 / 1680) → 2 ≤ T →
      ((Finset.univ.filter fun χ : DirichletCharacter ℂ q =>
        ∃ s : ℂ, σ ≤ s.re ∧ |s.im| ≤ T ∧ DirichletCharacter.LFunction χ s = 0).card : ℝ) ≤
          C * ((q : ℝ) * T) ^ ((11667 / 5000) * (1 - σ)) * Real.log ((q : ℝ) * T) ^ (10 : ℝ) :=
  charDensity_cglGen LinnikCGLHB101.prop31 parS0 parS0_good

