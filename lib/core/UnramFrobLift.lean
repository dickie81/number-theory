import CMEquiv

/-!
# A Frobenius lift on `K^ur`

CMEquiv's input `UnramFrob ℓ`, proved for every prime `ℓ` (`unramFrob`): a ring endomorphism `φ` of `unramC ℓ`, the
closure in `ℂ_ℓ` of the field generated by the roots of unity of order prime to `ℓ`, with `‖φ(x) − x^ℓ‖ ≤ ‖ℓ‖` on the
unit ball. No Galois theory of local fields: everything runs on the ring `ℤ[μ']` generated by those roots of unity.

**Frobenius on `ℤ[μ']`** (`phi0`). `ℤ[μ']` is the image of the evaluation `ℤ[X_g] → ℂ_ℓ`, `X_g ↦ g` (`ev`), and
`X_g ↦ g^ℓ` descends to it (`ev_rename_eq_zero`): the roots of unity in a relation `P(g) = 0` are powers of one
primitive `N`-th root `ζ`, `ℓ ∤ N`, and `ζ`, `ζ^ℓ` have the same minimal polynomial over `ℤ` (Mathlib's
`IsPrimitiveRoot.minpoly_eq_pow_coprime`), so `P(g^ℓ) = 0`.

**Congruences.** In `ℤ[μ']/ℓ`, of characteristic `ℓ`, `φ₀` and `y ↦ y^ℓ` are ring homomorphisms agreeing on the roots
of unity, so `φ₀(y) ≡ y^ℓ (mod ℓ)` (`phi0_sub_pow`); and `y^{ℓ^f} ≡ y` with `f = φ(N)` (`exists_mul_pow_sub`).

**Norms on `ℤ[μ']`.** From `y·(y^m − 1) ≡ 0 (mod ℓ)`, `m ≥ 1`: for `‖y‖ < 1`, `y·w = c·ℓ` with `‖w‖ = 1`; so the norms
on `ℤ[μ']` are the powers of `‖ℓ‖` (`norm_R0_eq_pow`), `y·w = c·ℓ^k` with `‖w‖ = 1` whenever `‖y‖ ≤ ‖ℓ‖^k`
(`exists_mul_eq_pow`), and `φ₀` is an isometry (`norm_phi0`). For `‖y‖ = 1`, `‖y^m − 1‖ < 1`.

**The unit ball.** The closure `A` of `ℤ[μ']` (`unramInt`) contains `a/ℓ^k` when `‖a‖ ≤ ‖ℓ‖^k` (`div_pow_mem`) and
`a⁻¹` when `‖a‖ = 1` (`inv_mem_unramInt`, by geometric series), and its norms are the powers of `‖ℓ‖`. So `A[1/ℓ]` is
a closed subfield (`unramB`, `isClosed_unramB`) containing the roots of unity, hence `unramC ℓ` (`unramC_le_unramB`),
and the unit ball of `unramC ℓ` is `A` (`mem_unramInt_of_mem_unramC`).

**The Frobenius.** `φ₀` extends by uniform continuity to `A` (`phiA`, Mathlib's `IsDenseInducing.extendRingHom`), the
congruence passing to the limit (`norm_phiA_sub_pow_le`), and from `A` to its localisation `A[1/ℓ] = unramC ℓ` at the
powers of `ℓ` (`IsLocalization.lift`).

**Corollaries.** CMEquiv's headline theorems without the Frobenius input: `isHerm_be_cm'` and
`be_classification_cm_omega'`, the latter for the Frobenius lift `frobUnram`.

**Main results:** `unramFrob`, `frobUnram`, `norm_frobUnram_sub_pow_le`, `isHerm_be_cm'`,
`be_classification_cm_omega'`; on the way `ev_rename_eq_zero`, `phi0`, `phi0_sub_pow`, `norm_phi0`,
`mem_unramInt_of_mem_unramC`, `unramC_le_unramB`.
-/

namespace UnramFrobLift

open CMFormalInert CMFormalGauss MvPolynomial

noncomputable section

variable {ℓ : ℕ} [hℓp : Fact ℓ.Prime]

section Roots

variable (ℓ) in
/-- **The prime-to-`ℓ` roots of unity** in `ℂ_ℓ`, the generators of `unramC ℓ`. -/
def muSet : Set ℂ_[ℓ] := {ζ | ∃ n : ℕ, 0 < n ∧ ¬ ℓ ∣ n ∧ ζ ^ n = 1}

/-- **Roots of unity are units**: `‖g‖ = 1`. -/
theorem norm_mu (g : muSet ℓ) : ‖(g : ℂ_[ℓ])‖ = 1 := by
  obtain ⟨n, hn, -, h⟩ := g.2
  have h' := congrArg norm h
  rw [norm_pow, norm_one] at h'
  exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) hn.ne').1 h'

/-- **Frobenius on the roots of unity**: `g ↦ g^ℓ`. -/
def frobMu (g : muSet ℓ) : muSet ℓ :=
  ⟨(g : ℂ_[ℓ]) ^ ℓ, by
    obtain ⟨n, hn, hnd, h⟩ := g.2
    exact ⟨n, hn, hnd, by rw [← pow_mul, mul_comm, pow_mul, h, one_pow]⟩⟩

variable (ℓ) in
/-- **Evaluation** of integer polynomials in the roots of unity. -/
def ev : MvPolynomial (muSet ℓ) ℤ →+* ℂ_[ℓ] := eval₂Hom (Int.castRingHom ℂ_[ℓ]) fun g => (g : ℂ_[ℓ])

/-- **`ev(X_g) = g`.** -/
theorem ev_X (g : muSet ℓ) : ev ℓ (X g) = g := eval₂Hom_X' _ _ _

/-- **`ev` after Frobenius on the variables** is evaluation at the `g^ℓ`. -/
theorem ev_rename (P : MvPolynomial (muSet ℓ) ℤ) :
    ev ℓ (rename frobMu P) = eval₂Hom (Int.castRingHom ℂ_[ℓ]) (fun g : muSet ℓ => (g : ℂ_[ℓ]) ^ ℓ) P :=
  eval₂Hom_rename _ _ _ _

/-- **Ring homomorphisms out of `ℤ[X_i]` agreeing on the variables of `P` agree at `P`.** -/
theorem hom_eq_of_vars {σ A : Type*} [CommRing A] (h₁ h₂ : MvPolynomial σ ℤ →+* A) {P : MvPolynomial σ ℤ}
    (hv : ∀ i ∈ P.vars, h₁ (X i) = h₂ (X i)) : h₁ P = h₂ P := by
  have e : ∀ h : MvPolynomial σ ℤ →+* A, h = eval₂Hom (Int.castRingHom A) (fun i => h (X i)) := fun h =>
    ringHom_ext (fun r => by simp) (fun i => by simp)
  rw [e h₁, e h₂]
  exact eval₂Hom_congr' rfl (fun i hi _ => hv i hi) rfl

/-- **A common order prime to `ℓ`** for the roots of unity occurring in `P`. -/
theorem exists_exponent (P : MvPolynomial (muSet ℓ) ℤ) :
    ∃ N : ℕ, 0 < N ∧ ℓ.Coprime N ∧ ∀ g ∈ P.vars, (g : ℂ_[ℓ]) ^ N = 1 := by
  classical
  choose n hn hnd h using fun g : muSet ℓ => (g.2 : ∃ n : ℕ, 0 < n ∧ ¬ ℓ ∣ n ∧ (g : ℂ_[ℓ]) ^ n = 1)
  refine ⟨∏ g ∈ P.vars, n g, Finset.prod_pos fun g _ => hn g,
    Nat.Coprime.prod_right fun g _ => (Nat.Prime.coprime_iff_not_dvd hℓp.out).2 (hnd g), fun g hg => ?_⟩
  obtain ⟨m, hm⟩ := Finset.dvd_prod_of_mem n hg
  rw [hm, pow_mul, h g, one_pow]

/-- **The kernel condition for Frobenius**: if `P(g) = 0` then `P(g^ℓ) = 0`. All `g` in `P` are powers of a primitive
`N`-th root `ζ`, `ℓ ∤ N`, and `ζ`, `ζ^ℓ` have the same minimal polynomial over `ℤ` (`minpoly_eq_pow_coprime`). -/
theorem ev_rename_eq_zero {P : MvPolynomial (muSet ℓ) ℤ} (hP : ev ℓ P = 0) : ev ℓ (rename frobMu P) = 0 := by
  classical
  let : Algebra ℤ ℂ_[ℓ] := Ring.toIntAlgebra ℂ_[ℓ]
  obtain ⟨N, hN, hcop, hgN⟩ := exists_exponent P
  have : NeZero N := ⟨hN.ne'⟩
  have : NeZero ((N : ℕ) : ℂ_[ℓ]) := ⟨Nat.cast_ne_zero.2 hN.ne'⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot ℂ_[ℓ] N
  have hj : ∀ g : muSet ℓ, ∃ j : ℕ, (g : ℂ_[ℓ]) ^ N = 1 → ζ ^ j = g := fun g => by
    by_cases h : (g : ℂ_[ℓ]) ^ N = 1
    · obtain ⟨j, -, hj⟩ := hζ.eq_pow_of_pow_eq_one h
      exact ⟨j, fun _ => hj⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose j hj using hj
  set ψ : MvPolynomial (muSet ℓ) ℤ →+* Polynomial ℤ := eval₂Hom Polynomial.C fun g => Polynomial.X ^ j g
  have key : ∀ (z : ℂ_[ℓ]) (w : muSet ℓ → ℂ_[ℓ]), (∀ g ∈ P.vars, w g = z ^ j g) →
      eval₂Hom (Int.castRingHom ℂ_[ℓ]) w P = Polynomial.aeval z (ψ P) := fun z w hw => by
    have := hom_eq_of_vars (eval₂Hom (Int.castRingHom ℂ_[ℓ]) w)
      ((Polynomial.aeval z : Polynomial ℤ →ₐ[ℤ] ℂ_[ℓ]).toRingHom.comp ψ) (P := P) fun g hg => by
        simp [ψ, hw g hg]
    simpa using this
  have h1 : ev ℓ P = Polynomial.aeval ζ (ψ P) := key ζ _ fun g hg => (hj g (hgN g hg)).symm
  have h2 : ev ℓ (rename frobMu P) = Polynomial.aeval (ζ ^ ℓ) (ψ P) := by
    rw [ev_rename]
    exact key _ _ fun g hg => by rw [← pow_mul, mul_comm, pow_mul, hj g (hgN g hg)]
  have hdvd := minpoly.isIntegrallyClosed_dvd (hζ.isIntegral hN) (h1 ▸ hP)
  rw [hζ.minpoly_eq_pow_coprime hcop] at hdvd
  rw [h2]
  exact Polynomial.aeval_eq_zero_of_dvd_aeval_eq_zero hdvd (minpoly.aeval ℤ _)

variable (ℓ) in
/-- **The ring `ℤ[μ']`** generated by the prime-to-`ℓ` roots of unity. -/
abbrev R0 : Subring ℂ_[ℓ] := (ev ℓ).range

/-- **The kernel condition, as kernels** (`ev_rename_eq_zero`). -/
theorem ker_le_ker_frob : RingHom.ker (ev ℓ).rangeRestrict ≤
    RingHom.ker ((ev ℓ).rangeRestrict.comp (rename frobMu).toRingHom) := by
  intro P hP
  rw [RingHom.mem_ker] at hP ⊢
  exact Subtype.ext (ev_rename_eq_zero (congrArg Subtype.val hP))

variable (ℓ) in
/-- **Frobenius on `ℤ[μ']`**: the ring endomorphism with `g ↦ g^ℓ` on roots of unity. -/
def phi0 : R0 ℓ →+* R0 ℓ :=
  (ev ℓ).rangeRestrict.liftOfSurjective (ev ℓ).rangeRestrict_surjective ⟨_, ker_le_ker_frob⟩

/-- **`φ₀(P(g)) = P(g^ℓ)`.** -/
theorem phi0_apply (P : MvPolynomial (muSet ℓ) ℤ) :
    phi0 ℓ ((ev ℓ).rangeRestrict P) = (ev ℓ).rangeRestrict (rename frobMu P) :=
  RingHom.liftOfSurjective_comp_apply _ _ _ P

/-- **`ℤ[μ']` lies in every subring containing the roots of unity.** -/
theorem R0_le {S : Subring ℂ_[ℓ]} (h : ∀ g : muSet ℓ, (g : ℂ_[ℓ]) ∈ S) : R0 ℓ ≤ S := by
  rintro _ ⟨P, rfl⟩
  induction P using MvPolynomial.induction_on with
  | C a => simp [ev]
  | add p q hp hq => rw [map_add]; exact S.add_mem hp hq
  | mul_X p g hp => rw [map_mul, ev_X]; exact S.mul_mem hp (h g)

/-- **`ℤ[μ']` is integral**: `‖y‖ ≤ 1`. -/
theorem norm_R0_le (y : R0 ℓ) : ‖(y : ℂ_[ℓ])‖ ≤ 1 :=
  R0_le (S := ball1 ℂ_[ℓ]) (fun g => (norm_mu g).le) y.2

/-- **`ℤ[μ'] ⊆ unramC ℓ`.** -/
theorem R0_le_unramC : R0 ℓ ≤ (unramC ℓ).toSubring :=
  R0_le fun g => Subfield.le_topologicalClosure _ (Subfield.subset_closure g.2)

end Roots

section Cong

/-- **`ℓ` is not a unit of `ℤ[μ']`** (`‖ℓ‖ < 1`). -/
theorem ell_nonunit : ((ℓ : ℕ) : R0 ℓ) ∈ nonunits (R0 ℓ) := by
  intro hu
  obtain ⟨v, hv⟩ := hu.exists_right_inv
  have h := congrArg (fun x : R0 ℓ => ‖(x : ℂ_[ℓ])‖) hv
  simp only [Subring.coe_mul, Subring.coe_natCast, norm_mul, OneMemClass.coe_one, norm_one] at h
  have : ‖((ℓ : ℕ) : ℂ_[ℓ])‖ * ‖(v : ℂ_[ℓ])‖ < 1 :=
    (mul_le_of_le_one_right (norm_nonneg _) (norm_R0_le v)).trans_lt norm_ell_lt_one
  linarith

/-- **The Frobenius congruence in `ℤ[μ']`**: `φ₀(y) ≡ y^ℓ (mod ℓ)`. Both sides are ring homomorphisms to
`ℤ[μ']/ℓ`, of characteristic `ℓ`, agreeing on the roots of unity. -/
theorem phi0_sub_pow (y : R0 ℓ) : ∃ c : R0 ℓ, phi0 ℓ y - y ^ ℓ = c * ℓ := by
  let : CharP (R0 ℓ ⧸ Ideal.span {((ℓ : ℕ) : R0 ℓ)}) ℓ := CharP.quotient _ ℓ ell_nonunit
  set π := Ideal.Quotient.mk (Ideal.span {((ℓ : ℕ) : R0 ℓ)})
  have hcomp : (π.comp (phi0 ℓ)).comp (ev ℓ).rangeRestrict =
      (frobenius _ ℓ).comp (π.comp (ev ℓ).rangeRestrict) := by
    refine MvPolynomial.ringHom_ext (fun r => by simp) (fun g => ?_)
    simp only [RingHom.comp_apply, phi0_apply, rename_X, frobenius_def, ← map_pow]
    congr 1
    exact Subtype.ext (by rw [RingHom.coe_rangeRestrict, RingHom.coe_rangeRestrict, map_pow, ev_X, ev_X]; rfl)
  obtain ⟨P, rfl⟩ := (ev ℓ).rangeRestrict_surjective y
  have h := congrArg (· P) hcomp
  simp only [RingHom.comp_apply, frobenius_def] at h
  rw [← map_pow, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h
  obtain ⟨c, hc⟩ := h
  exact ⟨c, hc.symm⟩

/-- **Fermat in `ℤ[μ']`**: `y^{ℓ^f} ≡ y (mod ℓ)` for some `f ≥ 1`, i.e. `y·(y^m − 1) ≡ 0` with `m = ℓ^f − 1 ≥ 1`.
With `N` a common order of the roots of unity in `y` and `f = φ(N)`, `g^{ℓ^f} = g` for each of them, and
`y ↦ y^{ℓ^f}` is a ring endomorphism of `ℤ[μ']/ℓ`. -/
theorem exists_mul_pow_sub (y : R0 ℓ) : ∃ m : ℕ, 0 < m ∧ ∃ c : R0 ℓ, y * (y ^ m - 1) = c * ℓ := by
  classical
  let : CharP (R0 ℓ ⧸ Ideal.span {((ℓ : ℕ) : R0 ℓ)}) ℓ := CharP.quotient _ ℓ ell_nonunit
  set π := Ideal.Quotient.mk (Ideal.span {((ℓ : ℕ) : R0 ℓ)})
  obtain ⟨P, rfl⟩ := (ev ℓ).rangeRestrict_surjective y
  obtain ⟨N, hN, hcop, hgN⟩ := exists_exponent P
  set f := N.totient
  have hf : ℓ ^ f % N = 1 % N := Nat.ModEq.pow_totient hcop
  have hf0 : 0 < f := Nat.totient_pos.2 hN
  have hℓf : 2 ≤ ℓ ^ f := hℓp.out.two_le.trans (Nat.le_self_pow hf0.ne' ℓ)
  have h := hom_eq_of_vars ((iterateFrobenius _ ℓ f).comp (π.comp (ev ℓ).rangeRestrict))
    (π.comp (ev ℓ).rangeRestrict) (P := P) fun g hg => by
      simp only [RingHom.comp_apply, iterateFrobenius_def, ← map_pow]
      congr 1
      refine Subtype.ext ?_
      simp only [RingHom.coe_rangeRestrict]
      rw [map_pow, ev_X, pow_eq_pow_mod _ (hgN g hg), hf, ← pow_eq_pow_mod _ (hgN g hg), pow_one]
  simp only [RingHom.comp_apply, iterateFrobenius_def] at h
  rw [← map_pow, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h
  obtain ⟨c, hc⟩ := h
  refine ⟨ℓ ^ f - 1, by omega, c, ?_⟩
  rw [hc, mul_sub, mul_one, ← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ ℓ ^ f)]

end Cong

section Norms

/-- **`‖ℓ‖ > 0`.** -/
theorem norm_ell_pos : 0 < ‖((ℓ : ℕ) : ℂ_[ℓ])‖ := norm_pos_iff.2 (Nat.cast_ne_zero.2 hℓp.out.ne_zero)

/-- **Ultrametric**: `‖x − 1‖ = 1` for `‖x‖ < 1`. -/
theorem norm_sub_one_of_lt {x : ℂ_[ℓ]} (h : ‖x‖ < 1) : ‖x - 1‖ = 1 := by
  rw [sub_eq_add_neg, IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm (by rw [norm_neg, norm_one]; exact h.ne),
    norm_neg, norm_one, max_eq_right h.le]

/-- **The Frobenius congruence, normed**: `‖φ₀(y) − y^ℓ‖ ≤ ‖ℓ‖` on `ℤ[μ']`. -/
theorem norm_phi0_sub_pow_le (y : R0 ℓ) : ‖(phi0 ℓ y : ℂ_[ℓ]) - (y : ℂ_[ℓ]) ^ ℓ‖ ≤ ‖((ℓ : ℕ) : ℂ_[ℓ])‖ := by
  obtain ⟨c, hc⟩ := phi0_sub_pow y
  have h : (phi0 ℓ y : ℂ_[ℓ]) - (y : ℂ_[ℓ]) ^ ℓ = c * ℓ := by exact_mod_cast congrArg Subtype.val hc
  rw [h, norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (norm_R0_le c)

/-- **`φ₀` preserves units**: `‖y‖ = 1` gives `‖φ₀(y)‖ = 1` (`‖φ₀(y) − y^ℓ‖ ≤ ‖ℓ‖ < 1`). -/
theorem norm_phi0_eq_one {y : R0 ℓ} (hy : ‖(y : ℂ_[ℓ])‖ = 1) : ‖(phi0 ℓ y : ℂ_[ℓ])‖ = 1 := by
  have h1 := (norm_phi0_sub_pow_le y).trans_lt norm_ell_lt_one
  have h2 : ‖(y : ℂ_[ℓ]) ^ ℓ‖ = 1 := by rw [norm_pow, hy, one_pow]
  rw [← sub_add_cancel (phi0 ℓ y : ℂ_[ℓ]) ((y : ℂ_[ℓ]) ^ ℓ),
    IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm (by rw [h2]; exact h1.ne), h2, max_eq_right h1.le]

/-- **Division by `ℓ` up to a unit**: for `‖y‖ < 1`, `y·w = c·ℓ` with `‖w‖ = 1` (`w = y^m − 1`). -/
theorem exists_mul_eq_of_lt {y : R0 ℓ} (hy : ‖(y : ℂ_[ℓ])‖ < 1) :
    ∃ c w : R0 ℓ, ‖(w : ℂ_[ℓ])‖ = 1 ∧ y * w = c * ℓ := by
  obtain ⟨m, hm, c, hc⟩ := exists_mul_pow_sub y
  refine ⟨c, y ^ m - 1, ?_, hc⟩
  have : ‖(y : ℂ_[ℓ]) ^ m‖ < 1 := by rw [norm_pow]; exact pow_lt_one₀ (norm_nonneg _) hy hm.ne'
  push_cast
  exact norm_sub_one_of_lt this

/-- **Units of `ℤ[μ']` have a power `≡ 1`**: for `‖y‖ = 1`, `‖y^m − 1‖ < 1` for some `m ≥ 1`. -/
theorem exists_norm_pow_sub_one_lt {y : R0 ℓ} (hy : ‖(y : ℂ_[ℓ])‖ = 1) :
    ∃ m : ℕ, 0 < m ∧ ‖(y : ℂ_[ℓ]) ^ m - 1‖ < 1 := by
  obtain ⟨m, hm, c, hc⟩ := exists_mul_pow_sub y
  refine ⟨m, hm, ?_⟩
  have h : (y : ℂ_[ℓ]) * ((y : ℂ_[ℓ]) ^ m - 1) = c * ℓ := by exact_mod_cast congrArg Subtype.val hc
  have h2 := congrArg norm h
  rw [norm_mul, hy, one_mul, norm_mul] at h2
  rw [h2]
  exact (mul_le_of_le_one_left (norm_nonneg _) (norm_R0_le c)).trans_lt norm_ell_lt_one

/-- **One division step**: for `‖y‖ < 1`, `‖y‖ = ‖c‖·‖ℓ‖` with `y·w = c·ℓ`, `‖w‖ = 1`, and `φ₀` preserves the
norm of `y` if it preserves that of `c`. -/
theorem norm_step {y : R0 ℓ} (hy : ‖(y : ℂ_[ℓ])‖ < 1) : ∃ c : R0 ℓ,
    ‖(y : ℂ_[ℓ])‖ = ‖(c : ℂ_[ℓ])‖ * ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ∧
      (‖(phi0 ℓ c : ℂ_[ℓ])‖ = ‖(c : ℂ_[ℓ])‖ → ‖(phi0 ℓ y : ℂ_[ℓ])‖ = ‖(y : ℂ_[ℓ])‖) := by
  obtain ⟨c, w, hw, hyw⟩ := exists_mul_eq_of_lt hy
  have e : (y : ℂ_[ℓ]) * w = c * ℓ := by exact_mod_cast congrArg Subtype.val hyw
  have e' : (phi0 ℓ y : ℂ_[ℓ]) * phi0 ℓ w = phi0 ℓ c * ℓ := by
    have := congrArg (fun x => ((phi0 ℓ x : R0 ℓ) : ℂ_[ℓ])) hyw
    simpa using this
  have hc : ‖(y : ℂ_[ℓ])‖ = ‖(c : ℂ_[ℓ])‖ * ‖((ℓ : ℕ) : ℂ_[ℓ])‖ := by
    rw [← norm_mul, ← e, norm_mul, hw, mul_one]
  refine ⟨c, hc, fun h => ?_⟩
  have := congrArg norm e'
  rw [norm_mul, norm_mul, norm_phi0_eq_one hw, mul_one, h] at this
  rw [this, hc]

/-- **Norms on `ℤ[μ']`, by induction on `k`**: `‖ℓ‖^{k+1} < ‖y‖` gives `‖y‖ = ‖ℓ‖^j` and `‖φ₀(y)‖ = ‖y‖`. -/
theorem norm_R0_aux (k : ℕ) : ∀ y : R0 ℓ, ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ (k + 1) < ‖(y : ℂ_[ℓ])‖ →
    (∃ j : ℕ, ‖(y : ℂ_[ℓ])‖ = ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ j) ∧ ‖(phi0 ℓ y : ℂ_[ℓ])‖ = ‖(y : ℂ_[ℓ])‖ := by
  induction k with
  | zero =>
    intro y hy
    by_cases h1 : ‖(y : ℂ_[ℓ])‖ = 1
    · exact ⟨⟨0, by rw [h1, pow_zero]⟩, by rw [h1, norm_phi0_eq_one h1]⟩
    obtain ⟨c, hc, -⟩ := norm_step (lt_of_le_of_ne (norm_R0_le y) h1)
    have := mul_le_of_le_one_left (norm_ell_pos (ℓ := ℓ)).le (norm_R0_le c)
    rw [zero_add, pow_one] at hy
    linarith
  | succ k ih =>
    intro y hy
    by_cases h1 : ‖(y : ℂ_[ℓ])‖ = 1
    · exact ⟨⟨0, by rw [h1, pow_zero]⟩, by rw [h1, norm_phi0_eq_one h1]⟩
    obtain ⟨c, hc, himp⟩ := norm_step (lt_of_le_of_ne (norm_R0_le y) h1)
    have hc' : ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ (k + 1) < ‖(c : ℂ_[ℓ])‖ := by
      rw [hc, pow_succ] at hy
      exact lt_of_mul_lt_mul_right hy norm_ell_pos.le
    obtain ⟨⟨j, hj⟩, hφ⟩ := ih c hc'
    exact ⟨⟨j + 1, by rw [hc, hj, pow_succ]⟩, himp hφ⟩

/-- **`‖ℓ‖^{k+1} < ‖x‖` for some `k`**, if `x ≠ 0`. -/
theorem exists_pow_lt_norm {x : ℂ_[ℓ]} (hx : x ≠ 0) : ∃ k : ℕ, ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ (k + 1) < ‖x‖ := by
  obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one (norm_pos_iff.2 hx) (norm_ell_lt_one (ℓ := ℓ))
  exact ⟨k, (pow_le_pow_of_le_one (norm_nonneg _) (norm_ell_lt_one (ℓ := ℓ)).le (Nat.le_succ k)).trans_lt hk⟩

/-- **`φ₀` is an isometry.** -/
theorem norm_phi0 (y : R0 ℓ) : ‖(phi0 ℓ y : ℂ_[ℓ])‖ = ‖(y : ℂ_[ℓ])‖ := by
  by_cases hy : (y : ℂ_[ℓ]) = 0
  · have : y = 0 := Subtype.ext hy
    simp [this]
  obtain ⟨k, hk⟩ := exists_pow_lt_norm hy
  exact (norm_R0_aux k y hk).2

/-- **The values of the norm on `ℤ[μ']`** are the powers of `‖ℓ‖`. -/
theorem norm_R0_eq_pow {y : R0 ℓ} (hy : (y : ℂ_[ℓ]) ≠ 0) :
    ∃ j : ℕ, ‖(y : ℂ_[ℓ])‖ = ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ j := by
  obtain ⟨k, hk⟩ := exists_pow_lt_norm hy
  exact (norm_R0_aux k y hk).1

/-- **Division by `ℓ^k` up to a unit**: `‖y‖ ≤ ‖ℓ‖^k` gives `y·w = c·ℓ^k` with `‖w‖ = 1`. -/
theorem exists_mul_eq_pow (k : ℕ) {y : R0 ℓ} (hy : ‖(y : ℂ_[ℓ])‖ ≤ ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ k) :
    ∃ c w : R0 ℓ, ‖(w : ℂ_[ℓ])‖ = 1 ∧ (y : ℂ_[ℓ]) * w = c * ((ℓ : ℕ) : ℂ_[ℓ]) ^ k := by
  induction k with
  | zero => exact ⟨y, 1, by simp, by simp⟩
  | succ k ih =>
    obtain ⟨c, w, hw, e⟩ :=
      ih (hy.trans (pow_le_pow_of_le_one (norm_nonneg _) norm_ell_lt_one.le (Nat.le_succ k)))
    have hc : ‖(c : ℂ_[ℓ])‖ < 1 := by
      have := congrArg norm e
      rw [norm_mul, hw, mul_one, norm_mul, norm_pow] at this
      rw [this, pow_succ, mul_comm (‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ k)] at hy
      exact (le_of_mul_le_mul_right hy (pow_pos norm_ell_pos k)).trans_lt norm_ell_lt_one
    obtain ⟨c', w', hw', e'⟩ := exists_mul_eq_of_lt hc
    have e'' : (c : ℂ_[ℓ]) * w' = c' * ℓ := by exact_mod_cast congrArg Subtype.val e'
    refine ⟨c', w * w', by push_cast; rw [norm_mul, hw, hw', one_mul], ?_⟩
    push_cast
    calc (y : ℂ_[ℓ]) * (w * w') = (y * w) * w' := by ring
      _ = c * w' * ℓ ^ k := by rw [e]; ring
      _ = c' * ℓ ^ (k + 1) := by rw [e'']; ring

end Norms

section Closure

variable (ℓ) in
/-- **The closure of `ℤ[μ']`**, which is the unit ball of `unramC ℓ` (`mem_unramInt_of_mem_unramC`). -/
abbrev unramInt : Subring ℂ_[ℓ] := (R0 ℓ).topologicalClosure

/-- **`A` is closed.** -/
theorem isClosed_unramInt : IsClosed ((unramInt ℓ : Subring ℂ_[ℓ]) : Set ℂ_[ℓ]) :=
  Subring.isClosed_topologicalClosure _

/-- **`ℤ[μ'] ⊆ A`.** -/
theorem R0_le_unramInt : R0 ℓ ≤ unramInt ℓ := Subring.le_topologicalClosure _

/-- **`A ⊆ unramC ℓ`** (`unramC ℓ` is closed). -/
theorem unramInt_le_unramC : unramInt ℓ ≤ (unramC ℓ).toSubring :=
  Subring.topologicalClosure_minimal _ R0_le_unramC isClosed_unramC

/-- **`ℤ[μ']` is dense in `A`.** -/
theorem exists_R0_near {a : ℂ_[ℓ]} (ha : a ∈ unramInt ℓ) {ε : ℝ} (hε : 0 < ε) : ∃ y : R0 ℓ, ‖a - y‖ < ε := by
  obtain ⟨b, hb, hab⟩ := Metric.mem_closure_iff.1 ha ε hε
  exact ⟨⟨b, hb⟩, by rwa [← dist_eq_norm]⟩

/-- **Ultrametric**: a close point has the same norm. -/
theorem norm_eq_of_near {a b : ℂ_[ℓ]} (h : ‖a - b‖ < ‖a‖) : ‖b‖ = ‖a‖ := by
  rw [show b = a + -(a - b) by ring, IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm
    (by rw [norm_neg]; exact h.ne'), norm_neg, max_eq_left h.le]

/-- **Geometric series in `A`**: `(1 − x)⁻¹ ∈ A` for `x ∈ A`, `‖x‖ < 1`. -/
theorem inv_one_sub_mem {x : ℂ_[ℓ]} (hx : x ∈ unramInt ℓ) (h : ‖x‖ < 1) : (1 - x)⁻¹ ∈ unramInt ℓ :=
  isClosed_unramInt.mem_of_tendsto (hasSum_geometric_of_norm_lt_one h).tendsto_sum_nat
    (Filter.Eventually.of_forall fun _ => sum_mem fun i _ => pow_mem hx i)

/-- **Units of `ℤ[μ']` are invertible in `A`**: `y^{-1} = y^{m−1}·(y^m)⁻¹` with `‖y^m − 1‖ < 1`. -/
theorem inv_mem_of_R0 {y : R0 ℓ} (hy : ‖(y : ℂ_[ℓ])‖ = 1) : (y : ℂ_[ℓ])⁻¹ ∈ unramInt ℓ := by
  obtain ⟨m, hm, h⟩ := exists_norm_pow_sub_one_lt hy
  have hy0 : (y : ℂ_[ℓ]) ≠ 0 := by intro h0; rw [h0, norm_zero] at hy; exact zero_ne_one hy
  have hyA : (y : ℂ_[ℓ]) ∈ unramInt ℓ := R0_le_unramInt y.2
  have hu : ((y : ℂ_[ℓ]) ^ m)⁻¹ ∈ unramInt ℓ := by
    have := inv_one_sub_mem (x := 1 - (y : ℂ_[ℓ]) ^ m) (sub_mem (one_mem _) (pow_mem hyA m))
      (by rwa [norm_sub_rev])
    rwa [sub_sub_cancel] at this
  have e : (y : ℂ_[ℓ]) ^ m = (y : ℂ_[ℓ]) ^ (m - 1) * y := by rw [← pow_succ, Nat.sub_add_cancel hm]
  have e' : (y : ℂ_[ℓ])⁻¹ = (y : ℂ_[ℓ]) ^ (m - 1) * ((y : ℂ_[ℓ]) ^ m)⁻¹ := by
    rw [e, mul_inv, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hy0), one_mul]
  rw [e']
  exact mul_mem (pow_mem hyA _) hu

/-- **Units of the closure are invertible in it.** -/
theorem inv_mem_unramInt {a : ℂ_[ℓ]} (ha : a ∈ unramInt ℓ) (h : ‖a‖ = 1) : a⁻¹ ∈ unramInt ℓ := by
  obtain ⟨y, hy⟩ := exists_R0_near ha one_pos
  have hy1 : ‖(y : ℂ_[ℓ])‖ = 1 := by rw [norm_eq_of_near (h ▸ hy), h]
  have hy0 : (y : ℂ_[ℓ]) ≠ 0 := by intro h0; rw [h0, norm_zero] at hy1; exact zero_ne_one hy1
  have hyi := inv_mem_of_R0 hy1
  set m := (y : ℂ_[ℓ])⁻¹ * (y - a) with hmdef
  have hm : m ∈ unramInt ℓ := mul_mem hyi (sub_mem (R0_le_unramInt y.2) ha)
  have hm1 : ‖m‖ < 1 := by rw [hmdef, norm_mul, norm_inv, hy1, inv_one, one_mul, norm_sub_rev]; exact hy
  have e : a⁻¹ = (1 - m)⁻¹ * (y : ℂ_[ℓ])⁻¹ := by
    rw [← mul_inv]
    congr 1
    rw [hmdef]
    field_simp
    ring
  rw [e]
  exact mul_mem (inv_one_sub_mem hm hm1) hyi

/-- **Division by `ℓ^k` from `ℤ[μ']` into `A`**: `y/ℓ^k = c·w⁻¹` (`exists_mul_eq_pow`). -/
theorem div_pow_mem_of_R0 (k : ℕ) {y : R0 ℓ} (hy : ‖(y : ℂ_[ℓ])‖ ≤ ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ k) :
    (y : ℂ_[ℓ]) / ((ℓ : ℕ) : ℂ_[ℓ]) ^ k ∈ unramInt ℓ := by
  obtain ⟨c, w, hw, e⟩ := exists_mul_eq_pow k hy
  have hw0 : (w : ℂ_[ℓ]) ≠ 0 := by intro h0; rw [h0, norm_zero] at hw; exact zero_ne_one hw
  have hℓ0 : ((ℓ : ℕ) : ℂ_[ℓ]) ^ k ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.2 hℓp.out.ne_zero)
  have e' : (y : ℂ_[ℓ]) / ((ℓ : ℕ) : ℂ_[ℓ]) ^ k = c * (w : ℂ_[ℓ])⁻¹ := by
    rw [div_eq_iff hℓ0, mul_comm (c : ℂ_[ℓ]), mul_assoc, ← e]
    field_simp
  rw [e']
  exact mul_mem (R0_le_unramInt c.2) (inv_mem_of_R0 hw)

/-- **Division by `ℓ^k` in the closure**: `‖a‖ ≤ ‖ℓ‖^k` gives `a/ℓ^k ∈ A`. -/
theorem div_pow_mem {a : ℂ_[ℓ]} (ha : a ∈ unramInt ℓ) (k : ℕ) (h : ‖a‖ ≤ ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ k) :
    a / ((ℓ : ℕ) : ℂ_[ℓ]) ^ k ∈ unramInt ℓ := by
  rw [← SetLike.mem_coe, ← isClosed_unramInt.closure_eq]
  refine Metric.mem_closure_iff.2 fun ε hε => ?_
  have hk : 0 < ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ k := pow_pos norm_ell_pos k
  obtain ⟨y, hy⟩ := exists_R0_near ha (lt_min (mul_pos hε hk) hk)
  have hyk : ‖(y : ℂ_[ℓ])‖ ≤ ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ k := by
    rw [show (y : ℂ_[ℓ]) = a + -(a - y) by ring]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le h ?_)
    rw [norm_neg]
    exact (hy.trans_le (min_le_right _ _)).le
  refine ⟨_, div_pow_mem_of_R0 k hyk, ?_⟩
  rw [dist_eq_norm, ← sub_div, norm_div, norm_pow, div_lt_iff₀ hk]
  exact hy.trans_le (min_le_left _ _)

/-- **The values of the norm on `A`** are the powers of `‖ℓ‖` (approximate by `ℤ[μ']`). -/
theorem norm_unramInt_eq_pow {a : ℂ_[ℓ]} (ha : a ∈ unramInt ℓ) (h0 : a ≠ 0) :
    ∃ j : ℕ, ‖a‖ = ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ j := by
  obtain ⟨y, hy⟩ := exists_R0_near ha (norm_pos_iff.2 h0)
  have e := norm_eq_of_near hy
  have hy0 : (y : ℂ_[ℓ]) ≠ 0 := by intro h; rw [h, norm_zero] at e; exact h0 (norm_eq_zero.1 e.symm)
  obtain ⟨j, hj⟩ := norm_R0_eq_pow hy0
  exact ⟨j, e ▸ hj⟩

end Closure

section Field

variable (ℓ) in
/-- **`A[1/ℓ]`**, a closed subfield containing the roots of unity, hence containing `unramC ℓ`. -/
def unramB : Subfield ℂ_[ℓ] where
  carrier := {x | ∃ k : ℕ, ((ℓ : ℕ) : ℂ_[ℓ]) ^ k * x ∈ unramInt ℓ}
  zero_mem' := ⟨0, by simp⟩
  one_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x y ⟨j, hj⟩ ⟨k, hk⟩
    refine ⟨j + k, ?_⟩
    rw [show ((ℓ : ℕ) : ℂ_[ℓ]) ^ (j + k) * (x + y) = ((ℓ : ℕ) : ℂ_[ℓ]) ^ k * (((ℓ : ℕ) : ℂ_[ℓ]) ^ j * x) +
      ((ℓ : ℕ) : ℂ_[ℓ]) ^ j * (((ℓ : ℕ) : ℂ_[ℓ]) ^ k * y) by ring]
    exact add_mem (mul_mem (pow_mem (natCast_mem _ ℓ) k) hj) (mul_mem (pow_mem (natCast_mem _ ℓ) j) hk)
  neg_mem' := by
    rintro x ⟨k, hk⟩
    exact ⟨k, by rw [mul_neg]; exact neg_mem hk⟩
  mul_mem' := by
    rintro x y ⟨j, hj⟩ ⟨k, hk⟩
    refine ⟨j + k, ?_⟩
    rw [show ((ℓ : ℕ) : ℂ_[ℓ]) ^ (j + k) * (x * y) = (((ℓ : ℕ) : ℂ_[ℓ]) ^ j * x) *
      (((ℓ : ℕ) : ℂ_[ℓ]) ^ k * y) by ring]
    exact mul_mem hj hk
  inv_mem' := by
    rintro x ⟨k, hk⟩
    by_cases hx : x = 0
    · exact ⟨0, by simp [hx]⟩
    have hℓ0 : ((ℓ : ℕ) : ℂ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.2 hℓp.out.ne_zero
    obtain ⟨j, hj⟩ := norm_unramInt_eq_pow hk (mul_ne_zero (pow_ne_zero _ hℓ0) hx)
    have hd1 : ‖((ℓ : ℕ) : ℂ_[ℓ]) ^ k * x / ((ℓ : ℕ) : ℂ_[ℓ]) ^ j‖ = 1 := by
      rw [norm_div, hj, norm_pow, div_self (pow_ne_zero _ norm_ell_pos.ne')]
    have hi := inv_mem_unramInt (div_pow_mem hk j hj.le) hd1
    refine ⟨j, ?_⟩
    rw [show ((ℓ : ℕ) : ℂ_[ℓ]) ^ j * x⁻¹ = ((ℓ : ℕ) : ℂ_[ℓ]) ^ k *
      (((ℓ : ℕ) : ℂ_[ℓ]) ^ k * x / ((ℓ : ℕ) : ℂ_[ℓ]) ^ j)⁻¹ by field_simp]
    exact mul_mem (pow_mem (natCast_mem _ ℓ) k) hi

/-- **The unit ball of `A[1/ℓ]` is `A`** (`div_pow_mem`). -/
theorem mem_unramInt_of_mem_unramB {x : ℂ_[ℓ]} (hx : x ∈ unramB ℓ) (h : ‖x‖ ≤ 1) : x ∈ unramInt ℓ := by
  obtain ⟨k, hk⟩ := hx
  have := div_pow_mem hk k (by
    rw [norm_mul, norm_pow]; exact mul_le_of_le_one_right (pow_nonneg (norm_nonneg _) _) h)
  rwa [mul_div_cancel_left₀ _ (pow_ne_zero _ (Nat.cast_ne_zero.2 hℓp.out.ne_zero))] at this

/-- **`A[1/ℓ]` is closed**: points of its closure are bounded, so a fixed `ℓ^K` moves them into `A`. -/
theorem isClosed_unramB : IsClosed ((unramB ℓ : Subfield ℂ_[ℓ]) : Set ℂ_[ℓ]) := by
  refine isClosed_of_closure_subset fun x hx => ?_
  obtain ⟨K, hK⟩ := exists_pow_lt_of_lt_one (show 0 < 1 / (‖x‖ + 1) by positivity) (norm_ell_lt_one (ℓ := ℓ))
  refine ⟨K, ?_⟩
  rw [← SetLike.mem_coe, ← isClosed_unramInt.closure_eq]
  refine Metric.mem_closure_iff.2 fun ε hε => ?_
  obtain ⟨z, hz, hxz⟩ := Metric.mem_closure_iff.1 hx (min 1 ε) (lt_min one_pos hε)
  rw [dist_eq_norm] at hxz
  refine ⟨((ℓ : ℕ) : ℂ_[ℓ]) ^ K * z,
    mem_unramInt_of_mem_unramB (mul_mem (pow_mem (natCast_mem _ ℓ) K) hz) ?_, ?_⟩
  · have hz1 : ‖z‖ ≤ ‖x‖ + 1 := by
      have := norm_sub_norm_le z x
      rw [norm_sub_rev] at this
      linarith [min_le_left 1 ε]
    rw [norm_mul, norm_pow]
    calc ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ K * ‖z‖ ≤ (1 / (‖x‖ + 1)) * (‖x‖ + 1) :=
          mul_le_mul hK.le hz1 (norm_nonneg _) (by positivity)
      _ = 1 := by field_simp
  · rw [dist_eq_norm, ← mul_sub, norm_mul, norm_pow]
    calc ‖((ℓ : ℕ) : ℂ_[ℓ])‖ ^ K * ‖x - z‖ ≤ 1 * ‖x - z‖ :=
          mul_le_mul_of_nonneg_right (pow_le_one₀ (norm_nonneg _) norm_ell_lt_one.le) (norm_nonneg _)
      _ < ε := by rw [one_mul]; exact hxz.trans_le (min_le_right _ _)

/-- **`unramC ℓ ⊆ A[1/ℓ]`**: a closed subfield containing the roots of unity. -/
theorem unramC_le_unramB : unramC ℓ ≤ unramB ℓ :=
  Subfield.topologicalClosure_minimal _ (Subfield.closure_le.2 fun g hg =>
    ⟨0, by rw [pow_zero, one_mul]; exact R0_le_unramInt ⟨X ⟨g, hg⟩, ev_X _⟩⟩) isClosed_unramB

/-- **The unit ball of `unramC ℓ` is the closure of `ℤ[μ']`.** -/
theorem mem_unramInt_of_mem_unramC {x : ℂ_[ℓ]} (hx : x ∈ unramC ℓ) (h : ‖x‖ ≤ 1) : x ∈ unramInt ℓ :=
  mem_unramInt_of_mem_unramB (unramC_le_unramB hx) h

end Field

section Extension

variable (ℓ) in
/-- **`φ₀` into `unramC ℓ`.** -/
def phi0U : R0 ℓ →+* unramC ℓ :=
  RingHom.codRestrict ((R0 ℓ).subtype.comp (phi0 ℓ)) (unramC ℓ) fun y => R0_le_unramC (phi0 ℓ y).2

variable (ℓ) in
/-- **The inclusion `ℤ[μ'] → A`.** -/
def inclA : R0 ℓ →+* unramInt ℓ := Subring.inclusion R0_le_unramInt

/-- **The inclusion `ℤ[μ'] → A` is uniform inducing** (an isometry). -/
theorem isUniformInducing_inclA : IsUniformInducing (inclA ℓ) :=
  Isometry.isUniformInducing (f := inclA ℓ) (Isometry.of_dist_eq fun _ _ => rfl)

/-- **The inclusion `ℤ[μ'] → A` has dense range.** -/
theorem denseRange_inclA : DenseRange (inclA ℓ) := by
  refine Metric.denseRange_iff.2 fun a r hr => ?_
  obtain ⟨y, hy⟩ := exists_R0_near a.2 hr
  exact ⟨y, by rw [Subtype.dist_eq, dist_eq_norm]; exact hy⟩

/-- **`φ₀` is uniformly continuous** (an isometry, `norm_phi0`). -/
theorem uniformContinuous_phi0U : UniformContinuous (phi0U ℓ) :=
  AddMonoidHomClass.uniformContinuous_of_bound _ 1 fun y => by
    rw [one_mul]
    exact (norm_phi0 y).le

/-- **`unramC ℓ` is complete** (closed in `ℂ_ℓ`). -/
instance : CompleteSpace (unramC ℓ) := isClosed_unramC.completeSpace_coe

variable (ℓ) in
/-- **Frobenius on the closure `A`**, the continuous extension of `φ₀`. -/
def phiA : unramInt ℓ →+* unramC ℓ :=
  IsDenseInducing.extendRingHom isUniformInducing_inclA denseRange_inclA uniformContinuous_phi0U

/-- **`φ_A` extends `φ₀`.** -/
theorem phiA_inclA (y : R0 ℓ) : phiA ℓ (inclA ℓ y) = phi0U ℓ y :=
  (isUniformInducing_inclA.isDenseInducing denseRange_inclA).extend_eq uniformContinuous_phi0U.continuous y

/-- **`φ_A` is continuous.** -/
theorem continuous_phiA : Continuous (phiA ℓ) :=
  (uniformContinuous_uniformly_extend isUniformInducing_inclA denseRange_inclA uniformContinuous_phi0U).continuous

/-- **The Frobenius congruence on `A`**, by density. -/
theorem norm_phiA_sub_pow_le (a : unramInt ℓ) :
    ‖((phiA ℓ a : unramC ℓ) : ℂ_[ℓ]) - (a : ℂ_[ℓ]) ^ ℓ‖ ≤ ‖((ℓ : ℕ) : ℂ_[ℓ])‖ := by
  refine denseRange_inclA.induction_on a (isClosed_le ?_ continuous_const) fun y => ?_
  · exact ((continuous_subtype_val.comp continuous_phiA).sub (continuous_subtype_val.pow ℓ)).norm
  · rw [phiA_inclA]
    exact norm_phi0_sub_pow_le y

end Extension

variable (ℓ) in
/-- **A Frobenius lift on `K^ur` exists** (`CMEquiv.UnramFrob`), for every prime `ℓ`. -/
theorem unramFrob : CMEquiv.UnramFrob ℓ := by
  let j : unramInt ℓ →+* unramC ℓ :=
    RingHom.codRestrict (unramInt ℓ).subtype (unramC ℓ) fun a => unramInt_le_unramC a.2
  let : Algebra (unramInt ℓ) (unramC ℓ) := j.toAlgebra
  have hℓ0 : ((ℓ : ℕ) : unramC ℓ) ≠ 0 := Nat.cast_ne_zero.2 hℓp.out.ne_zero
  have : IsLocalization (Submonoid.powers ((ℓ : ℕ) : unramInt ℓ)) (unramC ℓ) := by
    refine (isLocalization_iff _ _).2 ⟨?_, fun z => ?_, fun {x y} h => ⟨1, ?_⟩⟩
    · rintro ⟨_, k, rfl⟩
      refine isUnit_iff_ne_zero.2 ?_
      rw [map_pow, map_natCast]
      exact pow_ne_zero _ hℓ0
    · obtain ⟨k, hk⟩ := unramC_le_unramB z.2
      refine ⟨(⟨_, hk⟩, ⟨_, k, rfl⟩), Subtype.ext ?_⟩
      rw [RingHom.algebraMap_toAlgebra]
      simp only [j, MulMemClass.coe_mul, RingHom.codRestrict_apply, Subring.coe_subtype]
      push_cast
      ring
    · have h' := congrArg Subtype.val h
      have : x = y := Subtype.ext h'
      rw [this]
  have hunit : ∀ y : Submonoid.powers ((ℓ : ℕ) : unramInt ℓ), IsUnit (phiA ℓ (y : unramInt ℓ)) := by
    rintro ⟨_, k, rfl⟩
    refine isUnit_iff_ne_zero.2 ?_
    rw [map_pow, map_natCast]
    exact pow_ne_zero _ hℓ0
  refine ⟨IsLocalization.lift hunit, fun x hx => ?_⟩
  have hxA : (x : ℂ_[ℓ]) ∈ unramInt ℓ := mem_unramInt_of_mem_unramC x.2 hx
  have e : algebraMap (unramInt ℓ) (unramC ℓ) ⟨x, hxA⟩ = x := Subtype.ext rfl
  have h := IsLocalization.lift_eq (S := unramC ℓ) hunit ⟨x, hxA⟩
  rw [e] at h
  rw [h]
  have key := norm_phiA_sub_pow_le (ℓ := ℓ) ⟨x, hxA⟩
  have e1 : ‖phiA ℓ ⟨x, hxA⟩ - x ^ ℓ‖ = ‖((phiA ℓ ⟨x, hxA⟩ : unramC ℓ) : ℂ_[ℓ]) - (x : ℂ_[ℓ]) ^ ℓ‖ := by
    rw [← SubmonoidClass.coe_pow, ← AddSubgroupClass.coe_sub]; rfl
  have e2 : ‖((ℓ : ℕ) : unramC ℓ)‖ = ‖((ℓ : ℕ) : ℂ_[ℓ])‖ := rfl
  rw [e1, e2]
  exact key

variable (ℓ) in
/-- **The Frobenius lift on `K^ur`** given by `unramFrob`. -/
def frobUnram : unramC ℓ →+* unramC ℓ := (unramFrob ℓ).choose

/-- **`frobUnram` lifts Frobenius**: `‖φ(x) − x^ℓ‖ ≤ ‖ℓ‖` on the unit ball of `unramC ℓ`. -/
theorem norm_frobUnram_sub_pow_le (x : unramC ℓ) (hx : ‖x‖ ≤ 1) :
    ‖frobUnram ℓ x - x ^ ℓ‖ ≤ ‖((ℓ : ℕ) : unramC ℓ)‖ :=
  (unramFrob ℓ).choose_spec x hx

section Corollaries

open CMFormalBiadd ThetaNorm

/-- **The hermitian property of `be` for the CM curve, without the Frobenius input** (`CMEquiv.isHerm_be_cm` with
`unramFrob`): under CM-a′/c/d and `TorsionTransl`, `IsHerm (be …)` for every unit `ε ∈ K^ur` making
`t(ε·log_LT(T))` integral. -/
theorem isHerm_be_cm' (hj : CMThetaOne.CMjIntegral) (hu : CMUnramified) (hs : CMs2Unram)
    (htor : CMEquiv.TorsionTransl) {d : ℕ} {Λ : PeriodPair} (hd : Squarefree d) (hd4 : d % 4 = 3)
    (hcm : HasCM d Λ) (hΔ : Λ.g₂ ^ 3 - 27 * Λ.g₃ ^ 2 = 1) (h5 : 5 ≤ ℓ) (hdℓ : ¬ ℓ ∣ d)
    (hin : ¬ ∃ x : ZMod ℓ, x ^ 2 = -(d : ZMod ℓ)) (ι : ℂ ≃+* ℂ_[ℓ]) :
    ∀ ε : ℂ_[ℓ], ε ∈ unramC ℓ → ‖ε‖ = 1 → IsInt ((tSer (ι Λ.g₂) (ι Λ.g₃)).subst (zLT ℓ ε)) →
      IsHerm (be ℓ (ι Λ.g₂) (ι Λ.g₃) (ι (s2 Λ)) ε) :=
  CMEquiv.isHerm_be_cm hj hu hs htor (unramFrob ℓ) hd hd4 hcm hΔ h5 hdℓ hin ι

/-- **The classification for the CM curve, without the Frobenius input** (`CMEquiv.be_classification_cm_omega` for
`frobUnram`): with CM-b, CM-c, CM-a′, the strengthened CM-d and `TorsionTransl`, the Lubin–Tate unit `ε` of CM-b has
`be ≃ c·serAB` with `φ(c) = −c`, `‖c‖ ≤ 1`, for the Frobenius lift `φ = frobUnram ℓ`. -/
theorem be_classification_cm_omega' (hb : CMInertLubinTate) (hj : CMThetaOne.CMjIntegral) (hu : CMUnramified)
    (hs : CMs2Unram) (htor : CMEquiv.TorsionTransl) {d : ℕ} {Λ : PeriodPair} (hd : Squarefree d)
    (hd4 : d % 4 = 3) (hcm : HasCM d Λ) (hΔ : Λ.g₂ ^ 3 - 27 * Λ.g₃ ^ 2 = 1) (h5 : 5 ≤ ℓ) (hdℓ : ¬ ℓ ∣ d)
    (hin : ¬ ∃ x : ZMod ℓ, x ^ 2 = -(d : ZMod ℓ)) (ι : ℂ ≃+* ℂ_[ℓ]) :
    ∃ ε ∈ unramC ℓ, ‖ε‖ = 1 ∧ ∃ c : unramC ℓ, frobUnram ℓ c = -c ∧ ‖c‖ ≤ 1 ∧
      Simeq (be ℓ (ι Λ.g₂) (ι Λ.g₃) (ι (s2 Λ)) ε) (MvPowerSeries.C (c : ℂ_[ℓ]) * serAB ℓ) :=
  CMEquiv.be_classification_cm_omega hb hj hu hs htor hd hd4 hcm hΔ h5 hdℓ hin ι norm_frobUnram_sub_pow_le

end Corollaries

end

