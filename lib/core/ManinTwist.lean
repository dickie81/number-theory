/-
# Manin's twist: the degree of the `x`-coordinate is a quadratic form

Plain statement. Let `k` be a field of characteristic not `2`. Let `f = X³ + a₂X² + a₄X + a₆ ∈ k[X]` with
`D = 4a₂³a₆ − a₂²a₄² − 18a₂a₄a₆ + 4a₄³ + 27a₆² ≠ 0`, so that `f` has no double root (`−D` is the discriminant of
`f`). Put `s = f(t) ∈ k(t)`. The twist `E'`: `y² = x³ + a₂sx² + a₄s²x + a₆s³` over `k(t)` carries the point
`P₀ = (st, s²)`. For a point `P` of `E'` write `deg P` for the degree of the rational function `x(P)/s`, and
`deg 0 = 0`. Then for all points `P` and `Q`: `deg(P + Q) + deg(P − Q) = 2 deg P + 2 deg Q`
(`pdeg_parallelogram`). So `deg` is a quadratic form on the points of `E'`, and `deg P₀ = 1`. No hypothesis beyond
the two above.

This is the key step of Manin's proof of Hasse's bound (`ManinHasse`). In the coordinates `X = x/s`, `Y = y/s²` the
twist is `sY² = f(X)` and `P₀ = (t, 1)`. Write `X(P) = u₁/v₁` and `X(Q) = u₂/v₂` in lowest terms, and `M = u₁u₂`,
`S = v₁u₂ + u₁v₂`, `N = v₁v₂`, the coefficients of `(u₁ − v₁Z)(u₂ − v₂Z)`. The `X`-coordinates of `P ± Q` are the
roots of `q₀Z² − q₁Z + q₂` (`vieta2`), where
* `q₀ = S² − 4MN`,
* `q₁ = 2S(M + a₄N) + 4a₂MN + 4a₆N²`,
* `q₂ = (M − a₄N)² − 4a₆NS − 4a₂a₆N²`.

Then:
* `16D·N⁴` lies in the ideal generated by `q₀`, `q₁`, `q₂` (`qf_cert`). So the `qᵢ` have no common factor when `M`,
  `S`, `N` have none (`prim3_qf`), which Gauss's lemma gives (`ManinDegree.prim3_prod`). Their largest degree is twice
  that of `M`, `S`, `N` (`max_natDegree_qf`), which is `deg P + deg Q` (`ManinDegree.max_natDegree_prod`).
* `ManinDegree.rdeg_add_rdeg_of_vieta` turns these into the identity when `x(P) ≠ x(Q)`
  (`pdeg_add_add_pdeg_sub_of_X_ne`).
* `deg 2P = 4 deg P` follows from the case `x(P) ≠ x(Q)` applied to `(P, P₀)` and `(P + P₀, P − P₀)`, with
  `X(2P₀) = g(t)/4f(t)` of degree 4 (`pdeg_two_P0`), `g = X⁴ − 2a₄X² − 8a₆X + a₄² − 4a₂a₆`. A point of order 2 has
  a constant `X`, a root of `f` (`rdeg_eq_zero_of_root`).
-/
import ManinDegree

open Polynomial ManinDegree

namespace ManinHasse

/-- `D = 4a₂³a₆ − a₂²a₄² − 18a₂a₄a₆ + 4a₄³ + 27a₆²`, minus the discriminant of `X³ + a₂X² + a₄X + a₆`. -/
def dsc {R : Type*} [CommRing R] (a₂ a₄ a₆ : R) : R :=
  4 * a₂ ^ 3 * a₆ - a₂ ^ 2 * a₄ ^ 2 - 18 * a₂ * a₄ * a₆ + 4 * a₄ ^ 3 + 27 * a₆ ^ 2

/-- The discriminant of `y² = x³ + a₂x² + a₄x + a₆` is `−16D`. -/
lemma Δ_cubic {R : Type*} [CommRing R] (a₂ a₄ a₆ : R) :
    ({ a₁ := 0, a₂ := a₂, a₃ := 0, a₄ := a₄, a₆ := a₆ } : WeierstrassCurve R).Δ = -16 * dsc a₂ a₄ a₆ := by
  simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
    WeierstrassCurve.b₈, dsc]
  ring

/-! ## The quadratic forms of the addition formula -/

section forms

variable {R : Type*} [CommRing R]

/-- `q₀ = S² − 4MN`. -/
def qf0 (M S N : R) : R := S * S - 4 * (M * N)

/-- `q₁ = 2S(M + a₄N) + 4a₂MN + 4a₆N²`. -/
def qf1 (a₂ a₄ a₆ M S N : R) : R := 2 * (S * M) + 2 * a₄ * (S * N) + 4 * a₂ * (M * N) + 4 * a₆ * (N * N)

/-- `q₂ = (M − a₄N)² − 4a₆NS − 4a₂a₆N²`. -/
def qf2 (a₂ a₄ a₆ M S N : R) : R :=
  M * M - 2 * a₄ * (M * N) + (a₄ ^ 2 - 4 * a₂ * a₆) * (N * N) - 4 * a₆ * (N * S)

/-- **The three forms have no common zero but `0`**: `16D·N⁴` lies in the ideal they generate. -/
lemma qf_cert (a₂ a₄ a₆ M S N : R) :
    16 * dsc a₂ a₄ a₆ * N ^ 4 =
      (-4 * a₂ ^ 2 * M * N - 2 * a₂ * a₄ * N * S + 108 * a₂ * a₆ * N ^ 2 - 2 * a₂ * M * S - 32 * a₄ ^ 2 * N ^ 2 +
          16 * a₄ * M * N + 48 * a₆ * N * S) * qf0 M S N +
        (-8 * a₂ * a₄ * N ^ 2 + a₂ * S ^ 2 + 10 * a₄ * N * S + 108 * a₆ * N ^ 2 - 6 * M * S) *
          qf1 a₂ a₄ a₆ M S N +
        (-16 * a₂ ^ 2 * N ^ 2 + 16 * a₂ * N * S + 64 * a₄ * N ^ 2 + 12 * S ^ 2) * qf2 a₂ a₄ a₆ M S N := by
  unfold dsc qf0 qf1 qf2
  ring

end forms

variable {k : Type*} [Field k]

/-! ## The cubic and its Bézout identity -/

/-- `f = X³ + a₂X² + a₄X + a₆`. -/
noncomputable def fpol (a₂ a₄ a₆ : k) : k[X] := X ^ 3 + C a₂ * X ^ 2 + C a₄ * X + C a₆

/-- `g = X⁴ − 2a₄X² − 8a₆X + a₄² − 4a₂a₆`, the numerator of the doubling formula. -/
noncomputable def gpol (a₂ a₄ a₆ : k) : k[X] :=
  X ^ 4 - 2 * C a₄ * X ^ 2 - 8 * C a₆ * X + C a₄ ^ 2 - 4 * C a₂ * C a₆

lemma bezout_fg (a₂ a₄ a₆ : k) :
    (-3 * X ^ 3 + C a₂ * X ^ 2 + 5 * C a₄ * X - 2 * C a₂ * C a₄ + 27 * C a₆) * fpol a₂ a₄ a₆ +
      (3 * X ^ 2 + 2 * C a₂ * X - C a₂ ^ 2 + 4 * C a₄) * gpol a₂ a₄ a₆ = C (dsc a₂ a₄ a₆) := by
  simp only [fpol, gpol, dsc, map_add, map_sub, map_mul, map_pow, map_ofNat]
  ring

variable {a₂ a₄ a₆ : k}

lemma isCoprime_C {p : k[X]} {c : k} (hc : c ≠ 0) : IsCoprime p (C c) :=
  ⟨0, C c⁻¹, by rw [zero_mul, zero_add, ← C_mul, inv_mul_cancel₀ hc, C_1]⟩

lemma isCoprime_g_f (hD : dsc a₂ a₄ a₆ ≠ 0) : IsCoprime (gpol a₂ a₄ a₆) (fpol a₂ a₄ a₆) := by
  refine ⟨C (dsc a₂ a₄ a₆)⁻¹ * (3 * X ^ 2 + 2 * C a₂ * X - C a₂ ^ 2 + 4 * C a₄),
    C (dsc a₂ a₄ a₆)⁻¹ * (-3 * X ^ 3 + C a₂ * X ^ 2 + 5 * C a₄ * X - 2 * C a₂ * C a₄ + 27 * C a₆), ?_⟩
  have h := congrArg (C (dsc a₂ a₄ a₆)⁻¹ * ·) (bezout_fg a₂ a₄ a₆)
  simp only [← C_mul, inv_mul_cancel₀ hD, C_1] at h
  linear_combination h

variable (a₂ a₄ a₆) in
lemma fpol_ne_zero : fpol a₂ a₄ a₆ ≠ 0 := fun h => by
  have := congrArg (coeff · 3) h
  simp [fpol] at this

variable (a₂ a₄ a₆) in
lemma natDegree_fpol : (fpol a₂ a₄ a₆).natDegree = 3 := by
  unfold fpol; compute_degree!

variable (a₂ a₄ a₆) in
lemma natDegree_gpol : (gpol a₂ a₄ a₆).natDegree = 4 := by
  unfold gpol; compute_degree!

/-! ## The forms on a primitive triple of polynomials -/

lemma sixteen_ne_zero (h2 : (2 : k) ≠ 0) : (16 : k) ≠ 0 := by
  have e : (16 : k) = 2 ^ 4 := by norm_num
  rw [e]; exact pow_ne_zero 4 h2

lemma qf_eq_zero (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {M S N : k} (h0 : qf0 M S N = 0)
    (h1 : qf1 a₂ a₄ a₆ M S N = 0) (h2' : qf2 a₂ a₄ a₆ M S N = 0) : M = 0 ∧ S = 0 ∧ N = 0 := by
  have hN : N = 0 := by
    have := qf_cert a₂ a₄ a₆ M S N
    rw [h0, h1, h2', mul_zero, mul_zero, mul_zero, add_zero, add_zero] at this
    exact (pow_eq_zero_iff (by norm_num)).1
      ((mul_eq_zero.1 this).resolve_left (mul_ne_zero (sixteen_ne_zero h2) hD))
  subst hN
  have hS : S = 0 := by unfold qf0 at h0; simpa using h0
  have hM : M = 0 := by unfold qf2 at h2'; simpa using h2'
  exact ⟨hM, hS, rfl⟩

lemma dsc_C : dsc (C a₂) (C a₄) (C a₆) = C (dsc a₂ a₄ a₆) := by
  simp only [dsc, map_sub, map_add, map_mul, map_pow, map_ofNat]

/-- **The forms of a primitive triple have no common factor.** -/
lemma prim3_qf (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {M S N : k[X]} (h : Prim3 N S M) :
    Prim3 (qf0 M S N) (qf1 (C a₂) (C a₄) (C a₆) M S N) (qf2 (C a₂) (C a₄) (C a₆) M S N) := by
  refine prim3_of_prime fun π hπ h0 h1 h2' => ?_
  have hu : IsUnit (16 * dsc (C a₂) (C a₄) (C a₆) : k[X]) := by
    rw [dsc_C, ← map_ofNat C 16, ← C_mul]
    exact isUnit_C.2 (mul_ne_zero (sixteen_ne_zero h2) hD).isUnit
  have hN4 : π ∣ 16 * dsc (C a₂) (C a₄) (C a₆) * N ^ 4 := by
    rw [qf_cert]
    exact dvd_add (dvd_add (dvd_mul_of_dvd_right h0 _) (dvd_mul_of_dvd_right h1 _)) (dvd_mul_of_dvd_right h2' _)
  have hN : π ∣ N := by
    rcases hπ.dvd_or_dvd hN4 with h' | h'
    · exact absurd (isUnit_of_dvd_unit h' hu) hπ.not_isUnit
    · exact hπ.dvd_of_dvd_pow h'
  have hS : π ∣ S := by
    have h' : π ∣ S * S := by
      have := dvd_add h0 (dvd_mul_of_dvd_right (dvd_mul_of_dvd_right hN M) (4 : k[X]))
      rwa [qf0, sub_add_cancel] at this
    exact (hπ.dvd_or_dvd h').elim id id
  have hM : π ∣ M := by
    have h' : π ∣ M * M := by
      have e : M * M = qf2 (C a₂) (C a₄) (C a₆) M S N + (2 * C a₄ * (M * N) -
          (C a₄ ^ 2 - 4 * C a₂ * C a₆) * (N * N) + 4 * C a₆ * (N * S)) := by
        unfold qf2; ring
      rw [e]
      exact dvd_add h2' (dvd_add (dvd_sub (dvd_mul_of_dvd_right (dvd_mul_of_dvd_right hN M) _)
        (dvd_mul_of_dvd_right (dvd_mul_of_dvd_left hN N) _)) (dvd_mul_of_dvd_right (dvd_mul_of_dvd_left hN S) _))
    exact (hπ.dvd_or_dvd h').elim id id
  exact hπ.not_isUnit (h π hN hS hM)

/-- **The largest degree of the forms of a triple is twice that of the triple**, read off the coefficient of
`t^{2e}`. -/
lemma max_natDegree_qf (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {M S N : k[X]} {e : ℕ} (hM : M.natDegree ≤ e)
    (hS : S.natDegree ≤ e) (hN : N.natDegree ≤ e) (hne : M.coeff e ≠ 0 ∨ S.coeff e ≠ 0 ∨ N.coeff e ≠ 0) :
    max (qf0 M S N).natDegree
      (max (qf1 (C a₂) (C a₄) (C a₆) M S N).natDegree (qf2 (C a₂) (C a₄) (C a₆) M S N).natDegree) = 2 * e := by
  have f0 : qf0 M S N = S * S - C 4 * (M * N) := by rw [qf0, map_ofNat]
  have f1 : qf1 (C a₂) (C a₄) (C a₆) M S N =
      C 2 * (S * M) + C (2 * a₄) * (S * N) + C (4 * a₂) * (M * N) + C (4 * a₆) * (N * N) := by
    simp only [qf1, map_mul, map_ofNat]
  have f2 : qf2 (C a₂) (C a₄) (C a₆) M S N =
      M * M - C (2 * a₄) * (M * N) + C (a₄ ^ 2 - 4 * a₂ * a₆) * (N * N) - C (4 * a₆) * (N * S) := by
    simp only [qf2, map_mul, map_ofNat, map_sub, map_pow]
  have pd : ∀ {p r : k[X]}, p.natDegree ≤ e → r.natDegree ≤ e → (p * r).natDegree ≤ e + e := fun hp hr =>
    natDegree_mul_le.trans (add_le_add hp hr)
  have pc : ∀ {p r : k[X]}, p.natDegree ≤ e → r.natDegree ≤ e → (p * r).coeff (e + e) = p.coeff e * r.coeff e :=
    fun hp hr => coeff_mul_add_eq_of_natDegree_le hp hr
  have cd : ∀ (c : k) {p : k[X]}, p.natDegree ≤ e + e → (C c * p).natDegree ≤ e + e := fun c p hp =>
    (natDegree_C_mul_le c p).trans hp
  have b0 : (qf0 M S N).natDegree ≤ e + e := by
    rw [f0]; exact (natDegree_sub_le _ _).trans (max_le (pd hS hS) (cd _ (pd hM hN)))
  have b1 : (qf1 (C a₂) (C a₄) (C a₆) M S N).natDegree ≤ e + e := by
    rw [f1]
    refine (natDegree_add_le _ _).trans (max_le ((natDegree_add_le _ _).trans (max_le ((natDegree_add_le _ _).trans
      (max_le (cd _ (pd hS hM)) (cd _ (pd hS hN)))) (cd _ (pd hM hN)))) (cd _ (pd hN hN)))
  have b2 : (qf2 (C a₂) (C a₄) (C a₆) M S N).natDegree ≤ e + e := by
    rw [f2]
    refine (natDegree_sub_le _ _).trans (max_le ((natDegree_add_le _ _).trans (max_le ((natDegree_sub_le _ _).trans
      (max_le (pd hM hM) (cd _ (pd hM hN)))) (cd _ (pd hN hN)))) (cd _ (pd hN hS)))
  have c0 : (qf0 M S N).coeff (e + e) = qf0 (M.coeff e) (S.coeff e) (N.coeff e) := by
    rw [f0, coeff_sub, coeff_C_mul, pc hS hS, pc hM hN, qf0]
  have c1 : (qf1 (C a₂) (C a₄) (C a₆) M S N).coeff (e + e) = qf1 a₂ a₄ a₆ (M.coeff e) (S.coeff e) (N.coeff e) := by
    rw [f1, coeff_add, coeff_add, coeff_add, coeff_C_mul, coeff_C_mul, coeff_C_mul, coeff_C_mul, pc hS hM, pc hS hN,
      pc hM hN, pc hN hN, qf1]
  have c2 : (qf2 (C a₂) (C a₄) (C a₆) M S N).coeff (e + e) = qf2 a₂ a₄ a₆ (M.coeff e) (S.coeff e) (N.coeff e) := by
    rw [f2, coeff_sub, coeff_add, coeff_sub, coeff_C_mul, coeff_C_mul, coeff_C_mul, pc hM hM, pc hM hN, pc hN hN,
      pc hN hS, qf2]
  apply le_antisymm
  · rw [two_mul]; exact max_le b0 (max_le b1 b2)
  · by_contra hlt
    rw [not_le, two_mul] at hlt
    have z0 : (qf0 M S N).coeff (e + e) = 0 := coeff_eq_zero_of_natDegree_lt ((le_max_left _ _).trans_lt hlt)
    have z1 : (qf1 (C a₂) (C a₄) (C a₆) M S N).coeff (e + e) = 0 :=
      coeff_eq_zero_of_natDegree_lt (((le_max_left _ _).trans (le_max_right _ _)).trans_lt hlt)
    have z2 : (qf2 (C a₂) (C a₄) (C a₆) M S N).coeff (e + e) = 0 :=
      coeff_eq_zero_of_natDegree_lt (((le_max_right _ _).trans (le_max_right _ _)).trans_lt hlt)
    rw [c0] at z0
    rw [c1] at z1
    rw [c2] at z2
    obtain ⟨hM0, hS0, hN0⟩ := qf_eq_zero h2 hD z0 z1 z2
    rcases hne with h | h | h <;> contradiction

/-- The top coefficient of a triple with `N ≠ 0`, at the largest of the three degrees, is not zero in all three. -/
lemma coeff_max3_ne_zero {M S N : k[X]} (hN : N ≠ 0) :
    M.coeff (max N.natDegree (max S.natDegree M.natDegree)) ≠ 0 ∨
      S.coeff (max N.natDegree (max S.natDegree M.natDegree)) ≠ 0 ∨
        N.coeff (max N.natDegree (max S.natDegree M.natDegree)) ≠ 0 := by
  by_cases hSM : S = 0 ∧ M = 0
  · obtain ⟨rfl, rfl⟩ := hSM
    right; right
    rw [natDegree_zero, max_self, max_eq_left (Nat.zero_le _)]
    exact leadingCoeff_ne_zero.2 hN
  · rcases le_total (max S.natDegree M.natDegree) N.natDegree with h | h
    · right; right; rw [max_eq_left h]; exact leadingCoeff_ne_zero.2 hN
    · rw [max_eq_right h]
      rcases coeff_max_ne_zero (r := S) (s := M) (by tauto) with h' | h'
      · exact Or.inr (Or.inl h')
      · exact Or.inl h'

/-! ## Identities in a field -/

/-- **The `X`-coordinates of `P ± Q` are the roots of `(X₁ − X₂)²Z² − q₁Z + q₂`**, in the coordinates of `sY² = f(X)`
with `P = (X₁, Y₁)` and `Q = (X₂, Y₂)`. -/
lemma vieta2 {F : Type*} [Field F] {X₁ Y₁ X₂ Y₂ s A₂ A₄ A₆ : F}
    (hY₁ : s * Y₁ ^ 2 = X₁ ^ 3 + A₂ * X₁ ^ 2 + A₄ * X₁ + A₆) (hY₂ : s * Y₂ ^ 2 = X₂ ^ 3 + A₂ * X₂ ^ 2 + A₄ * X₂ + A₆)
    (hX : X₁ - X₂ ≠ 0) :
    (s * (Y₁ - Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + A₂) + (s * (Y₁ + Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + A₂))) *
        (X₁ - X₂) ^ 2 = 2 * (X₁ + X₂) * (X₁ * X₂ + A₄) + 4 * A₂ * X₁ * X₂ + 4 * A₆ ∧
      (s * (Y₁ - Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + A₂)) * (s * (Y₁ + Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + A₂)) *
        (X₁ - X₂) ^ 2 = (X₁ * X₂ - A₄) ^ 2 - 4 * A₆ * (X₁ + X₂) - 4 * A₂ * A₆ := by
  have hQ : (X₁ - X₂) ^ 2 ≠ 0 := pow_ne_zero 2 hX
  have eP : (s * (Y₁ - Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + A₂)) * (X₁ - X₂) ^ 2 =
      s * (Y₁ - Y₂) ^ 2 - (X₁ + X₂ + A₂) * (X₁ - X₂) ^ 2 := by
    rw [sub_mul, div_mul_cancel₀ _ hQ]
  have eM : (s * (Y₁ + Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + A₂)) * (X₁ - X₂) ^ 2 =
      s * (Y₁ + Y₂) ^ 2 - (X₁ + X₂ + A₂) * (X₁ - X₂) ^ 2 := by
    rw [sub_mul, div_mul_cancel₀ _ hQ]
  refine ⟨by linear_combination eP + eM + 2 * hY₁ + 2 * hY₂, ?_⟩
  refine mul_right_cancel₀ hQ ?_
  linear_combination (s * (Y₁ + Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + A₂)) * (X₁ - X₂) ^ 2 * eP +
    (s * (Y₁ - Y₂) ^ 2 - (X₁ + X₂ + A₂) * (X₁ - X₂) ^ 2) * eM +
    (-A₂ * X₁ ^ 2 + 4 * A₂ * X₁ * X₂ - 2 * A₂ * X₂ ^ 2 + A₄ * X₁ + A₆ - X₁ ^ 3 + 2 * X₁ ^ 2 * X₂ +
      2 * X₁ * X₂ ^ 2 - 2 * X₂ ^ 3 + Y₁ ^ 2 * s - 2 * Y₂ ^ 2 * s) * hY₁ +
    (-4 * A₂ * X₁ ^ 2 + 4 * A₂ * X₁ * X₂ - A₂ * X₂ ^ 2 - 2 * A₄ * X₁ + A₄ * X₂ - A₆ - 4 * X₁ ^ 3 +
      2 * X₁ ^ 2 * X₂ + 2 * X₁ * X₂ ^ 2 - X₂ ^ 3 + Y₂ ^ 2 * s) * hY₂

/-- The doubling formula at `P₀ = (st, s²)`: `x(2P₀)/s = g(t)/4s` with `s = f(t)`. -/
lemma double_div {F : Type*} [Field F] {s t A₂ A₄ A₆ : F} (h2 : (2 : F) ≠ 0) (hs0 : s ≠ 0)
    (hs : s = t ^ 3 + A₂ * t ^ 2 + A₄ * t + A₆) :
    (((3 * (s * t) ^ 2 + 2 * (A₂ * s) * (s * t) + A₄ * s ^ 2 - 0 * s ^ 2) / (s ^ 2 - -s ^ 2)) ^ 2 - A₂ * s -
        s * t - s * t) / s = (t ^ 4 - 2 * A₄ * t ^ 2 - 8 * A₆ * t + A₄ ^ 2 - 4 * A₂ * A₆) / (4 * s) := by
  have h4 : (4 : F) ≠ 0 := by
    have e : (4 : F) = 2 * 2 := by norm_num
    rw [e]; exact mul_ne_zero h2 h2
  have hss : s ^ 2 - -s ^ 2 = 2 * s ^ 2 := by ring
  rw [hss]
  field_simp
  linear_combination (-16 * (A₂ + 2 * t)) * hs

/-- The `X`-coordinate of `P + Q` from the chord through `P` and `Q`, in the coordinates `X = x/s`, `Y = y/s²`. -/
lemma chord2_pos {F : Type*} [Field F] {x₁ y₁ x₂ y₂ s A₂ : F} (hs : s ≠ 0) (hx : x₁ - x₂ ≠ 0) :
    (((y₁ - y₂) / (x₁ - x₂)) ^ 2 - A₂ * s - x₁ - x₂) / s =
      s * (y₁ / s ^ 2 - y₂ / s ^ 2) ^ 2 / (x₁ / s - x₂ / s) ^ 2 - (x₁ / s + x₂ / s + A₂) := by
  have hx' : x₁ / s - x₂ / s ≠ 0 := by rw [div_sub_div_same]; exact div_ne_zero hx hs
  field_simp
  ring

/-- The `X`-coordinate of `P − Q` from the chord through `P` and `−Q`. -/
lemma chord2_neg {F : Type*} [Field F] {x₁ y₁ x₂ y₂ s A₂ : F} (hs : s ≠ 0) (hx : x₁ - x₂ ≠ 0) :
    (((y₁ - -y₂) / (x₁ - x₂)) ^ 2 - A₂ * s - x₁ - x₂) / s =
      s * (y₁ / s ^ 2 + y₂ / s ^ 2) ^ 2 / (x₁ / s - x₂ / s) ^ 2 - (x₁ / s + x₂ / s + A₂) := by
  have hx' : x₁ / s - x₂ / s ≠ 0 := by rw [div_sub_div_same]; exact div_ne_zero hx hs
  field_simp
  ring

/-! ## The twist over `k(t)` -/

local notation "ι" => algebraMap k[X] (RatFunc k)

variable (a₂ a₄ a₆)

/-- `s = f(t)`. -/
noncomputable def sf : RatFunc k := ι (fpol a₂ a₄ a₆)

/-- The twist `y² = x³ + a₂sx² + a₄s²x + a₆s³` of `y² = f(x)` by `s = f(t)`, over `k(t)`. -/
noncomputable def twist : WeierstrassCurve (RatFunc k) :=
  { a₁ := 0, a₂ := ι (C a₂) * sf a₂ a₄ a₆, a₃ := 0, a₄ := ι (C a₄) * sf a₂ a₄ a₆ ^ 2,
    a₆ := ι (C a₆) * sf a₂ a₄ a₆ ^ 3 }

lemma sf_eq : sf a₂ a₄ a₆ = ι X ^ 3 + ι (C a₂) * ι X ^ 2 + ι (C a₄) * ι X + ι (C a₆) := by
  simp [sf, fpol]

lemma sf_ne_zero : sf a₂ a₄ a₆ ≠ 0 := fun h =>
  fpol_ne_zero a₂ a₄ a₆ (IsFractionRing.injective k[X] (RatFunc k) (h.trans (map_zero _).symm))

variable {a₂ a₄ a₆}

lemma twist_Δ_ne_zero (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) : (twist a₂ a₄ a₆).Δ ≠ 0 := by
  rw [twist, Δ_cubic]
  have hs := sf_ne_zero a₂ a₄ a₆
  have hD' : ι (C (dsc a₂ a₄ a₆)) ≠ 0 := fun h => hD (C_injective (IsFractionRing.injective k[X]
    (RatFunc k) (h.trans (map_zero _).symm) |>.trans C_0.symm))
  have h16 : (-16 : RatFunc k) ≠ 0 := by
    have h16k : (-16 : k) ≠ 0 := neg_ne_zero.2 (sixteen_ne_zero h2)
    have h := (map_ne_zero (algebraMap k (RatFunc k))).2 h16k
    rwa [map_neg, map_ofNat] at h
  have e : dsc (ι (C a₂) * sf a₂ a₄ a₆) (ι (C a₄) * sf a₂ a₄ a₆ ^ 2) (ι (C a₆) * sf a₂ a₄ a₆ ^ 3) =
      sf a₂ a₄ a₆ ^ 6 * ι (C (dsc a₂ a₄ a₆)) := by
    simp only [dsc, map_add, map_sub, map_mul, map_pow, map_ofNat]
    ring
  rw [e]
  exact mul_ne_zero h16 (mul_ne_zero (pow_ne_zero 6 hs) hD')

lemma twist_equation (x y : RatFunc k) :
    (twist a₂ a₄ a₆).toAffine.Equation x y ↔
      y ^ 2 = x ^ 3 + ι (C a₂) * sf a₂ a₄ a₆ * x ^ 2 + ι (C a₄) * sf a₂ a₄ a₆ ^ 2 * x +
        ι (C a₆) * sf a₂ a₄ a₆ ^ 3 := by
  rw [WeierstrassCurve.Affine.equation_iff]
  simp [twist]

lemma twist_nonsingular (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) (x y : RatFunc k) :
    (twist a₂ a₄ a₆).toAffine.Nonsingular x y ↔
      y ^ 2 = x ^ 3 + ι (C a₂) * sf a₂ a₄ a₆ * x ^ 2 + ι (C a₄) * sf a₂ a₄ a₆ ^ 2 * x +
        ι (C a₆) * sf a₂ a₄ a₆ ^ 3 :=
  (WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero (W := (twist a₂ a₄ a₆).toAffine)
    (twist_Δ_ne_zero h2 hD)).symm.trans (twist_equation x y)

/-- A point `(x, y)` of the twist is the point `(x/s, y/s²)` of `sY² = f(X)`. -/
lemma twist_YX (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {x y : RatFunc k}
    (h : (twist a₂ a₄ a₆).toAffine.Nonsingular x y) :
    sf a₂ a₄ a₆ * (y / sf a₂ a₄ a₆ ^ 2) ^ 2 =
      (x / sf a₂ a₄ a₆) ^ 3 + ι (C a₂) * (x / sf a₂ a₄ a₆) ^ 2 + ι (C a₄) * (x / sf a₂ a₄ a₆) + ι (C a₆) := by
  have hs0 := sf_ne_zero a₂ a₄ a₆
  have heq := (twist_nonsingular h2 hD x y).1 h
  have e : sf a₂ a₄ a₆ * (y / sf a₂ a₄ a₆ ^ 2) ^ 2 - ((x / sf a₂ a₄ a₆) ^ 3 +
      ι (C a₂) * (x / sf a₂ a₄ a₆) ^ 2 + ι (C a₄) * (x / sf a₂ a₄ a₆) + ι (C a₆)) =
      (y ^ 2 - (x ^ 3 + ι (C a₂) * sf a₂ a₄ a₆ * x ^ 2 + ι (C a₄) * sf a₂ a₄ a₆ ^ 2 * x +
        ι (C a₆) * sf a₂ a₄ a₆ ^ 3)) / sf a₂ a₄ a₆ ^ 3 := by
    field_simp
  rw [heq, sub_self, zero_div] at e
  exact sub_eq_zero.1 e

lemma P0_equation : (sf a₂ a₄ a₆ ^ 2) ^ 2 = (sf a₂ a₄ a₆ * ι X) ^ 3 +
    ι (C a₂) * sf a₂ a₄ a₆ * (sf a₂ a₄ a₆ * ι X) ^ 2 + ι (C a₄) * sf a₂ a₄ a₆ ^ 2 * (sf a₂ a₄ a₆ * ι X) +
      ι (C a₆) * sf a₂ a₄ a₆ ^ 3 := by
  have hs := sf_eq a₂ a₄ a₆
  linear_combination (sf a₂ a₄ a₆) ^ 3 * hs

/-- `P₀ = (st, s²)`, the point `(t, 1)` of `sY² = f(X)`. -/
noncomputable def P0 (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) : (twist a₂ a₄ a₆).toAffine.Point :=
  .some _ _ ((twist_nonsingular h2 hD _ _).2 P0_equation)

variable (a₂ a₄ a₆) in
/-- The degree of a point: the degree of the rational function `x/s`, and `0` at the point at infinity. -/
noncomputable def pdeg : (twist a₂ a₄ a₆).toAffine.Point → ℕ
  | .zero => 0
  | .some x _ _ => rdeg (x / sf a₂ a₄ a₆)

lemma pdeg_neg (P : (twist a₂ a₄ a₆).toAffine.Point) : pdeg a₂ a₄ a₆ (-P) = pdeg a₂ a₄ a₆ P := by
  rcases P with _ | ⟨x, y, h⟩
  · rfl
  · rfl

lemma pdeg_P0 (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) : pdeg a₂ a₄ a₆ (P0 h2 hD) = 1 := by
  simp only [P0, pdeg]
  rw [mul_div_cancel_left₀ _ (sf_ne_zero a₂ a₄ a₆), rdeg_algebraMap, natDegree_X]

lemma twist_negY (x y : RatFunc k) : (twist a₂ a₄ a₆).toAffine.negY x y = -y := by
  show -y - 0 * x - 0 = -y
  ring

lemma twist_addX (x₁ x₂ ℓ : RatFunc k) :
    (twist a₂ a₄ a₆).toAffine.addX x₁ x₂ ℓ = ℓ ^ 2 - ι (C a₂) * sf a₂ a₄ a₆ - x₁ - x₂ := by
  show ℓ ^ 2 + 0 * ℓ - ι (C a₂) * sf a₂ a₄ a₆ - x₁ - x₂ = _
  ring

lemma pdeg_zero : pdeg a₂ a₄ a₆ 0 = 0 := rfl

lemma ratFunc_two_ne_zero (h2 : (2 : k) ≠ 0) : (2 : RatFunc k) ≠ 0 := by
  have h := (map_ne_zero (algebraMap k (RatFunc k))).2 h2
  rwa [map_ofNat] at h

/-- **The identity in the coordinates `X = x/s`, `Y = y/s²`.** For points `(X₁, Y₁)` and `(X₂, Y₂)` of `sY² = f(X)`
with `X₁ ≠ X₂`, the degrees of the `X`-coordinates of their sum and difference add up to `2 deg X₁ + 2 deg X₂`. -/
lemma rdeg_vieta2 (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {X₁ Y₁ X₂ Y₂ : RatFunc k}
    (hY₁ : sf a₂ a₄ a₆ * Y₁ ^ 2 = X₁ ^ 3 + ι (C a₂) * X₁ ^ 2 + ι (C a₄) * X₁ + ι (C a₆))
    (hY₂ : sf a₂ a₄ a₆ * Y₂ ^ 2 = X₂ ^ 3 + ι (C a₂) * X₂ ^ 2 + ι (C a₄) * X₂ + ι (C a₆)) (hX : X₁ - X₂ ≠ 0) :
    rdeg (sf a₂ a₄ a₆ * (Y₁ - Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + ι (C a₂))) +
      rdeg (sf a₂ a₄ a₆ * (Y₁ + Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + ι (C a₂))) = 2 * rdeg X₁ + 2 * rdeg X₂ := by
  obtain ⟨V1, V2⟩ := vieta2 hY₁ hY₂ hX
  have hinj := IsFractionRing.injective k[X] (RatFunc k)
  have hv₁ : X₁.denom ≠ 0 := RatFunc.denom_ne_zero X₁
  have hv₂ : X₂.denom ≠ 0 := RatFunc.denom_ne_zero X₂
  have hv₁' : ι X₁.denom ≠ 0 := (map_ne_zero_iff _ hinj).2 hv₁
  have hv₂' : ι X₂.denom ≠ 0 := (map_ne_zero_iff _ hinj).2 hv₂
  have hu₁ : ι X₁.num = X₁ * ι X₁.denom := (div_eq_iff hv₁').1 (RatFunc.num_div_denom X₁)
  have hu₂ : ι X₂.num = X₂ * ι X₂.denom := (div_eq_iff hv₂').1 (RatFunc.num_div_denom X₂)
  set M := X₁.num * X₂.num with hM
  set S := X₁.denom * X₂.num + X₁.num * X₂.denom with hS
  set N := X₁.denom * X₂.denom with hN
  have e0 : ι (qf0 M S N) = (X₁ - X₂) ^ 2 * (ι X₁.denom * ι X₂.denom) ^ 2 := by
    simp only [qf0, hM, hS, hN, map_sub, map_mul, map_add, map_ofNat]
    rw [hu₁, hu₂]
    ring
  have e1 : ι (qf1 (C a₂) (C a₄) (C a₆) M S N) = (2 * (X₁ + X₂) * (X₁ * X₂ + ι (C a₄)) +
      4 * ι (C a₂) * X₁ * X₂ + 4 * ι (C a₆)) * (ι X₁.denom * ι X₂.denom) ^ 2 := by
    simp only [qf1, hM, hS, hN, map_mul, map_add, map_ofNat]
    rw [hu₁, hu₂]
    ring
  have e2 : ι (qf2 (C a₂) (C a₄) (C a₆) M S N) = ((X₁ * X₂ - ι (C a₄)) ^ 2 - 4 * ι (C a₆) * (X₁ + X₂) -
      4 * ι (C a₂) * ι (C a₆)) * (ι X₁.denom * ι X₂.denom) ^ 2 := by
    simp only [qf2, hM, hS, hN, map_sub, map_mul, map_add, map_pow, map_ofNat]
    rw [hu₁, hu₂]
    ring
  have hW0' : ι (qf0 M S N) ≠ 0 := by
    rw [e0]; exact mul_ne_zero (pow_ne_zero 2 hX) (pow_ne_zero 2 (mul_ne_zero hv₁' hv₂'))
  have hW0 : qf0 M S N ≠ 0 := fun h0 => hW0' (by rw [h0, map_zero])
  have hsum : sf a₂ a₄ a₆ * (Y₁ - Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + ι (C a₂)) +
      (sf a₂ a₄ a₆ * (Y₁ + Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + ι (C a₂))) =
        ι (qf1 (C a₂) (C a₄) (C a₆) M S N) / ι (qf0 M S N) := by
    rw [eq_div_iff hW0', e0, e1, ← V1]
    ring
  have hprod : (sf a₂ a₄ a₆ * (Y₁ - Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + ι (C a₂))) *
      (sf a₂ a₄ a₆ * (Y₁ + Y₂) ^ 2 / (X₁ - X₂) ^ 2 - (X₁ + X₂ + ι (C a₂))) =
        ι (qf2 (C a₂) (C a₄) (C a₆) M S N) / ι (qf0 M S N) := by
    rw [eq_div_iff hW0', e0, e2, ← V2]
    ring
  have hprim : Prim3 N S M := prim3_prod (RatFunc.isCoprime_num_denom X₁) (RatFunc.isCoprime_num_denom X₂)
  have hmax : max N.natDegree (max S.natDegree M.natDegree) = rdeg X₁ + rdeg X₂ :=
    max_natDegree_prod (Or.inr hv₁) (Or.inr hv₂)
  have hN0 : N ≠ 0 := mul_ne_zero hv₁ hv₂
  rw [rdeg_add_rdeg_of_vieta hW0 (prim3_qf h2 hD hprim) hsum hprod,
    max_natDegree_qf h2 hD (e := max N.natDegree (max S.natDegree M.natDegree))
      ((le_max_right _ _).trans (le_max_right _ _)) ((le_max_left _ _).trans (le_max_right _ _)) (le_max_left _ _)
      (coeff_max3_ne_zero hN0), hmax]
  ring

/-- A root of `f` in `k(t)` is a constant. -/
lemma rdeg_eq_zero_of_root {z : RatFunc k} (h : z ^ 3 + ι (C a₂) * z ^ 2 + ι (C a₄) * z + ι (C a₆) = 0) :
    rdeg z = 0 := by
  have hinj := IsFractionRing.injective k[X] (RatFunc k)
  have hv : z.denom ≠ 0 := RatFunc.denom_ne_zero z
  have hv' : ι z.denom ≠ 0 := (map_ne_zero_iff _ hinj).2 hv
  have hu : ι z.num = z * ι z.denom := (div_eq_iff hv').1 (RatFunc.num_div_denom z)
  have hF : z.num ^ 3 + C a₂ * z.num ^ 2 * z.denom + C a₄ * z.num * z.denom ^ 2 + C a₆ * z.denom ^ 3 = 0 := by
    apply hinj
    simp only [map_add, map_mul, map_pow, map_zero]
    rw [hu]
    linear_combination ι z.denom ^ 3 * h
  have hvu : z.denom ∣ z.num ^ 3 :=
    ⟨-(C a₂ * z.num ^ 2 + C a₄ * z.num * z.denom + C a₆ * z.denom ^ 2), by linear_combination hF⟩
  have hv0 : z.denom.natDegree = 0 :=
    natDegree_eq_zero_of_isUnit (((RatFunc.isCoprime_num_denom z).pow_left (m := 3)).isUnit_of_dvd' hvu dvd_rfl)
  have hu0 : z.num.natDegree = 0 := by
    by_contra hne
    have e1 : (z.num ^ 3).natDegree = 3 * z.num.natDegree := natDegree_pow _ _
    have e2 : z.num ^ 3 = -(z.denom * (C a₂ * z.num ^ 2 + C a₄ * z.num * z.denom + C a₆ * z.denom ^ 2)) := by
      linear_combination hF
    have b1 : (C a₂ * z.num ^ 2).natDegree ≤ 2 * z.num.natDegree :=
      (natDegree_C_mul_le _ _).trans (natDegree_pow_le.trans (by rw [mul_comm]))
    have b2 : (C a₄ * z.num * z.denom).natDegree ≤ 2 * z.num.natDegree :=
      natDegree_mul_le.trans (by rw [hv0]; have := natDegree_C_mul_le a₄ z.num; omega)
    have b3 : (C a₆ * z.denom ^ 2).natDegree ≤ 2 * z.num.natDegree :=
      (natDegree_C_mul_le _ _).trans (natDegree_pow_le.trans (by rw [hv0]; omega))
    have b : (z.denom * (C a₂ * z.num ^ 2 + C a₄ * z.num * z.denom + C a₆ * z.denom ^ 2)).natDegree ≤
        2 * z.num.natDegree :=
      natDegree_mul_le.trans (by
        rw [hv0, zero_add]
        exact (natDegree_add_le _ _).trans (max_le ((natDegree_add_le _ _).trans (max_le b1 b2)) b3))
    rw [e2, natDegree_neg] at e1
    omega
  show max z.num.natDegree z.denom.natDegree = 0
  rw [hu0, hv0]
  rfl

section group

variable [DecidableEq (RatFunc k)]

/-- **`deg 2P₀ = 4`**: `X(2P₀) = g(t)/4f(t)`. -/
lemma pdeg_two_P0 (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) :
    pdeg a₂ a₄ a₆ (P0 h2 hD + P0 h2 hD) = 4 := by
  have hs0 := sf_ne_zero a₂ a₄ a₆
  have h2' := ratFunc_two_ne_zero h2
  have hy : sf a₂ a₄ a₆ ^ 2 ≠ (twist a₂ a₄ a₆).toAffine.negY (sf a₂ a₄ a₆ * ι X) (sf a₂ a₄ a₆ ^ 2) := by
    rw [twist_negY]
    intro h
    have : 2 * sf a₂ a₄ a₆ ^ 2 = 0 := by linear_combination h
    exact mul_ne_zero h2' (pow_ne_zero 2 hs0) this
  have h4 : (4 : k) ≠ 0 := by
    have e : (4 : k) = 2 * 2 := by norm_num
    rw [e]; exact mul_ne_zero h2 h2
  have hx : (twist a₂ a₄ a₆).toAffine.addX (sf a₂ a₄ a₆ * ι X) (sf a₂ a₄ a₆ * ι X)
      ((twist a₂ a₄ a₆).toAffine.slope (sf a₂ a₄ a₆ * ι X) (sf a₂ a₄ a₆ * ι X) (sf a₂ a₄ a₆ ^ 2)
        (sf a₂ a₄ a₆ ^ 2)) / sf a₂ a₄ a₆ = ι (gpol a₂ a₄ a₆) / ι (C 4 * fpol a₂ a₄ a₆) := by
    rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hy, twist_addX, twist_negY]
    show (((3 * (sf a₂ a₄ a₆ * ι X) ^ 2 + 2 * (ι (C a₂) * sf a₂ a₄ a₆) * (sf a₂ a₄ a₆ * ι X) +
      ι (C a₄) * sf a₂ a₄ a₆ ^ 2 - 0 * sf a₂ a₄ a₆ ^ 2) / (sf a₂ a₄ a₆ ^ 2 - -sf a₂ a₄ a₆ ^ 2)) ^ 2 -
        ι (C a₂) * sf a₂ a₄ a₆ - sf a₂ a₄ a₆ * ι X - sf a₂ a₄ a₆ * ι X) / sf a₂ a₄ a₆ =
      ι (gpol a₂ a₄ a₆) / ι (C 4 * fpol a₂ a₄ a₆)
    have h4f : ι (C 4 * fpol a₂ a₄ a₆) = 4 * sf a₂ a₄ a₆ := by simp only [map_mul, map_ofNat, sf]
    have hg : ι (gpol a₂ a₄ a₆) = ι X ^ 4 - 2 * ι (C a₄) * ι X ^ 2 - 8 * ι (C a₆) * ι X + ι (C a₄) ^ 2 -
        4 * ι (C a₂) * ι (C a₆) := by
      simp only [gpol, map_add, map_sub, map_mul, map_pow, map_ofNat]
    rw [h4f, hg]
    exact double_div h2' hs0 (sf_eq a₂ a₄ a₆)
  unfold P0
  rw [WeierstrassCurve.Affine.Point.add_self_of_Y_ne hy]
  simp only [pdeg]
  rw [hx, rdeg_div ((isCoprime_C h4).mul_right (isCoprime_g_f hD))
    (mul_ne_zero (C_ne_zero.2 h4) (fpol_ne_zero a₂ a₄ a₆)), natDegree_gpol, natDegree_C_mul h4, natDegree_fpol]
  rfl

lemma P0_add_P0_ne_zero (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) : P0 (a₂ := a₂) (a₄ := a₄) (a₆ := a₆) h2 hD +
    P0 h2 hD ≠ 0 := fun h => by
  have := pdeg_two_P0 (a₂ := a₂) (a₄ := a₄) (a₆ := a₆) h2 hD
  rw [h, pdeg_zero] at this
  omega

/-- `deg(P + Q)` for points `P = (x₁, y₁)` and `Q = (x₂, y₂)` with `x₁ ≠ x₂`, in the coordinates `X = x/s`,
`Y = y/s²`. -/
lemma pdeg_some_add_some {x₁ y₁ x₂ y₂ : RatFunc k} (h₁ : (twist a₂ a₄ a₆).toAffine.Nonsingular x₁ y₁)
    (h₂ : (twist a₂ a₄ a₆).toAffine.Nonsingular x₂ y₂) (hx : x₁ ≠ x₂) :
    pdeg a₂ a₄ a₆ (.some x₁ y₁ h₁ + .some x₂ y₂ h₂) = rdeg (sf a₂ a₄ a₆ *
      (y₁ / sf a₂ a₄ a₆ ^ 2 - y₂ / sf a₂ a₄ a₆ ^ 2) ^ 2 / (x₁ / sf a₂ a₄ a₆ - x₂ / sf a₂ a₄ a₆) ^ 2 -
        (x₁ / sf a₂ a₄ a₆ + x₂ / sf a₂ a₄ a₆ + ι (C a₂))) := by
  rw [WeierstrassCurve.Affine.Point.add_of_X_ne hx]
  simp only [pdeg]
  rw [twist_addX, WeierstrassCurve.Affine.slope_of_X_ne hx, chord2_pos (sf_ne_zero a₂ a₄ a₆) (sub_ne_zero.2 hx)]

/-- `deg(P − Q)` for points `P = (x₁, y₁)` and `Q = (x₂, y₂)` with `x₁ ≠ x₂`. -/
lemma pdeg_some_sub_some {x₁ y₁ x₂ y₂ : RatFunc k} (h₁ : (twist a₂ a₄ a₆).toAffine.Nonsingular x₁ y₁)
    (h₂ : (twist a₂ a₄ a₆).toAffine.Nonsingular x₂ y₂) (hx : x₁ ≠ x₂) :
    pdeg a₂ a₄ a₆ (.some x₁ y₁ h₁ - .some x₂ y₂ h₂) = rdeg (sf a₂ a₄ a₆ *
      (y₁ / sf a₂ a₄ a₆ ^ 2 + y₂ / sf a₂ a₄ a₆ ^ 2) ^ 2 / (x₁ / sf a₂ a₄ a₆ - x₂ / sf a₂ a₄ a₆) ^ 2 -
        (x₁ / sf a₂ a₄ a₆ + x₂ / sf a₂ a₄ a₆ + ι (C a₂))) := by
  rw [sub_eq_add_neg, WeierstrassCurve.Affine.Point.neg_some, WeierstrassCurve.Affine.Point.add_of_X_ne hx]
  simp only [pdeg]
  rw [twist_addX, WeierstrassCurve.Affine.slope_of_X_ne hx, twist_negY,
    chord2_neg (sf_ne_zero a₂ a₄ a₆) (sub_ne_zero.2 hx)]

/-- `deg(P − P₀)` for a point `P = (x, y)` with `x ≠ st`, in the coordinates `X = x/s`, `Y = y/s²`. -/
lemma pdeg_some_sub_P0 (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {x y : RatFunc k}
    (h : (twist a₂ a₄ a₆).toAffine.Nonsingular x y) (hx : x ≠ sf a₂ a₄ a₆ * ι X) :
    pdeg a₂ a₄ a₆ (.some x y h - P0 h2 hD) = rdeg (sf a₂ a₄ a₆ * (y / sf a₂ a₄ a₆ ^ 2 + 1) ^ 2 /
      (x / sf a₂ a₄ a₆ - ι X) ^ 2 - (x / sf a₂ a₄ a₆ + ι X + ι (C a₂))) := by
  have hs0 := sf_ne_zero a₂ a₄ a₆
  unfold P0
  rw [pdeg_some_sub_some h _ hx, mul_div_cancel_left₀ _ hs0, div_self (pow_ne_zero 2 hs0)]

/-- **`deg(P + Q) + deg(P − Q) = 2 deg P + 2 deg Q`** for points with different `x`-coordinates. -/
theorem pdeg_add_add_pdeg_sub_of_X_ne (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {x₁ y₁ x₂ y₂ : RatFunc k}
    (h₁ : (twist a₂ a₄ a₆).toAffine.Nonsingular x₁ y₁) (h₂ : (twist a₂ a₄ a₆).toAffine.Nonsingular x₂ y₂)
    (hx : x₁ ≠ x₂) :
    pdeg a₂ a₄ a₆ (.some x₁ y₁ h₁ + .some x₂ y₂ h₂) + pdeg a₂ a₄ a₆ (.some x₁ y₁ h₁ - .some x₂ y₂ h₂) =
      2 * pdeg a₂ a₄ a₆ (.some x₁ y₁ h₁) + 2 * pdeg a₂ a₄ a₆ (.some x₂ y₂ h₂) := by
  have hs0 := sf_ne_zero a₂ a₄ a₆
  have hX : x₁ / sf a₂ a₄ a₆ - x₂ / sf a₂ a₄ a₆ ≠ 0 := by
    rw [div_sub_div_same]; exact div_ne_zero (sub_ne_zero.2 hx) hs0
  rw [pdeg_some_add_some h₁ h₂ hx, pdeg_some_sub_some h₁ h₂ hx]
  exact rdeg_vieta2 h2 hD (twist_YX h2 hD h₁) (twist_YX h2 hD h₂) hX

/-- **`deg 2P = 4 deg P`** for an affine point. -/
lemma pdeg_add_self_some (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) {x y : RatFunc k}
    (h : (twist a₂ a₄ a₆).toAffine.Nonsingular x y) :
    pdeg a₂ a₄ a₆ (.some x y h + .some x y h) = 4 * pdeg a₂ a₄ a₆ (.some x y h) := by
  by_cases hy : y = 0
  · -- a point of order 2: `X` is a root of `f`
    subst hy
    rw [WeierstrassCurve.Affine.Point.add_self_of_Y_eq (by rw [twist_negY, neg_zero])]
    have hroot := twist_YX h2 hD h
    rw [zero_div, zero_pow two_ne_zero, mul_zero] at hroot
    show 0 = 4 * rdeg (x / sf a₂ a₄ a₆)
    rw [rdeg_eq_zero_of_root hroot.symm]
  have hy' : y ≠ (twist a₂ a₄ a₆).toAffine.negY x y := by
    rw [twist_negY]
    intro h'
    apply hy
    have : 2 * y = 0 := by linear_combination h'
    exact (mul_eq_zero.1 this).resolve_left (ratFunc_two_ne_zero h2)
  have hPP : (.some x y h + .some x y h : (twist a₂ a₄ a₆).toAffine.Point) ≠ 0 := by
    rw [WeierstrassCurve.Affine.Point.add_self_of_Y_ne hy']
    exact WeierstrassCurve.Affine.Point.some_ne_zero _
  have h0 := (twist_nonsingular h2 hD _ _).2 (P0_equation (a₂ := a₂) (a₄ := a₄) (a₆ := a₆))
  have hP0 : P0 h2 hD = .some _ _ h0 := rfl
  by_cases hx : x = sf a₂ a₄ a₆ * ι X
  · -- `P = ±P₀`
    rcases (WeierstrassCurve.Affine.Point.X_eq_iff (h₁ := h) (h₂ := h0)).1 hx with hP | hP
    · rw [hP, ← hP0, pdeg_two_P0, pdeg_P0]
    · rw [hP, ← hP0, show -P0 (a₂ := a₂) (a₄ := a₄) (a₆ := a₆) h2 hD + -P0 h2 hD = -(P0 h2 hD + P0 h2 hD) by abel,
        pdeg_neg, pdeg_neg, pdeg_two_P0, pdeg_P0]
  · -- the case `x(P) ≠ x(P₀)`, applied to `(P, P₀)` and to `(P + P₀, P − P₀)`
    have k1 := pdeg_add_add_pdeg_sub_of_X_ne h2 hD h h0 hx
    rw [← hP0, pdeg_P0] at k1
    obtain ⟨x₁, y₁, h₁, e₁⟩ : ∃ x₁ y₁ h₁, (.some x y h : (twist a₂ a₄ a₆).toAffine.Point) + P0 h2 hD =
        .some x₁ y₁ h₁ := ⟨_, _, _, WeierstrassCurve.Affine.Point.add_of_X_ne hx⟩
    obtain ⟨x₂, y₂, h₂, e₂⟩ : ∃ x₂ y₂ h₂, (.some x y h : (twist a₂ a₄ a₆).toAffine.Point) - P0 h2 hD =
        .some x₂ y₂ h₂ := ⟨_, _, _, by
      rw [hP0, sub_eq_add_neg, WeierstrassCurve.Affine.Point.neg_some]
      exact WeierstrassCurve.Affine.Point.add_of_X_ne hx⟩
    have hx₁₂ : x₁ ≠ x₂ := by
      intro hxx
      rcases (WeierstrassCurve.Affine.Point.X_eq_iff (h₁ := h₁) (h₂ := h₂)).1 hxx with hc | hc
      · rw [← e₁, ← e₂] at hc
        apply P0_add_P0_ne_zero h2 hD
        rw [show P0 h2 hD + P0 h2 hD = (.some x y h + P0 h2 hD) - (.some x y h - P0 h2 hD) by abel, hc, sub_self]
      · rw [← e₁, ← e₂] at hc
        apply hPP
        rw [show (.some x y h + .some x y h : (twist a₂ a₄ a₆).toAffine.Point) =
          (.some x y h + P0 h2 hD) + (.some x y h - P0 h2 hD) by abel, hc, neg_add_cancel]
    have k2 := pdeg_add_add_pdeg_sub_of_X_ne h2 hD h₁ h₂ hx₁₂
    rw [← e₁, ← e₂, show (.some x y h + P0 h2 hD) + (.some x y h - P0 h2 hD) =
      (.some x y h + .some x y h : (twist a₂ a₄ a₆).toAffine.Point) by abel,
      show (.some x y h + P0 h2 hD) - (.some x y h - P0 h2 hD) = P0 (a₂ := a₂) (a₄ := a₄) (a₆ := a₆) h2 hD +
        P0 h2 hD by abel, pdeg_two_P0] at k2
    omega

/-- **`deg 2P = 4 deg P`.** -/
theorem pdeg_add_self (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) (P : (twist a₂ a₄ a₆).toAffine.Point) :
    pdeg a₂ a₄ a₆ (P + P) = 4 * pdeg a₂ a₄ a₆ P := by
  rcases P with _ | ⟨x, y, h⟩
  · rfl
  · exact pdeg_add_self_some h2 hD h

/-- **The parallelogram law**: `deg(P + Q) + deg(P − Q) = 2 deg P + 2 deg Q` for all points of the twist, so `deg` is
a quadratic form on them. -/
theorem pdeg_parallelogram (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) (P Q : (twist a₂ a₄ a₆).toAffine.Point) :
    pdeg a₂ a₄ a₆ (P + Q) + pdeg a₂ a₄ a₆ (P - Q) = 2 * pdeg a₂ a₄ a₆ P + 2 * pdeg a₂ a₄ a₆ Q := by
  rcases P with _ | ⟨x₁, y₁, h₁⟩
  · rw [← WeierstrassCurve.Affine.Point.zero_def, zero_add, zero_sub, pdeg_neg, pdeg_zero]
    omega
  rcases Q with _ | ⟨x₂, y₂, h₂⟩
  · rw [← WeierstrassCurve.Affine.Point.zero_def, add_zero, sub_zero, pdeg_zero]
    omega
  by_cases hx : x₁ = x₂
  · rcases (WeierstrassCurve.Affine.Point.X_eq_iff (h₁ := h₁) (h₂ := h₂)).1 hx with hP | hP
    · rw [hP, sub_self, pdeg_add_self h2 hD, pdeg_zero]
      omega
    · rw [hP, neg_add_cancel, show -(.some x₂ y₂ h₂ : (twist a₂ a₄ a₆).toAffine.Point) - .some x₂ y₂ h₂ =
        -(.some x₂ y₂ h₂ + .some x₂ y₂ h₂) by abel, pdeg_neg, pdeg_neg, pdeg_add_self h2 hD, pdeg_zero]
      omega
  · exact pdeg_add_add_pdeg_sub_of_X_ne h2 hD h₁ h₂ hx

/-- **`deg(P + P₀) + deg(P − P₀) = 2 deg P + 2`**, the parallelogram law along `P₀`. -/
theorem pdeg_add_add_pdeg_sub (h2 : (2 : k) ≠ 0) (hD : dsc a₂ a₄ a₆ ≠ 0) (P : (twist a₂ a₄ a₆).toAffine.Point) :
    pdeg a₂ a₄ a₆ (P + P0 h2 hD) + pdeg a₂ a₄ a₆ (P - P0 h2 hD) = 2 * pdeg a₂ a₄ a₆ P + 2 := by
  rw [pdeg_parallelogram h2 hD, pdeg_P0, mul_one]

end group

