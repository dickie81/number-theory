def eTN : List ℤ := [116263245619296, 581316228096315, 1743948684288862, 3737032894904657, 6228388158174401, 8493256579328714, 9799911437686972, 9799911437686972, 8646980680312039, 6826563694983197, 4876116924988010, 3180076255426977, 1908045753256203, 1060025418475687, 548289009556410, 265301133656349, 120591424389272, 51682039023997, 20952177982726, 8058529993382, 2948242680532, 1028456749050, 342818916378, 109410292489, 33492946709, 9850866708, 2787981174, 760358532, 200094381, 50871484, 12509413, 2978463, 687370, 153921, 33494, 7109, 1494, 332, 98, 52, 43, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42]

def qQ (n k : ℕ) : ℚ := ((qN.getD n []).getD k 0 : ℚ) / 2 ^ 128
def eU (n : ℕ) : ℚ := (eTN.getD n 0 : ℚ) / 2 ^ 128
def BU (n : ℕ) : ℚ := (15 / 2) ^ n / (n.factorial : ℚ)

def XN (n m : ℕ) : ℤ := ((List.range 40).map fun k => ((List.range 40).map fun l =>
  (qN.getD n []).getD k 0 * (qN.getD m []).getD l 0 * nuN.getD ((n + m) / 2 + k + l) 0).sum).sum

def aq (n : ℕ) : ℚ := ((List.range 40).map fun k => |qQ n k|).sum

def sg (n : ℕ) : ℚ := if n / 2 % 2 = 0 then 1 else -1

def eJU (n m : ℕ) : ℚ := BU n * eU m + (BU m + eU m) * eU n

def εwq : ℚ := 16 / 10 ^ 10

def R (n m : ℕ) (c : ℚ) : ℚ :=
  let Z : ℚ := (XN n m : ℚ) / 2 ^ 384
  let ulo : ℚ := 1 / WeilConst.phi
  let uhi : ℚ := 1 / WeilConst.plo
  let cl := fun k => (sqb.getD k (0, 0)).1
  let ch := fun k => (sqb.getD k (0, 0)).2
  let c' := sg n * sg m * c
  let a := 30 * ulo * cl n * cl m * Z
  let b := 30 * uhi * ch n * ch m * Z
  max |a - c'| |b - c'| + 30 * uhi * ch n * ch m * (56 * eJU n m + aq n * aq m * 128 / 2 ^ 128) + εwq

def rowOK (par : ℕ) (cq : List (List ℚ)) (εc : ℚ) (i : ℕ) : Bool :=
  (List.range 28).all fun j => decide (R (2 * i + par) (2 * j + par) (WeilTail.getq cq i j) ≤ εc)

end CmFin
