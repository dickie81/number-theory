/-- Kernel-checked certificate inequalities (exact rational arithmetic). -/
theorem even_chk : chk L05Tail.Mq L05Tail.Dq (7/62500000) 1 EvenQ.bq EvenQ.pq EvenQ.cq
    (487/10^25 - 12/10^30) = true := by decide +kernel
theorem odd_chk : chk L05Odd.Mq L05Odd.Dq (233/10000000) (-1) OddQ.bq OddQ.pq OddQ.cq
    (189/10^25 - 12/10^30) = true := by decide +kernel
theorem even_pchk : pchk EvenQ.pq = true := by decide +kernel
theorem odd_pchk : pchk OddQ.pq = true := by decide +kernel

lemma cast_lsum (n : ℕ) (f : ℕ → ℚ) : ((((List.range n).map f).sum : ℚ) : ℝ) = ∑ k ∈ range n, (f k : ℝ) := by
  induction n with
  | zero => simp
  | succ n ih => rw [List.range_succ, List.map_append, List.sum_append, Rat.cast_add, ih, sum_range_succ]; simp

lemma chk_spec {Mq Dq δ σ bq pq cq r} (h : chk Mq Dq δ σ bq pq cq r = true) {i j : ℕ} (hi : i < 28) (hj : j < 28) :
    |((Aq σ bq pq cq i j : ℚ) : ℝ) - ((certq Mq Dq δ i j : ℚ) : ℝ)| ≤ (r : ℝ) := by
  unfold chk at h
  have := List.all_eq_true.mp (List.all_eq_true.mp h i (List.mem_range.mpr hi)) j (List.mem_range.mpr hj)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  rw [abs_sub_le_iff]; constructor <;> [exact_mod_cast this.1; exact_mod_cast this.2]

lemma pchk_spec {pq} (h : pchk pq = true) {i : ℕ} (hi : i < 28) : |((pq.getD i 0 : ℚ) : ℝ)| ≤ 2 := by
  unfold pchk at h
  have := List.all_eq_true.mp h i (List.mem_range.mpr hi)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  rw [abs_le]; constructor <;> [exact_mod_cast this.2; exact_mod_cast this.1]

/-- `certMat` with the cast data is the cast of the rational `certq`. -/
lemma certMat_eq (Mq : List (List ℚ)) (Dq : List ℚ) (δ : ℚ) {i j : ℕ} (hi : i < 28) (hj : j < 28) :
    certMat 28 (fun k i => if h : k < 28 ∧ i < 28 then ((getq Mq k i : ℚ) : ℝ) else 0)
      (fun k => if k < 28 then ((Dq.getD k 0 : ℚ) : ℝ) else 0) (δ : ℝ) i j = ((certq Mq Dq δ i j : ℚ) : ℝ) := by
  unfold certMat certq
  rw [Rat.cast_add, cast_lsum]
  congr 1
  · refine sum_congr rfl (fun k hk => ?_)
    have hk' := mem_range.mp hk
    simp [hk', hi, hj]
  · split_ifs <;> simp

/-- **Named residual hypothesis (arb numerics), per-entry enclosures at `ε = 10⁻³⁰`.** Three families:
`β*`; the pole values `p_{2i+par}`; the digamma-weighted Bessel integrals `C^ψ`. -/
structure HeadEnc (par : ℕ) (bq : ℚ) (pq : List ℚ) (cq : List (List ℚ)) : Prop where
  beta : |βs - (bq : ℝ)| ≤ ε
  pole : ∀ i < 28, |pole (2 * i + par) - ((pq.getD i 0 : ℚ) : ℝ)| ≤ ε
  cm : ∀ i < 28, ∀ j < 28, |Cm wψ (2 * i + par) (2 * j + par) - ((getq cq i j : ℚ) : ℝ)| ≤ ε

lemma Rm_near {par : ℕ} {σ : ℚ} (hσ : |(σ:ℝ)| ≤ 1) {bq pq cq} (E : HeadEnc par bq pq cq)
    (hp : pchk pq = true) {i j : ℕ} (hi : i < 28) (hj : j < 28) :
    |Rm par (σ:ℝ) wψ βs i j - ((Aq σ bq pq cq i j : ℚ) : ℝ)| ≤ 12 * ε := by
  have hε : (0:ℝ) ≤ ε := by unfold ε; positivity
  have hε1 : ε ≤ 1 := by unfold ε; norm_num
  unfold Rm Aq
  push_cast
  set a := pole (2 * i + par); set b := pole (2 * j + par)
  set a' := ((pq.getD i 0 : ℚ) : ℝ); set b' := ((pq.getD j 0 : ℚ) : ℝ)
  have ha := E.pole i hi; have hb := E.pole j hj
  have ha' := pchk_spec hp hi; have hb' := pchk_spec hp hj
  have hbb : |b| ≤ 3 := by
    have := abs_sub_abs_le_abs_sub b b'; linarith
  have hprod : |a * b - a' * b'| ≤ 5 * ε := by
    rw [show a * b - a' * b' = (a - a') * b + a' * (b - b') by ring]
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_mul]
    nlinarith [abs_nonneg (a - a'), abs_nonneg (b - b'), abs_nonneg b, abs_nonneg a']
  have hc := E.cm i hi j hj
  have hβ : |(if i = j then βs else 0) - ((if i = j then bq else 0 : ℚ) : ℝ)| ≤ ε := by
    split_ifs
    · simpa using E.beta
    · simp [hε]
  have e : (if i = j then βs else 0) + (σ:ℝ) * 2 * a * b + Cm wψ (2 * i + par) (2 * j + par)
      - (((if i = j then bq else 0 : ℚ) : ℝ) + (σ:ℝ) * 2 * a' * b' + ((getq cq i j : ℚ) : ℝ))
      = ((if i = j then βs else 0) - ((if i = j then bq else 0 : ℚ) : ℝ)) + 2 * (σ:ℝ) * (a * b - a' * b')
        + (Cm wψ (2 * i + par) (2 * j + par) - ((getq cq i j : ℚ) : ℝ)) := by ring
  rw [e]
  refine (abs_add_three _ _ _).trans ?_
  have hY : |2 * (σ:ℝ) * (a * b - a' * b')| ≤ 10 * ε := by
    rw [abs_mul, abs_mul, abs_two]
    nlinarith [abs_nonneg (a * b - a' * b'), abs_nonneg (σ:ℝ)]
  linarith

theorem evenHead_of (E : HeadEnc 0 EvenQ.bq EvenQ.pq EvenQ.cq) : EvenHead := by
  intro i hi j hj
  have h1 := Rm_near (σ := 1) (by norm_num) E even_pchk hi hj
  have h2 := chk_spec even_chk hi hj
  have h3 := certMat_eq L05Tail.Mq L05Tail.Dq (7/62500000) hi hj
  have hM : L05Tail.Mn = fun k i => if h : k < 28 ∧ i < 28 then ((getq L05Tail.Mq k i : ℚ) : ℝ) else 0 := rfl
  have hD : L05Tail.Dn = fun k => if k < 28 then ((L05Tail.Dq.getD k 0 : ℚ) : ℝ) else 0 := by
    funext k; unfold L05Tail.Dn L05Tail.D; split_ifs <;> rfl
  have hδ : L05Tail.δ = ((7/62500000 : ℚ) : ℝ) := by unfold L05Tail.δ; norm_num
  rw [hM, hD, hδ, h3]
  push_cast at h1
  have hr : (((487/10^25 - 12/10^30 : ℚ)) : ℝ) = L05Tail.ρ - 12 * ε := by unfold L05Tail.ρ ε; push_cast; norm_num
  rw [hr] at h2
  calc _ ≤ |Rm 0 1 wψ βs i j - ((Aq 1 EvenQ.bq EvenQ.pq EvenQ.cq i j : ℚ) : ℝ)|
        + |((Aq 1 EvenQ.bq EvenQ.pq EvenQ.cq i j : ℚ) : ℝ) - ((certq L05Tail.Mq L05Tail.Dq (7/62500000) i j : ℚ) : ℝ)| :=
          abs_sub_le _ _ _
    _ ≤ 12 * ε + (L05Tail.ρ - 12 * ε) := add_le_add (by simpa using h1) h2
    _ = _ := by ring

theorem oddHead_of (E : HeadEnc 1 OddQ.bq OddQ.pq OddQ.cq) : OddHead := by
  intro i hi j hj
  have h1 := Rm_near (σ := -1) (by norm_num) E odd_pchk hi hj
  have h2 := chk_spec odd_chk hi hj
  have h3 := certMat_eq L05Odd.Mq L05Odd.Dq (233/10000000) hi hj
  have hM : L05Odd.Mn = fun k i => if h : k < 28 ∧ i < 28 then ((getq L05Odd.Mq k i : ℚ) : ℝ) else 0 := rfl
  have hD : L05Odd.Dn = fun k => if k < 28 then ((L05Odd.Dq.getD k 0 : ℚ) : ℝ) else 0 := by
    funext k; unfold L05Odd.Dn L05Odd.D; split_ifs <;> rfl
  have hδ : L05Odd.δ = ((233/10000000 : ℚ) : ℝ) := by unfold L05Odd.δ; norm_num
  rw [hM, hD, hδ, h3]
  push_cast at h1
  have hr : (((189/10^25 - 12/10^30 : ℚ)) : ℝ) = L05Odd.ρ - 12 * ε := by unfold L05Odd.ρ ε; push_cast; norm_num
  rw [hr] at h2
  calc _ ≤ |Rm 1 (-1) wψ βs i j - ((Aq (-1) OddQ.bq OddQ.pq OddQ.cq i j : ℚ) : ℝ)|
        + |((Aq (-1) OddQ.bq OddQ.pq OddQ.cq i j : ℚ) : ℝ) - ((certq L05Odd.Mq L05Odd.Dq (233/10000000) i j : ℚ) : ℝ)| :=
          abs_sub_le _ _ _
    _ ≤ 12 * ε + (L05Odd.ρ - 12 * ε) := add_le_add (by simpa using h1) h2
    _ = _ := by ring

/-- **Even sector, final.** Only input: the entrywise enclosure families `HeadEnc` (arb numerics). -/
theorem L05_even (E : HeadEnc 0 EvenQ.bq EvenQ.pq EvenQ.cq) (N : ℕ) (hN : 28 ≤ N)
    (x : ℕ → ℝ) (hx : ∃ i ∈ range N, x i ≠ 0) : 0 < WeilForm.weilQ (1 / 2) (WeilPlanch.fx N x) :=
  WeilArch.L05_even (evenHead_of E) N hN x hx

/-- **Odd sector, final** (frequency form). Only input: `HeadEnc` (arb numerics). -/
theorem L05_odd (E : HeadEnc 1 OddQ.bq OddQ.pq OddQ.cq) (N : ℕ) (hN : 28 ≤ N)
    (x : ℕ → ℝ) (hx : ∃ i ∈ range N, x i ≠ 0) : 0 < WeilZhuRed.QF 1 (-1) N x :=
  WeilFourier.L05_odd (oddHead_of E) N hN x hx

end WeilHead
