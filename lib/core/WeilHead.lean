import Mathlib
import WeilArch

/-! # The head certificates, kernel-checked over ℚ

`EvenHead`/`OddHead` say `|R_ij − C_ij| ≤ ρ` for `i, j < 28`, where `R = β*·I + 2σ p pᵀ + C^ψ` is the reduced
Zhu matrix and `C = MᵀDM + δI` the exact-rational LDLᵀ certificate. Here:
* the certificate side is checked by kernel evaluation over `ℚ` (`decide +kernel`, with nothing evaluated outside the kernel):
  `|A_ij − C_ij| ≤ ρ − (ε_β + 10ε_p + ε_c)` for the rational centre matrix `A = b̂·I + 2σ p̂ p̂ᵀ + ĉ`;
* the analytic side is reduced to three named families of entrywise enclosures with tolerances `ε_β = ε_p = 10⁻¹²`, `ε_c = 6·10⁻⁹` (even) and
  `ε_β = ε_p = 10⁻¹⁰`, `ε_c = 1.3·10⁻⁶` (odd); the certificate uses `δ ≈ 0.9 λ_min` and the Cauchy–Schwarz head bound `hρ`
  (`HeadEnc`): `β*`, the pole values `p_n` (`n < 56`, one parity), and the digamma-weighted Bessel integrals
  `C^ψ_{nm} = (1/π)∫₀³⁰ (Ψ_L − β*) T̂ₙT̂ₘ`.
-/

namespace WeilHead

open Finset WeilTail WeilTailB

noncomputable def ε : ℝ := 1 / 10 ^ 30

def certq (Mq : List (List ℚ)) (Dq : List ℚ) (δ : ℚ) (i j : ℕ) : ℚ :=
  ((List.range 28).map fun k => getq Mq k i * Dq.getD k 0 * getq Mq k j).sum + if i = j then δ else 0

def Aq (σ bq : ℚ) (pq : List ℚ) (cq : List (List ℚ)) (i j : ℕ) : ℚ :=
  (if i = j then bq else 0) + σ * 2 * pq.getD i 0 * pq.getD j 0 + getq cq i j

def chk (Mq : List (List ℚ)) (Dq : List ℚ) (δ σ bq : ℚ) (pq : List ℚ) (cq : List (List ℚ)) (r : ℚ) : Bool :=
  (List.range 28).all fun i => (List.range 28).all fun j =>
    decide (Aq σ bq pq cq i j - certq Mq Dq δ i j ≤ r) && decide (certq Mq Dq δ i j - Aq σ bq pq cq i j ≤ r)

def pchk (pq : List ℚ) : Bool := (List.range 28).all fun i => decide (pq.getD i 0 ≤ 2) && decide (-2 ≤ pq.getD i 0)

