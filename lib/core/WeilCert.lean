/-
# Finite-mode certificate for Weil positivity (Zhu convention)

General theorem `pos_of_cert`: entrywise closeness (within `ρ`) to `Mᵀ D M + δ I` with `D ≥ 0` and `n² ρ < δ`
implies positive definiteness. Concrete data at L = 1/2, 7/10, 4/5 (24 even sine modes, k odd ≤ 47) from an arb
ball-arithmetic run (`scripts/positivity/arbcert.py`, `certgen.py`). The link to the true Weil form is the explicit
hypothesis `WeilEnclosure.encl` (the arb claim), not proved in Lean. Positivity is proved only on the 24-dimensional
span of the modes, not for all test functions with that support.
-/
import Mathlib

namespace WeilCert

open Finset

/-- The certificate matrix `C = Mᵀ D M + δ I`. -/
def certMat {n : ℕ} (M : Fin n → Fin n → ℝ) (D : Fin n → ℝ) (δ : ℝ) (i j : Fin n) : ℝ :=
  (∑ k, M k i * D k * M k j) + if i = j then δ else 0

lemma quad_certMat {n : ℕ} (M : Fin n → Fin n → ℝ) (D : Fin n → ℝ) (δ : ℝ) (x : Fin n → ℝ) :
    ∑ i, ∑ j, x i * certMat M D δ i j * x j
      = (∑ k, D k * (∑ i, M k i * x i) ^ 2) + δ * ∑ i, x i ^ 2 := by
  have h1 : ∑ i, ∑ j, x i * (∑ k, M k i * D k * M k j) * x j
      = ∑ k, D k * (∑ i, M k i * x i) ^ 2 := by
    calc ∑ i, ∑ j, x i * (∑ k, M k i * D k * M k j) * x j
        = ∑ i, ∑ k, ∑ j, x i * (M k i * D k * M k j) * x j := by
          refine sum_congr rfl (fun i _ => ?_)
          simp only [mul_sum, sum_mul]
          exact sum_comm
      _ = ∑ k, ∑ i, ∑ j, x i * (M k i * D k * M k j) * x j := sum_comm
      _ = ∑ k, D k * (∑ i, M k i * x i) ^ 2 := by
          refine sum_congr rfl (fun k _ => ?_)
          simp only [sq, sum_mul, mul_sum]
          refine sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => ?_))
          ring
  have h2 : ∑ i, ∑ j, x i * (if i = j then δ else 0) * x j = δ * ∑ i, x i ^ 2 := by
    simp [mul_ite, ite_mul, mul_sum, sq]
    refine sum_congr rfl (fun i _ => ?_); ring
  rw [← h1, ← h2, ← sum_add_distrib]
  refine sum_congr rfl (fun i _ => ?_)
  rw [← sum_add_distrib]
  refine sum_congr rfl (fun j _ => ?_)
  simp only [certMat]; ring

/-- **Perturbation certificate.** If `A` is entrywise within `ρ` of `Mᵀ D M + δ I` with `D ≥ 0`
and `n² ρ < δ`, then the quadratic form of `A` is positive definite. -/
theorem pos_of_cert {n : ℕ} (A M : Fin n → Fin n → ℝ) (D : Fin n → ℝ) (δ ρ : ℝ)
    (hD : ∀ k, 0 ≤ D k) (hρ : (n : ℝ) ^ 2 * ρ < δ)
    (hA : ∀ i j, |A i j - certMat M D δ i j| ≤ ρ) (x : Fin n → ℝ) (hx : x ≠ 0) :
    0 < ∑ i, ∑ j, x i * A i j * x j := by
  set S := ∑ i, x i ^ 2 with hS
  obtain ⟨i0, hi0⟩ : ∃ i, x i ≠ 0 := by
    by_contra h; push Not at h; exact hx (funext h)
  have hSpos : 0 < S := by
    have : x i0 ^ 2 ≤ S := single_le_sum (f := fun i => x i ^ 2) (fun _ _ => sq_nonneg _) (mem_univ i0)
    have : 0 < x i0 ^ 2 := by positivity
    linarith
  have hρ0 : 0 ≤ ρ := le_trans (abs_nonneg _) (hA i0 i0)
  have hC : δ * S ≤ ∑ i, ∑ j, x i * certMat M D δ i j * x j := by
    rw [quad_certMat]
    have : 0 ≤ ∑ k, D k * (∑ i, M k i * x i) ^ 2 :=
      sum_nonneg (fun k _ => mul_nonneg (hD k) (sq_nonneg _))
    linarith
  have hxx : ∀ i j, |x i| * |x j| ≤ S := by
    intro i j
    have h1 : x i ^ 2 ≤ S := single_le_sum (f := fun i => x i ^ 2) (fun _ _ => sq_nonneg _) (mem_univ i)
    have h2 : x j ^ 2 ≤ S := single_le_sum (f := fun i => x i ^ 2) (fun _ _ => sq_nonneg _) (mem_univ j)
    have : |x i| * |x j| ≤ (x i ^ 2 + x j ^ 2) / 2 := by
      nlinarith [sq_nonneg (|x i| - |x j|), sq_abs (x i), sq_abs (x j)]
    linarith
  have hE : |∑ i, ∑ j, x i * (A i j - certMat M D δ i j) * x j| ≤ (n : ℝ) ^ 2 * ρ * S := by
    calc |∑ i, ∑ j, x i * (A i j - certMat M D δ i j) * x j|
        ≤ ∑ i, ∑ j, |x i * (A i j - certMat M D δ i j) * x j| := by
          refine (abs_sum_le_sum_abs _ _).trans (sum_le_sum (fun i _ => abs_sum_le_sum_abs _ _))
      _ ≤ ∑ i : Fin n, ∑ j : Fin n, ρ * S := by
          refine sum_le_sum (fun i _ => sum_le_sum (fun j _ => ?_))
          rw [abs_mul, abs_mul]
          have := hA i j
          calc |x i| * |A i j - certMat M D δ i j| * |x j|
              = |A i j - certMat M D δ i j| * (|x i| * |x j|) := by ring
            _ ≤ ρ * S := mul_le_mul this (hxx i j) (by positivity) hρ0
      _ = (n : ℝ) ^ 2 * ρ * S := by simp [sum_const, card_univ]; ring
  have split : ∑ i, ∑ j, x i * A i j * x j
      = ∑ i, ∑ j, x i * certMat M D δ i j * x j
        + ∑ i, ∑ j, x i * (A i j - certMat M D δ i j) * x j := by
    rw [← sum_add_distrib]; refine sum_congr rfl (fun i _ => ?_)
    rw [← sum_add_distrib]; refine sum_congr rfl (fun j _ => ?_); ring
  have hlow := neg_abs_le (∑ i, ∑ j, x i * (A i j - certMat M D δ i j) * x j)
  have : (n : ℝ) ^ 2 * ρ * S < δ * S := by nlinarith
  linarith


/-- **The arb hypothesis, stated explicitly.** `A i j` is meant to be the Weil form `Q(s_i, s_j)` in Zhu's convention
(eq. 17 of arXiv 2608.24827) on the orthonormal modes `s_k(u) = sin(kπ(u+L)/2L)/√L`, `k = 2i+1`. The field `encl`
records the claim, produced by a python-flint/arb ball-arithmetic computation, that each such entry lies within `ρ`
of the certificate matrix. Lean does not verify this claim. -/
structure WeilEnclosure {n : ℕ} (M : Fin n → Fin n → ℝ) (D : Fin n → ℝ) (δ ρ : ℝ) where
  A : Fin n → Fin n → ℝ
  encl : ∀ i j, |A i j - certMat M D δ i j| ≤ ρ

