/-
# The Frobenius dictionary for the orbit curve

Plain statement. Over `𝔽_q`, the Frobenius points `P_k` of Manin's twist, normalised by `q^{k/2}`, have Toeplitz Gram
matrix: the normalised traces `c_{|i−j|}` (`ManinHasse.toeplitz_nonneg`), the Riemann hypothesis for `E` in every
degree. For `ζ` the same holds along the orbit curve of `BallCurve`, with the Frobenius replaced by the flow `U_h` for
any step `h > 0`:
* the curve in log coordinates has a stationary Gram kernel, `⟨v_u, v_t⟩ = k(e^{t−u})` (`gram_v`);
* the samples `v_{nh}` form a `U_h`-orbit, `U_h v_{nh} = v_{(n+1)h}` (`sample_orbit`), the analogue of
  `ManinHasse.frobenius_similitude` with `h = log q`;
* so the Toeplitz forms `Σ x_i x_j k(e^{(i−j)h})` are nonnegative for every `h` and every real `x`
  (`toeplitz_nonneg`), the analogue of `ManinHasse.toeplitz_nonneg`.
Dictionary: `ℤ` (degrees `d`) ↔ `ℝ` (log scale `t`); `c_d` ↔ `k(e^t)`; Frobenius `φ` ↔ `U_{log q}`; one curve over
`𝔽_q` and all its extensions `𝔽_{q^n}` ↔ one step `h` and its multiples. What has no analogue here is integrality: the
twist's lattice is generated by `P_0` under `φ` inside an integral form, while for `ζ` no step `h` is distinguished.
-/
import Mathlib
import BallCurve

open Real Complex Finset ComplexConjugate
open scoped InnerProductSpace

noncomputable section

namespace BallFrobenius

open BallCurve

variable {k : ℝ → ℂ}

/-- **The Gram kernel of the curve in log coordinates is stationary**: `⟨v_u, v_t⟩ = k(e^{t−u})`. -/
theorem gram_v (C : CurveRealization k) (u t : ℝ) : ⟪C.v u, C.v t⟫_ℂ = k (Real.exp (t - u)) := by
  have hs : Real.sqrt (Real.exp t * Real.exp u) = Real.exp ((t + u) / 2) := by
    rw [← Real.exp_add, show t + u = (t + u) / 2 + (t + u) / 2 by ring, Real.exp_add, Real.sqrt_mul_self
      (Real.exp_pos _).le]
    ring_nf
  simp only [CurveRealization.v, inner_smul_left, inner_smul_right, Complex.conj_ofReal,
    C.gram _ _ (Real.exp_pos t) (Real.exp_pos u), hs, ← Real.exp_sub]
  rw [← mul_assoc, ← mul_assoc, ← Complex.ofReal_mul, ← Complex.ofReal_mul, ← Real.exp_add, ← Real.exp_add,
    show -t / 2 + -u / 2 + (t + u) / 2 = 0 by ring, Real.exp_zero, Complex.ofReal_one, one_mul]

/-- **The samples at step `h` are an orbit of `U_h`.** -/
theorem sample_orbit (C : CurveRealization k) (h : ℝ) (n : ℤ) : C.U h (C.v (n * h)) = C.v ((n + 1) * h) := by
  rw [← flow_orbit]
  congr 1
  ring

/-- **Toeplitz positivity at every step**: `Σ_{i,j} x_i x_j k(e^{(i−j)h}) ≥ 0` for real `x`. -/
theorem toeplitz_nonneg (C : CurveRealization k) (h : ℝ) (K : ℕ) (x : Fin K → ℝ) :
    0 ≤ (∑ i, ∑ j, ((x i * x j : ℝ) : ℂ) * k (Real.exp (((i : ℝ) - j) * h))).re := by
  set y : C.E := ∑ i, (x i : ℂ) • C.v (i * h)
  have e : ⟪y, y⟫_ℂ = ∑ i, ∑ j, ((x i * x j : ℝ) : ℂ) * k (Real.exp (((i : ℝ) - j) * h)) := by
    simp only [y, sum_inner, inner_sum, inner_smul_left, inner_smul_right, Complex.conj_ofReal, gram_v, mul_sum]
    refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
    rw [show (i : ℝ) * h - j * h = ((i : ℝ) - j) * h by ring]
    push_cast
    ring
  rw [← e]
  have := inner_self_nonneg (𝕜 := ℂ) (x := y)
  exact this

end BallFrobenius

#print axioms BallFrobenius.gram_v
#print axioms BallFrobenius.sample_orbit
#print axioms BallFrobenius.toeplitz_nonneg
