import Mathlib

/-!
# Representations of `gl_n`: extremal projectors, the Casimir and complete reducibility

A `GlRep K V n` is an action of `gl_n` on a `K`-vector space `V` by operators `E a b` with the commutation relations of
the matrix units, together with weight projections `comp μ` (`μ : Fin n → ℤ`) decomposing every vector into finitely
many weight vectors, on which `E a a` acts by `μ a`. `K` has characteristic `0` and `W ≤ V` is a finite-dimensional
subspace stable under every `E a b` (`Stable`); its weight components stay in it (`comp_mem`, a Lagrange interpolation
in the diagonal operators), and the off-diagonal operators are nilpotent on it (`exists_nil`).

**The extremal projector** (T5 of the L5/L6 spec). For `e = E a b`, `f = E b a` and a weight vector `y` of weight `μ`,
the rank-one factor `pfac a b N = Σ_k (−1)^k / C(N + k, k) · f^(k) e^(k)` satisfies `e · pfac(N) y = (μ_a − μ_b + 1 − N)
· pfac'(N) y` (`E_pfac`); with `N = μ_a − μ_b + 1` it lands in `ker e`. The rank-two lemma (`E_pfac_pfac`): for distinct
`a, c, d` and `E c d Z = 0`, `E c d · pfac_{ac}(μ_a − μ_c + s) pfac_{ad}(μ_a − μ_d + s + 1) Z = 0`, by the commutators
`[e₂, f₃] = f₁`, `[e₂, e₁] = −e₃` and the `sl_2` identities. The extremal projector of a sorted index list, `xproj (a ::
l) = rfac a l 1 · xproj l` with `rfac a [b₀, …] t = pfac_{ab₀}(· + t) pfac_{ab₁}(· + t + 1) ⋯`, is then killed by the
consecutive raising operators (`xproj_chain`, induction on the list with the rank-two lemma), hence by all of them
(`kill_of_chain`), moves vectors by lowering images (`xproj_sub_mem`) and fixes highest weight vectors (`xproj_of_hw`).
On a dominant weight space of `W` it is the projection onto the highest weight vectors along the lowering images
(`isHw_xproj`, `xproj_lowSp`).

**Complete reducibility** (the Casimir route). The Casimir `Σ E a b E b a` is central (`cas_comm`) and acts on the
submodule generated by a highest weight vector of weight `λ` by `casVal λ = Σ_a λ_a(λ_a + n − 1 − 2a)` (`cas_gen`); that
submodule is spanned by lowering words and has weights `≼ λ` in the dominance order (`dle_of_comp_ne`), with top weight
space `K·h` (`comp_mem_span`). `casVal` is strictly monotone on dominant weights (`casVal_lt`, Abel summation). Hence:
highest weight vectors generate `W` (`le_hwSum`, induction on the height with the extremal projector and the negative
weight lemma `mem_of_neg`); a highest weight vector of `W` in the lowering images is `0` (`hw_eq_zero_of_mem_lowSp`);
the isotypic parts `isoPart W λ` are independent (`isoPart_indep`) and exhaust `W` (`iSup_isoPart`). The type projector
`typeProj hW T` projects onto the isotypic parts of type in `T` along the others (and a complement of `W`); it is
equivariant on `W` (`typeProj_E`, `typeProj_comp`), commutes with every operator commuting with the action on `W`
(`typeProj_comm`), with the type projectors of a commuting action (`typeProj_comm_typeProj`), and on a dominant weight
space it is the extremal projector (`xproj_eq_typeProj`). Invariant forms vanishing on highest weight pairs of equal
weight vanish (`invForm_zero`).

**Isotypic projectors by averaging.** `restr` restricts `G` to `W`; `endRep` is the adjoint action on `End U` (`U`
finite-dimensional), and `avg = xproj₀ ∘ comp₀` there has invariant values (`avg_comm`), preserves stable operator
subspaces (`avg_mem`) and traces on stable subspaces (`trOn_avg`). For the highest weight projector `hwOp λ` of `W`,
`isoAvg λ = avg (hwOp λ)` acts on `U·h` by `1 / dim U·h` (`isoAvg_on_gen`, a trace computation), kills the other highest
weight modules (`isoAvg_kill`), and `typeProj {λ} = d · isoAvg λ` on `W` with `d ∈ ℕ` (`isoAvg_spec`). This formula, a
product of `2·C(n, 2)` rank-one factors, gives the integrality of `IsoProjectors`.
-/

open Finset

noncomputable section

/-- **A representation of `gl_n`** on `V`: operators `E a b` with `[E a b, E c d] = δ_bc E a d − δ_da E c b`, and weight
projections `comp μ`, complete orthogonal idempotents with finite support on each vector, `E a a = μ a` on the range
of `comp μ`, and `E a b` moving weight `μ` to `μ + e_a − e_b`. -/
structure GlRep (K V : Type*) [Field K] [AddCommGroup V] [Module K V] (n : ℕ) where
  /-- **The matrix units.** -/
  E : Fin n → Fin n → Module.End K V
  comm : ∀ a b c d, E a b * E c d - E c d * E a b = (if b = c then E a d else 0) - (if d = a then E c b else 0)
  /-- **The weight projections.** -/
  comp : (Fin n → ℤ) → Module.End K V
  comp_mul : ∀ μ ν, comp μ * comp ν = if μ = ν then comp ν else 0
  exists_sum : ∀ x, ∃ s : Finset (Fin n → ℤ), (∀ μ ∉ s, comp μ x = 0) ∧ ∑ μ ∈ s, comp μ x = x
  diag_comp : ∀ μ a, E a a * comp μ = (μ a : K) • comp μ
  comp_E : ∀ μ a b, comp μ * E a b = E a b * comp (μ - (Pi.single a 1 - Pi.single b 1))

namespace GlRep

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {n : ℕ} (G : GlRep K V n)

/-- **The root `e_a − e_b`.** -/
def rt (a b : Fin n) : Fin n → ℤ := Pi.single a 1 - Pi.single b 1

theorem rt_self (a : Fin n) : rt a a = 0 := sub_self _

theorem rt_apply (a b c : Fin n) : rt a b c = (if c = a then 1 else 0) - (if c = b then 1 else 0) := by
  simp [rt, Pi.single_apply]

/-- **Weight vectors**: `x` has weight `μ` when `comp μ x = x`. -/
def IsWt (μ : Fin n → ℤ) (x : V) : Prop := G.comp μ x = x

/-- **Highest weight vectors** of weight `μ`: weight vectors killed by every raising operator `E a b`, `a < b`. -/
def IsHw (μ : Fin n → ℤ) (x : V) : Prop := G.IsWt μ x ∧ ∀ a b, a < b → G.E a b x = 0

/-- **Stable subspaces**: stable under every `E a b`. -/
def Stable (W : Submodule K V) : Prop := ∀ a b, ∀ x ∈ W, G.E a b x ∈ W

theorem comm_apply (a b c d : Fin n) (x : V) : G.E a b (G.E c d x) =
    G.E c d (G.E a b x) + ((if b = c then G.E a d x else 0) - (if d = a then G.E c b x else 0)) := by
  have h := congrArg (fun T : Module.End K V => T x) (G.comm a b c d)
  simp only [LinearMap.sub_apply, Module.End.mul_apply] at h
  rw [eq_add_of_sub_eq h, add_comm]; congr 1; split_ifs <;> simp

/-- **Matrix units with `b ≠ c` and `d ≠ a` commute.** -/
theorem E_comm {a b c d : Fin n} (h1 : b ≠ c) (h2 : d ≠ a) : G.E a b * G.E c d = G.E c d * G.E a b := by
  have h := G.comm a b c d
  rw [ite_eq_right h1, ite_eq_right h2, sub_zero] at h
  exact sub_eq_zero.mp h

theorem comp_comp (μ ν : Fin n → ℤ) (x : V) : G.comp μ (G.comp ν x) = if μ = ν then G.comp ν x else 0 := by
  have h := congrArg (fun T : Module.End K V => T x) (G.comp_mul μ ν)
  simp only [Module.End.mul_apply] at h
  rw [h]; split_ifs <;> simp

theorem isWt_comp (μ : Fin n → ℤ) (x : V) : G.IsWt μ (G.comp μ x) := by
  simp [IsWt, comp_comp]

theorem comp_of_isWt {μ : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (ν : Fin n → ℤ) :
    G.comp ν x = if ν = μ then x else 0 := by
  rw [← hx, comp_comp]

theorem comp_of_isWt_ne {μ ν : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (h : ν ≠ μ) : G.comp ν x = 0 := by
  rw [G.comp_of_isWt hx, ite_eq_right h]

theorem isWt_zero (μ : Fin n → ℤ) : G.IsWt μ (0 : V) := by simp [IsWt]

variable {G} in
theorem IsWt.add {μ : Fin n → ℤ} {x y : V} (hx : G.IsWt μ x) (hy : G.IsWt μ y) : G.IsWt μ (x + y) := by
  simp only [IsWt, map_add]; rw [hx, hy]

variable {G} in
theorem IsWt.smul {μ : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (c : K) : G.IsWt μ (c • x) := by
  simp only [IsWt, map_smul]; rw [hx]

variable {G} in
theorem IsWt.sum {ι : Type*} {s : Finset ι} {μ : Fin n → ℤ} {x : ι → V} (hx : ∀ i ∈ s, G.IsWt μ (x i)) :
    G.IsWt μ (∑ i ∈ s, x i) := by
  simp only [IsWt, map_sum]; exact Finset.sum_congr rfl hx

theorem diag_apply {μ : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (a : Fin n) : G.E a a x = (μ a : K) • x := by
  have h := congrArg (fun T : Module.End K V => T x) (G.diag_comp μ a)
  simp only [Module.End.mul_apply, LinearMap.smul_apply] at h
  rwa [hx] at h

theorem comp_E_apply (μ : Fin n → ℤ) (a b : Fin n) (x : V) :
    G.comp μ (G.E a b x) = G.E a b (G.comp (μ - rt a b) x) := by
  simpa [rt] using congrArg (fun T : Module.End K V => T x) (G.comp_E μ a b)

variable {G} in
theorem IsWt.E_apply {μ : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (a b : Fin n) : G.IsWt (μ + rt a b) (G.E a b x) := by
  rw [IsWt, comp_E_apply, add_sub_cancel_right, hx]

variable {G} in
theorem IsWt.E_pow {μ : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (a b : Fin n) (k : ℕ) :
    G.IsWt (μ + (k : ℤ) • rt a b) ((G.E a b ^ k) x) := by
  induction k with
  | zero => simpa using hx
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply]
    have key : μ + ((k + 1 : ℕ) : ℤ) • rt a b = μ + (k : ℤ) • rt a b + rt a b := by
      push_cast; rw [add_smul, one_smul, add_assoc]
    rw [key]; exact ih.E_apply a b

/-- **The diagonal operators commute with the weight projections.** -/
theorem comp_diag (μ : Fin n → ℤ) (a : Fin n) (x : V) : G.comp μ (G.E a a x) = (μ a : K) • G.comp μ x := by
  rw [comp_E_apply, rt_self, sub_zero]
  exact G.diag_apply (G.isWt_comp μ x) a

/-- **A vector on which every `E a a` acts by `ν a` has weight `ν`.** -/
theorem isWt_of_diag [CharZero K] {ν : Fin n → ℤ} {x : V} (h : ∀ a, G.E a a x = (ν a : K) • x) : G.IsWt ν x := by
  have hz : ∀ μ, μ ≠ ν → G.comp μ x = 0 := by
    intro μ hμ
    obtain ⟨a, ha⟩ := Function.ne_iff.mp hμ
    have h1 := G.comp_diag μ a x
    rw [h a, map_smul] at h1
    have h2 : ((ν a : K) - μ a) • G.comp μ x = 0 := by rw [sub_smul, h1, sub_self]
    rcases smul_eq_zero.mp h2 with h3 | h3
    · exact absurd (by exact_mod_cast (sub_eq_zero.mp h3).symm) ha
    · exact h3
  obtain ⟨s, hs0, hs⟩ := G.exists_sum x
  rw [IsWt]
  conv_rhs => rw [← hs]
  by_cases hν : ν ∈ s
  · rw [Finset.sum_eq_single ν (fun μ _ hμ => hz μ hμ) (fun h => absurd hν h)]
  · rw [hs0 ν hν, Finset.sum_eq_zero (fun μ hμ => hz μ (fun h => hν (h ▸ hμ)))]

/-- **The sum of the weight components over any finite set containing the support is the vector.** -/
theorem sum_comp_of_supp {x : V} {s : Finset (Fin n → ℤ)} (hs : ∀ μ ∉ s, G.comp μ x = 0) :
    ∑ μ ∈ s, G.comp μ x = x := by
  obtain ⟨t, ht0, ht⟩ := G.exists_sum x
  conv_rhs => rw [← ht]
  rw [← Finset.sum_subset (Finset.inter_subset_left (s₁ := s) (s₂ := t)) (fun μ _ h => by
      by_cases hμ : μ ∈ t
      · exact absurd (Finset.mem_inter.mpr ⟨‹μ ∈ s›, hμ⟩) h
      · exact ht0 μ hμ),
    ← Finset.sum_subset (Finset.inter_subset_right (s₁ := s) (s₂ := t)) (fun μ _ h => by
      by_cases hμ : μ ∈ s
      · exact absurd (Finset.mem_inter.mpr ⟨hμ, ‹μ ∈ t›⟩) h
      · exact hs μ hμ)]

/-- **The support of a vector**: the weights of its nonzero components. -/
theorem supp_finite (x : V) : {μ | G.comp μ x ≠ 0}.Finite := by
  obtain ⟨s, hs0, -⟩ := G.exists_sum x
  exact s.finite_toSet.subset fun μ hμ => by
    by_contra h; exact hμ (hs0 μ h)

/-- **Two vectors with the same components are equal.** -/
theorem ext_comp {x y : V} (h : ∀ μ, G.comp μ x = G.comp μ y) : x = y := by
  obtain ⟨s, hs0, hs⟩ := G.exists_sum (x - y)
  have : ∀ μ, G.comp μ (x - y) = 0 := fun μ => by rw [map_sub, h, sub_self]
  rw [← sub_eq_zero, ← hs, Finset.sum_eq_zero (fun μ _ => this μ)]

theorem rt_apply_left {a b : Fin n} (hab : a ≠ b) : rt a b a = 1 := by simp [rt_apply, hab]

theorem rt_apply_right {a b : Fin n} (hab : a ≠ b) : rt a b b = -1 := by simp [rt_apply, Ne.symm hab]

theorem rt_apply_other {a b c : Fin n} (hca : c ≠ a) (hcb : c ≠ b) : rt a b c = 0 := by simp [rt_apply, hca, hcb]

variable {G} in
theorem Stable.pow_mem {W : Submodule K V} (hW : G.Stable W) (a b : Fin n) (k : ℕ) {x : V} (hx : x ∈ W) :
    (G.E a b ^ k) x ∈ W := by
  induction k with
  | zero => simpa using hx
  | succ k ih => rw [pow_succ', Module.End.mul_apply]; exact hW a b _ ih

section Stable

variable [CharZero K]

omit [CharZero K] in
theorem comp_diag_sub (μ : Fin n → ℤ) (a : Fin n) (c : K) (y : V) :
    G.comp μ (G.E a a y - c • y) = ((μ a : K) - c) • G.comp μ y := by
  rw [map_sub, map_smul, comp_diag, sub_smul]

/-- **Stable subspaces are spanned by weight vectors**: the weight components of a vector of a stable subspace lie
in it (a Lagrange interpolation in the diagonal operators). -/
theorem comp_mem {W : Submodule K V} (hW : G.Stable W) (μ : Fin n → ℤ) {x : V} (hx : x ∈ W) : G.comp μ x ∈ W := by
  have key : ∀ t : Finset (Fin n → ℤ), μ ∉ t → ∃ y ∈ W, G.comp μ y = G.comp μ x ∧ (∀ ν ∈ t, G.comp ν y = 0) ∧
      ∀ ν, G.comp ν x = 0 → G.comp ν y = 0 := by
    intro t
    induction t using Finset.induction_on with
    | empty => intro _; exact ⟨x, hx, rfl, by simp, fun ν h => h⟩
    | insert ν t hνt ih =>
      intro hμ
      obtain ⟨y, hyW, hyμ, hyt, hy0⟩ := ih (fun h => hμ (Finset.mem_insert_of_mem h))
      have hne : ν ≠ μ := fun h => hμ (h ▸ Finset.mem_insert_self ν t)
      obtain ⟨a, ha⟩ := Function.ne_iff.mp hne
      have hd : ((μ a : K) - ν a) ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast (Ne.symm ha))
      refine ⟨((μ a : K) - ν a)⁻¹ • (G.E a a y - (ν a : K) • y),
        W.smul_mem _ (W.sub_mem (hW a a y hyW) (W.smul_mem _ hyW)), ?_, ?_, ?_⟩
      · rw [map_smul, comp_diag_sub, hyμ, smul_smul, inv_mul_cancel₀ hd, one_smul]
      · intro ν' hν'
        rw [map_smul, comp_diag_sub]
        rcases Finset.mem_insert.mp hν' with rfl | h
        · rw [sub_self, zero_smul, smul_zero]
        · rw [hyt ν' h, smul_zero, smul_zero]
      · intro ν' h
        rw [map_smul, comp_diag_sub, hy0 ν' h, smul_zero, smul_zero]
  obtain ⟨y, hyW, hyμ, hyt, hy0⟩ := key ((G.supp_finite x).toFinset.erase μ) (Finset.notMem_erase μ _)
  have : y = G.comp μ x := by
    refine G.ext_comp fun ν => ?_
    rw [comp_comp]
    split_ifs with h
    · rw [h, hyμ]
    · by_cases hν : G.comp ν x = 0
      · exact hy0 ν hν
      · exact hyt ν (Finset.mem_erase.mpr ⟨h, by simpa using hν⟩)
  exact this ▸ hyW

/-- **The weights of a subspace.** -/
def wts (W : Submodule K V) : Set (Fin n → ℤ) := {μ | ∃ x ∈ W, G.comp μ x ≠ 0}

omit [CharZero K] in
theorem mem_wts_of_isWt {W : Submodule K V} {μ : Fin n → ℤ} {x : V} (hx : x ∈ W) (hμ : G.IsWt μ x) (h0 : x ≠ 0) :
    μ ∈ G.wts W := ⟨x, hx, by rwa [hμ]⟩

omit [CharZero K] in
/-- **A finite-dimensional subspace has finitely many weights.** -/
theorem wts_finite (W : Submodule K V) [FiniteDimensional K W] : (G.wts W).Finite := by
  obtain ⟨S, hS⟩ := (Submodule.fg_iff_finiteDimensional W).mpr ‹_›
  refine (S.finite_toSet.biUnion fun s _ => G.supp_finite s).subset ?_
  rintro μ ⟨x, hx, hμ⟩
  by_contra h
  simp only [Set.mem_iUnion, not_exists] at h
  have : (S : Set V) ⊆ LinearMap.ker (G.comp μ) := fun s hs => LinearMap.mem_ker.mpr (by simpa using h s hs)
  rw [← hS] at hx
  exact hμ (LinearMap.mem_ker.mp (Submodule.span_le.mpr this hx))

/-- **Nilpotency from the spread**: if the weights `μ` of `W` have `μ a − μ b ≤ L`, then `E a b ^ (L + 1)` vanishes
on `W` (`a ≠ b`). -/
theorem pow_E_eq_zero {W : Submodule K V} (hW : G.Stable W) {L : ℕ} (hL : ∀ μ ∈ G.wts W, ∀ a b, μ a - μ b ≤ L)
    {a b : Fin n} (hab : a ≠ b) {x : V} (hx : x ∈ W) : (G.E a b ^ (L + 1)) x = 0 := by
  have hpow : ∀ k, ∀ y ∈ W, (G.E a b ^ k) y ∈ W := fun k y hy => hW.pow_mem a b k hy
  obtain ⟨s, hs0, hs⟩ := G.exists_sum x
  rw [← hs, map_sum]
  refine Finset.sum_eq_zero fun ν _ => ?_
  by_contra hne
  have hy := G.isWt_comp ν x
  have h1 := hL _ (G.mem_wts_of_isWt (hpow _ _ (G.comp_mem hW ν hx)) (hy.E_pow a b (L + 1)) hne) a b
  have h2 := hL ν (G.mem_wts_of_isWt (G.comp_mem hW ν hx) hy (fun h => hne (by rw [h, map_zero]))) b a
  simp only [Pi.add_apply, Pi.smul_apply, rt_apply_left hab, rt_apply_right hab, smul_eq_mul] at h1
  push_cast at h1
  linarith

omit [CharZero K] in
/-- **A finite-dimensional subspace has a spread bound.** -/
theorem exists_spread (W : Submodule K V) [FiniteDimensional K W] :
    ∃ L : ℕ, ∀ μ ∈ G.wts W, ∀ a b, μ a - μ b ≤ L := by
  obtain ⟨L, hL⟩ := ((G.wts_finite W).image fun μ => ∑ a, ∑ b, (μ a - μ b).toNat).bddAbove
  refine ⟨L, fun μ hμ a b => ?_⟩
  have h : ∑ a, ∑ b, (μ a - μ b).toNat ≤ L := hL ⟨μ, hμ, rfl⟩
  have h1 : (μ a - μ b).toNat ≤ ∑ a, ∑ b, (μ a - μ b).toNat :=
    (Finset.single_le_sum (f := fun b => (μ a - μ b).toNat) (fun _ _ => Nat.zero_le _) (Finset.mem_univ b)).trans
      (Finset.single_le_sum (f := fun a => ∑ b, (μ a - μ b).toNat) (fun _ _ => Nat.zero_le _) (Finset.mem_univ a))
  have h2 := Int.self_le_toNat (μ a - μ b)
  omega

end Stable

/-! ## Divided powers and the `sl_2` identities -/

/-- **Divided powers** `T^k/k!`. -/
def dpow (T : Module.End K V) (k : ℕ) : Module.End K V := ((k.factorial : K)⁻¹) • T ^ k

theorem dpow_zero (T : Module.End K V) : dpow T 0 = 1 := by simp [dpow]

theorem dpow_one (T : Module.End K V) : dpow T 1 = T := by simp [dpow]

theorem dpow_succ [CharZero K] (T : Module.End K V) (k : ℕ) :
    ((k + 1 : ℕ) : K) • dpow T (k + 1) = T * dpow T k := by
  simp only [dpow, Nat.factorial_succ, Nat.cast_mul, smul_smul, mul_inv, pow_succ', Algebra.mul_smul_comm]
  rw [← mul_assoc, mul_inv_cancel₀ (by exact_mod_cast Nat.succ_ne_zero k), one_mul]

theorem dpow_succ' [CharZero K] (T : Module.End K V) (k : ℕ) :
    ((k + 1 : ℕ) : K) • dpow T (k + 1) = dpow T k * T := by
  rw [dpow_succ]; simp only [dpow, Algebra.smul_mul_assoc, Algebra.mul_smul_comm, ← pow_succ, ← pow_succ']

/-- **Moving an operator past a power**: if `T S = S T + U` and `U` commutes with `S`, then
`T S^(k+1) = S^(k+1) T + (k + 1) S^k U`. -/
theorem mul_pow_succ (T S U : Module.End K V) (h1 : T * S = S * T + U) (h2 : U * S = S * U) (k : ℕ) :
    T * S ^ (k + 1) = S ^ (k + 1) * T + ((k + 1 : ℕ) : K) • (S ^ k * U) := by
  induction k with
  | zero => simp [h1]
  | succ k ih =>
    calc T * S ^ (k + 1 + 1) = (T * S ^ (k + 1)) * S := by rw [mul_assoc, ← pow_succ]
      _ = S ^ (k + 1) * (T * S) + ((k + 1 : ℕ) : K) • (S ^ k * (U * S)) := by
          rw [ih, add_mul, mul_assoc, Algebra.smul_mul_assoc, mul_assoc]
      _ = S ^ (k + 1 + 1) * T + ((k + 1 + 1 : ℕ) : K) • (S ^ (k + 1) * U) := by
          rw [h1, h2, mul_add, ← mul_assoc, ← pow_succ, ← mul_assoc, ← pow_succ, add_assoc]
          push_cast; module

/-- **Moving an operator past a divided power.** -/
theorem mul_dpow_succ [CharZero K] (T S U : Module.End K V) (h1 : T * S = S * T + U) (h2 : U * S = S * U)
    (k : ℕ) : T * dpow S (k + 1) = dpow S (k + 1) * T + dpow S k * U := by
  simp only [dpow, Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
  rw [mul_pow_succ T S U h1 h2, smul_add, smul_smul, Nat.factorial_succ, Nat.cast_mul, mul_inv, mul_comm,
    mul_assoc, inv_mul_cancel₀ (by exact_mod_cast Nat.succ_ne_zero k), mul_one]

/-- **The divided powers of commuting operators commute.** -/
theorem dpow_comm {S T : Module.End K V} (h : S * T = T * S) (j k : ℕ) :
    dpow S j * dpow T k = dpow T k * dpow S j := by
  simp only [dpow, Algebra.smul_mul_assoc, Algebra.mul_smul_comm, smul_smul, mul_comm (j.factorial : K)⁻¹]
  rw [((Commute.pow_pow h j k).eq)]

theorem E_dpow_comm {a b c d : Fin n} (h1 : b ≠ c) (h2 : d ≠ a) (j k : ℕ) :
    dpow (G.E a b) j * dpow (G.E c d) k = dpow (G.E c d) k * dpow (G.E a b) j :=
  dpow_comm (G.E_comm h1 h2) j k

variable {G} in
theorem IsWt.dpow {μ : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (a b : Fin n) (k : ℕ) :
    G.IsWt (μ + (k : ℤ) • rt a b) (GlRep.dpow (G.E a b) k x) := by
  simp only [GlRep.dpow, LinearMap.smul_apply]; exact (hx.E_pow a b k).smul _

theorem pow_succ_apply (T : Module.End K V) (k : ℕ) (x : V) : (T ^ (k + 1)) x = T ((T ^ k) x) := by
  rw [pow_succ', Module.End.mul_apply]

/-- **The bracket `[E a b**, E b a] = E a a − E b b`, applied. -/
theorem comm_apply_ba (a b : Fin n) (x : V) :
    G.E a b (G.E b a x) = G.E b a (G.E a b x) + (G.E a a x - G.E b b x) := by
  rw [comm_apply]; simp

/-- **The `sl_2` identity** `e f^(j+1) = f^(j+1) e + (j + 1)(h − j) f^j` on a weight vector (`e = E a b`,
`f = E b a`, `h = μ a − μ b`). -/
theorem E_pow_succ [CharZero K] {a b : Fin n} (hab : a ≠ b) {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (j : ℕ) :
    G.E a b ((G.E b a ^ (j + 1)) y) = (G.E b a ^ (j + 1)) (G.E a b y) +
      (((j + 1 : ℕ) : K) * ((μ a - μ b : ℤ) - j)) • (G.E b a ^ j) y := by
  induction j with
  | zero =>
    rw [pow_succ_apply, pow_zero, Module.End.one_apply, comm_apply_ba, G.diag_apply hy, G.diag_apply hy,
      ← sub_smul]
    congr 2; push_cast; ring
  | succ j ih =>
    have hw := hy.E_pow b a (j + 1)
    rw [pow_succ_apply (G.E b a) (j + 1) y, comm_apply_ba, ih, G.diag_apply hw, G.diag_apply hw, map_add,
      map_smul, ← pow_succ_apply, ← pow_succ_apply, add_assoc, ← sub_smul, ← add_smul]
    congr 2
    simp only [Pi.add_apply, Pi.smul_apply, rt_apply_left (Ne.symm hab), rt_apply_right (Ne.symm hab),
      smul_eq_mul]
    push_cast; ring

/-- **The `sl_2` identity with divided powers**: `e f^(j+1) = f^(j+1) e + (h − j) f^(j)` on a weight vector. -/
theorem E_dpow_succ [CharZero K] {a b : Fin n} (hab : a ≠ b) {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (j : ℕ) :
    G.E a b (dpow (G.E b a) (j + 1) y) = dpow (G.E b a) (j + 1) (G.E a b y) +
      (((μ a - μ b : ℤ) : K) - j) • dpow (G.E b a) j y := by
  simp only [dpow, LinearMap.smul_apply, map_smul, E_pow_succ G hab hy, smul_add, smul_smul]
  congr 2
  have hj : ((j + 1 : ℕ) : K) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero j
  have hf : ((j.factorial : ℕ) : K) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero j
  rw [Nat.factorial_succ, Nat.cast_mul]
  field_simp

/-- **The `sl_2` identity, other side**: `e^(k+1) f = f e^(k+1) + (h + k) e^(k)` on a weight vector of weight `μ`
(`h = μ a − μ b`). -/
theorem dpow_succ_E [CharZero K] {a b : Fin n} (hab : a ≠ b) {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (k : ℕ) :
    dpow (G.E a b) (k + 1) (G.E b a y) = G.E b a (dpow (G.E a b) (k + 1) y) +
      (((μ a - μ b : ℤ) : K) + k) • dpow (G.E a b) k y := by
  rw [E_dpow_succ G (Ne.symm hab) hy k, add_assoc, ← add_smul]
  have : (((μ b - μ a : ℤ) : K) - k) + (((μ a - μ b : ℤ) : K) + k) = 0 := by push_cast; ring
  rw [this, zero_smul, add_zero]

variable {G} in
theorem Stable.dpow_mem {W : Submodule K V} (hW : G.Stable W) (a b : Fin n) (k : ℕ) {x : V} (hx : x ∈ W) :
    dpow (G.E a b) k x ∈ W := by
  simp only [dpow, LinearMap.smul_apply]; exact W.smul_mem _ (hW.pow_mem a b k hx)

variable {G} in
theorem Stable.inf {W W' : Submodule K V} (hW : G.Stable W) (hW' : G.Stable W') : G.Stable (W ⊓ W') :=
  fun a b _ hx => ⟨hW a b _ hx.1, hW' a b _ hx.2⟩

theorem stable_bot : G.Stable ⊥ := fun a b x hx => by rw [(Submodule.mem_bot K).mp hx, map_zero]; exact zero_mem _

theorem stable_iSup {ι : Sort*} {W : ι → Submodule K V} (hW : ∀ i, G.Stable (W i)) : G.Stable (⨆ i, W i) := by
  intro a b x hx
  refine Submodule.iSup_induction (motive := fun x => G.E a b x ∈ ⨆ i, W i) W hx
    (fun i x hx => Submodule.mem_iSup_of_mem i (hW i a b x hx)) (by rw [map_zero]; exact zero_mem _)
    (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)

/-- **Negative weights**: if `E a b x` lies in a stable subspace `N`, `x` has weight `μ` with `μ a < μ b`, and
`E b a` is nilpotent on `x`, then `x ∈ N` (the `sl_2` string of `x` would otherwise end in a negative highest
weight). -/
theorem mem_of_neg [CharZero K] {N : Submodule K V} (hN : G.Stable N) {a b : Fin n} (hab : a ≠ b)
    {μ : Fin n → ℤ} {x : V} (hx : G.IsWt μ x) (hneg : μ a - μ b < 0) (hnil : ∃ D, (G.E b a ^ D) x = 0)
    (he : G.E a b x ∈ N) : x ∈ N := by
  classical
  have hex : ∃ k, (G.E b a ^ k) x ∈ N := let ⟨D, hD⟩ := hnil; ⟨D, hD ▸ N.zero_mem⟩
  by_contra hxN
  have hk := Nat.find_spec hex
  have hk0 : Nat.find hex ≠ 0 := fun h => hxN (by simpa [h] using hk)
  obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero hk0
  have hmin : (G.E b a ^ j) x ∉ N := Nat.find_min hex (by omega)
  rw [hj] at hk
  have h1 := E_pow_succ G hab hx j
  have hL : G.E a b ((G.E b a ^ (j + 1)) x) ∈ N := hN a b _ hk
  have hR : (G.E b a ^ (j + 1)) (G.E a b x) ∈ N := hN.pow_mem b a _ he
  have hm : (((j + 1 : ℕ) : K) * (((μ a - μ b : ℤ) : K) - j)) • (G.E b a ^ j) x ∈ N := by
    have := N.sub_mem hL hR; rwa [h1, add_sub_cancel_left] at this
  have hc : (((j + 1 : ℕ) : K) * (((μ a - μ b : ℤ) : K) - j)) ≠ 0 := by
    refine mul_ne_zero (by exact_mod_cast Nat.succ_ne_zero j) ?_
    have : ((μ a - μ b - j : ℤ) : K) ≠ 0 := by exact_mod_cast (by omega : (μ a - μ b - (j : ℤ)) ≠ 0)
    push_cast at this ⊢; exact this
  exact hmin ((N.smul_mem_iff hc).mp hm)

/-- **Nilpotency** of the off-diagonal operators on a finite-dimensional stable subspace. -/
theorem exists_nil [CharZero K] {W : Submodule K V} [FiniteDimensional K W] (hW : G.Stable W) :
    ∃ D, ∀ a b, a ≠ b → ∀ x ∈ W, (G.E a b ^ D) x = 0 := by
  obtain ⟨L, hL⟩ := G.exists_spread W
  exact ⟨L + 1, fun a b hab x hx => G.pow_E_eq_zero hW hL hab hx⟩

/-! ## The extremal projector -/

/-- **The coefficients `(−1)^k / C(N + k**, k)` of the rank-one factors. -/
def ecoef (N k : ℕ) : K := (-1) ^ k / ((N + k).choose k : K)

omit [Module K V] in
theorem ecoef_succ [CharZero K] (N k : ℕ) :
    ecoef N k * ((k + 1 : ℕ) : K) = -(ecoef N (k + 1) * ((N + k + 1 : ℕ) : K)) := by
  have h := Nat.add_one_mul_choose_eq (N + k) k
  have h1 : ((N + k).choose k : K) ≠ 0 := by exact_mod_cast (Nat.choose_pos (by omega)).ne'
  have h2 : ((N + (k + 1)).choose (k + 1) : K) ≠ 0 := by exact_mod_cast (Nat.choose_pos (by omega)).ne'
  have h' : ((N + k + 1 : ℕ) : K) * ((N + k).choose k : K) =
      ((N + (k + 1)).choose (k + 1) : K) * ((k + 1 : ℕ) : K) := by
    rw [show N + (k + 1) = N + k + 1 by ring]; exact_mod_cast h
  have key : ((k + 1 : ℕ) : K) / ((N + k).choose k : K) =
      ((N + k + 1 : ℕ) : K) / ((N + (k + 1)).choose (k + 1) : K) := by
    rw [div_eq_div_iff h1 h2]; linear_combination h'.symm
  simp only [ecoef, pow_succ]
  rw [div_mul_eq_mul_div, mul_div_assoc, key]; ring

/-- **The rank-one factor** `Σ_{k < D} (−1)^k / C(N + k, k) · f^(k) e^(k)` (`e = E a b`, `f = E b a`); for `N` the
`sl_2`-weight plus one it is the `sl_2` highest weight projector. -/
def pfac (a b : Fin n) (N D : ℕ) : Module.End K V :=
  ∑ k ∈ range D, (ecoef N k : K) • (dpow (G.E b a) k * dpow (G.E a b) k)

/-- **The companion `Σ_{k < D} (−1)^(k+1) / C(N + k + 1**, k + 1) · f^(k) e^(k+1)` of the rank-one factor. -/
def pfac' (a b : Fin n) (N D : ℕ) : Module.End K V :=
  ∑ k ∈ range D, (ecoef N (k + 1) : K) • (dpow (G.E b a) k * dpow (G.E a b) (k + 1))

/-- **The rank-one lemma**: `e · pfac(N) y = (h + 1 − N) · pfac'(N) y` for `y` of weight `μ`, `h = μ a − μ b`, when
`e^(D) y = 0`. With `N = h + 1` the factor lands in `ker e`. -/
theorem E_pfac [CharZero K] {a b : Fin n} (hab : a ≠ b) {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) {D : ℕ}
    (hD : dpow (G.E a b) D y = 0) (N : ℕ) :
    G.E a b (G.pfac a b N D y) = ((((μ a - μ b : ℤ) : K) + 1 - N)) • G.pfac' a b N D y := by
  set m : K := ((μ a - μ b : ℤ) : K)
  set X : ℕ → V := fun k => dpow (G.E b a) k (dpow (G.E a b) (k + 1) y)
  have hterm0 : G.E a b ((dpow (G.E b a) 0 * dpow (G.E a b) 0) y) = X 0 := by
    simp [X, dpow_zero, dpow_one]
  have hterm : ∀ k, G.E a b ((dpow (G.E b a) (k + 1) * dpow (G.E a b) (k + 1)) y) =
      ((k + 2 : ℕ) : K) • X (k + 1) + (m + k + 2) • X k := by
    intro k
    have hz := hy.dpow a b (k + 1)
    rw [Module.End.mul_apply, E_dpow_succ G hab hz k]
    have he : G.E a b (dpow (G.E a b) (k + 1) y) = ((k + 2 : ℕ) : K) • dpow (G.E a b) (k + 2) y := by
      rw [← Module.End.mul_apply, ← dpow_succ]; rfl
    rw [he, map_smul]
    congr 2
    simp only [Pi.add_apply, Pi.smul_apply, rt_apply_left hab, rt_apply_right hab, smul_eq_mul, m]
    push_cast; ring
  rcases D with _ | D
  · simp [pfac, pfac']
  have hXD : X D = 0 := by simp [X, hD]
  simp only [pfac, pfac', LinearMap.sum_apply, LinearMap.smul_apply, map_sum, map_smul]
  have hR : ∀ k, (dpow (G.E b a) k * dpow (G.E a b) (k + 1)) y = X k := fun k => rfl
  simp only [hR]
  rw [Finset.sum_range_succ', hterm0, Finset.sum_range_succ (fun k => (ecoef N (k + 1) : K) • X k) D, hXD,
    smul_zero, add_zero]
  simp only [hterm, smul_add, smul_smul, Finset.sum_add_distrib]
  have h1 := Finset.sum_range_succ' (fun k => ((ecoef N k : K) * ((k + 1 : ℕ) : K)) • X k) D
  rw [Finset.sum_range_succ, hXD, smul_zero, add_zero] at h1
  simp only [zero_add, Nat.cast_one, mul_one, show ∀ x : ℕ, x + 1 + 1 = x + 2 from fun x => rfl] at h1
  rw [add_right_comm, ← h1, ← Finset.sum_add_distrib, Finset.smul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [smul_smul, ← add_smul]
  congr 1
  have := ecoef_succ (K := K) N k
  push_cast at this ⊢
  linear_combination this

theorem rt_swap (a b : Fin n) : rt b a = -rt a b := by simp [rt]

theorem isWt_dpow_dpow {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (a b : Fin n) (k : ℕ) :
    G.IsWt μ ((dpow (G.E b a) k * dpow (G.E a b) k) y) := by
  have := (hy.dpow a b k).dpow b a k
  rwa [rt_swap a b, smul_neg, add_neg_cancel_right] at this

theorem isWt_dpow_dpow_succ {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (a b : Fin n) (k : ℕ) :
    G.IsWt (μ + rt a b) ((dpow (G.E b a) k * dpow (G.E a b) (k + 1)) y) := by
  have := (hy.dpow a b (k + 1)).dpow b a k
  convert this using 1
  rw [rt_swap a b]; push_cast; module

theorem isWt_pfac {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (a b : Fin n) (N D : ℕ) :
    G.IsWt μ (G.pfac a b N D y) := by
  simp only [pfac, LinearMap.sum_apply, LinearMap.smul_apply]
  exact IsWt.sum fun k _ => (G.isWt_dpow_dpow hy a b k).smul _

theorem isWt_pfac' {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (a b : Fin n) (N D : ℕ) :
    G.IsWt (μ + rt a b) (G.pfac' a b N D y) := by
  simp only [pfac', LinearMap.sum_apply, LinearMap.smul_apply]
  exact IsWt.sum fun k _ => (G.isWt_dpow_dpow_succ hy a b k).smul _

theorem pfac_mem {W : Submodule K V} (hW : G.Stable W) (a b : Fin n) (N D : ℕ) {y : V} (hy : y ∈ W) :
    G.pfac a b N D y ∈ W := by
  simp only [pfac, LinearMap.sum_apply, LinearMap.smul_apply, Module.End.mul_apply]
  exact W.sum_mem fun k _ => W.smul_mem _ (hW.dpow_mem _ _ _ (hW.dpow_mem _ _ _ hy))

theorem pfac'_mem {W : Submodule K V} (hW : G.Stable W) (a b : Fin n) (N D : ℕ) {y : V} (hy : y ∈ W) :
    G.pfac' a b N D y ∈ W := by
  simp only [pfac', LinearMap.sum_apply, LinearMap.smul_apply, Module.End.mul_apply]
  exact W.sum_mem fun k _ => W.smul_mem _ (hW.dpow_mem _ _ _ (hW.dpow_mem _ _ _ hy))

theorem E_mul_E {a b c d : Fin n} (h1 : b = c) (h2 : d ≠ a) :
    G.E a b * G.E c d = G.E c d * G.E a b + G.E a d := by
  have h := G.comm a b c d
  rw [ite_eq_left h1, ite_eq_right h2, sub_zero] at h
  rw [← h]; abel

theorem E_mul_E' {a b c d : Fin n} (h1 : b ≠ c) (h2 : d = a) :
    G.E a b * G.E c d = G.E c d * G.E a b - G.E c b := by
  have h := G.comm a b c d
  rw [ite_eq_right h1, ite_eq_left h2, zero_sub] at h
  rw [sub_eq_add_neg, ← h]; abel

/-- **The rank-two lemma**: for `a, c, d` distinct and `Z` of weight `μ` killed by `E c d`,
`E c d · pfac_{ac}(μ_a − μ_c + s) · pfac_{ad}(μ_a − μ_d + s + 1) · Z = 0`. With `s` the position of `c` after `a`
this is the step of the extremal projector. -/
theorem E_pfac_pfac [CharZero K] {a c d : Fin n} (hac : a ≠ c) (had : a ≠ d) (hcd : c ≠ d) {μ : Fin n → ℤ}
    {Z : V} (hZ : G.IsWt μ Z) {W : Submodule K V} (hW : G.Stable W) (hZW : Z ∈ W) {D : ℕ}
    (hD : ∀ x y, x ≠ y → ∀ z ∈ W, dpow (G.E x y) D z = 0) (he2 : G.E c d Z = 0) (s A B : ℕ)
    (hA : (A : ℤ) = μ a - μ c + s) (hB : (B : ℤ) = μ a - μ d + s + 1) :
    G.E c d (G.pfac a c A D (G.pfac a d B D Z)) = 0 := by
  set Y := G.pfac a d B D Z
  set Y' := G.pfac' a d B D Z
  have hYW : Y ∈ W := G.pfac_mem hW _ _ _ _ hZW
  have hY'W : Y' ∈ W := G.pfac'_mem hW _ _ _ _ hZW
  have hY' : G.IsWt (μ + rt a d) Y' := G.isWt_pfac' hZ _ _ _ _
  have hcomm1 : ∀ k, G.E c d * dpow (G.E a d) k = dpow (G.E a d) k * G.E c d := fun k => by
    simpa [dpow_one] using G.E_dpow_comm (Ne.symm had) (Ne.symm hcd) 1 k
  have hcomm2 : ∀ k, dpow (G.E d a) k * G.E c a = G.E c a * dpow (G.E d a) k := fun k => by
    simpa [dpow_one] using G.E_dpow_comm hac had k 1
  have hcomm3 : ∀ k, G.E c d * dpow (G.E c a) k = dpow (G.E c a) k * G.E c d := fun k => by
    simpa [dpow_one] using G.E_dpow_comm (Ne.symm hcd) hac.symm.symm 1 k
  -- (i) `e2 Y = f1 Y'`
  have hi : G.E c d Y = G.E c a Y' := by
    have h1 : G.E c d * G.E d a = G.E d a * G.E c d + G.E c a := G.E_mul_E rfl hac
    have h2 : G.E c a * G.E d a = G.E d a * G.E c a := G.E_comm had hac
    have hj : ∀ j, G.E c d ((dpow (G.E d a) (j + 1) * dpow (G.E a d) (j + 1)) Z) =
        G.E c a ((dpow (G.E d a) j * dpow (G.E a d) (j + 1)) Z) := by
      intro j
      rw [← Module.End.mul_apply (G.E c d), ← mul_assoc, mul_dpow_succ (G.E c d) (G.E d a) (G.E c a) h1 h2 j,
        add_mul, mul_assoc, hcomm1, hcomm2, LinearMap.add_apply]
      simp [he2]
    rcases D with _ | D
    · simp [Y, Y', pfac, pfac']
    simp only [Y, Y', pfac, pfac', LinearMap.sum_apply, LinearMap.smul_apply, map_sum, map_smul]
    rw [Finset.sum_range_succ', Finset.sum_range_succ (fun k => (ecoef B (k + 1) : K) • G.E c a _) D]
    simp only [hj, dpow_zero, mul_one, Module.End.one_apply, he2, smul_zero, add_zero]
    rw [Module.End.mul_apply, hD a d had Z hZW, map_zero, map_zero, smul_zero, add_zero]
  -- (ii) `e3 Y = −s Y'`
  have hii : G.E a d Y = (-(s : K)) • Y' := by
    rw [E_pfac G had hZ (hD a d had Z hZW) B]
    congr 1
    have : ((B : ℤ) : K) = ((μ a - μ d + s + 1 : ℤ) : K) := by rw [hB]
    push_cast at this ⊢; linear_combination -this
  -- (iii)–(v)
  set A' : K := ((((μ + rt a d) a - (μ + rt a d) c) : ℤ) : K)
  have hA' : A' + s = A + 1 := by
    have : ((A : ℤ) : K) = ((μ a - μ c + s : ℤ) : K) := by rw [hA]
    simp only [A', Pi.add_apply, rt_apply_left had, rt_apply_other hac.symm hcd] at this ⊢
    push_cast at this ⊢; linear_combination -this
  set Zk : ℕ → V := fun k => dpow (G.E c a) (k + 1) (dpow (G.E a c) k Y')
  have hterm0 : G.E c d ((dpow (G.E c a) 0 * dpow (G.E a c) 0) Y) = Zk 0 := by
    simp [Zk, dpow_zero, dpow_one, hi]
  have hterm : ∀ k, G.E c d ((dpow (G.E c a) (k + 1) * dpow (G.E a c) (k + 1)) Y) =
      ((k + 2 : ℕ) : K) • Zk (k + 1) + ((A : K) + k + 1) • Zk k := by
    intro k
    have h1 : G.E c d * G.E a c = G.E a c * G.E c d + -G.E a d := by
      rw [G.E_mul_E' (Ne.symm had) rfl]; abel
    have h2 : -G.E a d * G.E a c = G.E a c * -G.E a d := by
      rw [neg_mul, mul_neg, G.E_comm (a := a) (b := d) (c := a) (d := c) had.symm hac.symm]
    have hY'k := dpow_succ_E G hac hY' k
    rw [Module.End.mul_apply, ← Module.End.mul_apply (G.E c d), hcomm3, Module.End.mul_apply,
      ← Module.End.mul_apply (G.E c d), mul_dpow_succ (G.E c d) (G.E a c) (-G.E a d) h1 h2 k, LinearMap.add_apply,
      Module.End.mul_apply, Module.End.mul_apply, hi, LinearMap.neg_apply, hii, neg_smul, neg_neg, hY'k, map_smul,
      add_assoc, ← add_smul, map_add, map_smul, ← Module.End.mul_apply (dpow (G.E c a) (k + 1)) (G.E c a),
      ← dpow_succ', LinearMap.smul_apply]
    have hc : (((μ + rt a d) a - (μ + rt a d) c : ℤ) : K) + k + s = A + k + 1 := by
      have := hA'; simp only [A'] at this; linear_combination this
    rw [hc]
  rcases D with _ | D
  · simp [pfac]
  have hZD : Zk D = 0 := hD c a hac.symm _ (hW.dpow_mem _ _ _ hY'W)
  simp only [pfac, LinearMap.sum_apply, LinearMap.smul_apply, map_sum, map_smul]
  rw [Finset.sum_range_succ', hterm0]
  simp only [hterm, smul_add, smul_smul, Finset.sum_add_distrib]
  have h1 := Finset.sum_range_succ' (fun k => ((ecoef A k : K) * ((k + 1 : ℕ) : K)) • Zk k) D
  rw [Finset.sum_range_succ, hZD, smul_zero, add_zero] at h1
  simp only [zero_add, Nat.cast_one, mul_one, show ∀ x : ℕ, x + 1 + 1 = x + 2 from fun x => rfl] at h1
  rw [add_right_comm, ← h1, ← Finset.sum_add_distrib]
  refine Finset.sum_eq_zero fun k _ => ?_
  rw [← add_smul]
  have := ecoef_succ (K := K) A k
  convert zero_smul K (Zk k) using 2
  push_cast at this ⊢
  linear_combination this

/-- **The `a`-row of the extremal projector**: `pfac_{a b₀}(μ_a − μ_{b₀} + t) ⋯ pfac_{a b_k}(μ_a − μ_{b_k} + t + k)`,
the
factor with the largest shift applied first. -/
def rfac (a : Fin n) (μ : Fin n → ℤ) (D : ℕ) : List (Fin n) → ℕ → Module.End K V
  | [], _ => 1
  | b :: bs, t => G.pfac a b ((μ a - μ b).toNat + t) D * rfac a μ D bs (t + 1)

/-- **The extremal projector** of the index list `l` at the weight `μ` (cut off at `D`):
`xproj (a :: l) = rfac a l 1 · xproj l`, the ordered product of the rank-one factors over the pairs of `l` in the
order `(a₀, a₁), …, (a₀, a_k), (a₁, a₂), …`. -/
def xproj (μ : Fin n → ℤ) (D : ℕ) : List (Fin n) → Module.End K V
  | [] => 1
  | a :: l => G.rfac a μ D l 1 * xproj μ D l

theorem isWt_rfac {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (a : Fin n) (D : ℕ) (bs : List (Fin n)) (t : ℕ) :
    G.IsWt μ (G.rfac a μ D bs t y) := by
  induction bs generalizing t with
  | nil => simpa [rfac] using hy
  | cons b bs ih => rw [rfac, Module.End.mul_apply]; exact G.isWt_pfac (ih (t + 1)) _ _ _ _

theorem rfac_mem {W : Submodule K V} (hW : G.Stable W) (a : Fin n) (μ : Fin n → ℤ) (D : ℕ) (bs : List (Fin n))
    (t : ℕ) {y : V} (hy : y ∈ W) : G.rfac a μ D bs t y ∈ W := by
  induction bs generalizing t with
  | nil => simpa [rfac] using hy
  | cons b bs ih => rw [rfac, Module.End.mul_apply]; exact G.pfac_mem hW _ _ _ _ (ih (t + 1))

theorem isWt_xproj {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (D : ℕ) (l : List (Fin n)) :
    G.IsWt μ (G.xproj μ D l y) := by
  induction l with
  | nil => simpa [xproj] using hy
  | cons a l ih => rw [xproj, Module.End.mul_apply]; exact G.isWt_rfac ih _ _ _ _

theorem xproj_mem {W : Submodule K V} (hW : G.Stable W) (μ : Fin n → ℤ) (D : ℕ) (l : List (Fin n)) {y : V}
    (hy : y ∈ W) : G.xproj μ D l y ∈ W := by
  induction l with
  | nil => simpa [xproj] using hy
  | cons a l ih => rw [xproj, Module.End.mul_apply]; exact G.rfac_mem hW _ _ _ _ _ ih

theorem E_pfac_comm {a b c d : Fin n} (hca : c ≠ a) (hcb : c ≠ b) (hda : d ≠ a) (hdb : d ≠ b) (N D : ℕ) :
    G.E c d * G.pfac a b N D = G.pfac a b N D * G.E c d := by
  have h1 : ∀ k, G.E c d * dpow (G.E b a) k = dpow (G.E b a) k * G.E c d := fun k => by
    simpa [dpow_one] using G.E_dpow_comm (a := c) (b := d) (c := b) (d := a) hdb hca.symm 1 k
  have h2 : ∀ k, G.E c d * dpow (G.E a b) k = dpow (G.E a b) k * G.E c d := fun k => by
    simpa [dpow_one] using G.E_dpow_comm (a := c) (b := d) (c := a) (d := b) hda hcb.symm 1 k
  simp only [pfac, Finset.mul_sum, Finset.sum_mul, Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [← mul_assoc, h1, mul_assoc, h2, mul_assoc]

theorem E_rfac_comm {a c d : Fin n} (hca : c ≠ a) (hda : d ≠ a) (μ : Fin n → ℤ) (D : ℕ) (bs : List (Fin n))
    (hc : c ∉ bs) (hd : d ∉ bs) (t : ℕ) : G.E c d * G.rfac a μ D bs t = G.rfac a μ D bs t * G.E c d := by
  induction bs generalizing t with
  | nil => simp [rfac]
  | cons b bs ih =>
    simp only [List.mem_cons, not_or] at hc hd
    rw [rfac, ← mul_assoc, G.E_pfac_comm hca hc.1 hda hd.1, mul_assoc, ih hc.2 hd.2, mul_assoc]

/-- **The factor with `N = h + 1` lands in `ker e`.** -/
theorem E_pfac_eq_zero [CharZero K] {a b : Fin n} (hab : a ≠ b) {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y)
    {D : ℕ} (hD : dpow (G.E a b) D y = 0) {N : ℕ} (hN : (N : ℤ) = μ a - μ b + 1) :
    G.E a b (G.pfac a b N D y) = 0 := by
  rw [E_pfac G hab hy hD]
  have : ((N : ℤ) : K) = ((μ a - μ b + 1 : ℤ) : K) := by rw [hN]
  push_cast at this
  rw [this, show (((μ a - μ b : ℤ) : K) + 1 - (μ a - μ b + 1)) = 0 by push_cast; ring, zero_smul]

/-- **The row step**: if the consecutive pairs of `bs` kill `y`, they kill `rfac a bs t y`; for `t = 1` so does
`E a b₀` (`b₀` the head of `bs`). -/
theorem rfac_kill [CharZero K] {W : Submodule K V} (hW : G.Stable W) {D : ℕ}
    (hD : ∀ x y, x ≠ y → ∀ z ∈ W, dpow (G.E x y) D z = 0) (a : Fin n) (μ : Fin n → ℤ) :
    ∀ (bs : List (Fin n)), (a :: bs).Pairwise (· < ·) → (∀ x ∈ a :: bs, ∀ y ∈ a :: bs, x < y → μ y ≤ μ x) →
      ∀ (t : ℕ) (y : V), G.IsWt μ y → y ∈ W → bs.IsChain (fun b b' => G.E b b' y = 0) →
      bs.IsChain (fun b b' => G.E b b' (G.rfac a μ D bs t y) = 0) ∧
        (t = 1 → ∀ b ∈ bs.head?, G.E a b (G.rfac a μ D bs t y) = 0) := by
  intro bs
  induction bs with
  | nil => intro _ _ t y _ _ _; simp [rfac]
  | cons b bs ih =>
    intro hsort hdom t y hy hyW hchain
    have hsort' : (a :: bs).Pairwise (· < ·) := by
      simp only [List.pairwise_cons, List.mem_cons] at hsort ⊢
      exact ⟨fun x hx => hsort.1 x (Or.inr hx), hsort.2.2⟩
    have hsub : ∀ x ∈ a :: bs, x ∈ a :: b :: bs := fun x hx => by
      simp only [List.mem_cons] at hx ⊢; tauto
    have hdom' : ∀ x ∈ a :: bs, ∀ z ∈ a :: bs, x < z → μ z ≤ μ x := fun x hx z hz =>
      hdom x (hsub x hx) z (hsub z hz)
    have hab : a < b := List.rel_of_pairwise_cons hsort (List.mem_cons_self)
    have hbs : ∀ x ∈ bs, b < x := fun x hx => List.rel_of_pairwise_cons (List.Pairwise.of_cons hsort) hx
    have has : ∀ x ∈ bs, a < x := fun x hx => List.rel_of_pairwise_cons hsort (List.mem_cons_of_mem b hx)
    obtain ⟨ihc, -⟩ := ih hsort' hdom' (t + 1) y hy hyW hchain.tail
    set Y := G.rfac a μ D bs (t + 1) y
    have hYW : Y ∈ W := G.rfac_mem hW _ _ _ _ _ hyW
    have hY : G.IsWt μ Y := G.isWt_rfac hy _ _ _ _
    have hNt : (((μ a - μ b).toNat + t : ℕ) : ℤ) = μ a - μ b + t := by
      have := hdom a List.mem_cons_self b (List.mem_cons_of_mem a List.mem_cons_self) hab
      push_cast; rw [Int.toNat_of_nonneg (by omega)]
    rw [rfac, Module.End.mul_apply]
    refine ⟨List.isChain_cons.mpr ⟨?_, ?_⟩, ?_⟩
    · -- the head pair, by the rank-two lemma
      intro b' hb'
      cases bs with
      | nil => simp at hb'
      | cons b₁ bs' =>
        simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hb'
        subst hb'
        have hbb₁ : b < b₁ := hbs b₁ List.mem_cons_self
        have hab₁ : a < b₁ := has b₁ List.mem_cons_self
        have hZ : G.E b b₁ (G.rfac a μ D bs' (t + 1 + 1) y) = 0 := by
          have hc : b ∉ bs' := fun h => (lt_irrefl b) ((hbs b (List.mem_cons_of_mem _ h)))
          have hd : b₁ ∉ bs' := fun h => by
            have := List.rel_of_pairwise_cons (List.Pairwise.of_cons (List.Pairwise.of_cons hsort)) h
            exact lt_irrefl b₁ this
          rw [← Module.End.mul_apply, G.E_rfac_comm (ne_of_gt hab) (ne_of_gt hab₁) μ D bs' hc hd,
            Module.End.mul_apply, (List.isChain_cons_cons.mp hchain).1, map_zero]
        have hNt1 : (((μ a - μ b₁).toNat + (t + 1) : ℕ) : ℤ) = μ a - μ b₁ + t + 1 := by
          have := hdom a List.mem_cons_self b₁ (by simp) hab₁
          push_cast; rw [Int.toNat_of_nonneg (by omega)]; ring
        simp only [rfac, Module.End.mul_apply]
        exact G.E_pfac_pfac (ne_of_lt hab) (ne_of_lt hab₁) (ne_of_lt hbb₁) (G.isWt_rfac hy _ _ _ _) hW
          (G.rfac_mem hW _ _ _ _ _ hyW) hD hZ t _ _ hNt hNt1
    · -- the later pairs commute with the new factor
      refine ihc.imp_of_mem_imp fun x x' hx hx' h => ?_
      have hx1 := hbs x hx; have hx2 := has x hx; have hx1' := hbs x' hx'; have hx2' := has x' hx'
      rw [← Module.End.mul_apply, G.E_pfac_comm (ne_of_gt hx2) (ne_of_gt hx1) (ne_of_gt hx2') (ne_of_gt hx1'),
        Module.End.mul_apply, h, map_zero]
    · intro ht b' hb'
      simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hb'
      subst hb' ht
      exact G.E_pfac_eq_zero (ne_of_lt hab) hY (hD a b (ne_of_lt hab) Y hYW) (by rw [hNt]; push_cast; ring)

/-- **The extremal projector lands in the highest weight vectors**: for a sorted list `l`, a weight `μ` dominant on
`l` and `y ∈ W` of weight `μ`, every consecutive pair `a, b` of `l` has `E a b (xproj l y) = 0`. -/
theorem xproj_chain [CharZero K] {W : Submodule K V} (hW : G.Stable W) {D : ℕ}
    (hD : ∀ x y, x ≠ y → ∀ z ∈ W, dpow (G.E x y) D z = 0) (μ : Fin n → ℤ) :
    ∀ (l : List (Fin n)), l.Pairwise (· < ·) → (∀ x ∈ l, ∀ y ∈ l, x < y → μ y ≤ μ x) →
      ∀ (y : V), G.IsWt μ y → y ∈ W → l.IsChain (fun a b => G.E a b (G.xproj μ D l y) = 0) := by
  intro l
  induction l with
  | nil => intros; exact List.isChain_nil
  | cons a l ih =>
    intro hsort hdom y hy hyW
    have hdom' : ∀ x ∈ l, ∀ z ∈ l, x < z → μ z ≤ μ x := fun x hx z hz =>
      hdom x (List.mem_cons_of_mem a hx) z (List.mem_cons_of_mem a hz)
    have h1 := ih (List.Pairwise.of_cons hsort) hdom' y hy hyW
    obtain ⟨h2, h3⟩ := G.rfac_kill hW hD a μ l hsort hdom 1 _ (G.isWt_xproj hy _ _) (G.xproj_mem hW _ _ _ hyW) h1
    rw [xproj, Module.End.mul_apply]
    exact List.isChain_cons.mpr ⟨h3 rfl, h2⟩

/-- **The lowering images into weight `μ`**: the span of `E b a w`, `a < b`, `w ∈ W` of weight `μ + e_a − e_b`. -/
def lowSp (W : Submodule K V) (μ : Fin n → ℤ) : Submodule K V :=
  Submodule.span K {z | ∃ a b, a < b ∧ ∃ w ∈ W, G.IsWt (μ + rt a b) w ∧ z = G.E b a w}

omit [Module K V] in
theorem ecoef_zero (N : ℕ) : (ecoef N 0 : K) = 1 := by simp [ecoef]

theorem pfac_sub_mem [CharZero K] {W : Submodule K V} (hW : G.Stable W) {a b : Fin n} (hab : a < b)
    {μ : Fin n → ℤ} {y : V} (hy : G.IsWt μ y) (hyW : y ∈ W) (N : ℕ) {D : ℕ} (hD : 0 < D) :
    G.pfac a b N D y - y ∈ G.lowSp W μ := by
  obtain ⟨D, rfl⟩ := Nat.exists_eq_add_of_lt hD
  simp only [zero_add, pfac, LinearMap.sum_apply, LinearMap.smul_apply]
  rw [Finset.sum_range_succ', ecoef_zero, one_smul, dpow_zero, dpow_zero, mul_one, Module.End.one_apply,
    add_sub_cancel_right]
  refine Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ ?_
  have h := dpow_succ (G.E b a) k
  have hk : ((k + 1 : ℕ) : K) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero k
  rw [Module.End.mul_apply, show dpow (G.E b a) (k + 1) = ((k + 1 : ℕ) : K)⁻¹ • (G.E b a * dpow (G.E b a) k) by
    rw [← h, smul_smul, inv_mul_cancel₀ hk, one_smul], LinearMap.smul_apply, Module.End.mul_apply]
  refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, b, hab, _, hW.dpow_mem _ _ _ (hW.dpow_mem _ _ _ hyW),
    ?_, rfl⟩)
  simpa [Module.End.mul_apply] using G.isWt_dpow_dpow_succ hy a b k

theorem rfac_sub_mem [CharZero K] {W : Submodule K V} (hW : G.Stable W) {D : ℕ} (hD : 0 < D) (a : Fin n)
    (μ : Fin n → ℤ) (bs : List (Fin n)) (hsort : (a :: bs).Pairwise (· < ·)) (t : ℕ) {y : V} (hy : G.IsWt μ y)
    (hyW : y ∈ W) : G.rfac a μ D bs t y - y ∈ G.lowSp W μ := by
  induction bs generalizing t with
  | nil => simp [rfac]
  | cons b bs ih =>
    have hsort' : (a :: bs).Pairwise (· < ·) := by
      simp only [List.pairwise_cons, List.mem_cons] at hsort ⊢
      exact ⟨fun x hx => hsort.1 x (Or.inr hx), hsort.2.2⟩
    rw [rfac, Module.End.mul_apply, ← sub_add_sub_cancel _ (G.rfac a μ D bs (t + 1) y)]
    exact add_mem (G.pfac_sub_mem hW (List.rel_of_pairwise_cons hsort List.mem_cons_self) (G.isWt_rfac hy _ _ _ _)
      (G.rfac_mem hW _ _ _ _ _ hyW) _ hD) (ih hsort' _)

/-- **The extremal projector moves a vector by lowering images.** -/
theorem xproj_sub_mem [CharZero K] {W : Submodule K V} (hW : G.Stable W) {D : ℕ} (hD : 0 < D) (μ : Fin n → ℤ)
    (l : List (Fin n)) (hsort : l.Pairwise (· < ·)) {y : V} (hy : G.IsWt μ y) (hyW : y ∈ W) :
    G.xproj μ D l y - y ∈ G.lowSp W μ := by
  induction l with
  | nil => simp [xproj]
  | cons a l ih =>
    rw [xproj, Module.End.mul_apply, ← sub_add_sub_cancel _ (G.xproj μ D l y)]
    exact add_mem (G.rfac_sub_mem hW hD a μ l hsort 1 (G.isWt_xproj hy _ _) (G.xproj_mem hW _ _ _ hyW))
      (ih (List.Pairwise.of_cons hsort))

theorem dpow_apply_eq_zero [CharZero K] {T : Module.End K V} {y : V} (h : T y = 0) {k : ℕ} (hk : 0 < k) :
    dpow T k y = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt hk
  simp [dpow, pow_succ, Module.End.mul_apply, h]

theorem pfac_of_E [CharZero K] {a b : Fin n} {y : V} (h : G.E a b y = 0) (N : ℕ) {D : ℕ} (hD : 0 < D) :
    G.pfac a b N D y = y := by
  obtain ⟨D, rfl⟩ := Nat.exists_eq_add_of_lt hD
  simp only [zero_add, pfac, LinearMap.sum_apply, LinearMap.smul_apply]
  rw [Finset.sum_range_succ', ecoef_zero, one_smul, dpow_zero, dpow_zero, mul_one, Module.End.one_apply]
  rw [Finset.sum_eq_zero fun k _ => by rw [Module.End.mul_apply, dpow_apply_eq_zero h k.succ_pos, map_zero,
    smul_zero], zero_add]

theorem rfac_of_hw [CharZero K] {a : Fin n} {y : V} (μ : Fin n → ℤ) {D : ℕ} (hD : 0 < D) (bs : List (Fin n))
    (h : ∀ b ∈ bs, G.E a b y = 0) (t : ℕ) : G.rfac a μ D bs t y = y := by
  induction bs generalizing t with
  | nil => simp [rfac]
  | cons b bs ih =>
    rw [rfac, Module.End.mul_apply, ih (fun c hc => h c (List.mem_cons_of_mem b hc)),
      G.pfac_of_E (h b List.mem_cons_self) _ hD]

/-- **The extremal projector fixes highest weight vectors.** -/
theorem xproj_of_hw [CharZero K] {y : V} (μ : Fin n → ℤ) {D : ℕ} (hD : 0 < D) (l : List (Fin n))
    (hsort : l.Pairwise (· < ·)) (h : ∀ a ∈ l, ∀ b ∈ l, a < b → G.E a b y = 0) : G.xproj μ D l y = y := by
  induction l with
  | nil => simp [xproj]
  | cons a l ih =>
    rw [xproj, Module.End.mul_apply, ih (List.Pairwise.of_cons hsort)
      (fun x hx z hz => h x (List.mem_cons_of_mem a hx) z (List.mem_cons_of_mem a hz))]
    exact G.rfac_of_hw μ hD l (fun b hb => h a List.mem_cons_self b (List.mem_cons_of_mem a hb)
      (List.rel_of_pairwise_cons hsort hb)) 1

/-- **Consecutive pairs suffice**: on a sorted list, a vector killed by the consecutive raising operators is killed
by all of them. -/
theorem kill_of_chain {x : V} : ∀ (l : List (Fin n)), l.Pairwise (· < ·) →
    l.IsChain (fun a b => G.E a b x = 0) → ∀ a ∈ l, ∀ b ∈ l, a < b → G.E a b x = 0 := by
  intro l
  induction l with
  | nil => simp
  | cons a l ih =>
    intro hsort hchain
    have ih' := ih (List.Pairwise.of_cons hsort) hchain.tail
    intro x' hx' d hd hxd
    simp only [List.mem_cons] at hx' hd
    rcases hx' with rfl | hx'
    · rcases hd with rfl | hd
      · exact absurd hxd (lt_irrefl _)
      cases l with
      | nil => simp at hd
      | cons b l =>
        have hab := (List.isChain_cons_cons.mp hchain).1
        simp only [List.mem_cons] at hd
        rcases hd with rfl | hd
        · exact hab
        · have hbd : b < d := List.rel_of_pairwise_cons (List.Pairwise.of_cons hsort) hd
          have hbd' := ih' b List.mem_cons_self d (List.mem_cons_of_mem b hd) hbd
          have h := G.comm_apply x' b b d x
          rw [hbd', map_zero, hab, map_zero, zero_add, ite_eq_left rfl,
            ite_eq_right (ne_of_gt hxd), sub_zero] at h
          exact h.symm
    · rcases hd with rfl | hd
      · exact absurd (List.rel_of_pairwise_cons hsort hx') (not_lt.mpr hxd.le)
      · exact ih' x' hx' d hd hxd

/-! ## Highest weight modules -/

/-- **The submodule generated** by a set: the least stable subspace containing it. -/
def gen (S : Set V) : Submodule K V := sInf {N | S ⊆ N ∧ G.Stable N}

theorem gen_stable (S : Set V) : G.Stable (G.gen S) := by
  intro a b x hx
  simp only [gen, Submodule.mem_sInf, Set.mem_ofPred_eq] at hx ⊢
  exact fun N hN => hN.2 a b x (hx N hN)

theorem subset_gen (S : Set V) : S ⊆ G.gen S := fun x hx => by
  simp only [gen, SetLike.mem_coe, Submodule.mem_sInf, Set.mem_ofPred_eq]
  exact fun N hN => hN.1 hx

theorem gen_le {S : Set V} {N : Submodule K V} (hS : S ⊆ N) (hN : G.Stable N) : G.gen S ≤ N :=
  sInf_le ⟨hS, hN⟩

theorem mem_gen_self (x : V) : x ∈ G.gen {x} := G.subset_gen _ rfl

/-- **The vectors obtained from `h` by lowering operators `E b a`**, `a < b`. -/
inductive Low (h : V) : V → Prop
  | base : Low h h
  | step (a b : Fin n) (hab : a < b) {y : V} : Low h y → Low h (G.E b a y)

/-- **The span of the lowering words applied to `h`.** -/
def lowSpan (h : V) : Submodule K V := Submodule.span K {y | G.Low h y}

theorem lowSpan_lower (h : V) {a b : Fin n} (hab : a < b) {x : V} (hx : x ∈ G.lowSpan h) :
    G.E b a x ∈ G.lowSpan h := by
  have : Submodule.span K {y | G.Low h y} ≤ (G.lowSpan h).comap (G.E b a) :=
    Submodule.span_le.mpr fun y hy => Submodule.subset_span (Low.step a b hab hy)
  exact this hx

/-- **The lowering words span a stable subspace** (for `h` a highest weight vector). -/
theorem lowSpan_stable {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) : G.Stable (G.lowSpan h) := by
  intro c d x hx
  refine Submodule.span_induction (p := fun x _ => G.E c d x ∈ G.lowSpan h) ?_ (by simp)
    (fun x y _ _ hx hy => by rw [map_add]; exact add_mem hx hy)
    (fun r x _ hx => by rw [map_smul]; exact Submodule.smul_mem _ r hx) hx
  intro y hy
  induction hy generalizing c d with
  | base =>
    rcases lt_trichotomy c d with hcd | rfl | hcd
    · rw [hh.2 c d hcd]; exact zero_mem _
    · rw [G.diag_apply hh.1]; exact Submodule.smul_mem _ _ (Submodule.subset_span Low.base)
    · exact Submodule.subset_span (Low.step d c hcd Low.base)
  | step a b hab hy ih =>
    rw [comm_apply]
    refine add_mem (G.lowSpan_lower h hab (ih c d)) (sub_mem ?_ ?_)
    · split_ifs; exacts [ih c a, zero_mem _]
    · split_ifs; exacts [ih b d, zero_mem _]

theorem low_mem_gen (h : V) {y : V} (hy : G.Low h y) : y ∈ G.gen {h} := by
  induction hy with
  | base => exact G.mem_gen_self h
  | step a b _ _ ih => exact G.gen_stable _ b a _ ih

/-- **The submodule generated by a highest weight vector is spanned by its lowering words.** -/
theorem gen_eq_lowSpan {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) : G.gen {h} = G.lowSpan h :=
  le_antisymm (G.gen_le (Set.singleton_subset_iff.mpr (show h ∈ G.lowSpan h from Submodule.subset_span Low.base))
    (G.lowSpan_stable hh))
    (Submodule.span_le.mpr fun _ hy => G.low_mem_gen h hy)

/-! ## The dominance order -/

/-- **Partial sums `Σ_{a < j} x a`.** -/
def psum (x : Fin n → ℤ) (j : ℕ) : ℤ := ∑ a : Fin n, if (a : ℕ) < j then x a else 0

/-- **The dominance order** `ν ≼ λ`: equal total and `Σ_{a<j} ν a ≤ Σ_{a<j} λ a` for all `j`. -/
def DLe (ν la : Fin n → ℤ) : Prop := (∀ j, psum ν j ≤ psum la j) ∧ ∑ a, ν a = ∑ a, la a

theorem psum_add (x y : Fin n → ℤ) (j : ℕ) : psum (x + y) j = psum x j + psum y j := by
  simp only [psum, Pi.add_apply, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun a _ => by split_ifs <;> simp

theorem psum_sub (x y : Fin n → ℤ) (j : ℕ) : psum (x - y) j = psum x j - psum y j := by
  simp only [psum, Pi.sub_apply, ← Finset.sum_sub_distrib]
  exact Finset.sum_congr rfl fun a _ => by split_ifs <;> simp

theorem psum_neg (x : Fin n → ℤ) (j : ℕ) : psum (-x) j = -psum x j := by
  simp only [psum, Pi.neg_apply, ← Finset.sum_neg_distrib]
  exact Finset.sum_congr rfl fun a _ => by split_ifs <;> simp

theorem psum_single (a : Fin n) (j : ℕ) : psum (Pi.single a 1) j = if (a : ℕ) < j then 1 else 0 := by
  simp only [psum]
  rw [Finset.sum_eq_single a (fun c _ hc => by simp [hc]) (by simp)]
  simp

theorem psum_rt {a b : Fin n} (hab : a < b) (j : ℕ) : 0 ≤ psum (rt a b) j := by
  rw [rt, psum_sub, psum_single, psum_single]
  have : (b : ℕ) < j → (a : ℕ) < j := fun h => lt_trans (Fin.lt_def.mp hab) h
  split_ifs <;> simp_all

theorem sum_rt (a b : Fin n) : ∑ c, rt a b c = 0 := by simp [rt, Finset.sum_sub_distrib]

theorem DLe.refl (ν : Fin n → ℤ) : DLe ν ν := ⟨fun _ => le_rfl, rfl⟩

theorem DLe.trans {ν ν' ν'' : Fin n → ℤ} (h1 : DLe ν ν') (h2 : DLe ν' ν'') : DLe ν ν'' :=
  ⟨fun j => (h1.1 j).trans (h2.1 j), h1.2.trans h2.2⟩

theorem psum_succ (x : Fin n → ℤ) (a : Fin n) : psum x (a + 1) = psum x a + x a := by
  simp only [psum]
  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ a), ← Finset.sum_erase_add _ _ (Finset.mem_univ a),
    ite_eq_left (Nat.lt_succ_self a), ite_eq_right (lt_irrefl _), add_zero]
  congr 1
  refine Finset.sum_congr rfl fun c hc => ?_
  have hca : (c : ℕ) ≠ a := fun h => (Finset.mem_erase.mp hc).1 (Fin.ext h)
  by_cases h : (c : ℕ) < a
  · rw [ite_eq_left h, ite_eq_left (by omega)]
  · rw [ite_eq_right h, ite_eq_right (by omega)]

theorem DLe.antisymm {ν la : Fin n → ℤ} (h1 : DLe ν la) (h2 : DLe la ν) : ν = la := by
  have hp : ∀ j, psum ν j = psum la j := fun j => le_antisymm (h1.1 j) (h2.1 j)
  funext a
  have := psum_succ ν a; have := psum_succ la a
  have := hp a; have := hp (a + 1)
  linarith

theorem dle_add_rt {ν : Fin n → ℤ} {a b : Fin n} (hab : a < b) : DLe (ν + rt b a) ν := by
  refine ⟨fun j => ?_, ?_⟩
  · rw [psum_add, rt_swap, psum_neg]
    linarith [psum_rt hab j]
  · simp [Finset.sum_add_distrib, sum_rt]

theorem rt_ne_zero {a b : Fin n} (hab : a ≠ b) : rt a b ≠ 0 := fun h => by
  have := congrFun h a; rw [rt_apply_left hab] at this; exact one_ne_zero this

theorem not_dle_add_rt {ν : Fin n → ℤ} {a b : Fin n} (hab : a < b) : ¬ DLe (ν + rt a b) ν := fun h => by
  have h1 := h.1 (a + 1)
  rw [psum_add, rt, psum_sub, psum_single, psum_single, ite_eq_left (Nat.lt_succ_self a),
    ite_eq_right (by have := Fin.lt_def.mp hab; omega)] at h1
  linarith

/-- **Weights of lowering words**: a lowering word applied to a highest weight vector of weight `la` has a weight
`ν ≼ la`, with `ν = la` only for the empty word. -/
theorem low_isWt {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) {y : V} (hy : G.Low h y) :
    ∃ ν, G.IsWt ν y ∧ DLe ν la ∧ (ν = la → y = h) := by
  induction hy with
  | base => exact ⟨la, hh.1, DLe.refl _, fun _ => rfl⟩
  | step a b hab _ ih =>
    obtain ⟨ν, hν, hνla, -⟩ := ih
    refine ⟨ν + rt b a, hν.E_apply b a, (dle_add_rt hab).trans hνla, fun h' => ?_⟩
    exfalso
    have h1 : DLe ν (ν + rt b a) := h' ▸ hνla
    have h2 := DLe.antisymm h1 (dle_add_rt hab)
    exact rt_ne_zero (ne_of_gt hab) (by simpa using h2.symm)

/-- **Weights of a highest weight module**: the weights of `gen {h}` are `≼ la`. -/
theorem dle_of_comp_ne {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) {x : V} (hx : x ∈ G.gen {h})
    {μ : Fin n → ℤ} (hμ : G.comp μ x ≠ 0) : DLe μ la := by
  rw [G.gen_eq_lowSpan hh] at hx
  revert hμ
  refine Submodule.span_induction (p := fun x _ => G.comp μ x ≠ 0 → DLe μ la) ?_ (by simp)
    (fun x y _ _ hx hy h => ?_) (fun r x _ hx h => hx (by rintro h'; rw [map_smul, h', smul_zero] at h; exact h rfl))
    hx
  · intro y hy h
    obtain ⟨ν, hν, hνla, -⟩ := G.low_isWt hh hy
    by_cases hμν : μ = ν
    · exact hμν ▸ hνla
    · exact absurd (G.comp_of_isWt_ne hν hμν) h
  · by_contra h'
    rw [map_add, show G.comp μ x = 0 from by_contra fun h1 => h' (hx h1),
      show G.comp μ y = 0 from by_contra fun h1 => h' (hy h1), add_zero] at h
    exact h rfl

/-- **The top weight space of a highest weight module** is the line of the highest weight vector. -/
theorem comp_mem_span {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) {x : V} (hx : x ∈ G.gen {h}) :
    G.comp la x ∈ K ∙ h := by
  rw [G.gen_eq_lowSpan hh] at hx
  refine Submodule.span_induction (p := fun x _ => G.comp la x ∈ K ∙ h) ?_ (by simp)
    (fun x y _ _ hx hy => by rw [map_add]; exact add_mem hx hy)
    (fun r x _ hx => by rw [map_smul]; exact Submodule.smul_mem _ r hx) hx
  intro y hy
  obtain ⟨ν, hν, -, hνy⟩ := G.low_isWt hh hy
  by_cases hla : la = ν
  · rw [hla, hν, hνy hla.symm]; exact Submodule.mem_span_singleton_self h
  · rw [G.comp_of_isWt_ne hν hla]; exact zero_mem _

/-! ## The Casimir operator -/

/-- **The Casimir** `Σ_{a,b} E a b E b a`. -/
def cas : Module.End K V := ∑ a, ∑ b, G.E a b * G.E b a

/-- **The Casimir is central.** -/
theorem cas_comm (c d : Fin n) : G.cas * G.E c d = G.E c d * G.cas := by
  have key : ∀ a b, G.E a b * G.E b a * G.E c d = G.E c d * (G.E a b * G.E b a) +
      (if b = c then G.E a d * G.E b a else 0) - (if d = a then G.E c b * G.E b a else 0) +
      (if a = c then G.E a b * G.E b d else 0) - (if d = b then G.E a b * G.E c a else 0) := by
    intro a b
    have h1 := G.comm a b c d
    have h2 := G.comm b a c d
    rw [sub_eq_iff_eq_add] at h1 h2
    rw [mul_assoc, h2, mul_add, ← mul_assoc (G.E a b) (G.E c d), h1]
    split_ifs <;> noncomm_ring
  simp only [cas, Finset.sum_mul, Finset.mul_sum, key, Finset.sum_add_distrib, Finset.sum_sub_distrib]
  simp only [Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ite_true, Finset.sum_ite_irrel,
    Finset.sum_const_zero]
  abel

theorem cas_comm_apply (c d : Fin n) (x : V) : G.cas (G.E c d x) = G.E c d (G.cas x) := by
  simpa using congrArg (fun T : Module.End K V => T x) (G.cas_comm c d)

/-- **The Casimir value** `Σ_a λ_a (λ_a + n − 1 − 2a)` of a highest weight `λ`. -/
def casVal (la : Fin n → ℤ) : ℤ := ∑ a : Fin n, la a * (la a + ((n : ℤ) - 1 - 2 * (a : ℕ)))

theorem casVal_eq (la : Fin n → ℤ) :
    ∑ a : Fin n, ∑ b : Fin n, (if a = b then la a ^ 2 else if a < b then la a - la b else 0) = casVal la := by
  have e1 : ∀ a b : Fin n, (if a = b then la a ^ 2 else if a < b then la a - la b else 0) =
      (if a = b then la a ^ 2 else 0) + (if a < b then la a else 0) - (if a < b then la b else 0) := by
    intro a b
    by_cases h : a = b
    · subst h; simp
    · by_cases h' : a < b <;> simp [h, h']
  simp only [e1, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  rw [Finset.sum_comm (f := fun a b => if a < b then la b else 0)]
  have e2 : ∀ a : Fin n, ∑ b : Fin n, (if a < b then la a else 0) = ((n - 1 - a : ℕ) : ℤ) * la a := by
    intro a
    rw [← Finset.sum_filter, Finset.filter_lt_eq_Ioi, Finset.sum_const, Fin.card_Ioi, nsmul_eq_mul]
  have e3 : ∀ b : Fin n, ∑ a : Fin n, (if a < b then la b else 0) = ((b : ℕ) : ℤ) * la b := by
    intro b
    rw [← Finset.sum_filter, Finset.filter_gt_eq_Iio, Finset.sum_const, Fin.card_Iio, nsmul_eq_mul]
  simp only [e2, e3, casVal, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun a _ => ?_
  have : ((n - 1 - a : ℕ) : ℤ) = n - 1 - a := by have := a.isLt; omega
  rw [this]; ring

/-- **The Casimir on a highest weight vector** is `casVal λ`. -/
theorem cas_hw [CharZero K] {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) : G.cas h = (casVal la : K) • h := by
  have key : ∀ a b, (G.E a b * G.E b a) h =
      (((if a = b then la a ^ 2 else if a < b then la a - la b else 0 : ℤ)) : K) • h := by
    intro a b
    rw [Module.End.mul_apply]
    rcases lt_trichotomy a b with hab | rfl | hab
    · rw [comm_apply_ba, hh.2 a b hab, map_zero, zero_add, G.diag_apply hh.1, G.diag_apply hh.1, ← sub_smul,
        ite_eq_right (ne_of_lt hab), ite_eq_left hab]
      push_cast; rfl
    · rw [G.diag_apply hh.1, map_smul, G.diag_apply hh.1, smul_smul, ite_eq_left rfl]; push_cast; ring_nf
    · rw [hh.2 b a hab, map_zero, ite_eq_right (ne_of_gt hab), ite_eq_right (not_lt.mpr hab.le)]; simp
  simp only [cas, LinearMap.sum_apply, key, ← Finset.sum_smul]
  rw [← casVal_eq]; push_cast; rfl

/-- **The Casimir on a highest weight module** is the scalar `casVal λ`. -/
theorem cas_gen [CharZero K] {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) {x : V} (hx : x ∈ G.gen {h}) :
    G.cas x = (casVal la : K) • x := by
  let N : Submodule K V := LinearMap.ker (G.cas - (casVal la : K) • 1)
  have hN : G.Stable N := fun a b y hy => by
    simp only [N, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply] at hy ⊢
    rw [cas_comm_apply, ← map_smul, ← map_sub, hy, map_zero]
  have hhN : h ∈ N := by
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply, G.cas_hw hh, sub_self]
  have : x ∈ N := G.gen_le (Set.singleton_subset_iff.mpr hhN) hN hx
  simpa [N, sub_eq_zero] using this

/-- **The extension by zero of a function on `Fin n` to `ℕ`.** -/
def extN (f : Fin n → ℤ) (i : ℕ) : ℤ := if h : i < n then f ⟨i, h⟩ else 0

theorem sum_eq_sum_extN (f : Fin n → ℤ) : ∑ a, f a = ∑ i ∈ range n, extN f i := by
  rw [← Fin.sum_univ_eq_sum_range]; simp [extN]

theorem psum_eq_sum_extN (x : Fin n → ℤ) {j : ℕ} (hj : j ≤ n) : psum x j = ∑ i ∈ range j, extN x i := by
  have : psum x j = ∑ i ∈ range n, if i < j then extN x i else 0 := by
    rw [psum, ← Fin.sum_univ_eq_sum_range (fun i => if i < j then extN x i else 0)]
    simp [extN]
  rw [this, ← Finset.sum_filter]
  congr 1; ext i; simp only [Finset.mem_filter, Finset.mem_range]; omega

/-- **The Casimir value is strictly monotone** in the dominance order on dominant weights. -/
theorem casVal_lt {ν la : Fin n → ℤ} (hν : Antitone ν) (hla : Antitone la) (hd : DLe ν la) (hne : ν ≠ la) :
    casVal ν < casVal la := by
  set β := la - ν
  set w : Fin n → ℤ := fun a => la a + ν a + ((n : ℤ) - 1 - 2 * (a : ℕ))
  have hdiff : casVal la - casVal ν = ∑ i ∈ range n, extN β i * extN w i := by
    rw [casVal, casVal, ← Finset.sum_sub_distrib]
    rw [show (fun a => la a * (la a + ((n : ℤ) - 1 - 2 * (a : ℕ))) - ν a * (ν a + ((n : ℤ) - 1 - 2 * (a : ℕ)))) =
        fun a => β a * w a from funext fun a => by simp only [β, w, Pi.sub_apply]; ring]
    rw [sum_eq_sum_extN]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [extN]; split_ifs <;> simp
  have hsumβ : ∑ i ∈ range n, extN β i = 0 := by
    rw [← sum_eq_sum_extN]; simp only [β, Pi.sub_apply, Finset.sum_sub_distrib, hd.2, sub_self]
  have hps : ∀ j ≤ n, 0 ≤ ∑ i ∈ range j, extN β i := fun j hj => by
    rw [← psum_eq_sum_extN β hj]; simp only [β]; rw [psum_sub]; linarith [hd.1 j]
  have hw : ∀ i, i + 1 < n → 2 ≤ extN w i - extN w (i + 1) := fun i hi => by
    simp only [extN, hi, show i < n by omega, dite_true, w]
    have h1 := hla (show (⟨i, by omega⟩ : Fin n) ≤ ⟨i + 1, hi⟩ from Fin.le_def.mpr (by simp))
    have h2 := hν (show (⟨i, by omega⟩ : Fin n) ≤ ⟨i + 1, hi⟩ from Fin.le_def.mpr (by simp))
    push_cast; linarith
  have hparts := Finset.sum_range_by_parts' (R := ℤ) (f := extN β) (g := extN w) (n := n)
  simp only [smul_eq_mul, hsumβ, zero_mul, zero_sub] at hparts
  rw [← hdiff] at hparts
  have hterm : ∀ i ∈ range (n - 1), 0 ≤ -((∑ j ∈ range (i + 1), extN β j) * (extN w (i + 1) - extN w i)) := by
    intro i hi
    have := hps (i + 1) (by simp at hi; omega)
    have := hw i (by simp at hi; omega)
    nlinarith
  have hnn : 0 ≤ casVal la - casVal ν := by
    rw [hparts, ← Finset.sum_neg_distrib]; exact Finset.sum_nonneg hterm
  refine lt_of_le_of_ne (by linarith) fun heq => hne ?_
  have hz : ∀ i ∈ range (n - 1), -((∑ j ∈ range (i + 1), extN β j) * (extN w (i + 1) - extN w i)) = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg hterm).mp (by rw [Finset.sum_neg_distrib, ← hparts]; linarith)
  have hp0 : ∀ j ≤ n, ∑ i ∈ range j, extN β i = 0 := by
    intro j hj
    rcases Nat.eq_zero_or_pos j with rfl | hj0
    · simp
    rcases eq_or_lt_of_le hj with rfl | hjn
    · exact hsumβ
    obtain ⟨i, rfl⟩ := Nat.exists_eq_add_of_lt hj0
    have h1 := hz i (by simp; omega)
    have h2 := hw i (by omega)
    rw [show 0 + i + 1 = i + 1 by omega]
    rcases mul_eq_zero.mp (neg_eq_zero.mp h1) with h | h
    · exact h
    · omega
  funext a
  have := hp0 (a + 1) a.isLt
  rw [Finset.sum_range_succ, hp0 a a.isLt.le, zero_add] at this
  simp only [extN, a.isLt, dite_true, β, Pi.sub_apply] at this
  linarith

/-! ## Complete reducibility -/

/-- **The highest weight vectors of `W` (all weights).** -/
def HwIn (W : Submodule K V) : Type _ := {h : V // h ∈ W ∧ ∃ la, G.IsHw la h}

/-- **The highest weight part** `⨆_h U·h` over the highest weight vectors `h` of `W`. -/
def hwSum (W : Submodule K V) : Submodule K V := ⨆ h : G.HwIn W, G.gen {h.1}

/-- **The isotypic part** of type `λ`: `⨆_h U·h` over the highest weight vectors of weight `λ` in `W`. -/
def isoPart (W : Submodule K V) (la : Fin n → ℤ) : Submodule K V :=
  ⨆ h : {h : V // h ∈ W ∧ G.IsHw la h}, G.gen {h.1}

theorem hwSum_stable (W : Submodule K V) : G.Stable (G.hwSum W) := G.stable_iSup fun _ => G.gen_stable _

theorem isoPart_stable (W : Submodule K V) (la : Fin n → ℤ) : G.Stable (G.isoPart W la) :=
  G.stable_iSup fun _ => G.gen_stable _

theorem gen_le_of_mem {W : Submodule K V} (hW : G.Stable W) {h : V} (hh : h ∈ W) : G.gen {h} ≤ W :=
  G.gen_le (Set.singleton_subset_iff.mpr hh) hW


section CR

variable [CharZero K] {W : Submodule K V} [FiniteDimensional K W]

theorem dpow_nil (hW : G.Stable W) : ∃ D, 0 < D ∧ ∀ a b, a ≠ b → ∀ z ∈ W, dpow (G.E a b) D z = 0 := by
  obtain ⟨D, hD⟩ := G.exists_nil hW
  refine ⟨D + 1, D.succ_pos, fun a b hab z hz => ?_⟩
  simp [dpow, pow_succ', Module.End.mul_apply, hD a b hab z hz]

/-- **Highest weights are dominant**: a nonzero highest weight vector of a finite-dimensional stable subspace has an
antitone weight. -/
theorem antitone_of_hw (hW : G.Stable W) {la : Fin n → ℤ} {h : V} (hh : G.IsHw la h) (hhW : h ∈ W) (h0 : h ≠ 0) :
    Antitone la := by
  obtain ⟨D, hD⟩ := G.exists_nil hW
  intro a b hab
  rcases eq_or_lt_of_le hab with rfl | hab
  · exact le_rfl
  by_contra hlt
  exact h0 ((Submodule.mem_bot K).mp (G.mem_of_neg G.stable_bot (ne_of_lt hab) hh.1 (by omega)
    ⟨D, hD b a (ne_of_gt hab) h hhW⟩ (by rw [hh.2 a b hab]; exact zero_mem _)))

/-- **The height `Σ_a (−a) μ_a`**, raised by every `e_a − e_b`, `a < b`. -/
def ht (μ : Fin n → ℤ) : ℤ := ∑ a : Fin n, (-((a : ℕ) : ℤ)) * μ a

theorem ht_add_rt (μ : Fin n → ℤ) {a b : Fin n} (hab : a < b) : ht μ < ht (μ + rt a b) := by
  simp only [ht, Pi.add_apply, mul_add, Finset.sum_add_distrib, rt, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
  simp only [Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  have := Fin.lt_def.mp hab
  omega

/-- **Nonzero stable subspaces contain highest weight vectors.** -/
theorem exists_hw {Z : Submodule K V} [FiniteDimensional K Z] (hZ : G.Stable Z) (hne : Z ≠ ⊥) :
    ∃ la h, G.IsHw la h ∧ h ∈ Z ∧ h ≠ 0 := by
  obtain ⟨x, hxZ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  have hne' : (G.wts Z).Nonempty := by
    by_contra hemp
    rw [Set.not_nonempty_iff_eq_empty] at hemp
    exact hx0 (G.ext_comp fun μ => by
      rw [map_zero]; by_contra h; exact (Set.eq_empty_iff_forall_notMem.mp hemp) μ ⟨x, hxZ, h⟩)
  obtain ⟨μ, hμ, hmax⟩ := (G.wts_finite Z).exists_maximalFor ht _ hne'
  obtain ⟨y, hyZ, hy⟩ := hμ
  refine ⟨μ, G.comp μ y, ⟨G.isWt_comp μ y, fun a b hab => ?_⟩, G.comp_mem hZ μ hyZ, hy⟩
  by_contra h
  have hmem : μ + rt a b ∈ G.wts Z :=
    G.mem_wts_of_isWt (hZ a b _ (G.comp_mem hZ μ hyZ)) ((G.isWt_comp μ y).E_apply a b) h
  have := hmax hmem (ht_add_rt μ hab).le
  linarith [ht_add_rt μ hab]

omit [CharZero K] [FiniteDimensional K W] in
theorem hwSum_le (hW : G.Stable W) : G.hwSum W ≤ W := iSup_le fun h => G.gen_le_of_mem hW h.2.1

omit [CharZero K] [FiniteDimensional K W] in
theorem isoPart_le (hW : G.Stable W) (la : Fin n → ℤ) : G.isoPart W la ≤ W :=
  iSup_le fun h => G.gen_le_of_mem hW h.2.1

omit [FiniteDimensional K W] in
/-- **The highest weight projector** `xproj` over all indices lands in the highest weight vectors. -/
theorem isHw_xproj (hW : G.Stable W) {D : ℕ} (hD : ∀ a b, a ≠ b → ∀ z ∈ W, dpow (G.E a b) D z = 0)
    {μ : Fin n → ℤ} (hμ : Antitone μ) {y : V} (hy : G.IsWt μ y) (hyW : y ∈ W) :
    G.IsHw μ (G.xproj μ D (List.finRange n) y) := by
  refine ⟨G.isWt_xproj hy _ _, fun a b hab => ?_⟩
  exact G.kill_of_chain _ (List.pairwise_lt_finRange n)
    (G.xproj_chain hW hD μ _ (List.pairwise_lt_finRange n) (fun x _ z _ hxz => hμ hxz.le) y hy hyW) a
    (List.mem_finRange a)
    b (List.mem_finRange b) hab

/-- **Highest weight vectors generate** a finite-dimensional stable subspace. -/
theorem le_hwSum (hW : G.Stable W) : W ≤ G.hwSum W := by
  obtain ⟨D, hD0, hD⟩ := G.dpow_nil hW
  obtain ⟨Dn, hDn⟩ := G.exists_nil hW
  set S := (G.wts_finite W).toFinset
  have key : ∀ k : ℕ, ∀ μ, (S.filter fun ν => ht μ < ht ν).card ≤ k → ∀ x ∈ W, G.IsWt μ x → x ∈ G.hwSum W := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
    intro μ hk x hxW hx
    -- raising lands in the highest weight part
    have hup : ∀ a b, a < b → ∀ z ∈ W, G.IsWt (μ + rt a b) z → z ∈ G.hwSum W := by
      intro a b hab z hzW hz
      by_cases hz0 : z = 0
      · rw [hz0]; exact zero_mem _
      have hmem : μ + rt a b ∈ S := (Set.Finite.mem_toFinset _).mpr (G.mem_wts_of_isWt hzW hz hz0)
      refine ih _ ?_ (μ + rt a b) le_rfl z hzW hz
      refine lt_of_lt_of_le (Finset.card_lt_card ?_) hk
      refine ⟨fun ν hν => ?_, fun hsub => ?_⟩
      · simp only [Finset.mem_filter] at hν ⊢; exact ⟨hν.1, (ht_add_rt μ hab).trans hν.2⟩
      have := hsub (Finset.mem_filter.mpr ⟨hmem, ht_add_rt μ hab⟩)
      exact lt_irrefl _ (Finset.mem_filter.mp this).2
    by_cases hdom : Antitone μ
    · have hP := G.isHw_xproj hW hD hdom hx hxW
      have h1 : G.xproj μ D (List.finRange n) x ∈ G.hwSum W :=
        Submodule.mem_iSup_of_mem (⟨_, G.xproj_mem hW _ _ _ hxW, μ, hP⟩ : G.HwIn W) (G.mem_gen_self _)
      have h2 : G.xproj μ D (List.finRange n) x - x ∈ G.hwSum W := by
        refine Submodule.span_le.mpr ?_ (G.xproj_sub_mem hW hD0 μ _ (List.pairwise_lt_finRange n) hx hxW)
        rintro z ⟨a, b, hab, w, hwW, hw, rfl⟩
        exact G.hwSum_stable W b a w (hup a b hab w hwW hw)
      simpa using sub_mem h1 h2
    · obtain ⟨a, b, hab, hlt⟩ : ∃ a b, a < b ∧ μ a < μ b := by
        simp only [Antitone, not_forall, not_le] at hdom
        obtain ⟨a, b, hab, hlt⟩ := hdom
        rcases eq_or_lt_of_le hab with rfl | hab'
        · exact absurd hlt (lt_irrefl _)
        · exact ⟨a, b, hab', hlt⟩
      exact G.mem_of_neg (G.hwSum_stable W) (ne_of_lt hab) hx (by omega) ⟨Dn, hDn b a (ne_of_gt hab) x hxW⟩
        (hup a b hab _ (hW a b x hxW) (hx.E_apply a b))
  intro x hxW
  obtain ⟨s, hs0, hs⟩ := G.exists_sum x
  rw [← hs]
  exact Submodule.sum_mem _ fun μ _ => key _ μ le_rfl _ (G.comp_mem hW μ hxW) (G.isWt_comp μ x)

/-- **Highest weight vectors generate**: a finite-dimensional stable subspace is the sum of the submodules generated
by its highest weight vectors. -/
theorem hwSum_eq (hW : G.Stable W) : G.hwSum W = W := le_antisymm (G.hwSum_le hW) (G.le_hwSum hW)

omit [CharZero K] [FiniteDimensional K W] in
theorem gen_zero : G.gen {(0 : V)} = ⊥ :=
  le_bot_iff.mp (G.gen_le (Set.singleton_subset_iff.mpr (zero_mem _)) G.stable_bot)

/-- **The sum of the Casimir eigenspaces other than that of `casVal ν`.** -/
def casT (ν : Fin n → ℤ) : Submodule K V := ⨆ (c : K) (_ : c ≠ (casVal ν : K)), Module.End.eigenspace G.cas c

omit [FiniteDimensional K W] in
theorem eq_zero_of_mem_casT {ν : Fin n → ℤ} {h : V} (hh : G.IsHw ν h) (hT : h ∈ G.casT ν) : h = 0 := by
  have hdis := (Module.End.eigenspaces_iSupIndep G.cas) (casVal ν : K)
  refine (Submodule.disjoint_def.mp hdis) h ?_ hT
  rw [Module.End.mem_eigenspace_iff]; exact G.cas_hw hh

/-- **Other highest weight modules lie off the Casimir eigenspace of `ν`** in weight `ν`. -/
theorem comp_mem_casT (hW : G.Stable W) {ν : Fin n → ℤ} (hν : Antitone ν) {la : Fin n → ℤ} {h' : V}
    (hh' : G.IsHw la h') (hh'W : h' ∈ W) (hne : la ≠ ν) {y : V} (hy : y ∈ G.gen {h'}) :
    G.comp ν y ∈ G.casT ν := by
  by_cases h0 : G.comp ν y = 0
  · rw [h0]; exact zero_mem _
  have hd := G.dle_of_comp_ne hh' hy h0
  have h'0 : h' ≠ 0 := by
    rintro rfl; rw [gen_zero, Submodule.mem_bot] at hy; exact h0 (by rw [hy, map_zero])
  have hlt := casVal_lt hν (G.antitone_of_hw hW hh' hh'W h'0) hd hne.symm
  refine Submodule.mem_iSup_of_mem ((casVal la : ℤ) : K) (Submodule.mem_iSup_of_mem
    (by exact_mod_cast hlt.ne') ?_)
  rw [Module.End.mem_eigenspace_iff]; exact G.cas_gen hh' (G.comp_mem (G.gen_stable _) ν hy)

/-- **Uniqueness**: a highest weight vector of `W` lying in the lowering images is zero. -/
theorem hw_eq_zero_of_mem_lowSp (hW : G.Stable W) {ν : Fin n → ℤ} {h : V} (hh : G.IsHw ν h) (hhW : h ∈ W)
    (hl : h ∈ G.lowSp W ν) : h = 0 := by
  by_contra h0
  have hν := G.antitone_of_hw hW hh hhW h0
  refine h0 (G.eq_zero_of_mem_casT hh ?_)
  rw [← hh.1]
  refine Submodule.span_induction (p := fun z _ => G.comp ν z ∈ G.casT ν) ?_ (by simp)
    (fun x y _ _ hx hy => by rw [map_add]; exact add_mem hx hy)
    (fun r x _ hx => by rw [map_smul]; exact Submodule.smul_mem _ r hx) hl
  rintro z ⟨a, b, hab, w, hwW, -, rfl⟩
  have hw : w ∈ G.hwSum W := G.le_hwSum hW hwW
  refine Submodule.iSup_induction (motive := fun w => G.comp ν (G.E b a w) ∈ G.casT ν) _ hw ?_ (by simp)
    (fun x y hx hy => by rw [map_add, map_add]; exact add_mem hx hy)
  rintro ⟨h', hh'W, la, hh'⟩ w' hw'
  by_cases hla : la = ν
  · subst hla
    rw [comp_E_apply, rt_swap, sub_neg_eq_add]
    by_cases hc : G.comp (la + rt a b) w' = 0
    · rw [hc, map_zero]; exact zero_mem _
    · exact absurd (G.dle_of_comp_ne hh' hw' hc) (not_dle_add_rt hab)
  · exact G.comp_mem_casT hW hν hh' hh'W hla (G.gen_stable _ b a _ hw')

omit [FiniteDimensional K W] in
theorem isoPart_le_eigenspace (la : Fin n → ℤ) :
    G.isoPart W la ≤ Module.End.eigenspace G.cas (casVal la : K) :=
  iSup_le fun h x hx => by rw [Module.End.mem_eigenspace_iff]; exact G.cas_gen h.2.2 hx

/-- **The other isotypic parts lie off the Casimir eigenspace**: the weight-`ν` components of
`⨆_{λ ≠ ν} isoPart λ` lie in `casT ν`. -/
theorem comp_mem_casT_of_mem (hW : G.Stable W) {ν : Fin n → ℤ} (hν : Antitone ν) {x : V}
    (hx : x ∈ ⨆ (la : Fin n → ℤ) (_ : la ≠ ν), G.isoPart W la) : G.comp ν x ∈ G.casT ν := by
  refine Submodule.iSup_induction (motive := fun z => G.comp ν z ∈ G.casT ν) _ hx ?_ (by simp)
    (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)
  intro la' x hx
  refine Submodule.iSup_induction (motive := fun z => G.comp ν z ∈ G.casT ν) _ hx ?_ (by simp)
    (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)
  intro hla' x hx
  refine Submodule.iSup_induction (motive := fun z => G.comp ν z ∈ G.casT ν) _ hx ?_ (by simp)
    (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)
  rintro ⟨h', hh'W, hh'⟩ y hy
  exact G.comp_mem_casT hW hν hh' hh'W hla' hy

/-- **The isotypic parts are independent.** -/
theorem isoPart_indep (hW : G.Stable W) : iSupIndep (G.isoPart W) := by
  intro la
  rw [disjoint_iff]
  by_contra hne
  set Z := G.isoPart W la ⊓ ⨆ (la' : Fin n → ℤ) (_ : la' ≠ la), G.isoPart W la'
  have hZW : Z ≤ W := inf_le_left.trans (G.isoPart_le hW la)
  have : FiniteDimensional K Z := Submodule.finiteDimensional_of_le hZW
  have hZ : G.Stable Z := (G.isoPart_stable W la).inf (G.stable_iSup fun _ => G.stable_iSup fun _ =>
    G.isoPart_stable W _)
  obtain ⟨ν, z, hz, hzZ, hz0⟩ := G.exists_hw hZ hne
  have hν := G.antitone_of_hw hW hz (hZW hzZ) hz0
  -- `ν = la`
  have hd : DLe ν la ∧ Antitone la := by
    have : G.comp ν z ≠ 0 → DLe ν la ∧ Antitone la := by
      refine Submodule.iSup_induction (motive := fun z => G.comp ν z ≠ 0 → DLe ν la ∧ Antitone la) _ hzZ.1
        ?_ (by simp) ?_
      · rintro ⟨h', hh'W, hh'⟩ y hy hc
        have h'0 : h' ≠ 0 := by
          rintro rfl; rw [gen_zero, Submodule.mem_bot] at hy; exact hc (by rw [hy, map_zero])
        exact ⟨G.dle_of_comp_ne hh' hy hc, G.antitone_of_hw hW hh' hh'W h'0⟩
      · intro x y hx hy hc
        by_cases hx0 : G.comp ν x = 0
        · rw [map_add, hx0, zero_add] at hc; exact hy hc
        · exact hx hx0
    exact this (by rwa [hz.1])
  have hcas : (casVal ν : K) = casVal la := by
    have h1 := (Module.End.mem_eigenspace_iff.mp (G.isoPart_le_eigenspace la hzZ.1))
    rw [G.cas_hw hz] at h1
    have h2 : ((casVal ν : K) - casVal la) • z = 0 := by rw [sub_smul, h1, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h2).resolve_right hz0)
  have hνla : ν = la := by
    by_contra h'
    exact absurd (by exact_mod_cast hcas : casVal ν = casVal la) (casVal_lt hν hd.2 hd.1 h').ne
  subst hνla
  -- `z` lies off the Casimir eigenspace of `ν`
  refine hz0 (G.eq_zero_of_mem_casT hz ?_)
  rw [← hz.1]
  exact G.comp_mem_casT_of_mem hW hν hzZ.2

/-- **The isotypic parts exhaust `W`.** -/
theorem iSup_isoPart (hW : G.Stable W) : ⨆ la, G.isoPart W la = W := by
  refine le_antisymm (iSup_le fun la => G.isoPart_le hW la) ((G.le_hwSum hW).trans (iSup_le fun h => ?_))
  obtain ⟨h, hhW, la, hh⟩ := h
  exact le_iSup_of_le la (le_iSup_of_le ⟨h, hhW, hh⟩ le_rfl)

/-- **A highest weight vector of weight `ν` in the other isotypic parts is zero.** -/
theorem hw_eq_zero_of_mem_iSup (hW : G.Stable W) {ν : Fin n → ℤ} {h : V} (hh : G.IsHw ν h) (hhW : h ∈ W)
    (hx : h ∈ ⨆ (la : Fin n → ℤ) (_ : la ≠ ν), G.isoPart W la) : h = 0 := by
  by_contra h0
  refine h0 (G.eq_zero_of_mem_casT hh ?_)
  rw [← hh.1]
  exact G.comp_mem_casT_of_mem hW (G.antitone_of_hw hW hh hhW h0) hx

/-! ## Type projectors -/

/-- **The sum of the isotypic parts with type in `T`.** -/
def isoSum (W : Submodule K V) (T : Set (Fin n → ℤ)) : Submodule K V := ⨆ la ∈ T, G.isoPart W la

omit [CharZero K] [FiniteDimensional K W] in
theorem isoSum_stable (W : Submodule K V) (T : Set (Fin n → ℤ)) : G.Stable (G.isoSum W T) :=
  G.stable_iSup fun _ => G.stable_iSup fun _ => G.isoPart_stable W _

omit [CharZero K] [FiniteDimensional K W] in
theorem isoSum_le (hW : G.Stable W) (T : Set (Fin n → ℤ)) : G.isoSum W T ≤ W :=
  iSup₂_le fun la _ => G.isoPart_le hW la

theorem isoSum_sup (hW : G.Stable W) (T : Set (Fin n → ℤ)) : G.isoSum W T ⊔ G.isoSum W Tᶜ = W := by
  rw [isoSum, isoSum]
  simp only [Set.mem_compl_iff]
  rw [← iSup_split (G.isoPart W) (· ∈ T)]
  exact G.iSup_isoPart hW

theorem isoSum_disjoint (hW : G.Stable W) (T : Set (Fin n → ℤ)) : Disjoint (G.isoSum W T) (G.isoSum W Tᶜ) :=
  (G.isoPart_indep hW).disjoint_biSup_biSup disjoint_compl_right

omit [CharZero K] [FiniteDimensional K W] in
variable (W) in
/-- **A complement of `W` in `V`.** -/
def compl : Submodule K V := (Submodule.exists_isCompl W).choose

omit [CharZero K] [FiniteDimensional K W] in
theorem isCompl_compl : IsCompl W (compl W) := (Submodule.exists_isCompl W).choose_spec

theorem isCompl_isoSum (hW : G.Stable W) (T : Set (Fin n → ℤ)) :
    IsCompl (G.isoSum W T) (G.isoSum W Tᶜ ⊔ compl W) := by
  constructor
  · rw [disjoint_iff]
    have h1 : G.isoSum W T ⊓ (G.isoSum W Tᶜ ⊔ compl W) ≤ G.isoSum W T ⊓ G.isoSum W Tᶜ := by
      refine le_inf inf_le_left ?_
      calc G.isoSum W T ⊓ (G.isoSum W Tᶜ ⊔ compl W) ≤ (G.isoSum W Tᶜ ⊔ compl W) ⊓ W :=
            le_inf inf_le_right (inf_le_left.trans (G.isoSum_le hW T))
        _ = G.isoSum W Tᶜ ⊔ compl W ⊓ W := sup_inf_assoc_of_le _ (G.isoSum_le hW Tᶜ)
        _ = G.isoSum W Tᶜ := by rw [inf_comm, (isCompl_compl (W := W)).inf_eq_bot, sup_bot_eq]
    exact le_bot_iff.mp (h1.trans (disjoint_iff.mp (G.isoSum_disjoint hW T)).le)
  · rw [codisjoint_iff, ← sup_assoc, G.isoSum_sup hW T]; exact (isCompl_compl (W := W)).sup_eq_top

/-- **The type projector** onto the isotypic parts of type in `T`, along the other isotypic parts and a
complement of `W`. -/
def typeProj (hW : G.Stable W) (T : Set (Fin n → ℤ)) : Module.End K V :=
  Submodule.projection _ _ (G.isCompl_isoSum hW T)

theorem typeProj_of_mem (hW : G.Stable W) (T : Set (Fin n → ℤ)) {x : V} (hx : x ∈ G.isoSum W T) :
    G.typeProj hW T x = x :=
  Submodule.projection_apply_of_mem_left _ hx

theorem typeProj_of_mem_compl (hW : G.Stable W) (T : Set (Fin n → ℤ)) {x : V} (hx : x ∈ G.isoSum W Tᶜ) :
    G.typeProj hW T x = 0 :=
  Submodule.projection_apply_of_mem_right _ (Submodule.mem_sup_left hx)

theorem typeProj_mem (hW : G.Stable W) (T : Set (Fin n → ℤ)) (x : V) : G.typeProj hW T x ∈ G.isoSum W T :=
  Submodule.projection_apply_mem _ x

/-- **The type projector on `W`**: the `T`-part of the decomposition. -/
theorem typeProj_apply (hW : G.Stable W) (T : Set (Fin n → ℤ)) {y z : V} (hy : y ∈ G.isoSum W T)
    (hz : z ∈ G.isoSum W Tᶜ) : G.typeProj hW T (y + z) = y := by
  rw [map_add, G.typeProj_of_mem hW T hy, G.typeProj_of_mem_compl hW T hz, add_zero]

theorem exists_split (hW : G.Stable W) (T : Set (Fin n → ℤ)) {x : V} (hx : x ∈ W) :
    ∃ y ∈ G.isoSum W T, ∃ z ∈ G.isoSum W Tᶜ, x = y + z := by
  rw [← G.isoSum_sup hW T] at hx
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
  exact ⟨y, hy, z, hz, rfl⟩

/-- **Type projectors are equivariant** on `W`. -/
theorem typeProj_E (hW : G.Stable W) (T : Set (Fin n → ℤ)) {x : V} (hx : x ∈ W) (a b : Fin n) :
    G.typeProj hW T (G.E a b x) = G.E a b (G.typeProj hW T x) := by
  obtain ⟨y, hy, z, hz, rfl⟩ := G.exists_split hW T hx
  rw [map_add, G.typeProj_apply hW T (G.isoSum_stable W T a b y hy) (G.isoSum_stable W Tᶜ a b z hz),
    G.typeProj_apply hW T hy hz]

/-- **Type projectors commute with the weight projections** on `W`. -/
theorem typeProj_comp (hW : G.Stable W) (T : Set (Fin n → ℤ)) {x : V} (hx : x ∈ W) (μ : Fin n → ℤ) :
    G.typeProj hW T (G.comp μ x) = G.comp μ (G.typeProj hW T x) := by
  obtain ⟨y, hy, z, hz, rfl⟩ := G.exists_split hW T hx
  rw [map_add, G.typeProj_apply hW T (G.comp_mem (G.isoSum_stable W T) μ hy)
    (G.comp_mem (G.isoSum_stable W Tᶜ) μ hz), G.typeProj_apply hW T hy hz]

theorem typeProj_mem_W (hW : G.Stable W) (T : Set (Fin n → ℤ)) (x : V) : G.typeProj hW T x ∈ W :=
  G.isoSum_le hW T (G.typeProj_mem hW T x)

omit [FiniteDimensional K W] in
/-- **Equivariant operators preserve the isotypic parts.** -/
theorem map_isoPart {S : Module.End K V} (hW : G.Stable W) (hS : ∀ x ∈ W, S x ∈ W)
    (hSE : ∀ a b, ∀ x ∈ W, S (G.E a b x) = G.E a b (S x)) (la : Fin n → ℤ) {x : V} (hx : x ∈ G.isoPart W la) :
    S x ∈ G.isoPart W la := by
  refine Submodule.iSup_induction (motive := fun x => S x ∈ G.isoPart W la) _ hx ?_ (by simp)
    (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)
  rintro ⟨h, hhW, hh⟩ y hy
  have hSh : G.IsHw la (S h) := by
    refine ⟨G.isWt_of_diag fun a => ?_, fun a b hab => ?_⟩
    · rw [← hSE a a h hhW, G.diag_apply hh.1, map_smul]
    · rw [← hSE a b h hhW, hh.2 a b hab, map_zero]
  let N : Submodule K V := (G.gen {S h}).comap S ⊓ W
  have hN : G.Stable N := by
    intro a b y hy
    refine Submodule.mem_inf.mpr ⟨?_, hW a b y hy.2⟩
    change S (G.E a b y) ∈ G.gen {S h}
    rw [hSE a b y hy.2]
    exact G.gen_stable _ a b _ hy.1
  have hy' : y ∈ N := G.gen_le (Set.singleton_subset_iff.mpr
    (Submodule.mem_inf.mpr ⟨Submodule.mem_comap.mpr (G.mem_gen_self (S h)), hhW⟩)) hN hy
  exact Submodule.mem_iSup_of_mem (⟨S h, hS h hhW, hSh⟩ : {h : V // h ∈ W ∧ G.IsHw la h}) hy'.1

omit [FiniteDimensional K W] in
theorem map_isoSum {S : Module.End K V} (hW : G.Stable W) (hS : ∀ x ∈ W, S x ∈ W)
    (hSE : ∀ a b, ∀ x ∈ W, S (G.E a b x) = G.E a b (S x)) (T : Set (Fin n → ℤ)) {x : V}
    (hx : x ∈ G.isoSum W T) : S x ∈ G.isoSum W T := by
  refine Submodule.iSup_induction (motive := fun x => S x ∈ G.isoSum W T) _ hx ?_ (by simp)
    (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)
  intro la x hx
  refine Submodule.iSup_induction (motive := fun x => S x ∈ G.isoSum W T) _ hx ?_ (by simp)
    (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)
  intro hla x hx
  exact Submodule.mem_iSup_of_mem la (Submodule.mem_iSup_of_mem hla (G.map_isoPart hW hS hSE la hx))

/-- **Type projectors commute with equivariant operators** on `W`: an operator preserving `W` and commuting with the
action on `W` commutes there with every type projector. -/
theorem typeProj_comm {S : Module.End K V} (hW : G.Stable W) (hS : ∀ x ∈ W, S x ∈ W)
    (hSE : ∀ a b, ∀ x ∈ W, S (G.E a b x) = G.E a b (S x)) (T : Set (Fin n → ℤ)) {x : V} (hx : x ∈ W) :
    S (G.typeProj hW T x) = G.typeProj hW T (S x) := by
  obtain ⟨y, hy, z, hz, rfl⟩ := G.exists_split hW T hx
  rw [G.typeProj_apply hW T hy hz, map_add,
    G.typeProj_apply hW T (G.map_isoSum hW hS hSE T hy) (G.map_isoSum hW hS hSE Tᶜ hz)]

omit [CharZero K] [FiniteDimensional K W] in
theorem isoSum_singleton (W : Submodule K V) (la : Fin n → ℤ) : G.isoSum W {la} = G.isoPart W la := by
  simp [isoSum]

omit [CharZero K] [FiniteDimensional K W] in
theorem isoSum_compl_singleton (W : Submodule K V) (la : Fin n → ℤ) :
    G.isoSum W {la}ᶜ = ⨆ (la' : Fin n → ℤ) (_ : la' ≠ la), G.isoPart W la' := by
  simp [isoSum]

omit [CharZero K] [FiniteDimensional K W] in
/-- **The weight-`λ` vectors of the isotypic part of type `λ` are highest weight vectors.** -/
theorem isHw_of_mem_isoPart {la : Fin n → ℤ} {y : V} (hy : y ∈ G.isoPart W la) (hyw : G.IsWt la y) :
    G.IsHw la y := by
  refine ⟨hyw, fun a b hab => ?_⟩
  rw [← hyw]
  refine Submodule.iSup_induction (motive := fun y => G.E a b (G.comp la y) = 0) _ hy ?_ (by simp)
    (fun x y hx hy => by rw [map_add, map_add, hx, hy, add_zero])
  intro i x hx
  obtain ⟨h, _, hh⟩ := i
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (G.comp_mem_span hh hx)
  rw [← hc, map_smul, hh.2 a b hab, smul_zero]

/-- **The extremal projector is the isotypic projector on the dominant weight spaces**: for `μ` dominant and
`x ∈ W` of weight `μ`, `xproj μ x` is the component of `x` in the isotypic part of type `μ`. -/
theorem xproj_eq_typeProj (hW : G.Stable W) {D : ℕ} (hD0 : 0 < D)
    (hD : ∀ a b, a ≠ b → ∀ z ∈ W, dpow (G.E a b) D z = 0) {μ : Fin n → ℤ} (hμ : Antitone μ) {x : V}
    (hx : G.IsWt μ x) (hxW : x ∈ W) : G.xproj μ D (List.finRange n) x = G.typeProj hW {μ} x := by
  obtain ⟨y, hy, z, hz, hxyz⟩ := G.exists_split hW {μ} hxW
  have hx' : x = G.comp μ y + G.comp μ z := by rw [← map_add, ← hxyz, hx]
  have hy' : G.comp μ y ∈ G.isoPart W μ := by
    rw [← G.isoSum_singleton]; exact G.comp_mem (G.isoSum_stable W _) μ hy
  have hz' : G.comp μ z ∈ G.isoSum W {μ}ᶜ := G.comp_mem (G.isoSum_stable W _) μ hz
  have hzW : G.comp μ z ∈ W := G.isoSum_le hW _ hz'
  have h1 : G.xproj μ D (List.finRange n) (G.comp μ y) = G.comp μ y :=
    G.xproj_of_hw μ hD0 _ (List.pairwise_lt_finRange n) fun a _ b _ hab =>
      (G.isHw_of_mem_isoPart hy' (G.isWt_comp μ y)).2 a b hab
  have h2 : G.xproj μ D (List.finRange n) (G.comp μ z) = 0 := by
    refine G.hw_eq_zero_of_mem_iSup hW (G.isHw_xproj hW hD hμ (G.isWt_comp μ z) hzW)
      (G.xproj_mem hW _ _ _ hzW) ?_
    rw [← G.isoSum_compl_singleton]
    exact G.xproj_mem (G.isoSum_stable W _) _ _ _ hz'
  rw [hx', map_add, h1, h2, add_zero, G.typeProj_apply hW {μ} (by rwa [G.isoSum_singleton]) hz']

end CR

/-! ## Restriction to a stable subspace, and the adjoint action on its endomorphisms -/

section Restr

variable [CharZero K] {W : Submodule K V}

/-- **The restriction of `G` to a stable subspace.** -/
def restr (hW : G.Stable W) : GlRep K W n where
  E a b := (G.E a b).restrict (hW a b)
  comm a b c d := by
    ext x
    have h := congrArg (fun T : Module.End K V => T x) (G.comm a b c d)
    simp only [LinearMap.sub_apply, Module.End.mul_apply] at h
    simp only [LinearMap.sub_apply, Module.End.mul_apply, LinearMap.coe_restrict_apply, Submodule.coe_sub, h]
    split_ifs <;> simp
  comp μ := (G.comp μ).restrict fun _ hx => G.comp_mem hW μ hx
  comp_mul μ ν := by
    ext x
    simp only [Module.End.mul_apply, LinearMap.coe_restrict_apply, comp_comp]
    split_ifs <;> simp
  exists_sum x := by
    obtain ⟨s, hs0, hs⟩ := G.exists_sum (x : V)
    exact ⟨s, fun μ hμ => Subtype.ext (by simpa using hs0 μ hμ), Subtype.ext (by simpa using hs)⟩
  diag_comp μ a := by
    ext x
    simp only [Module.End.mul_apply, LinearMap.coe_restrict_apply, LinearMap.smul_apply, Submodule.coe_smul]
    exact G.diag_apply (G.isWt_comp μ x) a
  comp_E μ a b := by
    ext x
    simp only [Module.End.mul_apply, LinearMap.coe_restrict_apply]
    exact G.comp_E_apply μ a b x

theorem restr_E (hW : G.Stable W) (a b : Fin n) (x : W) : ((G.restr hW).E a b x : V) = G.E a b x := rfl

theorem restr_comp (hW : G.Stable W) (μ : Fin n → ℤ) (x : W) : ((G.restr hW).comp μ x : V) = G.comp μ x := rfl

end Restr

section EndRep

variable [CharZero K] {U : Type*} [AddCommGroup U] [Module K U] [FiniteDimensional K U] (G' : GlRep K U n)

/-- **The (finitely many) weights of a finite-dimensional representation.** -/
def wtsU : Finset (Fin n → ℤ) := (G'.wts_finite ⊤).toFinset

omit [CharZero K] in
theorem comp_eq_zero_of_notMem {ξ : Fin n → ℤ} (h : ξ ∉ G'.wtsU) : G'.comp ξ = 0 := by
  ext x; by_contra hx; exact h ((Set.Finite.mem_toFinset _).mpr ⟨x, Submodule.mem_top, hx⟩)

omit [CharZero K] in
theorem sum_compU : ∑ ν ∈ G'.wtsU, G'.comp ν = 1 := by
  ext x; simp only [LinearMap.sum_apply, Module.End.one_apply]
  exact G'.sum_comp_of_supp fun μ hμ => by rw [comp_eq_zero_of_notMem G' hμ]; rfl

/-- **The adjoint action** `T ↦ E a b T − T E a b` on `End U`. -/
def adE (a b : Fin n) : Module.End K (Module.End K U) :=
  LinearMap.mulLeft K (G'.E a b) - LinearMap.mulRight K (G'.E a b)

omit [CharZero K] [FiniteDimensional K U] in
theorem adE_apply (a b : Fin n) (T : Module.End K U) : G'.adE a b T = G'.E a b * T - T * G'.E a b := rfl

/-- **The weight projections of `End U`**: `T ↦ Σ_ν comp (ν + μ) T comp ν`. -/
def endComp (μ : Fin n → ℤ) : Module.End K (Module.End K U) :=
  ∑ ν ∈ G'.wtsU, LinearMap.mulLeft K (G'.comp (ν + μ)) * LinearMap.mulRight K (G'.comp ν)

omit [CharZero K] in
theorem endComp_apply (μ : Fin n → ℤ) (T : Module.End K U) :
    G'.endComp μ T = ∑ ν ∈ G'.wtsU, G'.comp (ν + μ) * T * G'.comp ν := by
  simp [endComp, mul_assoc]

/-- **The adjoint representation** on `End U`. -/
def endRep : GlRep K (Module.End K U) n where
  E := G'.adE
  comm a b c d := by
    ext1 T
    simp only [LinearMap.sub_apply, Module.End.mul_apply, adE_apply]
    have h := G'.comm a b c d
    have : G'.E a b * (G'.E c d * T - T * G'.E c d) - (G'.E c d * T - T * G'.E c d) * G'.E a b -
        (G'.E c d * (G'.E a b * T - T * G'.E a b) - (G'.E a b * T - T * G'.E a b) * G'.E c d) =
        (G'.E a b * G'.E c d - G'.E c d * G'.E a b) * T - T * (G'.E a b * G'.E c d - G'.E c d * G'.E a b) := by
      noncomm_ring
    rw [this, h]
    split_ifs <;> simp [adE_apply] <;> noncomm_ring
  comp := G'.endComp
  comp_mul μ ν := by
    ext1 T
    simp only [Module.End.mul_apply, endComp_apply, Finset.mul_sum, Finset.sum_mul]
    have key : ∀ ξ ζ, G'.comp (ξ + μ) * (G'.comp (ζ + ν) * T * G'.comp ζ) * G'.comp ξ =
        if ζ = ξ ∧ μ = ν then G'.comp (ξ + ν) * T * G'.comp ξ else 0 := by
      intro ξ ζ
      have h1 := G'.comp_mul ζ ξ
      have h2 := G'.comp_mul (ξ + μ) (ζ + ν)
      rw [show G'.comp (ξ + μ) * (G'.comp (ζ + ν) * T * G'.comp ζ) * G'.comp ξ =
        (G'.comp (ξ + μ) * G'.comp (ζ + ν)) * T * (G'.comp ζ * G'.comp ξ) by noncomm_ring, h1, h2]
      by_cases hζ : ζ = ξ
      · subst hζ
        by_cases hμ : μ = ν
        · subst hμ; simp
        · simp [hμ, add_right_injective ζ |>.ne hμ]
      · simp [hζ]
    simp only [key]
    split_ifs with hμ
    · subst hμ; simp [endComp_apply]
    · simp [hμ]
  exists_sum T := by
    classical
    refine ⟨(G'.wtsU ×ˢ G'.wtsU).image fun q => q.1 - q.2, fun μ hμ => ?_, ?_⟩
    · rw [endComp_apply]
      refine Finset.sum_eq_zero fun ν hν => ?_
      have : ν + μ ∉ G'.wtsU := fun h => hμ (Finset.mem_image.mpr ⟨(ν + μ, ν), Finset.mem_product.mpr ⟨h, hν⟩,
        by simp⟩)
      rw [comp_eq_zero_of_notMem G' this, zero_mul, zero_mul]
    · simp only [endComp_apply]
      rw [Finset.sum_comm]
      have hsumν : ∀ ν ∈ G'.wtsU,
          ∑ μ ∈ (G'.wtsU ×ˢ G'.wtsU).image (fun q => q.1 - q.2), G'.comp (ν + μ) = 1 := by
        intro ν hν
        rw [← Finset.sum_image (f := G'.comp) (fun x _ y _ h => add_left_cancel h), ← sum_compU G']
        symm
        refine Finset.sum_subset (fun ξ hξ => Finset.mem_image.mpr ⟨ξ - ν, Finset.mem_image.mpr
          ⟨(ξ, ν), Finset.mem_product.mpr ⟨hξ, hν⟩, rfl⟩, by abel⟩) fun ξ _ hξ => comp_eq_zero_of_notMem G' hξ
      calc ∑ ν ∈ G'.wtsU, ∑ μ ∈ (G'.wtsU ×ˢ G'.wtsU).image (fun q => q.1 - q.2), G'.comp (ν + μ) * T * G'.comp ν
          = ∑ ν ∈ G'.wtsU, T * G'.comp ν := Finset.sum_congr rfl fun ν hν => by
            rw [← Finset.sum_mul, ← Finset.sum_mul, hsumν ν hν, one_mul]
        _ = T := by rw [← Finset.mul_sum, sum_compU, mul_one]
  diag_comp μ a := by
    ext1 T
    simp only [Module.End.mul_apply, LinearMap.smul_apply, endComp_apply, adE_apply, Finset.mul_sum,
      Finset.sum_mul, Finset.smul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun ν _ => ?_
    have h1 := G'.diag_comp (ν + μ) a
    have h2 : G'.comp ν * G'.E a a = (ν a : K) • G'.comp ν := by
      rw [G'.comp_E, sub_self, sub_zero, G'.diag_comp]
    rw [show G'.E a a * (G'.comp (ν + μ) * T * G'.comp ν) - G'.comp (ν + μ) * T * G'.comp ν * G'.E a a =
      (G'.E a a * G'.comp (ν + μ)) * T * G'.comp ν - G'.comp (ν + μ) * T * (G'.comp ν * G'.E a a) by noncomm_ring,
      h1, h2]
    simp only [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, Pi.add_apply, ← sub_smul]
    congr 1; push_cast; ring
  comp_E μ a b := by
    ext1 T
    classical
    set r : Fin n → ℤ := Pi.single a 1 - Pi.single b 1
    have hR : ∀ ξ, G'.comp ξ * G'.E a b = G'.E a b * G'.comp (ξ - r) := fun ξ => G'.comp_E ξ a b
    have hL : ∀ ξ, G'.E a b * G'.comp ξ = G'.comp (ξ + r) * G'.E a b := fun ξ => by
      rw [hR, add_sub_cancel_right]
    simp only [Module.End.mul_apply, endComp_apply, adE_apply, Finset.mul_sum, Finset.sum_mul,
      ← Finset.sum_sub_distrib]
    -- the two sums of the `T E` terms agree after the shift `ν ↦ ν + r`
    set g : (Fin n → ℤ) → Module.End K U := fun ξ => G'.comp (ξ + (μ - r)) * T * G'.comp ξ * G'.E a b
    have hg1 : ∀ ξ ∈ G'.wtsU, ξ - r ∉ G'.wtsU → g ξ = 0 := fun ξ _ h => by
      simp only [g, mul_assoc, hR ξ, comp_eq_zero_of_notMem G' h, mul_zero]
    have hg2 : ∀ ξ, ξ ∉ G'.wtsU → g ξ = 0 := fun ξ h => by
      simp only [g, comp_eq_zero_of_notMem G' h, mul_zero, zero_mul]
    have hshift : ∑ ν ∈ G'.wtsU, G'.comp (ν + μ) * T * (G'.E a b * G'.comp ν) = ∑ ν ∈ G'.wtsU, g ν := by
      have e1 : ∑ ν ∈ G'.wtsU, G'.comp (ν + μ) * T * (G'.E a b * G'.comp ν) =
          ∑ ν ∈ G'.wtsU, g (ν + r) := Finset.sum_congr rfl fun ν _ => by
        simp only [g, hL]; rw [show ν + r + (μ - r) = ν + μ by abel]; noncomm_ring
      rw [e1, ← Finset.sum_image (f := g) (fun x _ y _ h => add_right_cancel h)]
      have hu1 : ∑ x ∈ G'.wtsU.image (· + r), g x = ∑ x ∈ G'.wtsU ∪ G'.wtsU.image (· + r), g x :=
        Finset.sum_subset Finset.subset_union_right fun ξ hξ hξ' => by
          have : ξ ∈ G'.wtsU := by
            rcases Finset.mem_union.mp hξ with h | h
            · exact h
            · exact absurd h hξ'
          exact hg1 ξ this fun h => hξ' (Finset.mem_image.mpr ⟨ξ - r, h, by abel⟩)
      have hu2 : ∑ x ∈ G'.wtsU, g x = ∑ x ∈ G'.wtsU ∪ G'.wtsU.image (· + r), g x :=
        Finset.sum_subset Finset.subset_union_left fun ξ _ hξ' => hg2 ξ hξ'
      rw [hu1, hu2]
    have h1 : ∀ ν, G'.comp (ν + μ) * (G'.E a b * T - T * G'.E a b) * G'.comp ν =
        G'.E a b * (G'.comp (ν + (μ - r)) * T * G'.comp ν) - G'.comp (ν + μ) * T * (G'.E a b * G'.comp ν) := by
      intro ν
      rw [mul_sub, sub_mul, ← mul_assoc, hR, show ν + μ - r = ν + (μ - r) by abel]; noncomm_ring
    simp only [h1, Finset.sum_sub_distrib, hshift, g]


omit [CharZero K] in
theorem endRep_E (a b : Fin n) (T : Module.End K U) : G'.endRep.E a b T = G'.E a b * T - T * G'.E a b := rfl

omit [CharZero K] in
theorem endRep_comp (μ : Fin n → ℤ) (T : Module.End K U) :
    G'.endRep.comp μ T = ∑ ν ∈ G'.wtsU, G'.comp (ν + μ) * T * G'.comp ν := endComp_apply G' μ T

/-- **Invariant highest weight vectors**: a highest weight vector of weight `0` in `End U` commutes with the action. -/
theorem comm_of_isHw_zero {T : Module.End K U} (hT : G'.endRep.IsHw 0 T) (a b : Fin n) :
    G'.E a b * T = T * G'.E a b := by
  rw [← sub_eq_zero, ← endRep_E]
  rcases lt_trichotomy a b with hab | rfl | hab
  · exact hT.2 a b hab
  · rw [G'.endRep.diag_apply hT.1]; simp
  · have hy := hT.1.E_apply a b
    simp only [zero_add] at hy
    have hfd : FiniteDimensional K (⊤ : Submodule K (Module.End K U)) := inferInstance
    obtain ⟨D, hD⟩ := G'.endRep.exists_nil (W := ⊤) (fun _ _ _ _ => Submodule.mem_top)
    refine (Submodule.mem_bot K).mp (G'.endRep.mem_of_neg G'.endRep.stable_bot (ne_of_lt hab) hy ?_
      ⟨D, hD a b (ne_of_gt hab) _ Submodule.mem_top⟩ ?_)
    · rw [rt_apply_left (ne_of_gt hab), rt_apply_right (ne_of_gt hab)]; norm_num
    · rw [comm_apply_ba, hT.2 b a hab, map_zero, zero_add, G'.endRep.diag_apply hT.1, G'.endRep.diag_apply hT.1]
      simp

/-- **The averaging operator** `Π₀ = xproj₀ ∘ comp₀` on `End U`: its values are invariant operators. -/
def avg : Module.End K (Module.End K U) :=
  G'.endRep.xproj 0 (Classical.choose (G'.endRep.dpow_nil (W := ⊤) fun _ _ _ _ => Submodule.mem_top))
    (List.finRange n) * G'.endRep.comp 0

theorem avg_comm (S : Module.End K U) (a b : Fin n) : G'.E a b * G'.avg S = G'.avg S * G'.E a b := by
  obtain ⟨hD0, hD⟩ := Classical.choose_spec (G'.endRep.dpow_nil (W := ⊤) fun _ _ _ _ => Submodule.mem_top)
  refine G'.comm_of_isHw_zero (G'.endRep.isHw_xproj (fun _ _ _ _ => Submodule.mem_top) hD
    (fun _ _ _ => le_rfl) (G'.endRep.isWt_comp 0 S) Submodule.mem_top) a b

/-- **Averaging preserves stable operator subspaces.** -/
theorem avg_mem {A : Submodule K (Module.End K U)} (hA : G'.endRep.Stable A) {S : Module.End K U} (hS : S ∈ A) :
    G'.avg S ∈ A := by
  simp only [avg, Module.End.mul_apply]
  exact G'.endRep.xproj_mem hA _ _ _ (G'.endRep.comp_mem hA 0 hS)

/-- **The operators preserving a subspace `X` of `U` form a stable operator subspace (for `X` stable).** -/
def presSub (X : Submodule K U) : Submodule K (Module.End K U) where
  carrier := {T | ∀ x ∈ X, T x ∈ X}
  add_mem' hT hT' x hx := X.add_mem (hT x hx) (hT' x hx)
  zero_mem' _ _ := X.zero_mem
  smul_mem' c _ hT x hx := X.smul_mem c (hT x hx)

/-- **The operators killing a subspace `X` of `U`.** -/
def killSub (X : Submodule K U) : Submodule K (Module.End K U) where
  carrier := {T | ∀ x ∈ X, T x = 0}
  add_mem' hT hT' x hx := by simp [hT x hx, hT' x hx]
  zero_mem' _ _ := rfl
  smul_mem' _ _ hT x hx := by simp [hT x hx]

omit [CharZero K] in
theorem presSub_stable {X : Submodule K U} (hX : G'.Stable X) : G'.endRep.Stable (presSub X) := by
  intro a b T hT x hx
  rw [endRep_E, LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply]
  exact X.sub_mem (hX a b _ (hT x hx)) (hT _ (hX a b x hx))

omit [CharZero K] in
theorem killSub_stable {X : Submodule K U} (hX : G'.Stable X) : G'.endRep.Stable (killSub X) := by
  intro a b T hT x hx
  rw [endRep_E, LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply, hT x hx, map_zero,
    hT _ (hX a b x hx), sub_zero]

/-- **The trace on a subspace** `X`: `T ↦ tr(π_X T ι_X)` (`π_X` a projection onto `X`). -/
def trOn (X : Submodule K U) (T : Module.End K U) : K :=
  LinearMap.trace K X (X.projectionOnto _ (isCompl_compl (W := X)) ∘ₗ T ∘ₗ X.subtype)

omit [CharZero K] [FiniteDimensional K U] in
theorem trOn_mul_comm {X : Submodule K U} {T T' : Module.End K U} (hT : T ∈ presSub X)
    (hT' : T' ∈ presSub X) : trOn X (T * T') = trOn X (T' * T) := by
  have key : ∀ A B : Module.End K U, B ∈ presSub X → X.projectionOnto _ (isCompl_compl (W := X)) ∘ₗ (A * B) ∘ₗ
      X.subtype = (X.projectionOnto _ (isCompl_compl (W := X)) ∘ₗ A ∘ₗ X.subtype) *
        (X.projectionOnto _ (isCompl_compl (W := X)) ∘ₗ B ∘ₗ X.subtype) := by
    intro A B hB
    ext x
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.coe_subtype, Module.End.mul_apply]
    rw [Submodule.projectionOnto_apply_of_mem_left _ (hB x x.2)]
  rw [trOn, trOn, key _ _ hT', key _ _ hT, LinearMap.trace_mul_comm]


omit [CharZero K] [FiniteDimensional K U] in
theorem trOn_add (X : Submodule K U) (T T' : Module.End K U) : trOn X (T + T') = trOn X T + trOn X T' := by
  simp [trOn, LinearMap.add_comp, LinearMap.comp_add]

omit [CharZero K] [FiniteDimensional K U] in
theorem trOn_smul (X : Submodule K U) (c : K) (T : Module.End K U) : trOn X (c • T) = c * trOn X T := by
  simp [trOn, LinearMap.smul_comp, LinearMap.comp_smul]

omit [CharZero K] [FiniteDimensional K U] in
theorem trOn_zero (X : Submodule K U) : trOn X 0 = 0 := by simp [trOn]

omit [CharZero K] [FiniteDimensional K U] in
theorem trOn_sum (X : Submodule K U) {ι : Type*} (s : Finset ι) (T : ι → Module.End K U) :
    trOn X (∑ i ∈ s, T i) = ∑ i ∈ s, trOn X (T i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [trOn_zero]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, trOn_add, ih]

omit [CharZero K] [FiniteDimensional K U] in
theorem trOn_sub (X : Submodule K U) (T T' : Module.End K U) : trOn X (T - T') = trOn X T - trOn X T' := by
  simp [trOn, LinearMap.sub_comp, LinearMap.comp_sub]

/-- **Averaging preserves traces on stable subspaces.** -/
theorem trOn_avg {X : Submodule K U} (hX : G'.Stable X) {S : Module.End K U} (hS : S ∈ presSub X) :
    trOn X (G'.avg S) = trOn X S := by
  obtain ⟨hD0, hD⟩ := Classical.choose_spec (G'.endRep.dpow_nil (W := ⊤) fun _ _ _ _ => Submodule.mem_top)
  have hstab := G'.presSub_stable hX
  have hE : ∀ a b, G'.E a b ∈ presSub X := fun a b x hx => hX a b x hx
  have hcX : ∀ ν, G'.comp ν ∈ presSub X := fun ν x hx => G'.comp_mem hX ν hx
  -- the weight-`0` projection preserves the trace
  have h1 : trOn X (G'.endRep.comp 0 S) = trOn X S := by
    rw [endRep_comp, trOn_sum]
    have : ∀ ν, trOn X (G'.comp (ν + 0) * S * G'.comp ν) = trOn X (S * G'.comp ν) := fun ν => by
      rw [add_zero, mul_assoc, trOn_mul_comm (hcX ν) (fun x hx => hS (G'.comp ν x) (hcX ν x hx)), mul_assoc,
        G'.comp_mul, ite_eq_left rfl]
    simp only [this, ← trOn_sum, ← Finset.mul_sum, sum_compU, mul_one]
  -- the extremal projector moves by commutators
  have h2 : ∀ Y ∈ presSub X, G'.endRep.IsWt 0 Y → trOn X (G'.endRep.xproj 0
      (Classical.choose (G'.endRep.dpow_nil (W := ⊤) fun _ _ _ _ => Submodule.mem_top)) (List.finRange n) Y) =
      trOn X Y := by
    intro Y hY hYw
    have hmem := G'.endRep.xproj_sub_mem hstab hD0 0 (List.finRange n) (List.pairwise_lt_finRange n) hYw hY
    have hz : ∀ z ∈ G'.endRep.lowSp (presSub X) 0, trOn X z = 0 := by
      intro z hz
      refine Submodule.span_induction (p := fun z _ => trOn X z = 0) ?_ (trOn_zero X)
        (fun x y _ _ hx hy => by rw [trOn_add, hx, hy, add_zero])
        (fun c x _ hx => by rw [trOn_smul, hx, mul_zero]) hz
      rintro z ⟨a, b, hab, w, hw, -, rfl⟩
      rw [endRep_E, trOn_sub, trOn_mul_comm (hE b a) hw, sub_self]
    have := hz _ hmem
    rwa [trOn_sub, sub_eq_zero] at this
  rw [avg, Module.End.mul_apply, h2 _ (G'.endRep.comp_mem hstab 0 hS) (G'.endRep.isWt_comp 0 S), h1]

end EndRep

/-! ## Isotypic projectors by averaging -/

section IsoAvg

variable [CharZero K] {W : Submodule K V} [FiniteDimensional K W] (hW : G.Stable W)

/-- **The highest weight projector at `λ` composed with the weight projection**, on `W`. -/
def hwOp (la : Fin n → ℤ) : Module.End K W :=
  (G.xproj la (Classical.choose (G.dpow_nil hW)) (List.finRange n) * G.comp la).restrict
    fun _ hx => G.xproj_mem hW _ _ _ (G.comp_mem hW la hx)

/-- **The averaged highest weight projector** `Π₀(hwOp λ)` on `W`. -/
def isoAvg (la : Fin n → ℤ) : Module.End K W := (G.restr hW).avg (G.hwOp hW la)

theorem hwOp_apply (la : Fin n → ℤ) (y : W) :
    (G.hwOp hW la y : V) = G.xproj la (Classical.choose (G.dpow_nil hW)) (List.finRange n) (G.comp la y) := rfl

theorem isoAvg_E (la : Fin n → ℤ) (a b : Fin n) (y : W) :
    G.isoAvg hW la ((G.restr hW).E a b y) = (G.restr hW).E a b (G.isoAvg hW la y) := by
  have := congrArg (fun T : Module.End K W => T y) ((G.restr hW).avg_comm (G.hwOp hW la) a b)
  simpa [isoAvg] using this.symm

theorem isoAvg_isWt (la : Fin n → ℤ) {μ : Fin n → ℤ} {y : W} (hy : G.IsWt μ (y : V)) :
    G.IsWt μ (G.isoAvg hW la y : V) := by
  refine G.isWt_of_diag fun a => ?_
  have h1 := congrArg Subtype.val (G.isoAvg_E hW la a a y)
  have h2 : (G.restr hW).E a a y = (μ a : K) • y := Subtype.ext (by rw [restr_E, G.diag_apply hy]; rfl)
  rw [show G.E a a (G.isoAvg hW la y : V) = ((G.restr hW).E a a (G.isoAvg hW la y) : V) from rfl, ← h1, h2,
    map_smul]; rfl

/-- **The comap of a subspace of `V` to `W`.** -/
abbrev inW (X : Submodule K V) : Submodule K W := X.comap W.subtype

omit [FiniteDimensional K W] in
theorem inW_stable {X : Submodule K V} (hX : G.Stable X) : (G.restr hW).Stable (inW X) :=
  fun a b y hy => by simp only [inW, Submodule.mem_comap, Submodule.subtype_apply, restr_E] at hy ⊢; exact hX a b _ hy

theorem hwOp_pres (la : Fin n → ℤ) {X : Submodule K V} (hX : G.Stable X) : G.hwOp hW la ∈ presSub (inW X) := by
  intro y hy
  simp only [inW, Submodule.mem_comap, Submodule.subtype_apply, hwOp_apply] at hy ⊢
  exact G.xproj_mem hX _ _ _ (G.comp_mem hX la hy)


/-- **The average on a highest weight module** `U·h` (`h ≠ 0` of weight `λ`) is the scalar `1 / dim U·h`. -/
theorem isoAvg_on_gen (la : Fin n → ℤ) {h : V} (hh : G.IsHw la h) (hhW : h ∈ W) (h0 : h ≠ 0) :
    ∃ c : K, c * Module.finrank K (inW (G.gen {h}) : Submodule K W) = 1 ∧
      ∀ y : W, (y : V) ∈ G.gen {h} → G.isoAvg hW la y = c • y := by
  obtain ⟨hD0, hD⟩ := Classical.choose_spec (G.dpow_nil hW)
  set X : Submodule K W := inW (G.gen {h})
  have hX : (G.restr hW).Stable X := G.inW_stable hW (G.gen_stable _)
  have hT : G.isoAvg hW la ∈ presSub X :=
    (G.restr hW).avg_mem ((G.restr hW).presSub_stable hX) (G.hwOp_pres hW la (G.gen_stable _))
  set h' : W := ⟨h, hhW⟩
  have hh' : h' ∈ X := G.mem_gen_self h
  have hxh : G.xproj la (Classical.choose (G.dpow_nil hW)) (List.finRange n) h = h :=
    G.xproj_of_hw la hD0 _ (List.pairwise_lt_finRange n) fun a _ b _ hab => hh.2 a b hab
  -- the eigenvalue
  obtain ⟨c, hc⟩ : ∃ c : K, c • h = (G.isoAvg hW la h' : V) := by
    have hw := G.isoAvg_isWt hW la (y := h') hh.1
    have hmem : (G.isoAvg hW la h' : V) ∈ G.gen {h} := hT h' hh'
    have := G.comp_mem_span hh hmem
    rw [hw] at this
    exact Submodule.mem_span_singleton.mp this
  have hTc : ∀ y : W, (y : V) ∈ G.gen {h} → G.isoAvg hW la y = c • y := by
    let N : Submodule K V := (LinearMap.ker (G.isoAvg hW la - c • 1)).map W.subtype
    have hN : G.Stable N := by
      rintro a b _ ⟨y, hy, rfl⟩
      refine ⟨(G.restr hW).E a b y, ?_, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply,
        sub_eq_zero] at hy ⊢
      rw [G.isoAvg_E, hy, map_smul]
    have hhN : h ∈ N := ⟨h', by
      rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply,
        sub_eq_zero]
      exact Subtype.ext hc.symm, rfl⟩
    intro y hy
    obtain ⟨y', hy', hyy'⟩ := G.gen_le (Set.singleton_subset_iff.mpr hhN) hN hy
    rw [← Subtype.ext hyy']
    simpa [sub_eq_zero] using hy'
  refine ⟨c, ?_, hTc⟩
  -- the trace of the average on `X` is `c · dim X`, that of the projector is `1`
  have htr1 : trOn X (G.isoAvg hW la) = c * Module.finrank K X := by
    have : X.projectionOnto _ (isCompl_compl (W := X)) ∘ₗ G.isoAvg hW la ∘ₗ X.subtype = c • LinearMap.id := by
      ext ⟨y, hy⟩
      simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.coe_subtype, LinearMap.smul_apply,
        LinearMap.id_coe, id_eq]
      rw [hTc y hy, Submodule.projectionOnto_apply_of_mem_left _ (X.smul_mem c hy)]; rfl
    rw [trOn, this, map_smul, LinearMap.trace_id, smul_eq_mul]
  have htr2 : trOn X (G.hwOp hW la) = 1 := by
    set h₀ : X := ⟨h', hh'⟩
    have h₀ne : h₀ ≠ 0 := fun H => h0 (congrArg (fun z : X => ((z : W) : V)) H)
    set f := X.projectionOnto _ (isCompl_compl (W := X)) ∘ₗ G.hwOp hW la ∘ₗ X.subtype
    have hval : ∀ y : X, ∃ a : K, (G.hwOp hW la (y : W) : V) = a • h := by
      intro y
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
        (G.comp_mem_span hh (y.2 : ((y : W) : V) ∈ G.gen {h}))
      exact ⟨a, by rw [hwOp_apply, show G.comp la ((y : W) : V) = a • h from ha.symm, map_smul, hxh]⟩
    have happ : ∀ y : X, f y = (Classical.choose (hval y)) • h₀ := by
      intro y
      have hm : G.hwOp hW la (y : W) ∈ X := G.hwOp_pres hW la (G.gen_stable _) _ y.2
      simp only [f, LinearMap.coe_comp, Function.comp_apply, Submodule.coe_subtype]
      rw [Submodule.projectionOnto_apply_of_mem_left _ hm]
      exact Subtype.ext (Subtype.ext (Classical.choose_spec (hval y)))
    have hinj : ∀ a b : K, a • h₀ = b • h₀ → a = b := fun a b hab => smul_left_injective K h₀ne hab
    let g : X →ₗ[K] K :=
      { toFun := fun y => Classical.choose (hval y)
        map_add' := fun y y' => hinj _ _ (by rw [add_smul, ← happ, ← happ, ← happ, map_add])
        map_smul' := fun c y => hinj _ _ (by rw [RingHom.id_apply, smul_eq_mul, mul_smul, ← happ, ← happ,
          map_smul]) }
    have hf : f = g.smulRight h₀ := by ext y; simp only [LinearMap.smulRight_apply]; rw [happ]; rfl
    have hg : g h₀ = 1 := by
      have h2 : (G.hwOp hW la (h₀ : W) : V) = h := by
        rw [hwOp_apply]; simp only [h₀, h']; rw [hh.1, hxh]
      have key : h = Classical.choose (hval h₀) • h := h2.symm.trans (Classical.choose_spec (hval h₀))
      have h3 : (1 - Classical.choose (hval h₀)) • h = 0 := by rw [sub_smul, one_smul, ← key, sub_self]
      rcases smul_eq_zero.mp h3 with h4 | h4
      · exact (sub_eq_zero.mp h4).symm
      · exact absurd h4 h0
    rw [trOn]; change LinearMap.trace K X f = 1; rw [hf, LinearMap.trace_smulRight, hg]
  rw [← htr1, isoAvg, (G.restr hW).trOn_avg hX (G.hwOp_pres hW la (G.gen_stable _))]
  exact htr2


/-- **The average kills the other highest weight modules.** -/
theorem isoAvg_kill (la : Fin n → ℤ) (hla : Antitone la) {la' : Fin n → ℤ} {h' : V} (hh' : G.IsHw la' h')
    (hh'W : h' ∈ W) (hne : la' ≠ la) (y : W) (hy : (y : V) ∈ G.gen {h'}) : G.isoAvg hW la y = 0 := by
  obtain ⟨hD0, hD⟩ := Classical.choose_spec (G.dpow_nil hW)
  have hX := G.inW_stable hW (G.gen_stable {h'})
  have hS : G.hwOp hW la ∈ killSub (inW (G.gen {h'})) := by
    intro z hz
    have hz' : (z : V) ∈ G.gen {h'} := hz
    refine Subtype.ext ?_
    rw [hwOp_apply]
    refine G.hw_eq_zero_of_mem_iSup hW (G.isHw_xproj hW hD hla (G.isWt_comp la _) (G.comp_mem hW la z.2))
      (G.xproj_mem hW _ _ _ (G.comp_mem hW la z.2)) ?_
    have hsub : G.gen {h'} ≤ ⨆ (l : Fin n → ℤ) (_ : l ≠ la), G.isoPart W l :=
      (le_iSup_of_le (⟨h', hh'W, hh'⟩ : {h : V // h ∈ W ∧ G.IsHw la' h}) le_rfl : G.gen {h'} ≤ G.isoPart W la').trans
        (le_iSup₂_of_le la' hne le_rfl)
    exact hsub (G.xproj_mem (G.gen_stable _) _ _ _ (G.comp_mem (G.gen_stable _) la hz'))
  exact (G.restr hW).avg_mem ((G.restr hW).killSub_stable hX) hS y hy

/-- **The average is one scalar on the highest weight vectors of weight `λ`.** -/
theorem isoAvg_eigen_eq (la : Fin n → ℤ) {h₁ h₂ : V} (hh₁ : G.IsHw la h₁) (hh₂ : G.IsHw la h₂) (h₁W : h₁ ∈ W)
    (h₂W : h₂ ∈ W) (h₁0 : h₁ ≠ 0) (h₂0 : h₂ ≠ 0) {c₁ c₂ : K}
    (hc₁ : (G.isoAvg hW la ⟨h₁, h₁W⟩ : V) = c₁ • h₁) (hc₂ : (G.isoAvg hW la ⟨h₂, h₂W⟩ : V) = c₂ • h₂) :
    c₁ = c₂ := by
  by_cases hind : LinearIndependent K ![h₁, h₂]
  · have hh : G.IsHw la (h₁ + h₂) := ⟨hh₁.1.add hh₂.1, fun a b hab => by rw [map_add, hh₁.2 a b hab,
      hh₂.2 a b hab, add_zero]⟩
    have h0 : h₁ + h₂ ≠ 0 := fun H => by
      have := LinearIndependent.pair_iff.mp hind 1 1 (by simpa using H); simp at this
    obtain ⟨c₃, -, hc₃⟩ := G.isoAvg_on_gen hW la hh (W.add_mem h₁W h₂W) h0
    have e := congrArg Subtype.val (hc₃ ⟨h₁ + h₂, W.add_mem h₁W h₂W⟩ (G.mem_gen_self _))
    rw [show (⟨h₁ + h₂, W.add_mem h₁W h₂W⟩ : W) = ⟨h₁, h₁W⟩ + ⟨h₂, h₂W⟩ from rfl, map_add, Submodule.coe_add,
      hc₁, hc₂, Submodule.coe_smul] at e
    have := LinearIndependent.pair_iff.mp hind (c₁ - c₃) (c₂ - c₃) (by
      simp only [sub_smul]; rw [show (c₁ • h₁ - c₃ • h₁ + (c₂ • h₂ - c₃ • h₂)) = c₁ • h₁ + c₂ • h₂ -
        c₃ • (h₁ + h₂) by rw [smul_add]; abel, e]; simp)
    rw [sub_eq_zero.mp this.1, sub_eq_zero.mp this.2]
  · obtain ⟨a, ha⟩ : ∃ a : K, h₂ = a • h₁ := by
      rw [LinearIndependent.pair_iff] at hind
      push Not at hind
      obtain ⟨s, t, hst, hne⟩ := hind
      have ht : t ≠ 0 := fun ht => by
        rw [ht, zero_smul, add_zero] at hst
        rcases smul_eq_zero.mp hst with hs | hs
        · exact hne hs ht
        · exact h₁0 hs
      refine ⟨-(t⁻¹ * s), ?_⟩
      have : t • h₂ = -(s • h₁) := eq_neg_of_add_eq_zero_right hst
      calc h₂ = t⁻¹ • (t • h₂) := by rw [smul_smul, inv_mul_cancel₀ ht, one_smul]
        _ = -(t⁻¹ * s) • h₁ := by rw [this, smul_neg, smul_smul, neg_smul]
    subst ha
    have ha0 : a ≠ 0 := fun h => h₂0 (by rw [h, zero_smul])
    have e : (⟨a • h₁, h₂W⟩ : W) = a • ⟨h₁, h₁W⟩ := rfl
    rw [e, map_smul, Submodule.coe_smul, hc₁, smul_smul, smul_smul] at hc₂
    have h3 : (a * c₁ - c₂ * a) • h₁ = 0 := by rw [sub_smul, hc₂, sub_self]
    rcases smul_eq_zero.mp h3 with h4 | h4
    · have : a * (c₁ - c₂) = 0 := by rw [mul_sub, mul_comm a c₂]; exact h4
      exact sub_eq_zero.mp ((mul_eq_zero.mp this).resolve_left ha0)
    · exact absurd h4 h₁0


/-- **The isotypic projector is an integer multiple of the average**: there is `d ∈ ℕ` (the dimension of the
irreducible of type `λ`) with `typeProj {λ} x = d · Π₀(hwOp λ) x` on `W`. -/
theorem isoAvg_spec (la : Fin n → ℤ) :
    ∃ d : ℕ, ∀ x (hx : x ∈ W), G.typeProj hW {la} x = (d : K) • (G.isoAvg hW la ⟨x, hx⟩ : V) := by
  by_cases hex : ∃ h, G.IsHw la h ∧ h ∈ W ∧ h ≠ 0
  · obtain ⟨h₀, hh₀, h₀W, h₀0⟩ := hex
    have hla := G.antitone_of_hw hW hh₀ h₀W h₀0
    obtain ⟨c, hcd, hc⟩ := G.isoAvg_on_gen hW la hh₀ h₀W h₀0
    refine ⟨Module.finrank K (inW (G.gen {h₀}) : Submodule K W), fun x hx => ?_⟩
    obtain ⟨y, hy, z, hz, rfl⟩ := G.exists_split hW {la} hx
    rw [G.typeProj_apply hW {la} hy hz]
    rw [G.isoSum_singleton] at hy
    rw [G.isoSum_compl_singleton] at hz
    -- the other isotypic parts are killed
    have hTz : z ∈ W ∧ ∀ hz : z ∈ W, G.isoAvg hW la ⟨z, hz⟩ = 0 := by
      refine Submodule.iSup_induction (motive := fun z => z ∈ W ∧ ∀ hz : z ∈ W, G.isoAvg hW la ⟨z, hz⟩ = 0) _ hz
        ?_ ⟨W.zero_mem, fun _ => by rw [show (⟨0, _⟩ : W) = 0 from rfl, map_zero]⟩
        (fun x y hx hy => ⟨W.add_mem hx.1 hy.1, fun _ => by
          rw [show (⟨x + y, _⟩ : W) = ⟨x, hx.1⟩ + ⟨y, hy.1⟩ from rfl, map_add, hx.2, hy.2, add_zero]⟩)
      intro la' z hz
      refine Submodule.iSup_induction (motive := fun z => z ∈ W ∧ ∀ hz : z ∈ W, G.isoAvg hW la ⟨z, hz⟩ = 0) _ hz
        ?_ ⟨W.zero_mem, fun _ => by rw [show (⟨0, _⟩ : W) = 0 from rfl, map_zero]⟩
        (fun x y hx hy => ⟨W.add_mem hx.1 hy.1, fun _ => by
          rw [show (⟨x + y, _⟩ : W) = ⟨x, hx.1⟩ + ⟨y, hy.1⟩ from rfl, map_add, hx.2, hy.2, add_zero]⟩)
      intro hla' z hz
      refine Submodule.iSup_induction (motive := fun z => z ∈ W ∧ ∀ hz : z ∈ W, G.isoAvg hW la ⟨z, hz⟩ = 0) _ hz
        ?_ ⟨W.zero_mem, fun _ => by rw [show (⟨0, _⟩ : W) = 0 from rfl, map_zero]⟩
        (fun x y hx hy => ⟨W.add_mem hx.1 hy.1, fun _ => by
          rw [show (⟨x + y, _⟩ : W) = ⟨x, hx.1⟩ + ⟨y, hy.1⟩ from rfl, map_add, hx.2, hy.2, add_zero]⟩)
      intro i z hz
      obtain ⟨h', hh'W, hh'⟩ := i
      have hzW : z ∈ W := G.gen_le_of_mem hW hh'W hz
      exact ⟨hzW, fun hzW' => G.isoAvg_kill hW la hla hh' hh'W hla' ⟨z, hzW'⟩ hz⟩
    -- the isotypic part of type `λ` is scaled by `c`
    have hTy : y ∈ W ∧ ∀ hy : y ∈ W, (G.isoAvg hW la ⟨y, hy⟩ : V) = c • y := by
      refine Submodule.iSup_induction (motive := fun y => y ∈ W ∧ ∀ hy : y ∈ W,
        (G.isoAvg hW la ⟨y, hy⟩ : V) = c • y) _ hy ?_
        ⟨W.zero_mem, fun _ => by rw [show (⟨0, _⟩ : W) = 0 from rfl, map_zero, smul_zero]; rfl⟩
        (fun x y hx hy => ⟨W.add_mem hx.1 hy.1, fun _ => by
          rw [show (⟨x + y, _⟩ : W) = ⟨x, hx.1⟩ + ⟨y, hy.1⟩ from rfl, map_add, Submodule.coe_add, hx.2, hy.2,
            smul_add]⟩)
      intro i y hy
      obtain ⟨h, hhW, hh⟩ := i
      have hyW : y ∈ W := G.gen_le_of_mem hW hhW hy
      refine ⟨hyW, fun hyW' => ?_⟩
      by_cases h0 : h = 0
      · subst h0
        rw [gen_zero, Submodule.mem_bot] at hy
        subst hy
        rw [show (⟨0, hyW'⟩ : W) = 0 from rfl, map_zero, smul_zero]; rfl
      obtain ⟨c', -, hc'⟩ := G.isoAvg_on_gen hW la hh hhW h0
      have hcc' : c = c' := G.isoAvg_eigen_eq hW la hh₀ hh h₀W hhW h₀0 h0
        (congrArg Subtype.val (hc ⟨h₀, h₀W⟩ (G.mem_gen_self _)))
        (congrArg Subtype.val (hc' ⟨h, hhW⟩ (G.mem_gen_self _)))
      rw [hcc', hc' ⟨y, hyW'⟩ hy]; rfl
    rw [show (⟨y + z, hx⟩ : W) = ⟨y, hTy.1⟩ + ⟨z, hTz.1⟩ from rfl, map_add, hTz.2 hTz.1, add_zero, hTy.2 hTy.1,
      smul_smul, mul_comm, hcd, one_smul]
  · refine ⟨0, fun x hx => ?_⟩
    rw [Nat.cast_zero, zero_smul]
    have hbot : G.isoPart W la = ⊥ := by
      refine le_bot_iff.mp (iSup_le fun i => ?_)
      obtain ⟨h, hhW, hh⟩ := i
      have : h = 0 := by by_contra h0; exact hex ⟨h, hh, hhW, h0⟩
      change G.gen {h} ≤ ⊥
      rw [this, gen_zero]
    have := G.typeProj_mem hW {la} x
    rwa [G.isoSum_singleton, hbot, Submodule.mem_bot] at this

end IsoAvg

/-! ## Invariant forms -/

section InvForm

variable [CharZero K] {W : Submodule K V} [FiniteDimensional K W]

/-- **Invariant forms vanishing on highest weight pairs vanish** (B12.4(d)): a bilinear form with
`B(E a b x, y) = B(x, E b a y)` on `W` and `B(h, h') = 0` for highest weight vectors `h, h'` of `W` of equal weight
vanishes on `W × W`. -/
theorem invForm_zero (hW : G.Stable W) (B : V →ₗ[K] V →ₗ[K] K)
    (hinv : ∀ a b, ∀ x ∈ W, ∀ y ∈ W, B (G.E a b x) y = B x (G.E b a y))
    (hhw : ∀ la h h', G.IsHw la h → G.IsHw la h' → h ∈ W → h' ∈ W → B h h' = 0) :
    ∀ x ∈ W, ∀ y ∈ W, B x y = 0 := by
  -- a highest weight vector pairs to zero with `W`
  have step1 : ∀ la h, G.IsHw la h → h ∈ W → ∀ v ∈ W, B h v = 0 := by
    intro la h hh hhW v hv
    have hoff : ∀ μ, μ ≠ la → B h (G.comp μ v) = 0 := by
      intro μ hμ
      obtain ⟨c, hc⟩ := Function.ne_iff.mp hμ
      have e := hinv c c h hhW _ (G.comp_mem hW μ hv)
      rw [G.diag_apply hh.1, G.diag_apply (G.isWt_comp μ v), map_smul, map_smul, LinearMap.smul_apply] at e
      have : ((la c : K) - μ c) * B h (G.comp μ v) = 0 := by rw [sub_mul, ← smul_eq_mul, e]; simp
      exact (mul_eq_zero.mp this).resolve_left (sub_ne_zero.mpr (by exact_mod_cast (Ne.symm hc)))
    have hon : ∀ u ∈ W, B h (G.comp la u) = 0 := by
      intro u hu
      have hu' : u ∈ G.hwSum W := G.le_hwSum hW hu
      refine Submodule.iSup_induction (motive := fun u => B h (G.comp la u) = 0) _ hu' ?_ (by simp)
        (fun x y hx hy => by rw [map_add, map_add, hx, hy, add_zero])
      rintro ⟨h', hh'W, la', hh'⟩ u hu
      rw [G.gen_eq_lowSpan hh'] at hu
      refine Submodule.span_induction (p := fun u _ => B h (G.comp la u) = 0) ?_ (by simp)
        (fun x y _ _ hx hy => by rw [map_add, map_add, hx, hy, add_zero])
        (fun c x _ hx => by rw [map_smul, map_smul, hx, smul_zero]) hu
      intro y hy
      cases hy with
      | base =>
        by_cases hl : la' = la
        · subst hl; rw [hh'.1]; exact hhw la' h h' hh hh' hhW hh'W
        · rw [G.comp_of_isWt_ne hh'.1 (Ne.symm hl), map_zero]
      | step a b hab hy' =>
        obtain ⟨ν, hν, -⟩ := G.low_isWt hh' hy'
        have hy'W : _ ∈ W := G.gen_le_of_mem hW hh'W (G.low_mem_gen h' hy')
        rw [G.comp_of_isWt (hν.E_apply b a)]
        split_ifs
        · rw [← hinv a b h hhW _ hy'W, hh.2 a b hab, map_zero, LinearMap.zero_apply]
        · rw [map_zero]
    have hv' : v = ∑ μ ∈ (G.supp_finite v).toFinset ∪ {la}, G.comp μ v :=
      (G.sum_comp_of_supp fun μ hμ => by
        by_contra h; exact hμ (Finset.mem_union_left _ ((Set.Finite.mem_toFinset _).mpr h))).symm
    rw [hv', map_sum]
    refine Finset.sum_eq_zero fun μ _ => ?_
    by_cases hμ : μ = la
    · subst hμ; exact hon v hv
    · exact hoff μ hμ
  intro x hx y hy
  have hx' : x ∈ G.hwSum W := G.le_hwSum hW hx
  revert y
  refine Submodule.iSup_induction (motive := fun x => ∀ y ∈ W, B x y = 0) _ hx' ?_ (fun _ _ => by simp)
    (fun x y hx hy z hz => by rw [map_add, LinearMap.add_apply, hx z hz, hy z hz, add_zero])
  rintro ⟨h, hhW, la, hh⟩ x hx
  rw [G.gen_eq_lowSpan hh] at hx
  refine Submodule.span_induction (p := fun x _ => ∀ y ∈ W, B x y = 0) ?_ (fun _ _ => by simp)
    (fun x y _ _ hx hy z hz => by rw [map_add, LinearMap.add_apply, hx z hz, hy z hz, add_zero])
    (fun c x _ hx z hz => by rw [map_smul, LinearMap.smul_apply, hx z hz, smul_zero]) hx
  intro y hy
  induction hy with
  | base => exact step1 la h hh hhW
  | step a b hab hy' ih =>
    intro z hz
    have hy'W := G.gen_le_of_mem hW hhW (G.low_mem_gen h hy')
    rw [hinv b a _ hy'W z hz]
    exact ih _ (hW a b z hz)

end InvForm

/-! ## The highest weight projector, and commuting actions -/

section HwProj

variable [CharZero K] {W : Submodule K V} [FiniteDimensional K W]

omit [CharZero K] [FiniteDimensional K W] in
theorem isWt_of_mem_lowSp {μ : Fin n → ℤ} {z : V} (hz : z ∈ G.lowSp W μ) : G.IsWt μ z := by
  refine Submodule.span_induction (p := fun z _ => G.IsWt μ z) ?_ (G.isWt_zero μ)
    (fun x y _ _ hx hy => hx.add hy) (fun c x _ hx => hx.smul c) hz
  rintro z ⟨a, b, -, w, -, hw, rfl⟩
  have := hw.E_apply b a
  rwa [rt_swap a b, add_neg_cancel_right] at this

/-- **The extremal projector kills the lowering images**: with `isHw_xproj` and `xproj_sub_mem`, `xproj μ` is the
projection of the weight-`μ` vectors of `W` onto its highest weight vectors along the lowering images. -/
theorem xproj_lowSp (hW : G.Stable W) {D : ℕ} (hD0 : 0 < D) (hD : ∀ a b, a ≠ b → ∀ z ∈ W, dpow (G.E a b) D z = 0)
    {μ : Fin n → ℤ} (hμ : Antitone μ) {z : V} (hz : z ∈ G.lowSp W μ) (hzW : z ∈ W) :
    G.xproj μ D (List.finRange n) z = 0 := by
  have hzw := G.isWt_of_mem_lowSp hz
  refine G.hw_eq_zero_of_mem_lowSp hW (G.isHw_xproj hW hD hμ hzw hzW) (G.xproj_mem hW _ _ _ hzW) ?_
  simpa using add_mem (G.xproj_sub_mem hW hD0 μ _ (List.pairwise_lt_finRange n) hzw hzW) hz

end HwProj

/-- **Type projectors of commuting actions commute** on a subspace stable under both (disjoint letter sets). -/
theorem typeProj_comm_typeProj [CharZero K] {n' : ℕ} (G₂ : GlRep K V n') {W : Submodule K V}
    [FiniteDimensional K W] (hW : G.Stable W) (hW₂ : G₂.Stable W)
    (hcomm : ∀ a b c d, ∀ x ∈ W, G.E a b (G₂.E c d x) = G₂.E c d (G.E a b x)) (T : Set (Fin n → ℤ))
    (T' : Set (Fin n' → ℤ)) {x : V} (hx : x ∈ W) :
    G.typeProj hW T (G₂.typeProj hW₂ T' x) = G₂.typeProj hW₂ T' (G.typeProj hW T x) := by
  refine (G.typeProj_comm hW (fun y _ => G₂.typeProj_mem_W hW₂ T' y) (fun a b y hy => ?_) T hx).symm
  exact (G₂.typeProj_comm hW₂ (fun z hz => hW a b z hz) (fun c d z hz => (hcomm a b c d z hz)) T' hy).symm

end GlRep
