def δg : ℚ := 7 / 1000

def xh (i : ℕ) : ℚ := yq.getD i 0 * lq.getD i 0

def Aq2 (i j : ℕ) : ℚ := Aq 1 EvenQ.bq EvenQ.pq EvenQ.cq i j + cg * xh i * xh j

def chk2 (r : ℚ) : Bool :=
  (List.range 28).all fun i => (List.range 28).all fun j =>
    decide (Aq2 i j - certq GMq GDq δg i j ≤ r) && decide (certq GMq GDq δg i j - Aq2 i j ≤ r)

theorem gap_chk : chk2 (3 / 10 ^ 9) = true := by decide +kernel

theorem GDq_nonneg : GDq.all (fun d => decide (0 ≤ d)) = true := by decide +kernel

/-- bracket data: `lq_i² (4i+1) ≤ 1 ≤ (lq_i + 10⁻³⁰)² (4i+1)`, `0 ≤ lq_i ≤ 1`, `|yq_i| ≤ 4` -/
def brOK : Bool := (List.range 10).all fun i =>
  decide (lq.getD i 0 ^ 2 * (4 * i + 1) ≤ 1) && decide (1 ≤ (lq.getD i 0 + 1 / 10 ^ 30) ^ 2 * (4 * i + 1))
    && decide (0 ≤ lq.getD i 0) && decide (lq.getD i 0 ≤ 1) && decide (|yq.getD i 0| ≤ 4)

theorem br_ok : brOK = true := by decide +kernel

lemma br_spec {i : ℕ} (hi : i < 10) :
    (lq.getD i 0 : ℝ) ^ 2 * (4 * i + 1) ≤ 1 ∧ 1 ≤ ((lq.getD i 0 : ℝ) + 1 / 10 ^ 30) ^ 2 * (4 * i + 1)
      ∧ 0 ≤ (lq.getD i 0 : ℝ) ∧ (lq.getD i 0 : ℝ) ≤ 1 ∧ |(yq.getD i 0 : ℝ)| ≤ 4 := by
  have := List.all_eq_true.mp br_ok i (List.mem_range.mpr hi)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := this
  refine ⟨by exact_mod_cast h1, by have h := (Rat.cast_le (K := ℝ)).2 h2; push_cast at h; exact h, by exact_mod_cast h3, by exact_mod_cast h4, by exact_mod_cast h5⟩

/-- `lq_i ≤ 1/√(4i+1) ≤ lq_i + 10⁻³⁰` -/
lemma bracket {i : ℕ} (hi : i < 10) :
    (lq.getD i 0 : ℝ) ≤ 1 / Real.sqrt (4 * i + 1) ∧ 1 / Real.sqrt (4 * i + 1) ≤ (lq.getD i 0 : ℝ) + 1 / 10 ^ 30 := by
  obtain ⟨h1, h2, h3, -, -⟩ := br_spec hi
  have ha : (0:ℝ) < 4 * i + 1 := by positivity
  have hs := Real.sqrt_pos.2 ha
  have hss := Real.sq_sqrt ha.le
  constructor
  · rw [le_div_iff₀ hs]
    have : ((lq.getD i 0 : ℝ) * Real.sqrt (4 * i + 1)) ^ 2 ≤ 1 := by rw [mul_pow, hss]; exact h1
    nlinarith [mul_nonneg h3 hs.le]
  · rw [div_le_iff₀ hs]
    have : 1 ≤ (((lq.getD i 0 : ℝ) + 1 / 10 ^ 30) * Real.sqrt (4 * i + 1)) ^ 2 := by rw [mul_pow, hss]; exact h2
    have hp : 0 ≤ ((lq.getD i 0 : ℝ) + 1 / 10 ^ 30) * Real.sqrt (4 * i + 1) := by positivity
    nlinarith

/-- the trial vector in normalised-mode coordinates -/
noncomputable def xv (i : ℕ) : ℝ := if i < 10 then (yq.getD i 0 : ℝ) / Real.sqrt (4 * i + 1) else 0

lemma yq_out {i : ℕ} (hi : 10 ≤ i) : yq.getD i 0 = 0 := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp [yq]; omega)]; rfl

lemma xh_out {i : ℕ} (hi : 10 ≤ i) : xh i = 0 := by unfold xh; rw [yq_out hi, zero_mul]

lemma xv_near1 {i : ℕ} (hi : i < 10) : |xv i - (xh i : ℝ)| ≤ 4 / 10 ^ 30 := by
  obtain ⟨-, -, -, -, hy⟩ := br_spec hi
  obtain ⟨b1, b2⟩ := bracket hi
  unfold xv xh; rw [ite_eq_left hi]; push_cast
  rw [div_eq_mul_one_div, ← mul_sub, abs_mul]
  have : |1 / Real.sqrt (4 * i + 1) - (lq.getD i 0 : ℝ)| ≤ 1 / 10 ^ 30 := by rw [abs_le]; constructor <;> linarith
  calc _ ≤ 4 * (1 / 10 ^ 30) := mul_le_mul hy this (abs_nonneg _) (by norm_num)
    _ = _ := by ring

lemma xv_bd (i : ℕ) : |xv i| ≤ 4 := by
  unfold xv; split_ifs with hi
  · obtain ⟨-, -, -, -, hy⟩ := br_spec hi
    rw [abs_div, abs_of_pos (Real.sqrt_pos.2 (by positivity))]
    have : 1 ≤ Real.sqrt (4 * i + 1) := by rw [Real.one_le_sqrt]; have := (Nat.cast_nonneg i : (0:ℝ) ≤ i); linarith
    rw [div_le_iff₀ (by linarith)]; nlinarith [abs_nonneg ((yq.getD i 0 : ℚ) : ℝ)]
  · simp

lemma xh_bd (i : ℕ) : |(xh i : ℝ)| ≤ 4 := by
  by_cases hi : i < 10
  · obtain ⟨-, -, h3, h4, hy⟩ := br_spec hi
    unfold xh; push_cast; rw [abs_mul, abs_of_nonneg h3]
    nlinarith [abs_nonneg ((yq.getD i 0 : ℚ) : ℝ)]
  · rw [xh_out (by omega)]; simp

lemma xv_near (i j : ℕ) : |xv i * xv j - (xh i : ℝ) * (xh j : ℝ)| ≤ 1 / 10 ^ 28 := by
  have ei : |xv i - (xh i : ℝ)| ≤ 4 / 10 ^ 30 := by
    by_cases hi : i < 10
    · exact xv_near1 hi
    · unfold xv; rw [ite_eq_right hi, xh_out (by omega)]; norm_num
  have ej : |xv j - (xh j : ℝ)| ≤ 4 / 10 ^ 30 := by
    by_cases hj : j < 10
    · exact xv_near1 hj
    · unfold xv; rw [ite_eq_right hj, xh_out (by omega)]; norm_num
  rw [show xv i * xv j - (xh i : ℝ) * (xh j : ℝ) = (xv i - xh i) * xv j + (xh i : ℝ) * (xv j - xh j) by ring]
  refine (abs_add_le _ _).trans ?_
  rw [abs_mul, abs_mul]
  have := xv_bd j; have := xh_bd i
  nlinarith [abs_nonneg (xv i - xh i), abs_nonneg (xv j - xh j), abs_nonneg (xv j), abs_nonneg ((xh i : ℚ) : ℝ)]

/-- the shifted reduced matrix `Rm + c·vvᵀ` -/
noncomputable def Rg (i j : ℕ) : ℝ := Rm 0 1 wψ βs i j + (cg : ℝ) * xv i * xv j

noncomputable def GMn (k i : ℕ) : ℝ := if _h : k < 28 ∧ i < 28 then ((getq GMq k i : ℚ) : ℝ) else 0
noncomputable def GDn (k : ℕ) : ℝ := if k < 28 then ((GDq.getD k 0 : ℚ) : ℝ) else 0

lemma GDn_nonneg (k : ℕ) : 0 ≤ GDn k := by
  unfold GDn; split_ifs
  · exact_mod_cast getD_nonneg GDq GDq_nonneg k
  · exact le_rfl

lemma chk2_spec {r : ℚ} (h : chk2 r = true) {i j : ℕ} (hi : i < 28) (hj : j < 28) :
    |((Aq2 i j : ℚ) : ℝ) - ((certq GMq GDq δg i j : ℚ) : ℝ)| ≤ (r : ℝ) := by
  unfold chk2 at h
  have := List.all_eq_true.mp (List.all_eq_true.mp h i (List.mem_range.mpr hi)) j (List.mem_range.mpr hj)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  rw [abs_sub_le_iff]; constructor <;> [exact_mod_cast this.1; exact_mod_cast this.2]

lemma cg_nonneg : (0:ℝ) ≤ cg := by unfold cg; norm_num
lemma cg_le : (cg:ℝ) ≤ 1 := by unfold cg; norm_num

theorem gapHead : ∀ i < 28, ∀ j < 28, |Rg i j - certMat 28 GMn GDn (δg : ℝ) i j| ≤ 1 / 10 ^ 8 := by
  intro i hi j hj
  have E : HeadEnc 0 EvenQ.bq EvenQ.pq EvenQ.cq (1/10^12) (1/10^12) (6/10^9) :=
    ⟨WeilConst.beta_enc_even, by have := WeilConst.pole_enc_even; simpa using this, CmFin.cmEnc_even⟩
  have h1 := Rm_near (σ := 1) (by norm_num) E (by norm_num) even_pchk hi hj
  have h2 := chk2_spec gap_chk hi hj
  have h3 := certMat_eq GMq GDq δg hi hj
  have hM : GMn = fun k i => if h : k < 28 ∧ i < 28 then ((getq GMq k i : ℚ) : ℝ) else 0 := rfl
  have hD : GDn = fun k => if k < 28 then ((GDq.getD k 0 : ℚ) : ℝ) else 0 := rfl
  rw [hM, hD, h3]
  have h4 := xv_near i j
  unfold Rg
  unfold Aq2 at h2
  push_cast at h1 h2
  have hc4 : |(cg:ℝ) * xv i * xv j - (cg:ℝ) * (xh i : ℝ) * (xh j : ℝ)| ≤ 1 / 10 ^ 28 := by
    rw [mul_assoc, mul_assoc, ← mul_sub, abs_mul, abs_of_nonneg cg_nonneg]
    calc _ ≤ 1 * (1 / 10 ^ 28) := mul_le_mul cg_le h4 (abs_nonneg _) (by norm_num)
      _ = _ := by ring
  set A := ((Aq 1 EvenQ.bq EvenQ.pq EvenQ.cq i j : ℚ) : ℝ)
  set C := ((certq GMq GDq δg i j : ℚ) : ℝ)
  have e : Rm 0 1 wψ βs i j + (cg:ℝ) * xv i * xv j - C
      = (Rm 0 1 wψ βs i j - A) + ((cg:ℝ) * xv i * xv j - (cg:ℝ) * (xh i : ℝ) * (xh j : ℝ))
        + (A + (cg:ℝ) * (xh i : ℝ) * (xh j : ℝ) - C) := by ring
  rw [e]
  refine (abs_add_three _ _ _).trans ?_
  have h1' : |Rm 0 1 wψ βs i j - A| ≤ 1 / 10 ^ 12 + 10 * (1 / 10 ^ 12) + 6 / 10 ^ 9 := by simpa [A] using h1
  linarith

lemma Rg_symm (i j : ℕ) : Rg i j = Rg j i := by unfold Rg; rw [Rm_symm]; ring

lemma Rg_out (i j : ℕ) (h : 28 ≤ i ∨ 28 ≤ j) : Rg i j = Rm 0 1 wψ βs i j := by
  unfold Rg
  rcases h with h | h
  · have : xv i = 0 := by unfold xv; rw [ite_eq_right (by omega)]
    rw [this]; ring
  · have : xv j = 0 := by unfold xv; rw [ite_eq_right (by omega)]
    rw [this]; ring

theorem sector_margin_gen (par : ℕ) (hpar : par ≤ 1) {σ : ℝ} (hσ : |σ| ≤ 1)
    (R : ℕ → ℕ → ℝ) (hsym : ∀ i j, R i j = R j i) (hR : ∀ i j, (28 ≤ i ∨ 28 ≤ j) → R i j = Rm par σ wψ βs i j)
    (Mh : ℕ → ℕ → ℝ) (Dh : ℕ → ℝ) (δ ρ m B0 : ℝ) (hD : ∀ k, 0 ≤ Dh k) (hρ0 : 0 ≤ ρ)
    (hhead : ∀ i < 28, ∀ j < 28, |R i j - certMat 28 Mh Dh δ i j| ≤ ρ)
    (hB0 : b (56 + par) ≤ B0)
    (hm1 : m ≤ δ - ((28:ℕ):ℝ) * ρ) (hm2 : m ≤ 0.37 - 558 * B0 ^ 2 - 558 * B0 * (2 * B0))
    (hb : 558 ^ 2 * (28 * 190269 ^ 2) * (2 * B0 ^ 2) ≤ (δ - ((28:ℕ):ℝ) * ρ - m) * (0.37 - 558 * B0 ^ 2 - 558 * B0 * (2 * B0) - m))
    (N : ℕ) (hN : 28 ≤ N) (x : ℕ → ℝ) :
    m * ∑ i ∈ range N, x i ^ 2 ≤ qf R x (range N) (range N) := by
  have hw : ∀ t, 0 ≤ t → t ≤ 30 → |wψ t| ≤ 55 := fun t h0 h1 => wψ_bound h0 h1
  have hE := Rm_entry par hσ wψ (by norm_num) hw βs
  have hK : (10 * (55:ℝ) + 8) = 558 := by norm_num
  rw [hK] at hE
  have B0nn : 0 ≤ B0 := (b_nonneg _).trans hB0
  have hbt : ∀ i, 28 ≤ i → b (2 * i + par) ≤ B0 := by
    intro i hi
    have := tail_mono (fun i => b (2 * i + par)) 28 (fun i => b_nonneg _) (bs_step par) i hi
    rw [show 2 * 28 + par = 56 + par by ring] at this; linarith
  have hH := head_margin 28 R Mh Dh δ ρ hD hρ0 hhead x
  refine block_margin R hsym 28 N hN _ (0.37 - 558 * B0 ^ 2) (558 * B0 * (2 * B0))
    (558 ^ 2 * (28 * 190269 ^ 2) * (2 * B0 ^ 2)) m x hH ?_ ?_ ?_ (by positivity) hm1 hm2 hb
  · intro i hi
    have hi' := (mem_Ico.mp hi).1
    have e := hE i i
    rw [← hR i i (Or.inl hi'), ite_eq_left rfl, abs_le] at e
    have hb := hbt i hi'
    have := b_nonneg (2 * i + par)
    have := βs_ge
    nlinarith
  · intro i hi
    have hi' := (mem_Ico.mp hi).1
    have hb := hbt i hi'
    have bi := b_nonneg (2 * i + par)
    calc ∑ j ∈ Ico 28 N, |if i = j then 0 else R i j|
        ≤ ∑ j ∈ Ico 28 N, 558 * b (2 * i + par) * b (2 * j + par) := by
          refine sum_le_sum (fun j _ => ?_)
          by_cases h : i = j
          · rw [ite_eq_left h, abs_zero]; have := b_nonneg (2 * j + par); positivity
          · rw [ite_eq_right h, hR i j (Or.inl hi')]; have := hE i j; rw [ite_eq_right h, sub_zero] at this; exact this
      _ = 558 * b (2 * i + par) * ∑ j ∈ Ico 28 N, b (2 * j + par) := by rw [mul_sum]
      _ ≤ 558 * B0 * (2 * B0) := by
          have ts := tail_sum par N hN
          have : b (56 + par) ≤ B0 := hB0
          have s0 : 0 ≤ ∑ j ∈ Ico 28 N, b (2 * j + par) := sum_nonneg (fun j _ => b_nonneg _)
          have : ∑ j ∈ Ico 28 N, b (2 * j + par) ≤ 2 * B0 := by linarith
          exact mul_le_mul (by nlinarith) this s0 (by positivity)
  · calc ∑ i ∈ range 28, ∑ j ∈ Ico 28 N, R i j ^ 2
        ≤ ∑ i ∈ range 28, ∑ j ∈ Ico 28 N, 558 ^ 2 * b (2 * i + par) ^ 2 * b (2 * j + par) ^ 2 := by
          refine sum_le_sum (fun i hi => sum_le_sum (fun j hj => ?_))
          have hij : i ≠ j := by
            have := mem_range.mp hi; have := (mem_Ico.mp hj).1; omega
          have e := hE i j
          rw [ite_eq_right hij, sub_zero, ← hR i j (Or.inr (mem_Ico.mp hj).1)] at e
          have : R i j ^ 2 ≤ (558 * b (2 * i + par) * b (2 * j + par)) ^ 2 := by
            rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) e 2
          nlinarith
      _ = 558 ^ 2 * (∑ i ∈ range 28, b (2 * i + par) ^ 2) * (∑ j ∈ Ico 28 N, b (2 * j + par) ^ 2) := by
          rw [mul_assoc, sum_mul_sum, mul_sum]
          refine sum_congr rfl (fun i _ => ?_); rw [mul_sum]
          refine sum_congr rfl (fun j _ => ?_); ring
      _ ≤ 558 ^ 2 * (28 * 190269 ^ 2) * (2 * B0 ^ 2) := by
          have h1 : ∑ i ∈ range 28, b (2 * i + par) ^ 2 ≤ 28 * 190269 ^ 2 := by
            calc ∑ i ∈ range 28, b (2 * i + par) ^ 2 ≤ ∑ i ∈ range 28, (190269:ℝ) ^ 2 := by
                  refine sum_le_sum (fun i hi => ?_)
                  have := b_le_head (2 * i + par) (by have := mem_range.mp hi; omega)
                  exact pow_le_pow_left₀ (b_nonneg _) this 2
              _ = 28 * 190269 ^ 2 := by simp
          have h2 : ∑ j ∈ Ico 28 N, b (2 * j + par) ^ 2 ≤ 2 * B0 ^ 2 := by
            have := tail_sumsq par N hN
            have : b (56 + par) ^ 2 ≤ B0 ^ 2 := pow_le_pow_left₀ (b_nonneg _) hB0 2
            linarith
          have s0 : 0 ≤ ∑ i ∈ range 28, b (2 * i + par) ^ 2 := sum_nonneg (fun _ _ => sq_nonneg _)
          have s1 : 0 ≤ ∑ j ∈ Ico 28 N, b (2 * j + par) ^ 2 := sum_nonneg (fun _ _ => sq_nonneg _)
          have := mul_le_mul h1 h2 s1 (by positivity)
          nlinarith


lemma qf_Rg (N : ℕ) (x : ℕ → ℝ) :
    qf Rg x (range N) (range N) = qf (Rm 0 1 wψ βs) x (range N) (range N)
      + (cg : ℝ) * (∑ i ∈ range N, x i * xv i) ^ 2 := by
  unfold qf Rg
  rw [sq, sum_mul_sum, mul_sum, ← sum_add_distrib]
  refine sum_congr rfl fun i _ => ?_
  rw [mul_sum, ← sum_add_distrib]
  refine sum_congr rfl fun j _ => ?_
  ring

/-- **Even-sector gap on the complement of the trial vector.** -/
theorem even_gap (N : ℕ) (hN : 28 ≤ N) (x : ℕ → ℝ) (hx : ∑ i ∈ range N, x i * xv i = 0) :
    (6 / 1000 : ℝ) * ∑ i ∈ range N, x i ^ 2 ≤ WeilZhuRed.QF 0 1 N x := by
  have hm := sector_margin_gen 0 (by norm_num) (by norm_num) Rg Rg_symm Rg_out GMn GDn (δg : ℝ) (1 / 10 ^ 8)
    (6 / 1000) (5 / 10 ^ 25) GDn_nonneg (by norm_num) gapHead b56_le
    (by unfold δg; norm_num) (by norm_num) (by unfold δg; norm_num) N hN x
  rw [qf_Rg, hx] at hm
  simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero, add_zero] at hm
  exact hm.trans (WeilZhuRed.QF_ge_R 0 1 (WeilPlanch.modePlancherel_of WeilModes.modeDecay 0
    (WeilFourier.modeOrth (by norm_num))) N x)

end GsGap
