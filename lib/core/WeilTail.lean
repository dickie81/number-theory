import Mathlib
import ShellSchur

namespace WeilTail

open Finset

/-- Quadratic form of the `N`-truncation of an infinite matrix `R`. -/
def qf (R : ℕ → ℕ → ℝ) (x : ℕ → ℝ) (I J : Finset ℕ) : ℝ := ∑ i ∈ I, ∑ j ∈ J, x i * R i j * x j

/-- Head certificate matrix `Mᵀ D M + δ I` on indices `< h`. -/
def certMat (h : ℕ) (M : ℕ → ℕ → ℝ) (D : ℕ → ℝ) (δ : ℝ) (i j : ℕ) : ℝ :=
  (∑ k ∈ range h, M k i * D k * M k j) + if i = j then δ else 0

lemma sq_le_sum {I : Finset ℕ} {x : ℕ → ℝ} {i : ℕ} (hi : i ∈ I) : x i ^ 2 ≤ ∑ j ∈ I, x j ^ 2 :=
  single_le_sum (f := fun i => x i ^ 2) (fun _ _ => sq_nonneg _) hi

/-- Head margin from an entrywise certificate (all of `range h`). -/
theorem head_margin (h : ℕ) (R M : ℕ → ℕ → ℝ) (D : ℕ → ℝ) (δ ρ : ℝ) (hD : ∀ k, 0 ≤ D k) (hρ0 : 0 ≤ ρ)
    (hA : ∀ i < h, ∀ j < h, |R i j - certMat h M D δ i j| ≤ ρ) (x : ℕ → ℝ) :
    (δ - (h : ℝ) ^ 2 * ρ) * ∑ i ∈ range h, x i ^ 2 ≤ qf R x (range h) (range h) := by
  set S := ∑ i ∈ range h, x i ^ 2
  have hC : δ * S ≤ qf (certMat h M D δ) x (range h) (range h) := by
    have e1 : qf (certMat h M D δ) x (range h) (range h)
        = (∑ k ∈ range h, D k * (∑ i ∈ range h, M k i * x i) ^ 2) + δ * S := by
      have h1 : ∑ i ∈ range h, ∑ j ∈ range h, x i * (∑ k ∈ range h, M k i * D k * M k j) * x j
          = ∑ k ∈ range h, D k * (∑ i ∈ range h, M k i * x i) ^ 2 := by
        calc ∑ i ∈ range h, ∑ j ∈ range h, x i * (∑ k ∈ range h, M k i * D k * M k j) * x j
            = ∑ i ∈ range h, ∑ k ∈ range h, ∑ j ∈ range h, x i * (M k i * D k * M k j) * x j := by
              refine sum_congr rfl (fun i _ => ?_)
              simp only [mul_sum, sum_mul]
              exact sum_comm
          _ = ∑ k ∈ range h, ∑ i ∈ range h, ∑ j ∈ range h, x i * (M k i * D k * M k j) * x j := sum_comm
          _ = _ := by
              refine sum_congr rfl (fun k _ => ?_)
              simp only [sq, sum_mul, mul_sum]
              refine sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => ?_))
              ring
      have h2 : ∑ i ∈ range h, ∑ j ∈ range h, x i * (if i = j then δ else 0) * x j = δ * S := by
        simp [mul_ite, ite_mul, mul_sum, sq, S]
        refine sum_congr rfl (fun i hi => ?_); rw [if_pos (mem_range.mp hi)]; ring
      unfold qf
      rw [← h1, ← h2, ← sum_add_distrib]
      refine sum_congr rfl (fun i _ => ?_)
      rw [← sum_add_distrib]
      refine sum_congr rfl (fun j _ => ?_)
      simp only [certMat]; ring
    rw [e1]
    have : 0 ≤ ∑ k ∈ range h, D k * (∑ i ∈ range h, M k i * x i) ^ 2 :=
      sum_nonneg (fun k _ => mul_nonneg (hD k) (sq_nonneg _))
    linarith
  have hxx : ∀ i ∈ range h, ∀ j ∈ range h, |x i| * |x j| ≤ S := by
    intro i hi j hj
    have h1 := sq_le_sum (x := x) hi
    have h2 := sq_le_sum (x := x) hj
    have : |x i| * |x j| ≤ (x i ^ 2 + x j ^ 2) / 2 := by
      nlinarith [sq_nonneg (|x i| - |x j|), sq_abs (x i), sq_abs (x j)]
    linarith
  have hE : |qf (fun i j => R i j - certMat h M D δ i j) x (range h) (range h)| ≤ (h : ℝ) ^ 2 * ρ * S := by
    unfold qf
    calc |∑ i ∈ range h, ∑ j ∈ range h, x i * (R i j - certMat h M D δ i j) * x j|
        ≤ ∑ i ∈ range h, ∑ j ∈ range h, |x i * (R i j - certMat h M D δ i j) * x j| :=
          (abs_sum_le_sum_abs _ _).trans (sum_le_sum (fun i _ => abs_sum_le_sum_abs _ _))
      _ ≤ ∑ i ∈ range h, ∑ j ∈ range h, ρ * S := by
          refine sum_le_sum (fun i hi => sum_le_sum (fun j hj => ?_))
          rw [abs_mul, abs_mul]
          have := hA i (mem_range.mp hi) j (mem_range.mp hj)
          calc |x i| * |R i j - certMat h M D δ i j| * |x j|
              = |R i j - certMat h M D δ i j| * (|x i| * |x j|) := by ring
            _ ≤ ρ * S := mul_le_mul this (hxx i hi j hj) (by positivity) hρ0
      _ = (h : ℝ) ^ 2 * ρ * S := by simp [sum_const, card_range]; ring
  have split : qf R x (range h) (range h) = qf (certMat h M D δ) x (range h) (range h)
      + qf (fun i j => R i j - certMat h M D δ i j) x (range h) (range h) := by
    unfold qf; rw [← sum_add_distrib]; refine sum_congr rfl (fun i _ => ?_)
    rw [← sum_add_distrib]; refine sum_congr rfl (fun j _ => ?_); ring
  have hlow := neg_abs_le (qf (fun i j => R i j - certMat h M D δ i j) x (range h) (range h))
  nlinarith

/-- Tail lower bound: diagonal `≥ d`, off-diagonal absolute row sums `≤ e`, symmetric. -/
theorem tail_lower (R : ℕ → ℕ → ℝ) (hsym : ∀ i j, R i j = R j i) (T : Finset ℕ) (d e : ℝ)
    (hdiag : ∀ i ∈ T, d ≤ R i i) (hrow : ∀ i ∈ T, ∑ j ∈ T, |if i = j then 0 else R i j| ≤ e)
    (x : ℕ → ℝ) : (d - e) * ∑ i ∈ T, x i ^ 2 ≤ qf R x T T := by
  set O : ℕ → ℕ → ℝ := fun i j => if i = j then 0 else R i j
  have hsplit : qf R x T T = (∑ i ∈ T, R i i * x i ^ 2) + qf O x T T := by
    unfold qf; rw [← sum_add_distrib]; refine sum_congr rfl (fun i hi => ?_)
    have : ∑ j ∈ T, x i * R i j * x j = x i * R i i * x i + ∑ j ∈ T, x i * O i j * x j := by
      rw [← add_sum_erase T _ hi]
      have e2 : ∑ j ∈ T, x i * O i j * x j = ∑ j ∈ T.erase i, x i * R i j * x j := by
        rw [← add_sum_erase T _ hi]; simp only [O, if_pos rfl]; simp only [mul_zero, zero_mul, zero_add]
        refine sum_congr rfl (fun j hj => ?_)
        rw [if_neg (Ne.symm (ne_of_mem_erase hj))]
      rw [e2]
    rw [this]; ring
  have hdiagS : d * ∑ i ∈ T, x i ^ 2 ≤ ∑ i ∈ T, R i i * x i ^ 2 := by
    rw [mul_sum]; exact sum_le_sum (fun i hi => mul_le_mul_of_nonneg_right (hdiag i hi) (sq_nonneg _))
  have hOsym : ∀ i j, |O i j| = |O j i| := by
    intro i j; simp only [O]; by_cases h : i = j
    · subst h; rfl
    · rw [if_neg h, if_neg (Ne.symm h), hsym]
  have hoff : |qf O x T T| ≤ e * ∑ i ∈ T, x i ^ 2 := by
    have step1 : |qf O x T T| ≤ ∑ i ∈ T, ∑ j ∈ T, |O i j| * ((x i ^ 2 + x j ^ 2) / 2) := by
      unfold qf
      refine (abs_sum_le_sum_abs _ _).trans (sum_le_sum (fun i _ => (abs_sum_le_sum_abs _ _).trans
        (sum_le_sum (fun j _ => ?_))))
      rw [abs_mul, abs_mul]
      have : |x i| * |x j| ≤ (x i ^ 2 + x j ^ 2) / 2 := by
        nlinarith [sq_nonneg (|x i| - |x j|), sq_abs (x i), sq_abs (x j)]
      calc |x i| * |O i j| * |x j| = |O i j| * (|x i| * |x j|) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left this (abs_nonneg _)
    have step2 : ∑ i ∈ T, ∑ j ∈ T, |O i j| * ((x i ^ 2 + x j ^ 2) / 2)
        = ∑ i ∈ T, x i ^ 2 * ∑ j ∈ T, |O i j| := by
      have a1 : ∑ i ∈ T, ∑ j ∈ T, |O i j| * x j ^ 2 = ∑ i ∈ T, ∑ j ∈ T, |O i j| * x i ^ 2 := by
        rw [sum_comm]; refine sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => ?_)); rw [hOsym]
      have : ∑ i ∈ T, ∑ j ∈ T, |O i j| * ((x i ^ 2 + x j ^ 2) / 2)
          = (∑ i ∈ T, ∑ j ∈ T, |O i j| * x i ^ 2 + ∑ i ∈ T, ∑ j ∈ T, |O i j| * x j ^ 2) / 2 := by
        rw [← sum_add_distrib, sum_div]; refine sum_congr rfl (fun i _ => ?_)
        rw [← sum_add_distrib, sum_div]; refine sum_congr rfl (fun j _ => ?_); ring
      rw [this, a1]; simp only [mul_sum]
      rw [show ∀ a : ℝ, (a + a) / 2 = a from fun a => by ring]
      refine sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => ?_)); ring
    have step3 : ∑ i ∈ T, x i ^ 2 * ∑ j ∈ T, |O i j| ≤ ∑ i ∈ T, x i ^ 2 * e :=
      sum_le_sum (fun i hi => mul_le_mul_of_nonneg_left (hrow i hi) (sq_nonneg _))
    rw [← sum_mul] at step3
    linarith [mul_comm e (∑ i ∈ T, x i ^ 2)]
  have := neg_abs_le (qf O x T T)
  rw [hsplit]; nlinarith

/-- Coupling bound by Cauchy–Schwarz. -/
theorem coupling_sq (R : ℕ → ℕ → ℝ) (I J : Finset ℕ) (x : ℕ → ℝ) :
    (qf R x I J) ^ 2 ≤ (∑ i ∈ I, ∑ j ∈ J, R i j ^ 2) * (∑ i ∈ I, x i ^ 2) * (∑ j ∈ J, x j ^ 2) := by
  unfold qf
  have e1 : ∑ i ∈ I, ∑ j ∈ J, x i * R i j * x j = ∑ p ∈ I ×ˢ J, R p.1 p.2 * (x p.1 * x p.2) := by
    rw [sum_product]; refine sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => ?_)); ring
  have e2 : ∑ i ∈ I, ∑ j ∈ J, R i j ^ 2 = ∑ p ∈ I ×ˢ J, R p.1 p.2 ^ 2 := by rw [sum_product]
  have e3 : (∑ i ∈ I, x i ^ 2) * (∑ j ∈ J, x j ^ 2) = ∑ p ∈ I ×ˢ J, (x p.1 * x p.2) ^ 2 := by
    rw [sum_product, sum_mul_sum]; refine sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => ?_)); ring
  rw [e1, e2, mul_assoc, e3]
  exact sum_mul_sq_le_sq_mul_sq _ _ _

/-- **Block theorem (fully proved).** Uniformly in the truncation size `N ≥ h`: head margin `lam0`,
tail diagonal `≥ d`, tail off-diagonal row sums `≤ e`, head–tail Frobenius coupling `≤ c²`, and
`c² ≤ (lam0 - m)(d - e - m)` give `m · ‖x‖² ≤ x ᵀ R_N x`. -/
theorem block_margin (R : ℕ → ℕ → ℝ) (hsym : ∀ i j, R i j = R j i) (h N : ℕ) (hN : h ≤ N)
    (lam0 d e c2 m : ℝ) (x : ℕ → ℝ)
    (hH : lam0 * ∑ i ∈ range h, x i ^ 2 ≤ qf R x (range h) (range h))
    (hdiag : ∀ i ∈ Ico h N, d ≤ R i i)
    (hrow : ∀ i ∈ Ico h N, ∑ j ∈ Ico h N, |if i = j then 0 else R i j| ≤ e)
    (hc : ∑ i ∈ range h, ∑ j ∈ Ico h N, R i j ^ 2 ≤ c2) (hc2 : 0 ≤ c2)
    (hm1 : m ≤ lam0) (hm2 : m ≤ d - e) (hb : c2 ≤ (lam0 - m) * (d - e - m)) :
    m * ∑ i ∈ range N, x i ^ 2 ≤ qf R x (range N) (range N) := by
  have hr : range N = range h ∪ Ico h N := by
    ext i; simp [mem_range, mem_Ico]; omega
  have hdisj : Disjoint (range h) (Ico h N) := by
    rw [disjoint_left]; intro i hi hi'; simp [mem_range, mem_Ico] at hi hi'; omega
  have hq : qf R x (range N) (range N) = qf R x (range h) (range h) + 2 * qf R x (range h) (Ico h N)
      + qf R x (Ico h N) (Ico h N) := by
    unfold qf; rw [hr, sum_union hdisj]
    simp only [sum_union hdisj, sum_add_distrib]
    have : ∑ i ∈ Ico h N, ∑ j ∈ range h, x i * R i j * x j = ∑ i ∈ range h, ∑ j ∈ Ico h N, x i * R i j * x j := by
      rw [sum_comm]; refine sum_congr rfl (fun i _ => sum_congr rfl (fun j _ => ?_)); rw [hsym]; ring
    rw [this]; ring
  have hs : ∑ i ∈ range N, x i ^ 2 = ∑ i ∈ range h, x i ^ 2 + ∑ i ∈ Ico h N, x i ^ 2 := by
    rw [hr, sum_union hdisj]
  have hT := tail_lower R hsym (Ico h N) d e hdiag hrow x
  have hcs : Real.sqrt c2 ^ 2 = c2 := Real.sq_sqrt hc2
  have hB : (qf R x (range h) (Ico h N)) ^ 2 ≤ Real.sqrt c2 ^ 2 * (∑ i ∈ range h, x i ^ 2) * (∑ j ∈ Ico h N, x j ^ 2) := by
    have := coupling_sq R (range h) (Ico h N) x
    have h0 : 0 ≤ (∑ i ∈ range h, x i ^ 2) * (∑ j ∈ Ico h N, x j ^ 2) :=
      mul_nonneg (sum_nonneg fun _ _ => sq_nonneg _) (sum_nonneg fun _ _ => sq_nonneg _)
    rw [hcs]; nlinarith
  have := ShellSchur.margin_of_coupling (qf R x (range h) (range h)) (qf R x (range h) (Ico h N))
    (qf R x (Ico h N) (Ico h N)) lam0 (Real.sqrt c2) (d - e) m (∑ i ∈ range h, x i ^ 2) (∑ i ∈ Ico h N, x i ^ 2)
    hm1 hm2 (sum_nonneg fun _ _ => sq_nonneg _) (sum_nonneg fun _ _ => sq_nonneg _) hH hT hB (by rw [hcs]; exact hb)
  rw [hq, hs]; linarith

