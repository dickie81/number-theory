lemma hD : ∀ k, 0 ≤ D k := by intro k; fin_cases k <;> simp [D] <;> norm_num
lemma hρ : (((28:ℕ)):ℝ) ^ 2 * ρ < δ := by simp only [ρ, δ]; norm_num


/-- ℕ-indexed versions of the head factor and pivots. -/
noncomputable def Mn (k i : ℕ) : ℝ := if h : k < 28 ∧ i < 28 then M ⟨k, h.1⟩ ⟨i, h.2⟩ else 0
noncomputable def Dn (k : ℕ) : ℝ := if h : k < 28 then D ⟨k, h⟩ else 0
lemma hDn : ∀ k, 0 ≤ Dn k := by
  intro k; unfold Dn; split_ifs with h
  · exact hD _
  · exact le_rfl
/-- Tail diagonal lower bound `d` (≤ β* − max|C_nn|), off-diagonal row bound `e`, coupling bound `c²`, margin `m`. -/
noncomputable def dT : ℝ := (:ℝ)
noncomputable def eT : ℝ := (1/100000000000000000000000000000000000000000000000000000:ℝ)
noncomputable def c2T : ℝ := (1/1000000000000000000000000000000000000000000000000:ℝ)
noncomputable def mT : ℝ := (69999999999976137/1250000000000000000000000:ℝ)

/-- **Named hypotheses** (not proved in Lean): arb head enclosure + analytic Bessel tail bounds for the
Zhu-reduced matrix `R` (index `i` ↔ Legendre order `2i`, L = 1/2, T# = 30). See docs. -/
structure TailHyp (R : ℕ → ℕ → ℝ) : Prop where
  symm : ∀ i j, R i j = R j i
  head : ∀ i < 28, ∀ j < 28, |R i j - certMat 28 Mn Dn δ i j| ≤ ρ
  diag : ∀ i, 28 ≤ i → dT ≤ R i i
  row : ∀ N, ∀ i ∈ Ico 28 N, ∑ j ∈ Ico 28 N, |if i = j then 0 else R i j| ≤ eT
  coup : ∀ N, ∑ i ∈ range 28, ∑ j ∈ Ico 28 N, R i j ^ 2 ≤ c2T

/-- **Named hypothesis** (Zhu, Thm 1.1 / Lemma 3.1): the Weil form dominates the reduced form on every truncation. -/
structure ZhuReduction (Q R : ℕ → ℕ → ℝ) : Prop where
  red : ∀ N x, qf R x (range N) (range N) ≤ qf Q x (range N) (range N)

theorem reduced_margin (R : ℕ → ℕ → ℝ) (H : TailHyp R) (N : ℕ) (hN : 28 ≤ N) (x : ℕ → ℝ) :
    mT * ∑ i ∈ range N, x i ^ 2 ≤ qf R x (range N) (range N) := by
  have hρ0 : (0:ℝ) ≤ ρ := by simp only [ρ]; norm_num
  have hH := head_margin 28 R Mn Dn δ ρ hDn hρ0 H.head x
  refine block_margin R H.symm 28 N hN (δ - ((28:ℕ):ℝ) ^ 2 * ρ) dT eT c2T mT x hH
    (fun i hi => H.diag i (mem_Ico.mp hi).1) (H.row N) (H.coup N) (by simp only [c2T]; norm_num)
    ?_ ?_ ?_
  · simp only [mT, δ, ρ]; norm_num
  · simp only [mT, dT, eT]; norm_num
  · simp only [mT, dT, eT, c2T, δ, ρ]; norm_num

/-- **Full-window even-sector positivity at L = 1/2 (conditional on the named hypotheses)**: for every
truncation size `N` and every nonzero coefficient vector, the Weil form is strictly positive. -/
theorem L05_even_pos (Q R : ℕ → ℕ → ℝ) (Z : ZhuReduction Q R) (H : TailHyp R) (N : ℕ) (hN : 28 ≤ N)
    (x : ℕ → ℝ) (hx : ∃ i ∈ range N, x i ≠ 0) : 0 < qf Q x (range N) (range N) := by
  obtain ⟨i, hi, hxi⟩ := hx
  have hs : 0 < ∑ i ∈ range N, x i ^ 2 :=
    lt_of_lt_of_le (by positivity) (sq_le_sum (x := x) hi)
  have hm : (0:ℝ) < mT := by simp only [mT]; norm_num
  have := reduced_margin R H N hN x
  have := Z.red N x
  nlinarith [mul_pos hm hs]

end L05Tail
end WeilTail
