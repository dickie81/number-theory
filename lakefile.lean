/-- The axioms of the papers' theorems; the default target. -/
@[default_target]
lean_lib Check where
  srcDir := "lib/check"
  roots := #[`Check]

/-- The axioms of every final theorem of the library but those CheckLinnik prints; not a default target. -/
lean_lib CheckAll where
  srcDir := "lib/check"
  roots := #[`CheckAll]

/-- The axioms of the zeta23 layer's results, which CheckAll cannot import; not a default target. -/
lean_lib CheckZeta23 where
  srcDir := "lib/check"
  roots := #[`CheckZeta23]

/-- The axioms of the lib/dh layer's results; not a default target. -/
lean_lib CheckDH where
  srcDir := "lib/check"
  roots := #[`CheckDH]

/-- The axioms of the Linnik paper's two theorems and their certificates; opt-in, not a default target. -/
lean_lib CheckLinnik where
  srcDir := "lib/check"
  roots := #[`CheckLinnik]

/-- The dead-code check's Lean side, run by scripts/dead_code.py; it imports only Lean. -/
lean_exe deadcode where
  srcDir := "scripts/lean"
  root := `DeadCode
  supportInterpreter := true
